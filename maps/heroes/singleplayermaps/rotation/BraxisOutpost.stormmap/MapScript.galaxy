//--------------------------------------------------------------------------------------------------
bool gt_HookupGlobalVariables_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libCore_gv_mAPMapStringID = "BraxisOutpost";
    libCore_gv_mAPMapImage = "CustomMiniMap.tga";
    libGame_gv_teams[libGame_gv_teamOrderIndex_C].lv_core = UnitFromId(22);
    libGame_gv_teams[libGame_gv_teamChaosIndex_C].lv_core = UnitFromId(346);
    libCore_gv_mAPOrderBaseRegion = RegionFromId(5);
    libCore_gv_mAPChaosBaseRegion = RegionFromId(3);
    libCore_gv_mAPMapSoundtrack[0] = "MX_BraxisHoldout_Intro";
    libCore_gv_mAPMapSoundtrack[1] = "MX_BraxisHoldout_LVL_1";
    libCore_gv_mAPMapSoundtrack[2] = "MX_BraxisHoldout_LVL_10";
    libCore_gv_mAPMapSoundtrack[3] = "MX_BraxisHoldout_LVL_20";
    return true;
}

