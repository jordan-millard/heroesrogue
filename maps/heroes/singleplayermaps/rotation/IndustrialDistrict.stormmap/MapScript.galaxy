void gf_HookupRegionData () {
    // Automatic Variable Declarations
    // Implementation
    libMapM_gf_MapSetRepulseRegion(libGame_gv_teamOrderIndex_C, RegionFromId(5), PointFromId(1519), PointFromId(1571), PointFromId(1594), null);
    libMapM_gf_MapSetRepulseRegion(libGame_gv_teamChaosIndex_C, RegionFromId(6), PointFromId(1537), PointFromId(1552), PointFromId(1553), null);
    libMapM_gf_MapSetSafeRegion(libGame_gv_teamOrderIndex_C, RegionFromId(5));
    libMapM_gf_MapSetSafeRegion(libGame_gv_teamChaosIndex_C, RegionFromId(6));
}

//--------------------------------------------------------------------------------------------------
// Trigger: Initialize Map
//--------------------------------------------------------------------------------------------------
bool gt_InitializeMap_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libAIAI_gt_IncludeAI, true, false);
    TriggerExecute(libGame_gt_IncludeGame, true, false);
    TriggerExecute(libGDHL_gt_IncludeGameDataHelper, true, false);
    TriggerExecute(libMapM_gt_IncludeMapMechanics, true, false);
    TriggerExecute(libSond_gt_IncludeSound, true, false);
    TriggerExecute(libSprt_gt_IncludeSupport, true, false);
    TriggerExecute(libUIUI_gt_IncludeUI, true, false);
    TriggerExecute(libStEx_gt_IncludeStartingExperience, true, false);
    libOVER_gf_InitTurretMercCampSiegeCamp1();
    gf_HookupGlobalVariables();
    gf_HookupJungleCreepData();
    gf_HookupLaneData();
    gf_HookupTownData();
    gf_HookupRegionData();
    libCore_gv_sYSIsBrawlGame = true;
    libCore_gv_dataXPBrawlMetaXPExpectedDuration = 22.0;
    libCore_gv_sYSTowns = true;
    libCore_gv_sYSJungleCreepCamps = true;
    libCore_gv_sYSJungleWatchTowers = false;
    libCore_gv_sYSTowerAI = true;
    libCore_gv_sYSMinionAI = true;
    // libIGHS_gf_InitializeShufflePickUnlocked(StringExternal("Param/Value/76A0F51C"), true, true, 30, 0.5, true); // HeroesRogue picks heroes
    libCore_gv_sYSGameMode = libCore_ge_GameModes_Sandbox;
    TriggerExecute(libCore_gt_InitializeStormMod, true, true);
    libCore_gf_DataAnnouncerVOSetDefaultAnnouncerForPlayerGroup(PlayerGroupAll(), "Athena");
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_InitializeMap_Init () {
    gt_InitializeMap = TriggerCreate("gt_InitializeMap_Func");
    TriggerAddEventMapInit(gt_InitializeMap);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_InitializeMap_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitTriggers();
}
