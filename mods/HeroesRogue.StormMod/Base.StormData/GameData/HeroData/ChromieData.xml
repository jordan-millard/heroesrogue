<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Chromie. Starters: Sand Sniper (Sand Blast), Bronze Breath (Dragon's Breath) and Chronomancer (an enemy Hero Time Stopped by a Time Trap resets Sand Blast, Dragon's Breath and Time Trap and adds a Temporal Surge stack). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script). Hits, quests, echoes, Temporal Surge and script boons are in HeroTriggers/Chromie.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="ChromieGoldenSniperMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenBreathMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenChronoMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenTemporalShardsMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenHourglassMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenBronzeRingMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenInfiniteBreathMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenTimeBombMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ChromieGoldenTimelineSplitMarker" parent="CarryBehaviorParent" />
  <!-- Temporal Shards (Epic): the shard's explosion -->
  <CEffectDamage id="ChromieGoldenShardDamage" parent="StormSpell">
    <MultiplicativeModifierArray index="TemporalShards" Modifier="-0.6" />
    <Amount value="305" />
    <SourceButtonFace value="ChromieSandBlast" />
    <AttributeFactor index="Structure" value="-0.5" />
  </CEffectDamage>
  <!-- Time Bomb (Epic): the trap's explosion -->
  <CEffectDamage id="ChromieGoldenTimeBombDamage" parent="StormSpell">
    <MultiplicativeModifierArray index="TimeBomb" Modifier="-0.5" />
    <Amount value="305" />
    <SourceButtonFace value="ChromieTimeTrap" />
    <AttributeFactor index="Structure" value="-0.5" />
  </CEffectDamage>

  <!-- ===== Sand Sniper ===== -->
  <!-- Sand Blast has 2 charges (3 second recharge), costs half Mana (10), deals 20% more damage and reaches 20% farther (15 to 18); Bronze Talons and Gnome Speed Ahead. Pinpoint quest (50% kept): 0.5% Sand Blast damage per enemy Hero hit. Sands of Time quest: takedowns within 3 seconds of a hit; stacks 1-40 1% of the recharge each, 41-80 1% missile acceleration each, 81-100 1% width each, 100 a second Sand Blast for 50% (script), then 2.5% all damage each. -->
  <CBehaviorTokenCounter id="ChromieGoldenPinpointTokenCounter" parent="StormQuestToken">
    <Face value="ChromieGoldenPinpointTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="ChromieGoldenSandsOfTimeTokenCounter" parent="StormQuestToken">
    <Face value="ChromieGoldenSandsOfTimeTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="ChromieGoldenPinpointTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="ChromieGoldenPinpointTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="ChromieSandBlastDamage">
    <MultiplicativeModifierArray index="ChromieSniperPower" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieSniperCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieSniperHit" Accumulator="ChromieGoldenPinpointTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ChromieSniperLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieGoldenSniperEcho" Validator="ChromieGoldenSniperEchoing" Modifier="-0.5" />
  </CEffectDamage>
  <CEffectDamage id="ChromieSandBlastPastAndFutureMeDamage">
    <MultiplicativeModifierArray index="ChromieSniperPower" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieSniperCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieSniperHit" Accumulator="ChromieGoldenPinpointTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ChromieSniperLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ChromieGoldenShardDamage">
    <MultiplicativeModifierArray index="ChromieSniperPower" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieSniperCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieSniperHit" Accumulator="ChromieGoldenPinpointTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ChromieSniperLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="ChromieGoldenPinpointTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Chromie_AetherCannon.dds" />
  </CButton>
  <CButton id="ChromieGoldenSandsOfTimeTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Chromie_AetherCannon.dds" />
  </CButton>

  <!-- ===== Bronze Breath ===== -->
  <!-- Dragon's Breath has 2 charges (14 second recharge), costs half Mana (32.5), deals 20% more damage and its blasts are 20% larger (radius 2 to 2.4, visuals too); Deep Breathing and Mobius Loop. Bronze Fire quest (50% kept): 1.5% Dragon's Breath damage per enemy Hero hit. Dragonflight quest: takedowns within 3 seconds of a hit; stacks 1-40 1% of the recharge each, 41-80 1% of the 0.6875 second delay each, 81-100 1% area each, 100 each blast erupts again for 50% (script), then 2.5% all damage each. -->
  <CBehaviorTokenCounter id="ChromieGoldenBronzeFireTokenCounter" parent="StormQuestToken">
    <Face value="ChromieGoldenBronzeFireTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="ChromieGoldenDragonflightTokenCounter" parent="StormQuestToken">
    <Face value="ChromieGoldenDragonflightTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="ChromieGoldenBronzeFireTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="ChromieGoldenBronzeFireTokenCounter" />
    <Scale value="0.015" />
  </CAccumulatorToken>
  <CEffectDamage id="ChromieDragonsBreathDamage">
    <MultiplicativeModifierArray index="ChromieBreathPower" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieBreathCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieBreathHit" Accumulator="ChromieGoldenBronzeFireTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ChromieBreathLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieGoldenBreathEcho" Validator="ChromieGoldenBreathEchoing" Modifier="-0.5" />
  </CEffectDamage>
  <CButton id="ChromieGoldenBronzeFireTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Chromie_SandStrike.dds" />
  </CButton>
  <CButton id="ChromieGoldenDragonflightTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Chromie_SandStrike.dds" />
  </CButton>

  <!-- ===== Chronomancer ===== -->
  <!-- Time Trap costs no Mana and up to 10 can be active (the script keeps the tracker at 10); the three level 4 Time Trap talents (Chronic Conditions: traps go off on enemy Heroes by themselves; Time Troubles; Andorhal Anomaly); Chronic Conditions' Slow 30% stronger (25% to 55%). An enemy Hero Time Stopped by one of the traps, set off or detonated (seen by the script), resets Sand Blast, Dragon's Breath and Time Trap and adds a Temporal Surge stack (10 seconds, each new one refreshes all, up to 5): Sand Blast and Dragon's Breath deal 10% more per stack, shown as critical (the script sets the Modifier). Resonance quest (50% kept): 0.25% more Temporal Surge damage per stack per enemy Hero Time Stopped. Timeline quest: takedowns within 6 seconds of a Time Stop or a Sand Blast or Dragon's Breath hit; stacks 1-40 each Time Stop heals 0.25% of maximum Health each, 41-80 Chronic Conditions' Slow 0.25% stronger each, 100 traps have twice the radius and Health (script), then 1% Spell Power each. -->
  <CBehaviorTokenCounter id="ChromieGoldenResonanceTokenCounter" parent="StormQuestToken">
    <Face value="ChromieGoldenResonanceTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="ChromieGoldenTimelineTokenCounter" parent="StormQuestToken">
    <Face value="ChromieGoldenTimelineTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="ChromieGoldenResonanceTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="ChromieGoldenResonanceTokenCounter" />
    <Scale value="0.0025" />
  </CAccumulatorToken>
  <CEffectDamage id="ChromieSandBlastDamage">
    <MultiplicativeModifierArray index="ChromieChronoPower" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoCommon" Validator="ChromieGoldenCasterHasSurge" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieGoldenSurge" Validator="ChromieGoldenCasterHasSurge" Modifier="0" Crit="1" />
  </CEffectDamage>
  <CEffectDamage id="ChromieDragonsBreathDamage">
    <MultiplicativeModifierArray index="ChromieChronoPower" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoCommon" Validator="ChromieGoldenCasterHasSurge" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieGoldenSurge" Validator="ChromieGoldenCasterHasSurge" Modifier="0" Crit="1" />
  </CEffectDamage>
  <CEffectDamage id="ChromieGoldenTimeBombDamage">
    <MultiplicativeModifierArray index="ChromieChronoPower" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoCommon" Validator="ChromieGoldenCasterHasSurge" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="ChromieGoldenResonanceTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Chromie_Looper.dds" />
  </CButton>
  <CButton id="ChromieGoldenTimelineTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Chromie_Looper.dds" />
  </CButton>

  <!-- ===== Takedown quest damage past the cap, also on these effects ===== -->
  <CEffectDamage id="ChromieDragonsBreathDamage">
    <MultiplicativeModifierArray index="ChromieSniperLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ChromieGoldenTimeBombDamage">
    <MultiplicativeModifierArray index="ChromieSniperLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieBreathLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ChromieHeroWeaponDamage">
    <MultiplicativeModifierArray index="ChromieSniperLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieBreathLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ChromieSandEchoWeaponDamage">
    <MultiplicativeModifierArray index="ChromieSniperLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieBreathLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ChromieSandBlastDamage">
    <MultiplicativeModifierArray index="ChromieBreathLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ChromieSandBlastPastAndFutureMeDamage">
    <MultiplicativeModifierArray index="ChromieBreathLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ChromieGoldenShardDamage">
    <MultiplicativeModifierArray index="ChromieBreathLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="ChromieChronoLegacy" Modifier="0" />
  </CEffectDamage>

  <!-- ===== Boons ===== -->
  <!-- ===== Echo markers: while one is on Chromie (an echo Sand Blast in flight, or one echo blast of Dragon's Breath)
       the matching damage modifier applies. The script adds them. -->
  <CBehaviorBuff id="ChromieGoldenSniperEchoMarker">
    <InfoFlags index="Hidden" value="1" />
    <MaxStackCount value="5" />
    <Duration value="1.25" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenSniperEchoing">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenSniperEchoMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CBehaviorBuff id="ChromieGoldenBreathEchoMarker">
    <InfoFlags index="Hidden" value="1" />
    <MaxStackCount value="5" />
    <Duration value="1.25" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenBreathEchoing">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenBreathEchoMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterHasSurge">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenTemporalSurge" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterIsSniper">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenSniperMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterHasShards">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenTemporalShardsMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterHasHourglass">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenHourglassMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterHasBronzeRing">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenBronzeRingMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>

  <!-- ===== Sand Sniper ===== -->
  <!-- Sand Blast's own hit effects, plus the Sand Sniper and boon ones -->
  <CEffectSet id="ChromieSandBlastImpactSet">
    <EffectArray value="ChromieGoldenFastForwardCharge" />
    <EffectArray value="ChromieGoldenShardPersistent" />
    <EffectArray value="ChromieGoldenHourglassCooldown" />
  </CEffectSet>
  <!-- Fast Forward lowers Sand Blast's cooldown to 0.5 seconds, which does nothing with charges: Sand Sniper takes 2.5
       seconds off the recharge instead -->
  <CEffectModifyUnit id="ChromieGoldenFastForwardCharge">
    <ValidatorArray value="ChromieGoldenCasterIsSniper" />
    <ValidatorArray value="ChromieFastForwardCombine" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="ChromieSandBlast,Execute" ChargeTimeUse="-2.5" />
  </CEffectModifyUnit>
  <!-- Temporal Shards (Epic): a Sand Blast hit on an enemy Hero leaves a shard at that spot that explodes 1.5 seconds later
       in a 1.5 radius for 40% of Sand Blast's damage (the script copies Sand Blast's Amount) -->
  <CEffectCreatePersistent id="ChromieGoldenShardPersistent">
    <ValidatorArray value="ChromieGoldenCasterHasShards" />
    <ValidatorArray value="TargetIsHero" />
    <WhichLocation Value="TargetPoint" />
    <ExpireDelay value="1.5" />
    <ExpireEffect value="ChromieGoldenShardSearch" />
  </CEffectCreatePersistent>
  <CEffectEnumArea id="ChromieGoldenShardSearch">
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="ChromieGoldenShardDamage">
      <Radius value="1.5" />
    </AreaArray>
  </CEffectEnumArea>
  <!-- Hourglass (Legendary): a Sand Blast hit on an enemy Hero takes 2 seconds off Dragon's Breath's cooldown -->
  <CEffectModifyUnit id="ChromieGoldenHourglassCooldown">
    <ValidatorArray value="ChromieGoldenCasterHasHourglass" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="ChromieDragonsBreath,Execute" CooldownOperation="Add" CooldownTimeUse="-2" ChargeTimeUse="-2" />
  </CEffectModifyUnit>

  <!-- ===== Bronze Breath ===== -->
  <!-- Deep Breathing's reward cuts Dragon's Breath's cooldown, which does nothing with charges: cut the recharge too -->
  <CEffectModifyPlayer id="ChromieDragonsBreathDeepBreathingFinalModifyUnit">
    <EffectArray Reference="Abil,ChromieDragonsBreath,Cost.Charge.TimeUse" Value="-4" />
  </CEffectModifyPlayer>
  <!-- Bronze Ring (Epic): each blast leaves a ring for 2 seconds that Slows enemies in it by 40% -->
  <CEffectSet id="ChromieDragonsBreathSet">
    <EffectArray value="ChromieGoldenBronzeRingPersistent" />
  </CEffectSet>
  <CEffectCreatePersistent id="ChromieGoldenBronzeRingPersistent">
    <ValidatorArray value="ChromieGoldenCasterHasBronzeRing" />
    <WhichLocation Value="TargetPoint" />
    <PeriodCount value="8" />
    <PeriodicPeriodArray value="0.25" />
    <PeriodicEffectArray value="ChromieGoldenBronzeRingSearch" />
  </CEffectCreatePersistent>
  <CEffectEnumArea id="ChromieGoldenBronzeRingSearch">
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="ChromieGoldenBronzeRingSlowApply">
      <Radius value="2.4" />
    </AreaArray>
  </CEffectEnumArea>
  <CBehaviorBuff id="ChromieGoldenBronzeRingSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Chromie_SandStrike.dds" />
    <Duration value="0.5" />
    <Modification>
      <UnifiedMoveSpeedFactor value="-0.4" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ChromieGoldenBronzeRingSlowApply">
    <Behavior value="ChromieGoldenBronzeRingSlow" />
  </CEffectApplyBehavior>

  <!-- ===== Chronomancer ===== -->
  <!-- Temporal Surge: a stack for each enemy Hero Time Stopped by one of Chromie's traps (set off or detonated; the script
       sees the Time Stop and adds it). Up to 5 (8 with Timeline Split), all refreshed to 10 seconds by each new one. -->
  <CBehaviorBuff id="ChromieGoldenTemporalSurge">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Chromie_Looper.dds" />
    <Alignment value="Positive" />
    <Duration value="10" />
    <MaxStackCount value="5" />
    <BuffFlags index="RefreshStack" value="1" />
  </CBehaviorBuff>
  <!-- Timeline stacks 1-40: each enemy Hero Time Stopped heals 0.25% of maximum Health per stack (the script raises
       the fraction) -->
  <CEffectModifyUnit id="ChromieGoldenTrapHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0" />
    </VitalArray>
  </CEffectModifyUnit>
  <!-- Time Bomb (Epic): an enemy Hero Time Stopped by a trap explodes for 50% of Sand Blast's damage -->
  <CEffectEnumArea id="ChromieGoldenTimeBombSearch">
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="ChromieGoldenTimeBombDamage">
      <Radius value="2.5" />
    </AreaArray>
  </CEffectEnumArea>

  <!-- ===== Echo blast visuals ===== -->
  <!-- Echo blasts of Dragon's Breath (Bronze Breath at 100) run its blast directly, without the delay
       persistent that makes the eruption and the warning circles. The script starts this persistent at the spot 0.6875
       seconds (the real delay) before the echo blast; copies of those actors follow it instead. -->
  <CEffectCreatePersistent id="ChromieGoldenEchoBreathFX">
    <WhichLocation Value="TargetPoint" />
    <ExpireDelay value="0.6875" />
  </CEffectCreatePersistent>
  <CActorModel id="ChromieGoldenEchoBreathGround" parent="ChromieDragonsBreathGround">
    <On index="0" Terms="Effect.ChromieGoldenEchoBreathFX.Start; At Effect" Send="Create" />
    <Model value="ChromieDragonsBreathGround" />
  </CActorModel>
  <CActorModel id="ChromieGoldenEchoBreathAllyWarningSplat" parent="ChromieDragonsBreathAllyWarningSplat">
    <On index="0" Terms="Effect.ChromieGoldenEchoBreathFX.Start; At Effect" Send="Create" />
    <On index="1" Terms="Effect.ChromieGoldenEchoBreathFX.Stop; At Effect" Send="Destroy Immediate" />
  </CActorModel>
  <CActorModel id="ChromieGoldenEchoBreathEnemyWarningSplat" parent="ChromieDragonsBreathEnemyWarningSplat">
    <On index="0" Terms="Effect.ChromieGoldenEchoBreathFX.Start; At Effect" Send="Create" />
    <On index="1" Terms="Effect.ChromieGoldenEchoBreathFX.Stop; At Effect" Send="Destroy Immediate" />
  </CActorModel>
</Catalog>
