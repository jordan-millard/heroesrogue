  <!-- ===== Boons ===== -->
  <!-- ===== Echo markers: while one is on Chromie (an echo Sand Blast in flight, or one echo blast of Dragon's Breath)
       the matching damage modifier applies. The script adds them. -->
  <CBehaviorBuff id="ChromieGoldenSniperEchoMarker">
    <InfoFlags index="Hidden" value="1" />
    <MaxStackCount value="5" />
    <Duration value="1.25" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenSniperEchoing">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenSniperEchoMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CBehaviorBuff id="ChromieGoldenBreathEchoMarker">
    <InfoFlags index="Hidden" value="1" />
    <MaxStackCount value="5" />
    <Duration value="1.25" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenBreathEchoing">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenBreathEchoMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterIsSniper">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenSniperMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterHasShards">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenTemporalShardsMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterHasHourglass">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenHourglassMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="ChromieGoldenCasterHasBronzeRing">
    <WhichUnit Value="Caster" />
    <Behavior value="ChromieGoldenBronzeRingMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>

  <!-- ===== Sand Sniper ===== -->
  <!-- Sand Blast's own hit effects, plus the Sand Sniper and boon ones -->
  <CEffectSet id="ChromieSandBlastImpactSet">
    <EffectArray value="ChromieGoldenFastForwardCharge" />
    <EffectArray value="ChromieGoldenShardPersistent" />
    <EffectArray value="ChromieGoldenHourglassCooldown" />
  </CEffectSet>
  <!-- Fast Forward lowers Sand Blast's cooldown to 0.5 seconds, which does nothing with charges: Sand Sniper takes 2.5
       seconds off the recharge instead -->
  <CEffectModifyUnit id="ChromieGoldenFastForwardCharge">
    <ValidatorArray value="ChromieGoldenCasterIsSniper" />
    <ValidatorArray value="ChromieFastForwardCombine" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="ChromieSandBlast,Execute" ChargeTimeUse="-2.5" />
  </CEffectModifyUnit>
  <!-- Temporal Shards (Epic): a Sand Blast hit on an enemy Hero leaves a shard at that spot that explodes 1.5 seconds later
       in a 1.5 radius for 40% of Sand Blast's damage (the script copies Sand Blast's Amount) -->
  <CEffectCreatePersistent id="ChromieGoldenShardPersistent">
    <ValidatorArray value="ChromieGoldenCasterHasShards" />
    <ValidatorArray value="TargetIsHero" />
    <WhichLocation Value="TargetPoint" />
    <ExpireDelay value="1.5" />
    <ExpireEffect value="ChromieGoldenShardSearch" />
  </CEffectCreatePersistent>
  <CEffectEnumArea id="ChromieGoldenShardSearch">
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="ChromieGoldenShardDamage">
      <Radius value="1.5" />
    </AreaArray>
  </CEffectEnumArea>
  <!-- Hourglass (Legendary): a Sand Blast hit on an enemy Hero takes 2 seconds off Dragon's Breath's cooldown -->
  <CEffectModifyUnit id="ChromieGoldenHourglassCooldown">
    <ValidatorArray value="ChromieGoldenCasterHasHourglass" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="ChromieDragonsBreath,Execute" CooldownOperation="Add" CooldownTimeUse="-2" ChargeTimeUse="-2" />
  </CEffectModifyUnit>

  <!-- ===== Bronze Breath ===== -->
  <!-- Deep Breathing's reward cuts Dragon's Breath's cooldown, which does nothing with charges: cut the recharge too -->
  <CEffectModifyPlayer id="ChromieDragonsBreathDeepBreathingFinalModifyUnit">
    <EffectArray Reference="Abil,ChromieDragonsBreath,Cost.Charge.TimeUse" Value="-4" />
  </CEffectModifyPlayer>
  <!-- Bronze Ring (Epic): each blast leaves a ring for 2 seconds that Slows enemies in it by 40% -->
  <CEffectSet id="ChromieDragonsBreathSet">
    <EffectArray value="ChromieGoldenBronzeRingPersistent" />
  </CEffectSet>
  <CEffectCreatePersistent id="ChromieGoldenBronzeRingPersistent">
    <ValidatorArray value="ChromieGoldenCasterHasBronzeRing" />
    <WhichLocation Value="TargetPoint" />
    <PeriodCount value="8" />
    <PeriodicPeriodArray value="0.25" />
    <PeriodicEffectArray value="ChromieGoldenBronzeRingSearch" />
  </CEffectCreatePersistent>
  <CEffectEnumArea id="ChromieGoldenBronzeRingSearch">
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="ChromieGoldenBronzeRingSlowApply">
      <Radius value="2.4" />
    </AreaArray>
  </CEffectEnumArea>
  <CBehaviorBuff id="ChromieGoldenBronzeRingSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Chromie_SandStrike.dds" />
    <Duration value="0.5" />
    <Modification>
      <UnifiedMoveSpeedFactor value="-0.4" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ChromieGoldenBronzeRingSlowApply">
    <Behavior value="ChromieGoldenBronzeRingSlow" />
  </CEffectApplyBehavior>

  <!-- ===== Chronomancer ===== -->
  <!-- The trap Slow decays from 90% to 15% over 6 seconds: Chronic Conditions' own Slow (90% for 1 second for this player,
       set by the starter) and these five (2 to 6 seconds), all applied at once. The strongest Slow is the one that counts,
       so it steps 90, 75, 60, 45, 30, 15%. Their amounts are 0 except for Chronomancer (set by the starter). -->
  <CBehaviorBuff id="ChromieGoldenTrapSlow2" parent="ChromieTimeTrapChronicConditionsSlow">
    <Duration value="2" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ChromieGoldenTrapSlow2Apply" parent="ChromieTimeTrapChronicConditionsSlowApplyBehavior">
    <Behavior value="ChromieGoldenTrapSlow2" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="ChromieGoldenTrapSlow3" parent="ChromieTimeTrapChronicConditionsSlow">
    <Duration value="3" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ChromieGoldenTrapSlow3Apply" parent="ChromieTimeTrapChronicConditionsSlowApplyBehavior">
    <Behavior value="ChromieGoldenTrapSlow3" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="ChromieGoldenTrapSlow4" parent="ChromieTimeTrapChronicConditionsSlow">
    <Duration value="4" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ChromieGoldenTrapSlow4Apply" parent="ChromieTimeTrapChronicConditionsSlowApplyBehavior">
    <Behavior value="ChromieGoldenTrapSlow4" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="ChromieGoldenTrapSlow5" parent="ChromieTimeTrapChronicConditionsSlow">
    <Duration value="5" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ChromieGoldenTrapSlow5Apply" parent="ChromieTimeTrapChronicConditionsSlowApplyBehavior">
    <Behavior value="ChromieGoldenTrapSlow5" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="ChromieGoldenTrapSlow6" parent="ChromieTimeTrapChronicConditionsSlow">
    <Duration value="6" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ChromieGoldenTrapSlow6Apply" parent="ChromieTimeTrapChronicConditionsSlowApplyBehavior">
    <Behavior value="ChromieGoldenTrapSlow6" />
  </CEffectApplyBehavior>
  <CEffectSet id="ChromieTimeTrapChronicConditionsSet">
    <EffectArray value="ChromieGoldenTrapSlow2Apply" />
    <EffectArray value="ChromieGoldenTrapSlow3Apply" />
    <EffectArray value="ChromieGoldenTrapSlow4Apply" />
    <EffectArray value="ChromieGoldenTrapSlow5Apply" />
    <EffectArray value="ChromieGoldenTrapSlow6Apply" />
  </CEffectSet>
  <!-- Timeline stacks 1-40: a Shield of 0.5% of maximum Health per stack (up to 20%) that never expires; the script sets
       its size and refills it on each takedown, respawn and map start -->
  <CBehaviorBuff id="ChromieGoldenTimelineShield" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Chromie_Looper.dds" />
    <Duration value="0" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <!-- Time Bomb (Epic): an enemy Hero Time Stopped by a trap explodes for 50% of Sand Blast's damage -->
  <CEffectEnumArea id="ChromieGoldenTimeBombSearch">
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="ChromieGoldenTimeBombDamage">
      <Radius value="2.5" />
    </AreaArray>
  </CEffectEnumArea>

  <!-- ===== Echo blast visuals ===== -->
  <!-- Echo blasts of Dragon's Breath (Bronze Breath at 100) run its blast directly, without the delay
       persistent that makes the eruption and the warning circles. The script starts this persistent at the spot 0.6875
       seconds (the real delay) before the echo blast; copies of those actors follow it instead. -->
  <CEffectCreatePersistent id="ChromieGoldenEchoBreathFX">
    <WhichLocation Value="TargetPoint" />
    <ExpireDelay value="0.6875" />
