<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- Fury's Movement Speed multiplies instead of using the unified bonus, so it stacks with other Movement Speed -->
  <CBehaviorBuff id="BarbarianFuryTraitMoveSpeedBuff">
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
      <MoveSpeedMultiplier value="1.1" />
    </Modification>
  </CBehaviorBuff>
  <CTalent id="BarbarianNoEscape">
    <AbilityModificationArray index="0">
      <Modifications index="0">
        <Field value="Modification.MoveSpeedMultiplier" />
      </Modifications>
    </AbilityModificationArray>
  </CTalent>

  <CBehaviorBuff id="SonyaSonyasFuryCarry" parent="CarryBehaviorParent">
    <Modification>
      <VitalMaxArray index="Energy" value="25" />
    </Modification>
  </CBehaviorBuff>

  <!-- Golden Sonya, Spin to Win: no Seismic Slam; Unstoppable for the first 1.5 seconds of Whirlwind. Whirlwind spends
       all Fury and its duration scales with the Fury spent, its area grows while Channeled, and hits store bonus damage
       for the next Whirlwind: see HeroTriggers/Sonya.galaxy -->
  <CBehaviorBuff id="SonyaSpinToWinMarker" parent="CarryBehaviorParent">
    <Modification>
      <AbilLinkDisableArray value="BarbarianSeismicSlam" />
    </Modification>
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="SonyaHasSpinToWin">
    <WhichUnit Value="Caster" />
    <Behavior value="SonyaSpinToWinMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- Shows the bonus damage of the next Whirlwind; it drops when a Whirlwind starts, so no quest sounds -->
  <CBehaviorTokenCounter id="SonyaSpinToWinTokenCounter" parent="StormQuestToken">
    <Face value="SonyaSpinToWinTokenCounter" />
    <Max value="100000" />
    <IncreaseEvents index="0" EventId="" />
    <DecreaseEvents index="0" EventId="" />
    <AtMinEvents index="0" EventId="" />
  </CBehaviorTokenCounter>
  <CBehaviorBuff id="SonyaSpinToWinUnstoppable" parent="StormUnstoppableParent">
    <Duration value="1.5" />
    <RemoveValidatorArray value="HasBarbarianWhirlwind" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="SonyaSpinToWinApplyUnstoppable">
    <ValidatorArray value="SonyaHasSpinToWin" />
    <WhichUnit Value="Caster" />
    <Behavior value="SonyaSpinToWinUnstoppable" />
  </CEffectApplyBehavior>
  <!-- Unstoppable Spin: any Sonya is Unstoppable for her whole Whirlwind (the boon removes the 1.5 second limit) -->
  <CEffectApplyBehavior id="SonyaUnstoppableSpinApply">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="SonyaSpinToWinUnstoppable" />
  </CEffectApplyBehavior>
  <CEffectRemoveBehavior id="SonyaSpinToWinRemoveUnstoppable">
    <WhichUnit Value="Source" />
    <BehaviorLink value="SonyaSpinToWinUnstoppable" />
  </CEffectRemoveBehavior>
  <!-- Damage radius indicator while Spin to Win Whirlwinds; the script scales it to the radius -->
  <CBehaviorBuff id="SonyaSpinToWinSpinning">
    <InfoFlags index="Hidden" value="1" />
    <RemoveValidatorArray value="HasBarbarianWhirlwind" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="SonyaSpinToWinApplySpinning">
    <ValidatorArray value="SonyaHasSpinToWin" />
    <WhichUnit Value="Caster" />
    <Behavior value="SonyaSpinToWinSpinning" />
  </CEffectApplyBehavior>
  <CEffectRemoveBehavior id="SonyaSpinToWinRemoveSpinning">
    <WhichUnit Value="Source" />
    <BehaviorLink value="SonyaSpinToWinSpinning" />
  </CEffectRemoveBehavior>
  <CActorSplat id="SonyaSpinToWinRadiusSplat" parent="StormRangeSplat">
    <On Terms="Behavior.SonyaSpinToWinSpinning.On" Send="Create" />
    <On Terms="Behavior.SonyaSpinToWinSpinning.Off" Send="Destroy" />
    <HostSiteOps Ops="SOpAttachOrigin" />
    <Scale value="2.5" />
  </CActorSplat>
  <CEffectSet id="BarbarianWhirlwindInitialSet">
    <EffectArray value="SonyaSpinToWinApplyUnstoppable" />
    <EffectArray value="SonyaUnstoppableSpinApply" />
    <EffectArray value="SonyaSpinToWinApplySpinning" />
  </CEffectSet>
  <!-- Spends all Fury before the Whirlwind starts; the duration was already set from the Fury held -->
  <CEffectModifyUnit id="SonyaSpinToWinSpendFury">
    <ValidatorArray value="SonyaHasSpinToWin" />
    <ImpactUnit Value="Caster" />
    <VitalArray index="Energy">
      <Change value="-100000" />
    </VitalArray>
  </CEffectModifyUnit>
  <CEffectSet id="SonyaSpinToWinWhirlwindInitialSet">
    <EffectArray value="SonyaSpinToWinSpendFury" />
    <EffectArray value="BarbarianWhirlwindInitialSet" />
  </CEffectSet>
  <CEffectCreatePersistent id="BarbarianWhirlwindCreatePersistent">
    <InitialEffect value="SonyaSpinToWinWhirlwindInitialSet" />
  </CEffectCreatePersistent>
  <CEffectSet id="BarbarianWhirlwindFinalSet">
    <EffectArray value="SonyaSpinToWinRemoveUnstoppable" />
    <EffectArray value="SonyaSpinToWinRemoveSpinning" />
  </CEffectSet>
  <!-- Spin to Win quest: Hero takedowns grant stacks that add Whirlwind damage and carry over -->
  <CBehaviorTokenCounter id="SonyaSpinToWinQuestTokenCounter" parent="StormQuestToken">
    <Face value="SonyaSpinToWinQuestTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="SonyaSpinToWinQuestAccumulator" parent="BaseAccumulator">
    <ApplicationRule value="Add" />
    <TokenId value="SonyaSpinToWinQuestTokenCounter" />
    <Scale value="0.01" />
    <MaxAccumulation value="100000" />
  </CAccumulatorToken>
  <CEffectDamage id="BarbarianWhirlwindDamage">
    <MultiplicativeModifierArray index="SonyaSpinToWin" Modifier="0" />
    <MultiplicativeModifierArray index="SonyaSpinToWinQuest" Accumulator="SonyaSpinToWinQuestAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="BarbarianWhirlwindHeroDamage">
    <MultiplicativeModifierArray index="SonyaSpinToWin" Modifier="0" />
    <MultiplicativeModifierArray index="SonyaSpinToWinQuest" Accumulator="SonyaSpinToWinQuestAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="BarbarianWhirlwindRuthlessTalentDamage">
    <MultiplicativeModifierArray index="SonyaSpinToWin" Modifier="0" />
    <MultiplicativeModifierArray index="SonyaSpinToWinQuest" Accumulator="SonyaSpinToWinQuestAccumulator" />
  </CEffectDamage>

  <!-- Golden Sonya, Seismic Brute: Seismic Slam hitting enemy Heroes grants stacks; stacks add Seismic Slam damage -->
  <CBehaviorTokenCounter id="SonyaSeismicBruteTokenCounter" parent="StormQuestToken">
    <Face value="SonyaSeismicBruteTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectModifyTokenCount id="SonyaSeismicBruteAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <EffectCategory index="Quest" value="1" />
    <TokenId value="SonyaSeismicBruteTokenCounter" />
  </CEffectModifyTokenCount>
  <CEffectSet id="BarbarianSeismicSlamSet">
    <EffectArray value="SonyaSeismicBruteAddToken" />
  </CEffectSet>
  <CAccumulatorToken id="SonyaSeismicBruteAccumulator" parent="BaseAccumulator">
    <ApplicationRule value="Add" />
    <TokenId value="SonyaSeismicBruteTokenCounter" />
    <Scale value="0.01" />
    <MaxAccumulation value="100000" />
  </CAccumulatorToken>
  <CEffectDamage id="BarbarianSeismicSlamDamage">
    <MultiplicativeModifierArray index="SonyaSeismicBrute" Accumulator="SonyaSeismicBruteAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="BarbarianSeismicSlamSecondaryDamage">
    <MultiplicativeModifierArray index="SonyaSeismicBrute" Accumulator="SonyaSeismicBruteAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="BarbarianSeismicSlamShatteredGroundSecondaryDamage">
    <MultiplicativeModifierArray index="SonyaSeismicBrute" Accumulator="SonyaSeismicBruteAccumulator" />
  </CEffectDamage>

  <!-- Golden Sonya, Ancient Hunter: Ancient Spear hitting enemy Heroes grants stacks; stacks add Ancient Spear damage -->
  <CBehaviorTokenCounter id="SonyaAncientHunterTokenCounter" parent="StormQuestToken">
    <Face value="SonyaAncientHunterTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectModifyTokenCount id="SonyaAncientHunterAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <EffectCategory index="Quest" value="1" />
    <TokenId value="SonyaAncientHunterTokenCounter" />
  </CEffectModifyTokenCount>
  <CEffectSet id="BarbarianAncientSpearImpactSet">
    <EffectArray value="SonyaAncientHunterAddToken" />
  </CEffectSet>
  <CAccumulatorToken id="SonyaAncientHunterAccumulator" parent="BaseAccumulator">
    <ApplicationRule value="Add" />
    <TokenId value="SonyaAncientHunterTokenCounter" />
    <Scale value="0.03" />
    <MaxAccumulation value="100000" />
  </CAccumulatorToken>
  <CEffectDamage id="BarbarianAncientSpearDamage">
    <MultiplicativeModifierArray index="SonyaAncientHunter" Accumulator="SonyaAncientHunterAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="BarbarianAncientSpearMasteryPoisonDamage">
    <MultiplicativeModifierArray index="SonyaAncientHunter" Accumulator="SonyaAncientHunterAccumulator" />
  </CEffectDamage>

  <!-- Crippling Whirl: Whirlwind hits slow by 5% per stack, up to 50%, for 5 seconds -->
  <CBehaviorBuff id="SonyaCripplingWhirlSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_sonya_whirlwind.dds" />
    <BuffFlags index="RefreshStack" value="1" />
    <MaxStackCount value="10" />
    <Duration value="5" />
    <Modification>
      <UnifiedMoveSpeedFactor value="-0.05" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="SonyaCripplingWhirlApplySlow">
    <Chance value="0" />
    <Behavior value="SonyaCripplingWhirlSlow" />
  </CEffectApplyBehavior>
  <!-- Eternal Battle: each Whirlwind hit extends Whirlwind -->
  <CEffectModifyBehaviorBuffDuration id="SonyaEternalBattleExtend">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="BarbarianWhirlwindChannel" />
    <Value value="0.1" />
  </CEffectModifyBehaviorBuffDuration>
  <CEffectSet id="BarbarianWhirlwindDamageSet">
    <EffectArray value="SonyaCripplingWhirlApplySlow" />
    <EffectArray value="SonyaEternalBattleExtend" />
  </CEffectSet>

  <CButton id="SonyaSpinToWinTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_sonya_whirlwind.dds" />
  </CButton>
  <CButton id="SonyaSpinToWinQuestTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_sonya_fury.dds" />
  </CButton>
  <CButton id="SonyaSeismicBruteTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_sonya_seismicslam.dds" />
  </CButton>
  <CButton id="SonyaAncientHunterTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_sonya_ancientspear.dds" />
  </CButton>

</Catalog>
