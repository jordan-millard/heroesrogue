<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Falstad, Wildhammer's Wrath: Hammerang charges and mana cost are set in AffixData.xml.
       Both quests are counted in HeroTriggers/Falstad.galaxy; their damage is applied here. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="FalstadWildhammerMarker" parent="CarryBehaviorParent" />

  <!-- Shockwave quest: each token is 1 flat BOOMerang explosion damage -->
  <CBehaviorTokenCounter id="FalstadShockwaveTokenCounter" parent="StormQuestToken">
    <Face value="FalstadShockwaveTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="FalstadShockwaveAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="FalstadShockwaveTokenCounter" />
    <Scale value="1" />
  </CAccumulatorToken>

  <!-- Gathering Thunder quest: +5% hammer damage per kill, up to +150% (Unbound Storm raises MaxAccumulation) -->
  <CBehaviorTokenCounter id="FalstadGatheringThunderTokenCounter" parent="StormQuestToken">
    <Face value="FalstadGatheringThunderTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="FalstadGatheringThunderAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="1.5" />
    <ApplicationRule value="Add" />
    <TokenId value="FalstadGatheringThunderTokenCounter" />
    <Scale value="0.05" />
  </CAccumulatorToken>

  <CEffectDamage id="HammerangDamage">
    <MultiplicativeModifierArray index="FalstadGatheringThunder" Accumulator="FalstadGatheringThunderAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="HammerangReturnDamage">
    <MultiplicativeModifierArray index="FalstadGatheringThunder" Accumulator="FalstadGatheringThunderAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="FalstadHammerangBOOMerangDamage">
    <MultiplicativeModifierArray index="FalstadGatheringThunder" Accumulator="FalstadGatheringThunderAccumulator" />
    <FlatModifierArray index="FalstadShockwave" Accumulator="FalstadShockwaveAccumulator" />
  </CEffectDamage>

  <!-- Detonating BOOMerang locks Hammerang for 1 second so a double press doesn't throw the next charge -->
  <CEffectModifyUnit id="FalstadWildhammerThrowLockout">
    <Chance value="0" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="FalstadHammerang,Execute" CooldownOperation="Set" CooldownTimeUse="1" />
  </CEffectModifyUnit>
  <CEffectSet id="FalstadHammerangBOOMerangActiveSet">
    <EffectArray value="FalstadWildhammerThrowLockout" />
  </CEffectSet>

  <!-- Wildhammer's Bulwark: level 1 talent shown only with the starter (TalentsShow), replacing the disabled Gathering
       Storm. -20 Hammerang Mana, and every Hammerang hit on a Hero adds a 2% max Health shield stack (up to 10) that
       doesn't expire, the same way Static Shield stacks. -->
  <CHero id="Falstad">
    <TalentTreeArray Talent="FalstadWildhammersBulwark" Tier="1" Column="4" />
  </CHero>
  <CTalent id="FalstadWildhammersBulwark">
    <Face value="FalstadWildhammersBulwarkTalent" />
    <Abil value="FalstadHammerang" />
    <AbilityModificationArray>
      <Modifications>
        <Type value="FlatModification" />
        <Entry value="FalstadHammerang" />
        <Field value="Cost[0].Vital[Energy]" />
        <Value value="-20.000000" />
      </Modifications>
      <Modifications>
        <Type value="FlatModification" />
        <Catalog value="Effect" />
        <Entry value="FalstadWildhammersBulwarkApplyShield" />
        <Field value="Chance" />
        <Value value="1.000000" />
      </Modifications>
    </AbilityModificationArray>
  </CTalent>
  <CButton id="FalstadWildhammersBulwarkTalent" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_falstad_hammerang_a.dds" />
  </CButton>
  <CBehaviorBuff id="FalstadWildhammersBulwarkShield" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_falstad_hammerang_a.dds" />
    <MaxStackCount value="10" />
    <DamageResponse>
      <ModifyLimitVitalMaxFractionArray index="Life" value="0.02" />
    </DamageResponse>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="FalstadWildhammersBulwarkApplyShield">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <Behavior value="FalstadWildhammersBulwarkShield" />
  </CEffectApplyBehavior>
  <CEffectSet id="HammerangDamageSet">
    <EffectArray value="FalstadWildhammersBulwarkApplyShield" />
  </CEffectSet>
  <CEffectSet id="HammerangReturnDamageSet">
    <EffectArray value="FalstadWildhammersBulwarkApplyShield" />
  </CEffectSet>
  <CEffectSet id="FalstadHammerangBOOMerangImpactSet">
    <EffectArray value="FalstadWildhammersBulwarkApplyShield" />
  </CEffectSet>

  <!-- Stormbreaker (Epic): BOOMerang explosions also deal 10% of the enemy Hero's maximum Health -->
  <CEffectDamage id="FalstadStormbreakerDamage" parent="StormSpell">
    <ValidatorArray value="TargetIsHero" />
    <Chance value="0" />
    <VitalFractionMax index="Life" value="0.1" />
  </CEffectDamage>
  <CEffectSet id="FalstadHammerangBOOMerangImpactSet">
    <EffectArray value="FalstadStormbreakerDamage" />
  </CEffectSet>

  <!-- BOOMerang radius indicator: a range circle on the hammer while BOOMerang can still be detonated. The marker is
       re-applied by the missiles' scan sets only while Falstad has the BOOMerang controller, expires shortly after
       that, and is removed as soon as BOOMerang detonates. Only enabled for the starter; Big Hammer sets the Scale. -->
  <CBehaviorBuff id="FalstadWildhammerIndicator">
    <Duration value="0.25" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="FalstadWildhammerApplyIndicator">
    <Chance value="0" />
    <ValidatorArray value="HasFalstadHammerangBOOMerangController" />
    <Behavior value="FalstadWildhammerIndicator" />
  </CEffectApplyBehavior>
  <CEffectRemoveBehavior id="FalstadWildhammerRemoveIndicator">
    <BehaviorLink value="FalstadWildhammerIndicator" />
  </CEffectRemoveBehavior>
  <CEffectSet id="FalstadHammerangBOOMerangActiveSet">
    <EffectArray value="FalstadWildhammerRemoveIndicator" />
  </CEffectSet>
  <CEffectSet id="HammerangScanSet">
    <EffectArray value="FalstadWildhammerApplyIndicator" />
  </CEffectSet>
  <CEffectSet id="HammerangReturnScanSet">
    <EffectArray value="FalstadWildhammerApplyIndicator" />
  </CEffectSet>
  <CActorSplat id="FalstadWildhammerExplosionSplat" parent="StormRangeSplat">
    <Scale value="2.500000" />
    <On Terms="Behavior.FalstadWildhammerIndicator.On" Send="Create" />
    <On Terms="Behavior.FalstadWildhammerIndicator.Off" Send="AnimBracketStop BSD" />
  </CActorSplat>

  <CButton id="FalstadShockwaveTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_falstad_boomerang.dds" />
  </CButton>
  <CButton id="FalstadGatheringThunderTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_falstad_hammerang.dds" />
  </CButton>
</Catalog>
