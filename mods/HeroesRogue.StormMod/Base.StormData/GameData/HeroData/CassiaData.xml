  <!-- Basic Attacks bounce to the 2 nearest other enemies within 3.5 for 50% damage (Charged Strikes' bounce visuals) -->
  <CEffectSet id="AmazonWeaponPrimaryPostImpactSet">
    <EffectArray value="AmazonGoldenBounceSearch" />
  </CEffectSet>
  <CEffectEnumArea id="AmazonGoldenBounceSearch">
    <ValidatorArray value="AmazonGoldenCasterIsSkirmisher" />
    <ExcludeArray Value="Target" />
    <SearchFilters value="Visible;Self,Player,Ally,Neutral,Structure,Missile,Item,Stasis,Dead,Hidden,Invulnerable,Benign" />
    <TargetSorts>
      <SortArray value="TSDistance" />
    </TargetSorts>
    <AreaArray Effect="AmazonGoldenBounceImpactSet" MaxCount="2">
      <Radius value="3.5" />
    </AreaArray>
    <SearchFlags index="ExtendByUnitRadius" value="1" />
  </CEffectEnumArea>
  <CEffectSet id="AmazonGoldenBounceImpactSet">
    <EffectArray value="AmazonGoldenBounceDamage" />
  </CEffectSet>
  <CActorSite id="AmazonHeroWeaponChargedStrikesLaunchSite">
    <On Terms="Effect.AmazonGoldenBounceSearch.Start; At Target" Send="Create" />
  </CActorSite>
  <CActorSite id="AmazonHeroWeaponChargedStrikesImpactSite">
    <On Terms="Effect.AmazonGoldenBounceImpactSet.Start; At Target" Send="Create" />
  </CActorSite>
