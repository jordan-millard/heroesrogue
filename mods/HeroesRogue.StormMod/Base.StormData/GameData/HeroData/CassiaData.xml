    <MultiplicativeModifierArray index="CassiaJavelinLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AmazonGoldenEcho" Validator="AmazonGoldenJavelinEchoing" Modifier="-0.5" />
  </CEffectDamage>
  <CEffectDamage id="AmazonLightningFuryLightningDamage">
    <MultiplicativeModifierArray index="CassiaJavelinPower" Modifier="0" />
    <MultiplicativeModifierArray index="CassiaJavelinCommon" Modifier="0" />
