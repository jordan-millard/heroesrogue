  <!-- ============================================================ -->
  <!-- Golden Cassia (Amazon). Starters: Valkyrie's Javelin (Lightning Fury), Warden of Arreat (Fend) and Skirmisher (Basic Attacks: range, bounces, empowered Fend; Valkyrie at level 1). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script). Hits, quests and script boons are in HeroTriggers/Cassia.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="AmazonGoldenJavelinMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenWardenMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenSkirmisherMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenStormSpearMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenJavelinMasteryMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenHoldTheLineMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenStaticFieldMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenKitingShotMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AmazonGoldenUntouchableMarker" parent="CarryBehaviorParent" />
  <!-- Storm Spear (Epic): a split bolt that hits an enemy Hero chains to the nearest other enemy Hero within 4. The
       script copies the bolt's Amount (level scaling) into this effect. -->
  <CEffectDamage id="AmazonGoldenStormSpearDamage" parent="AmazonSpellDamageParent">
    <Amount value="158" />
    <SourceButtonFace value="AmazonLightningFury" />
  </CEffectDamage>
  <!-- Kiting Shot (Epic): every 4th Basic Attack on an enemy Hero adds a bolt for 50% of Lightning Fury's damage. The
       script copies Lightning Fury's Amount (level scaling) into this effect. -->
  <CEffectDamage id="AmazonGoldenKitingShotDamage" parent="AmazonSpellDamageParent">
    <MultiplicativeModifierArray index="KitingShot" Modifier="-0.5" />
    <Amount value="158" />
    <SourceButtonFace value="AmazonLightningFury" />
  </CEffectDamage>
  <!-- Skirmisher bounce: 50% of a Basic Attack. The script copies the Basic Attack's Amount (level scaling). -->
  <CEffectDamage id="AmazonGoldenBounceDamage" parent="StormWeapon">
    <MultiplicativeModifierArray index="Bounce" Modifier="-0.5" />
    <Amount value="125" />
    <SourceButtonFace value="Attack" />
  </CEffectDamage>
  <!-- Takedown quest 100: Basic Attacks on enemy Heroes also deal 1% of their maximum Health (script) -->
  <CEffectDamage id="AmazonGoldenSkirmishMaxHealthDamage" parent="StormSpellPercentDamage">
    <Visibility value="Hidden" />
    <VitalFractionMax index="Life" value="0.01" />
    <ValidatorArray value="TargetIsHero" />
    <SourceButtonFace value="Attack" />
  </CEffectDamage>

  <!-- ===== Valkyrie's Javelin ===== -->
  <!-- Lightning Fury costs half Mana (10), deals 20% more damage and is 20% wider (0.6 to 0.72, javelin and bolts); Thunderstroke and Power Strike. Thunderbolt quest (50% kept): 1% Lightning Fury damage per enemy Hero hit, once per Hero per throw. Javelin Mastery quest: takedowns within 3 seconds of a hit; stacks 1-40 1% of the 5 second recharge each, 41-80 1% width each, 81-100 a 1% Slow each (1 second), 100 an echo throw for 50%, then 2.5% all damage each. -->
  <CBehaviorTokenCounter id="AmazonGoldenThunderboltTokenCounter" parent="StormQuestToken">
    <Face value="AmazonGoldenThunderboltTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="AmazonGoldenJavelinTokenCounter" parent="StormQuestToken">
    <Face value="AmazonGoldenJavelinTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="AmazonGoldenThunderboltTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="AmazonGoldenThunderboltTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="AmazonLightningFuryDamage">
    <MultiplicativeModifierArray index="CassiaJavelinPower" Modifier="0" />
    <MultiplicativeModifierArray index="CassiaJavelinCommon" Modifier="0" />
