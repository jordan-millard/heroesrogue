  <!-- ===== Boons ===== -->
  <!-- ===== Valkyrie's Javelin ===== -->
  <!-- Javelin echo (takedown quest 100): the javelin is thrown again 0.5 seconds later toward the same point. While the
       echo flies (1 second, or until the next real throw) this marker on Cassia halves Lightning Fury damage. -->
  <CBehaviorBuff id="AmazonGoldenJavelinEchoMarker">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="1" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenJavelinEchoing">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenJavelinEchoMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- Takedown quest 81-100: Lightning Fury hits on Heroes Slow them by 1% per stack for 1 second (the script applies it
       past 80 stacks and sets the amount per player) -->
  <CBehaviorBuff id="AmazonGoldenJavelinSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_cassia_lightningfury.dds" />
    <Duration value="1" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AmazonGoldenJavelinSlowApply">
    <Behavior value="AmazonGoldenJavelinSlow" />
  </CEffectApplyBehavior>

  <!-- ===== Warden of Arreat ===== -->
  <!-- A full Fend (every strike) heals Cassia for 5% of her maximum Health -->
  <CEffectCreatePersistent id="AmazonFendChannelCreatePersistent">
    <InitialEffect value="AmazonGoldenFendInitialSet" />
    <ExpireEffect value="AmazonGoldenFendFinishHeal" />
  </CEffectCreatePersistent>
  <!-- Fend's first strike, plus Steadfast's setup -->
  <CEffectSet id="AmazonGoldenFendInitialSet">
    <EffectArray value="AmazonGoldenSteadfastBrokenRemove" />
    <EffectArray value="AmazonGoldenSteadfastEarlyApply" />
    <EffectArray value="AmazonFendChannelSearchArea" />
    <EffectArray value="AmazonGoldenSteadfastPersistent" />
  </CEffectSet>

  <!-- ===== Steadfast (Legendary, any starter) ===== -->
  <!-- Fend lasts 1 second longer (boon: 8 more strikes, the channel behavior 1 second longer). Once Fend has been
       channeled for 0.5 seconds it keeps striking to the end: a second persistent, a child of Fend's so the strikes
       use Fend's own area and direction, strikes only while Cassia is no longer channeling. Stopping before 0.5
       seconds (Early still on Cassia when the channel ends) marks the Fend Broken and the extra strikes are skipped. -->
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterHasSteadfast">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenSteadfastMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CBehaviorBuff id="AmazonGoldenSteadfastEarly">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CBehaviorBuff id="AmazonGoldenSteadfastBroken">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="3" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AmazonGoldenSteadfastEarlyApply">
    <ValidatorArray value="AmazonGoldenCasterHasSteadfast" />
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenSteadfastEarly" />
  </CEffectApplyBehavior>
  <CEffectRemoveBehavior id="AmazonGoldenSteadfastBrokenRemove">
    <ValidatorArray value="AmazonGoldenCasterHasSteadfast" />
    <WhichUnit Value="Caster" />
    <BehaviorLink value="AmazonGoldenSteadfastBroken" />
  </CEffectRemoveBehavior>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterSteadfastEarly">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenSteadfastEarly" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterNotSteadfastEarly">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenSteadfastEarly" />
    <Compare value="EQ" />
    <Value value="0" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterNotSteadfastBroken">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenSteadfastBroken" />
    <Compare value="EQ" />
    <Value value="0" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- the channel ends: before 0.5 seconds, this Fend is Broken -->
  <CBehaviorBuff id="AmazonFendChanneling">
    <FinalEffect value="AmazonGoldenFendChannelEndSet" />
  </CBehaviorBuff>
  <CEffectSet id="AmazonGoldenFendChannelEndSet">
    <EffectArray value="AmazonAvoidanceApplyStationaryTimer" />
    <EffectArray value="AmazonGoldenSteadfastBrokenApply" />
  </CEffectSet>
  <CEffectApplyBehavior id="AmazonGoldenSteadfastBrokenApply">
    <ValidatorArray value="AmazonGoldenCasterSteadfastEarly" />
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenSteadfastBroken" />
  </CEffectApplyBehavior>
  <!-- 19 strikes: the 20 strikes of a 2.5 second Fend but the last, which the channel itself lands when it ends
       naturally -->
  <CEffectCreatePersistent id="AmazonGoldenSteadfastPersistent">
    <ValidatorArray value="AmazonGoldenCasterHasSteadfast" />
    <PeriodCount value="19" />
    <PeriodicEffectArray value="AmazonGoldenSteadfastStrike" />
    <PeriodicPeriodArray value="0.125" />
    <TimeScaleSource Value="Caster" />
  </CEffectCreatePersistent>
  <CEffectSet id="AmazonGoldenSteadfastStrike">
    <ValidatorArray value="AmazonFendCasterIsNotChanneling" />
    <ValidatorArray value="AmazonGoldenCasterNotSteadfastEarly" />
    <ValidatorArray value="AmazonGoldenCasterNotSteadfastBroken" />
    <EffectArray value="AmazonFendChannelSearchArea" />
  </CEffectSet>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterIsWarden">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenWardenMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectModifyUnit id="AmazonGoldenFendFinishHeal">
    <ValidatorArray value="AmazonGoldenCasterIsWarden" />
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.05" />
    </VitalArray>
  </CEffectModifyUnit>
  <!-- Takedown quest 100: Fend ends with one more strike on everything in front of Cassia (the script turns it on) -->
  <CEffectSet id="AmazonGoldenFendBlastSet">
    <Chance value="0" />
    <EffectArray value="AmazonFendChannelSearchArea" />
  </CEffectSet>
  <CEffectSet id="AmazonFendChannelFinalSet">
    <EffectArray value="AmazonGoldenFendBlastSet" />
  </CEffectSet>
  <!-- Hold the Line (Epic): an enemy Hero hit 4 times by one Fend is Slowed by 30% for 2 seconds -->
  <CBehaviorBuff id="AmazonGoldenHoldTheLineSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_cassia_fend.dds" />
    <Duration value="2" />
    <Modification>
      <UnifiedMoveSpeedFactor value="-0.3" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AmazonGoldenHoldTheLineApply">
    <Behavior value="AmazonGoldenHoldTheLineSlow" />
  </CEffectApplyBehavior>
  <!-- Static Field (Legendary): 25% less damage taken while Fending, and each Fend hit on an enemy Hero adds a 1% maximum
       Health shield for 4 seconds (up to 10 per Fend, script) -->
  <CBehaviorBuff id="AmazonGoldenStaticFieldGuard" parent="CarryBehaviorParent">
    <DisableValidatorArray value="AmazonFendCasterIsChanneling" />
    <DamageResponse>
      <Chance value="1" />
      <ModifyFraction value="0.75" />
    </DamageResponse>
  </CBehaviorBuff>
  <CBehaviorBuff id="AmazonGoldenStaticFieldShield" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_cassia_fend.dds" />
    <MaxStackCount value="10" />
    <Duration value="4" />
    <DamageResponse>
      <ModifyLimitVitalMaxFractionArray index="Life" value="0.01" />
    </DamageResponse>
  </CBehaviorBuff>

  <!-- ===== Skirmisher ===== -->
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterIsSkirmisher">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenSkirmisherMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- Charged Strikes bounces to every nearby enemy, not just Heroes: a second search for the other enemies (not
       buildings), with Charged Strikes' bounce visuals -->
  <CEffectSet id="AmazonChargedStrikesMeleeSet">
    <EffectArray value="AmazonGoldenChargedStrikesAllSearch" />
  </CEffectSet>
  <CEffectSet id="AmazonChargedStrikesRangedSet">
    <EffectArray value="AmazonGoldenChargedStrikesAllSearch" />
  </CEffectSet>
  <CEffectEnumArea id="AmazonGoldenChargedStrikesAllSearch">
    <ValidatorArray value="AmazonGoldenCasterIsSkirmisher" />
    <ExcludeArray Value="Target" />
    <SearchFilters value="Visible;Self,Player,Ally,Neutral,Heroic,Structure,Missile,Item,Stasis,Dead,Hidden,Invulnerable,Benign" />
    <AreaArray Effect="AmazonHeroWeaponChargedStrikesImpactSet">
      <Radius value="3.5" />
    </AreaArray>
    <SearchFlags index="ExtendByUnitRadius" value="1" />
    <ValidatorArray value="TargetNotEvading" />
  </CEffectEnumArea>
  <CActorSite id="AmazonHeroWeaponChargedStrikesLaunchSite">
    <On Terms="Effect.AmazonGoldenChargedStrikesAllSearch.Start; At Target" Send="Create" />
  </CActorSite>
  <CActorModel id="AmazonHeroWeaponChargedStrikesImpact">
    <On Terms="Effect.AmazonGoldenChargedStrikesAllSearch.Start; At Target" Send="Create" />
  </CActorModel>
  <!-- Takedown quest 1-40: 0.5% Attack Speed per stack (the script sets the stack count) -->
  <CBehaviorBuff id="AmazonGoldenSkirmisherAttackSpeed" parent="CarryBehaviorParent">
    <InfoFlags index="Hidden" value="1" />
    <MaxStackCount value="40" />
    <Modification>
      <AdditiveAttackSpeedFactor value="0.005" />
    </Modification>
  </CBehaviorBuff>
  <!-- Skirmish quest: every 10 Basic Attacks on enemy Heroes empower the next Fend: each enemy it hits is Rooted for 1.5
       seconds (once per enemy). The counter shows progress (script; its Max is high so it never shows the quest complete
       banner); casting an empowered Fend uses it up (data). -->
  <CBehaviorTokenCounter id="AmazonGoldenEmpoweredFendTokenCounter" parent="StormQuestToken">
    <Face value="AmazonGoldenEmpoweredFendTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CButton id="AmazonGoldenEmpoweredFendTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_cassia_fend.dds" />
  </CButton>
  <CBehaviorBuff id="AmazonGoldenEmpoweredFendReady">
    <InfoIcon value="Assets\Textures\storm_ui_icon_cassia_fend.dds" />
    <BehaviorFlags index="Permanent" value="1" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterEmpoweredFendReady">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenEmpoweredFendReady" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectSet id="AmazonFendChannelInitialSet">
    <EffectArray value="AmazonGoldenEmpoweredFendSet" />
  </CEffectSet>
  <CEffectSet id="AmazonGoldenEmpoweredFendSet">
    <ValidatorArray value="AmazonGoldenCasterEmpoweredFendReady" />
    <EffectArray value="AmazonGoldenEmpoweredFendChannelApply" />
    <EffectArray value="AmazonGoldenEmpoweredFendConsume" />
    <EffectArray value="AmazonGoldenEmpoweredFendRootSearch" />
  </CEffectSet>
  <!-- the empowered Fend Roots every enemy within 4 of Cassia right away (Fend's first strike lands before the set
       above runs) -->
  <CEffectEnumArea id="AmazonGoldenEmpoweredFendRootSearch">
    <ImpactLocation Value="CasterUnit" />
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="AmazonGoldenEmpoweredFendRootSet">
      <Radius value="4" />
    </AreaArray>
    <SearchFlags index="ExtendByUnitRadius" value="1" />
  </CEffectEnumArea>
  <CEffectRemoveBehavior id="AmazonGoldenEmpoweredFendConsume">
    <WhichUnit Value="Caster" />
    <BehaviorLink value="AmazonGoldenEmpoweredFendReady" />
  </CEffectRemoveBehavior>
  <!-- marks Cassia while the empowered Fend channels (longer than the channel) -->
  <CBehaviorBuff id="AmazonGoldenEmpoweredFendChannel">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="2.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AmazonGoldenEmpoweredFendChannelApply">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenEmpoweredFendChannel" />
  </CEffectApplyBehavior>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenCasterEmpoweredFendChanneling">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenEmpoweredFendChannel" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- each Fend hit: Root the enemy unless this Fend already Rooted it -->
  <CEffectSet id="AmazonFendChannelImpactSet">
    <EffectArray value="AmazonGoldenEmpoweredFendRootSet" />
  </CEffectSet>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenTargetNotRootedByFend">
    <WhichUnit Value="Target" />
    <Behavior value="AmazonGoldenEmpoweredFendRooted" />
    <Compare value="EQ" />
    <Value value="0" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectSet id="AmazonGoldenEmpoweredFendRootSet">
    <ValidatorArray value="AmazonGoldenCasterEmpoweredFendChanneling" />
    <ValidatorArray value="AmazonGoldenTargetNotRootedByFend" />
    <EffectArray value="AmazonGoldenEmpoweredFendRootApply" />
    <EffectArray value="AmazonGoldenEmpoweredFendRootedApply" />
  </CEffectSet>
  <!-- the game only stops a Rooted unit from moving if its Root is in this list -->
  <CValidatorUnitHasBehavior id="AmazonGoldenTargetHasEmpoweredFendRootIncludeDisabled">
    <Behavior value="AmazonGoldenEmpoweredFendRoot" />
    <IncludeDisabled value="1" />
  </CValidatorUnitHasBehavior>
  <CValidatorCombine id="StormTargetHasRootCombineIncludeDisabled">
    <CombineArray value="AmazonGoldenTargetHasEmpoweredFendRootIncludeDisabled" />
  </CValidatorCombine>
  <CBehaviorBuff id="AmazonGoldenEmpoweredFendRoot" parent="StormRoot">
    <InfoIcon value="Assets\Textures\storm_ui_icon_cassia_fend.dds" />
    <Duration value="1.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AmazonGoldenEmpoweredFendRootApply">
    <Behavior value="AmazonGoldenEmpoweredFendRoot" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="AmazonGoldenEmpoweredFendRooted">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="2.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AmazonGoldenEmpoweredFendRootedApply">
    <Behavior value="AmazonGoldenEmpoweredFendRooted" />
  </CEffectApplyBehavior>
  <!-- Gloves of Alacrity resets the Basic Attack range by setting it (4.5, or 5.5 with the talent), which would drop
       Skirmisher's 2.1; add it back after each reset -->
  <CBehaviorBuff id="AmazonGlovesOfAlacrityBaseAttackRangeBehavior">
    <FinalEffect value="AmazonGoldenGlovesBaseResetSet" />
  </CBehaviorBuff>
  <CBehaviorBuff id="AmazonGlovesOfAlacrityAvoidanceMaxedAttackRangeBehavior">
    <DisableEffect value="AmazonGoldenGlovesBonusResetSet" />
  </CBehaviorBuff>
  <CEffectSet id="AmazonGoldenGlovesBaseResetSet">
    <EffectArray value="AmazonAvoidanceGlovesOfAlacrityBaseResetPlayerRange" />
    <EffectArray value="AmazonGoldenSkirmisherRestoreRange" />
  </CEffectSet>
  <CEffectSet id="AmazonGoldenGlovesBonusResetSet">
    <EffectArray value="AmazonAvoidanceGlovesOfAlacrityBonusResetPlayerRange" />
    <EffectArray value="AmazonGoldenSkirmisherRestoreRange" />
  </CEffectSet>
  <CEffectModifyPlayer id="AmazonGoldenSkirmisherRestoreRange">
    <ValidatorArray value="AmazonGoldenCasterIsSkirmisher" />
    <EffectArray Reference="Weapon,AmazonHeroWeaponRanged,MinScanRange" Value="2.1" />
    <EffectArray Reference="Weapon,AmazonHeroWeaponRanged,Range" Value="2.1" />
  </CEffectModifyPlayer>
  <!-- Light Feet (Common): Movement Speed while moving -->
  <CBehaviorBuff id="AmazonGoldenSkirmisherGuard" parent="CarryBehaviorParent">
    <DisableValidatorArray value="AmazonAvoidanceMovementCheckIsActive" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Untouchable (Legendary): after 3 seconds of moving without taking damage, the next Basic Attack deals triple damage;
       on an enemy Hero it also Stuns for 0.5 seconds (script) -->
  <CBehaviorBuff id="AmazonGoldenUntouchableReady">
    <InfoIcon value="Assets\Textures\storm_ui_icon_cassia_avoidance.dds" />
    <BehaviorFlags index="Permanent" value="1" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="AmazonGoldenUntouchableIsReady">
    <WhichUnit Value="Caster" />
    <Behavior value="AmazonGoldenUntouchableReady" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CBehaviorBuff id="AmazonGoldenUntouchableStun" parent="StormStun">
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AmazonGoldenUntouchableStunApply">
    <Behavior value="AmazonGoldenUntouchableStun" />
  </CEffectApplyBehavior>
</Catalog>
