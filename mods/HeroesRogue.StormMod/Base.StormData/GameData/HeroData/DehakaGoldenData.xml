  <!-- ============================================================ -->
  <!-- Golden Dehaka. Starters: Tongue of the Pack (Drag), Swarm Host (Dark Swarm), Primal Evolution (mutations from Essence). Essence is kept between games at 50% (a token the script keeps equal to Essence). Each damage effect has its own multipliers: the Uncommon boon (a LibAffx multiplier), hit quest (accumulator) and takedown quest past its cap. Hits, quests and script boons are in HeroTriggers/DehakaGolden.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="DehakaGoldenDragMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenSwarmMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenPrimalMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenPrimalGraspMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenBrushMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenSwarmFeedingMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenEndlessSwarmMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenRapidAdaptationMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="DehakaGoldenApexFormMarker" parent="CarryBehaviorParent" />
  <!-- Tongue of the Pack's Hunger: the script adds this to each Basic Attack, 0.1 damage per Hunger stack per Essence held -->
  <CEffectDamage id="DehakaGoldenHungerDamage" parent="StormWeapon">
    <Amount value="0" />
  </CEffectDamage>

  <!-- ===== Tongue of the Pack ===== -->
  <!-- Drag lasts 0.5 seconds longer (stun, channel and pull); gain Feeding Frenzy and Paralyzing Enzymes. Hunger quest (10% of each map gains kept for good): each enemy Hero hit makes Basic Attacks deal 0.1 more damage per Essence held (script). Pack quest: takedowns within 6 seconds of a Drag hit; stacks 1-40 make Drag recharge 1% faster each (script), 41-80 make each Drag hit on an enemy Hero give 1 Essence per stack (script), 81-100 make Drag last 1% longer each, at 100 each Drag hit on an enemy Hero makes Dehaka Invulnerable for 0.75 seconds (script), then 2% damage each. -->
  <CBehaviorTokenCounter id="DehakaGoldenHungerTokenCounter" parent="StormQuestToken">
    <Face value="DehakaGoldenHungerTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="DehakaGoldenPackTokenCounter" parent="StormQuestToken">
    <Face value="DehakaGoldenPackTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="DehakaGoldenHungerTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="DehakaGoldenHungerTokenCounter" />
    <Scale value="0" />
  </CAccumulatorToken>
  <CEffectDamage id="DehakaDragDamage">
    <MultiplicativeModifierArray index="DehakaDragPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaDragCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaDragLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="DehakaGoldenHungerTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_dehaka_drag.dds" />
  </CButton>
  <CButton id="DehakaGoldenPackTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_dehaka_drag.dds" />
  </CButton>

  <!-- ===== Swarm Host ===== -->
  <!-- Dark Swarm has 2 charges (8 second recharge) and costs 25 Mana (half); gain Enduring Swarm and Symbiosis (Symbiosis also takes time off a charge). Swarm quest (10% of each map's gains kept for good): 0.5% Dark Swarm damage per enemy Hero hit, once per Hero per swarm. Brood quest: takedowns within 6 seconds of a swarm hit; stacks 1-40 make the swarm tick 2% faster each with the same ticks (script), 41-80 make it 1% larger each, 81-100 make enemy Heroes in it deal 1% less damage each (script applies the debuff), at 100 they're Slowed 25% (script), then 2% damage each. -->
  <CBehaviorTokenCounter id="DehakaGoldenSwarmTokenCounter" parent="StormQuestToken">
    <Face value="DehakaGoldenSwarmTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="DehakaGoldenBroodTokenCounter" parent="StormQuestToken">
    <Face value="DehakaGoldenBroodTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="DehakaGoldenSwarmTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="DehakaGoldenSwarmTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="DehakaDarkSwarmDamage">
    <MultiplicativeModifierArray index="DehakaSwarmPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaSwarmCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaSwarmHit" Accumulator="DehakaGoldenSwarmTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="DehakaSwarmLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="DehakaGoldenSwarmTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_dehaka_trample.dds" />
  </CButton>
  <CButton id="DehakaGoldenBroodTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_dehaka_trample.dds" />
  </CButton>

  <!-- ===== Primal Evolution ===== -->
  <!-- Every 40 Essence collected (32 with Rapid Adaptation, 10 more with Apex Form) grants a random mutation (script; each win keeps 10% of that map's mutations, rounded up): 2% Health, 2% Attack Speed, 1% Life Steal, 3% Ability damage, 2% Movement Speed (also added to the Movement Speed boons, so it adds to them), 1% shorter Stuns, Silences and Slows (script, up to 75%), 1% Healing Received, 1 max Essence (script), or 5% Attack Damage. Essence Collection heals 20% more and can be used at full Health (Or validators); its drain follows the raised max Essence (script). Gain Essence Claws and Primal Rage at the start; the Heroic is picked as normal. No hit quest. Evolution quest: takedowns within 6 seconds of any hit; stacks 1-40 add 1 max Essence each, 41-80 make Brushstalker recharge 3% faster each, 81-100 make Adaptation heal 1% more of the damage taken each, at 100 fatal damage Burrows Dehaka instead (once every 60 seconds), then 2% damage each (all script but the last). -->
  <CBehaviorTokenCounter id="DehakaGoldenEvolutionTokenCounter" parent="StormQuestToken">
    <Face value="DehakaGoldenEvolutionTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectDamage id="DehakaHeroWeaponDamage">
    <MultiplicativeModifierArray index="DehakaPrimalPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="DehakaDragDamage">
    <MultiplicativeModifierArray index="DehakaPrimalPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="DehakaDarkSwarmDamage">
    <MultiplicativeModifierArray index="DehakaPrimalPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="DehakaIsolationDamage">
    <MultiplicativeModifierArray index="DehakaPrimalPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="DehakaBurrowLurkerStrainTalentDamage">
    <MultiplicativeModifierArray index="DehakaPrimalPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="DehakaDragParalyzingEnzymesTalentDamage">
    <MultiplicativeModifierArray index="DehakaPrimalPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="DehakaGoldenHungerDamage">
    <MultiplicativeModifierArray index="DehakaPrimalPower" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="DehakaPrimalLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="DehakaGoldenEvolutionTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_dehaka_adaptation.dds" />
  </CButton>
  <!-- Tongue of the Pack: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="DehakaDragPastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Swarm Host: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="DehakaSwarmPastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Primal Evolution: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="DehakaPrimalPastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>

  <!-- ===== Boons ===== -->
  <!-- Essence kept between games (the script keeps it equal to Dehaka's Essence) -->
  <CBehaviorTokenCounter id="DehakaGoldenEssenceToken" parent="StormGenericToken">
    <Max value="1000" />
  </CBehaviorTokenCounter>
  <!-- Pack 100: each Drag hit on an enemy Hero makes Dehaka Invulnerable for 0.75 seconds (script) -->
  <CBehaviorBuff id="DehakaGoldenDragInvulnerable" parent="StormInvulnerable">
    <Duration value="0.75" />
  </CBehaviorBuff>
  <!-- Digestion (Epic): dragged enemy Heroes deal 30% less damage for 3 seconds after the stun ends -->
  <CBehaviorBuff id="DehakaGoldenDigestion">
    <Alignment value="Negative" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_dehaka_drag.dds" />
    <BehaviorCategories index="DebuffAbilityPower" value="1" />
    <BehaviorCategories index="DebuffAutoattackDPS" value="1" />
    <Duration value="3" />
    <Modification>
      <DamageDealtFraction index="Splash" value="-0.3" />
      <DamageDealtFraction index="Basic" value="-0.3" />
      <DamageDealtFraction index="Ability" value="-0.3" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="DehakaGoldenDigestionApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="DehakaGoldenDigestion" />
  </CEffectApplyBehavior>
  <!-- the Drag stun's final effect, on the dragged unit -->
  <CEffectSet id="DehakaDragTalentFinalSet">
    <EffectArray value="DehakaGoldenDigestionApply" />
  </CEffectSet>
  <!-- Stalker's Thicket (Rare, any starter): allied Heroes in Dehaka's brush patches are Stealthed, refreshed by the script
       every 0.125 seconds. Attacks and abilities that decloak, or taking damage, reveal them, as with other Stealth. -->
  <CBehaviorBuff id="DehakaGoldenBrushCloak" parent="StormCloak">
    <BuffFlags index="RefreshStack" value="1" />
    <Duration value="0.25" />
    <DisableValidatorArray value="NoCloakRevealerCombine" />
    <DamageResponse Chance="1" Handled="ApplyGenericDecloakSource" Priority="97">
      <ValidatorArray value="SourceNotUnrevealable" />
    </DamageResponse>
  </CBehaviorBuff>
  <!-- Brushstalker anywhere. The engine only lets an ability with the TargetShrub category target brush, and a mid-game
       change to the category doesn't take, so with the boon a copy without it (same button, slot and shared cooldown)
       replaces Brushstalker; the requirements show exactly one of them. Both use the base effects, whose brush check
       becomes "in brush, or Dehaka has the boon". The script copies Brushstalker's cooldown and cast time (talents) to
       the copy. -->
  <CRequirementCountBehavior id="CountBehaviorDehakaGoldenBrushMarkerAtUnit">
    <Flags index="TechTreeCheat" value="0" />
    <Count Link="DehakaGoldenBrushMarker" State="CompleteOnlyAtUnit" />
  </CRequirementCountBehavior>
  <CRequirementGTE id="GTECountBehaviorDehakaGoldenBrushMarkerAtUnit1">
    <OperandArray index="0" value="CountBehaviorDehakaGoldenBrushMarkerAtUnit" />
    <OperandArray index="1" value="1" />
  </CRequirementGTE>
  <CRequirementEq id="EqCountBehaviorDehakaGoldenBrushMarkerAtUnit0">
    <OperandArray index="0" value="CountBehaviorDehakaGoldenBrushMarkerAtUnit" />
    <OperandArray index="1" value="0" />
  </CRequirementEq>
  <CRequirement id="DehakaGoldenHasBrushMarker">
    <NodeArray index="Use" Link="GTECountBehaviorDehakaGoldenBrushMarkerAtUnit1" />
    <NodeArray index="Show" Link="GTECountBehaviorDehakaGoldenBrushMarkerAtUnit1" />
  </CRequirement>
  <CRequirement id="DehakaGoldenNoBrushMarker">
    <NodeArray index="Use" Link="EqCountBehaviorDehakaGoldenBrushMarkerAtUnit0" />
    <NodeArray index="Show" Link="EqCountBehaviorDehakaGoldenBrushMarkerAtUnit0" />
  </CRequirement>
  <CAbilEffectTarget id="DehakaBrushstalker">
    <CmdButtonArray index="Execute" Requirements="DehakaGoldenNoBrushMarker" />
  </CAbilEffectTarget>
  <CAbilEffectTarget id="DehakaGoldenBrushstalker" parent="DehakaBrushstalker">
    <AbilityCategories index="TargetShrub" value="0" />
    <Cost>
      <Cooldown Link="Abil/DehakaBrushstalker" />
    </Cost>
    <CmdButtonArray index="Execute" DefaultButtonFace="DehakaBrushstalker" Requirements="DehakaGoldenHasBrushMarker" />
  </CAbilEffectTarget>
  <!-- StormHeroMountedCustom has 23 layout buttons (0-22) and Dehaka adds 8 (23-30, Drag last), so the copy goes at 31 -->
  <CUnit id="HeroDehaka">
    <AbilArray Link="DehakaGoldenBrushstalker" />
    <CardLayouts index="0">
      <LayoutButtons index="31" Face="DehakaBrushstalker" Type="AbilCmd" AbilCmd="DehakaGoldenBrushstalker,Execute" Slot="Mount" />
    </CardLayouts>
  </CUnit>
  <CValidatorUnitCompareBehaviorCount id="DehakaGoldenCasterHasBrushMarker">
    <WhichUnit Value="Caster" />
    <Behavior value="DehakaGoldenBrushMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorCombine id="DehakaGoldenBrushstalkerTarget">
    <Type value="Or" />
    <CombineArray value="TargetInShrub" />
    <CombineArray value="DehakaGoldenCasterHasBrushMarker" />
  </CValidatorCombine>
  <!-- Primal Evolution: Essence Collection works at full Health (the button's disable check and the cast's check) -->
  <CValidatorUnitCompareBehaviorCount id="DehakaGoldenSourceHasPrimal">
    <WhichUnit Value="Source" />
    <Behavior value="DehakaGoldenPrimalMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="DehakaGoldenCasterHasPrimal">
    <WhichUnit Value="Caster" />
    <Behavior value="DehakaGoldenPrimalMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorCombine id="DehakaGoldenEssenceSourceLifeCheck">
    <Type value="Or" />
    <CombineArray value="SourceLifeNotFull" />
    <CombineArray value="DehakaGoldenSourceHasPrimal" />
  </CValidatorCombine>
  <CValidatorCombine id="DehakaGoldenEssenceCasterLifeCheck">
    <Type value="Or" />
    <CombineArray value="CasterLifeNotFull" />
    <CombineArray value="DehakaGoldenCasterHasPrimal" />
  </CValidatorCombine>
  <CBehaviorBuff id="DehakaEssenceCollectionEnabler">
    <DisableValidatorArray index="0" value="DehakaGoldenEssenceSourceLifeCheck" />
  </CBehaviorBuff>
  <CEffectSet id="DehakaEssenceCollectionInitialApplySet">
    <ValidatorArray index="0" value="DehakaGoldenEssenceCasterLifeCheck" />
  </CEffectSet>
  <CEffectCreatePersistent id="DehakaBrushstalkerEmergingCreatePersistent">
    <ValidatorArray index="1" value="DehakaGoldenBrushstalkerTarget" />
  </CEffectCreatePersistent>
  <CEffectCreatePersistent id="DehakaBrushstalkerPersistent">
    <ValidatorArray index="1" value="DehakaGoldenBrushstalkerTarget" />
  </CEffectCreatePersistent>
  <!-- the copy is disabled and enabled wherever Brushstalker is -->
  <CBehaviorBuff id="HeroGenericPregameAbilitySuppression">
    <Modification>
      <AbilLinkDisableArray value="DehakaGoldenBrushstalker" />
    </Modification>
  </CBehaviorBuff>
  <CBehaviorBuff id="DehakaBrushstalkerDisablerBehavior">
    <Modification>
      <AbilLinkEnableArray value="DehakaGoldenBrushstalker" />
    </Modification>
  </CBehaviorBuff>
  <CBehaviorBuff id="DehakaBrushstalkerDurationBehavior">
    <Modification>
      <AbilLinkDisableArray value="DehakaGoldenBrushstalker" />
    </Modification>
  </CBehaviorBuff>
  <CBehaviorBuff id="DehakaDragChannelBehavior">
    <Modification>
      <AbilLinkDisableArray value="DehakaGoldenBrushstalker" />
    </Modification>
  </CBehaviorBuff>
  <!-- the copy's cast animation, sound and effect -->
  <CActorUnit id="HeroDehaka">
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStart; !ValidatePlayer DehakaHasBrushstalkerApexPredator" Send="AnimPlay StandWorkStart Stand,Work,Start PlayForever,NonLooping -1.000000 -1.000000 1.000000 AsTimeScale" />
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStart; ValidatePlayer DehakaHasBrushstalkerApexPredator" Send="AnimPlay StandWorkStart Stand,Work,Start PlayForever,NonLooping -1.000000 -1.000000 1.250000 AsTimeScale" />
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStop" Send="TimerSet 0.187500 ClearStandWork" />
  </CActorUnit>
  <CActorSound id="DehakaBrushstalkerSound">
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStart" Send="Create" />
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStop" Send="Destroy" />
  </CActorSound>
  <CActorModel id="DehakaBrushstalkerFXStart">
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStart" Send="Create" />
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStop" Send="AnimBracketStop BSD" />
    <On Terms="Abil.DehakaGoldenBrushstalker.SourceCastStop" Send="HostSiteOpsSet ::Host SOpTipability 1 1" />
  </CActorModel>
  <!-- one bush of a patch (the script places 7 and picks each one's variation) -->
  <CActorModel id="DehakaGoldenBrushBush">
    <Model value="Storm_Doodad_KingsCrest_GardenBush" />
  </CActorModel>
