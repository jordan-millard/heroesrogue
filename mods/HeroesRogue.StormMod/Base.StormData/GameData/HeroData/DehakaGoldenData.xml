    <Alignment value="Positive" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_dehaka_burrow.dds" />
    <DamageResponse>
      <Chance value="1" />
      <Handled value="DehakaGoldenFreeBurrowSet" />
      <Priority value="18" />
      <Fatal value="1" />
      <RecordBehaviorShieldDamage value="1" />
      <ModifyFraction value="0" />
