<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Gazlowe. Starters: Turret Engineer (6 Scrap turrets that spend all Scrap and never decay) and Lazor Specialist (0.2 second Deth Lazor, the level 7 talents). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulators) and takedown quest past its cap (unused: past 100 the script adds a damage buff). Hits, quests and turret buffs are in HeroTriggers/GazloweGolden.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="GazloweEngineerMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GazloweLazorMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GazloweScrapGlobesMarker" parent="CarryBehaviorParent" />

  <!-- ===== Turret Engineer ===== -->
  <!-- Turrets cost 6 Scrap and their drop spends all Scrap; they never lose Health over time and heal 1% per second, each Scrap past 6 adds 5% Attack Speed, range and Health, 12 or more reveal enemies in attack range, each past 22 adds 0.2% maximum Health damage to Heroes (script). Targeting quest (50% kept): 0.1% turret damage per turret hit on an enemy Hero. Upgrades quest: takedowns within 6 seconds of a turret or Deth Lazor hit; stacks 1-40 make Scrap regenerate 1% faster each, 41-80 add 1% turret Attack Speed each (script), at 100 turrets heal 2% per second and their hits on Heroes Shield Gazlowe (script), then 1% damage each (script). -->
  <CBehaviorTokenCounter id="GazloweGoldenTargetingTokenCounter" parent="StormQuestToken">
    <Face value="GazloweGoldenTargetingTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="GazloweGoldenUpgradesTokenCounter" parent="StormQuestToken">
    <Face value="GazloweGoldenUpgradesTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GazloweGoldenTargetingTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GazloweGoldenTargetingTokenCounter" />
    <Scale value="0.001" />
  </CAccumulatorToken>
  <CEffectDamage id="RockItTurretWeaponDamage">
    <MultiplicativeModifierArray index="GazloweEngineerPower" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerHit" Accumulator="GazloweGoldenTargetingTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="GazloweEngineerHitCreator" Accumulator="GazloweGoldenTargetingCreatorAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="RockItTurretWeaponRelicSideDamage">
    <MultiplicativeModifierArray index="GazloweEngineerPower" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerHit" Accumulator="GazloweGoldenTargetingTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="GazloweEngineerHitCreator" Accumulator="GazloweGoldenTargetingCreatorAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="TinkerDethLazorFirinMahLazorzTalentDamage">
    <MultiplicativeModifierArray index="GazloweEngineerPower" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweEngineerHit" Accumulator="GazloweGoldenTargetingTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="GazloweEngineerHitCreator" Accumulator="GazloweGoldenTargetingCreatorAccumulator" />
  </CEffectDamage>
  <CButton id="GazloweGoldenTargetingTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Gazlowe_RockItTurret.dds" />
  </CButton>
  <CButton id="GazloweGoldenUpgradesTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Gazlowe_RockItTurret.dds" />
  </CButton>

  <!-- ===== Lazor Specialist ===== -->
  <!-- Deth Lazor fires 0.2 seconds after the cast instead of 0.65; gain Goblin Fusion, Overload and Master Blaster. Calibration quest (50% kept): 1% Deth Lazor damage per hit on an enemy Hero. Amplification quest: takedowns within 6 seconds of a Deth Lazor hit; stacks 1-40 make Deth Lazor 0.5% longer each, 41-80 a Shield per hit (script), at 100 a turret per hit (script), then 1% damage each (script). -->
  <CBehaviorTokenCounter id="GazloweGoldenCalibrationTokenCounter" parent="StormQuestToken">
    <Face value="GazloweGoldenCalibrationTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="GazloweGoldenAmplificationTokenCounter" parent="StormQuestToken">
    <Face value="GazloweGoldenAmplificationTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GazloweGoldenCalibrationTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GazloweGoldenCalibrationTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="DethLazorCharged1Damage">
    <MultiplicativeModifierArray index="GazloweLazorPower" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweLazorCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GazloweLazorHit" Accumulator="GazloweGoldenCalibrationTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="GazloweLazorLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="GazloweGoldenCalibrationTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Gazlowe_DethLazor.dds" />
  </CButton>
  <CButton id="GazloweGoldenAmplificationTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Gazlowe_DethLazor.dds" />
  </CButton>

  <!-- ===== Boons ===== -->
  <!-- Turret Engineer: the hit quest's damage read from the turret's creator (Gazlowe has the tokens, the turret attacks) -->
  <CAccumulatorToken id="GazloweGoldenTargetingCreatorAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GazloweGoldenTargetingTokenCounter" />
    <Scale value="0.001" />
    <UnitSource Value="Creator" />
  </CAccumulatorToken>
  <!-- Turret Engineer: turrets never lose Health over time and heal 1% of their maximum Health per second, 2% at 100 Upgrades
       stacks (the script adds it and sets the amount) -->
  <CBehaviorBuff id="GazloweGoldenTurretFrame" parent="CarryBehaviorParent">
    <Period value="1" />
    <PeriodicEffect value="GazloweGoldenTurretRepair" />
    <Modification>
      <VitalRegenMultiplier index="Life" value="-1" />
    </Modification>
  </CBehaviorBuff>
  <CEffectModifyUnit id="GazloweGoldenTurretRepair">
    <VitalArray index="Life">
      <ChangeFraction value="0.01" />
    </VitalArray>
  </CEffectModifyUnit>
  <!-- Turret Engineer: one stack per Scrap spent past 6 on the turret's drop, 5% Attack Speed, range and Health each (the script adds it) -->
  <CBehaviorBuff id="GazloweGoldenTurretOverclock" parent="CarryBehaviorParent">
    <MaxStackCount value="100" />
    <Modification>
      <AdditiveAttackSpeedFactor value="0.05" />
      <WeaponRange value="0.3" />
      <WeaponScanBonus value="0.3" />
      <VitalMaxFractionArray index="Life" value="0.05" />
    </Modification>
  </CBehaviorBuff>
  <!-- Turret Engineer: marks a turret dropped with 12 or more Scrap; every second the script reveals around it out to its
       attack range (GazloweGoldenTurretSentryReveal, radius set per turret from its weapon range) -->
  <CBehaviorBuff id="GazloweGoldenTurretSentry" parent="CarryBehaviorParent" />
  <!-- Turret Engineer, Scrap past 22: the script sets the fraction (0.2% per Scrap past 22) before each hit on a Hero -->
  <CEffectDamage id="GazloweGoldenTurretShredDamage" parent="StormSpellPercentDamage">
    <ValidatorArray value="TargetIsHero" />
    <VitalFractionMax index="Life" value="0" />
  </CEffectDamage>
  <CEffectCreatePersistent id="GazloweGoldenTurretSentryReveal">
    <WhichLocation Value="TargetUnit" />
    <ExpireDelay value="1.0625" />
    <RevealRadius value="7.8" />
    <RevealFlags index="Unfog" value="1" />
    <RevealFlags index="Detect" value="1" />
  </CEffectCreatePersistent>
  <!-- Upgrades stacks 41-80 Attack Speed and past 100 damage (the script sets the amounts and re-adds it to every turret) -->
  <CBehaviorBuff id="GazloweGoldenTurretTuning" parent="CarryBehaviorParent">
    <Modification>
      <AdditiveAttackSpeedFactor value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Upgrades at 100 stacks: turret hits on enemy Heroes add 1% of Gazlowe's maximum Health to this Shield, up to 35%;
       each hit restarts its 10 seconds (the script sets ModifyLimit and re-adds it) -->
  <CBehaviorBuff id="GazloweGoldenTurretShield" parent="StormShield">
    <InfoIcon value="Assets/Textures/storm_ui_icon_Gazlowe_RockItTurret.dds" />
    <Duration value="10" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <!-- Upgrades and Amplification past 100 stacks: Gazlowe's own damage (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="GazloweGoldenOverdrive" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Lazor Specialist, Amplification stacks 41-80: Deth Lazor hits on Heroes add to this Shield; no duration (the script
       sets ModifyLimit, as Alarak's Discordant Ward) -->
  <CBehaviorBuff id="GazloweGoldenLazorShield" parent="StormShield">
    <InfoIcon value="Assets/Textures/storm_ui_icon_Gazlowe_DethLazor.dds" />
    <Duration value="0" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <!-- Scrap Globes (Epic, any Gazlowe): Healing Globes grant 4 Scrap (globes belong to a computer player, so the marker is
       checked instead of a per-player Chance) -->
  <CValidatorUnitCompareBehaviorCount id="GazloweTargetHasScrapGlobes">
    <WhichUnit Value="Target" />
    <Compare value="GT" />
    <Behavior value="GazloweScrapGlobesMarker" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectModifyUnit id="GazloweScrapGlobesScrap">
    <ValidatorArray value="GazloweTargetHasScrapGlobes" />
    <VitalArray index="Energy">
      <Change value="4" />
    </VitalArray>
  </CEffectModifyUnit>
  <CEffectSet id="RegenGlobeImpactSet">
    <EffectArray value="GazloweScrapGlobesScrap" />
  </CEffectSet>
  <!-- on each new turret (Turret Engineer turns it on) -->
  <CEffectApplyBehavior id="GazloweGoldenTurretTuningApply">
    <Chance value="0" />
    <Behavior value="GazloweGoldenTurretTuning" />
  </CEffectApplyBehavior>
  <CEffectSet id="GazloweRockItTurretCreateUnitSet">
    <EffectArray value="GazloweGoldenTurretTuningApply" />
  </CEffectSet>
</Catalog>
