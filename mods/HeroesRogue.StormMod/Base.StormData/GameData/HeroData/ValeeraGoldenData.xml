<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Valeera. Starters: Eviscerator (Eviscerate: no Energy cost), Garrote Specialist (Garrote: no Energy cost, Vanish 2 charges, Rupture) and Scared Assassin (no damage to enemy Heroes; while stealthed, allied non-Heroes nearby heal and share her general boons; stealth openers make Heroes take double damage from minions and mercenaries). Each damage effect has its own multipliers: starter power, the Uncommon boon (a LibAffx multiplier), hit quest (accumulator) and takedown quest past its cap. Hits, quests and script boons are in HeroTriggers/ValeeraGolden.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="ValeeraEviscerateMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ValeeraGarroteMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ValeeraScaredMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ValeeraTwinGarroteMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ValeeraLongShadowsMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ValeeraRallyBannerMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="ValeeraShadowPactMarker" parent="CarryBehaviorParent" />
  <!-- Eviscerator, Domino Effect (Legendary): Eviscerate splashes to non-Heroes within 5 of its target for 60% -->
  <CEffectDamage id="ValeeraGoldenDominoDamage" parent="ValeeraEviscerateDamage">
    <MultiplicativeModifierArray index="ValeeraGoldenDomino" Modifier="-0.4" />
  </CEffectDamage>

  <!-- ===== Eviscerator ===== -->
  <!-- Eviscerate costs no Energy. Cut quest (15% of each map gains kept for good): 10% Eviscerate damage per 3 Combo Point Eviscerate on an enemy Hero. Edge quest: takedowns within 6 seconds of a hit; stacks 1-40 make Eviscerate Slow 1% each for 2 seconds, 41-80 add 1% range each, 81-100 add a 1% chance each to refund the spent Combo Points, at 100 Eviscerate also casts a free Vanish (script), and 1% damage for every stack. -->
  <CBehaviorTokenCounter id="ValeeraGoldenCutTokenCounter" parent="StormQuestToken">
    <Face value="ValeeraGoldenCutTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="ValeeraGoldenEdgeTokenCounter" parent="StormQuestToken">
    <Face value="ValeeraGoldenEdgeTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="ValeeraGoldenCutTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="ValeeraGoldenCutTokenCounter" />
    <Scale value="0.1" />
  </CAccumulatorToken>
  <CEffectDamage id="ValeeraEviscerateDamage">
    <MultiplicativeModifierArray index="ValeeraEvisceratePower" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraEviscerateCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraEviscerateHit" Accumulator="ValeeraGoldenCutTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ValeeraEviscerateLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ValeeraGoldenDominoDamage">
    <MultiplicativeModifierArray index="ValeeraEvisceratePower" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraEviscerateCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraEviscerateHit" Accumulator="ValeeraGoldenCutTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ValeeraEviscerateLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="ValeeraGoldenCutTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_eviscerate.dds" />
  </CButton>
  <CButton id="ValeeraGoldenEdgeTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_eviscerate.dds" />
  </CButton>

  <!-- ===== Garrote Specialist ===== -->
  <!-- Garrote costs no Energy; Vanish stores 2 charges (8 second recharge); gain Rupture. Wire quest (15% of each map gains kept for good): 0.5% Garrote damage per Garrote on an enemy Hero. Hush quest: takedowns within 6 seconds of a Garrote; stacks 1-40 make Vanish recharge 1% faster each, 41-80 make the bleed last 1% longer each (more ticks, script), 81-100 make the Silence last 1% longer each, at 100 Garrote also casts a free Smoke Bomb at most once every 20 seconds (script), and 1% damage for every stack. -->
  <CBehaviorTokenCounter id="ValeeraGoldenWireTokenCounter" parent="StormQuestToken">
    <Face value="ValeeraGoldenWireTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="ValeeraGoldenHushTokenCounter" parent="StormQuestToken">
    <Face value="ValeeraGoldenHushTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="ValeeraGoldenWireTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="ValeeraGoldenWireTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="ValeeraGarroteDamage">
    <MultiplicativeModifierArray index="ValeeraGarrotePower" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraGarroteCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraGarroteHit" Accumulator="ValeeraGoldenWireTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ValeeraGarroteLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="ValeeraGarroteDoTDamage">
    <MultiplicativeModifierArray index="ValeeraGarrotePower" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraGarroteCommon" Modifier="0" />
    <MultiplicativeModifierArray index="ValeeraGarroteHit" Accumulator="ValeeraGoldenWireTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="ValeeraGarroteLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="ValeeraGoldenWireTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_garrote.dds" />
  </CButton>
  <CButton id="ValeeraGoldenHushTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_garrote.dds" />
  </CButton>

  <!-- ===== Scared Assassin ===== -->
  <!-- Valeera deals no damage to enemy Heroes (an attacker damage response). While she is stealthed, allied non-Heroes within 12 heal 3% of their maximum Health per second (6% at 100 Shelter), gain 30% Attack Speed and share her general boons at full power (script; a ring shows the range). Her stealth openers expose enemy Heroes for 6 seconds: they take 100% more damage from non-Hero, non-structure attackers. Rally quest (15% of each map gains kept for good): every 10 enemy minions or mercenaries that die within her range add 1% to that bonus (script). Shelter quest (script, no participation): enemy Hero deaths within 6 seconds of allied minion or mercenary damage near her; stacks 1-40 give her supported allies 1% Attack Speed each, 41-80 1 Armor each, 81-100 make Cheap Shot Stun 2% longer each, at 100 the healing doubles, and 1% more bonus damage for every stack. -->
  <CBehaviorTokenCounter id="ValeeraGoldenRallyTokenCounter" parent="StormQuestToken">
    <Face value="ValeeraGoldenRallyTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="ValeeraGoldenShelterTokenCounter" parent="StormQuestToken">
    <Face value="ValeeraGoldenShelterTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="ValeeraGoldenRallyTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="ValeeraGoldenRallyTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CButton id="ValeeraGoldenRallyTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_vanish.dds" />
  </CButton>
  <CButton id="ValeeraGoldenShelterTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_vanish.dds" />
  </CButton>
  <!-- Eviscerator: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="ValeeraEvisceratePastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Garrote Specialist: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="ValeeraGarrotePastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>

  <!-- ===== Boons ===== -->
  <!-- ===== Eviscerator ===== -->
  <!-- Eviscerate's damage is replaced (index 0) by a set that starts with it, so everything here still sees the Combo
       Points it spent (the base set resets them right after). Every added effect is Chance 0 until the starter's quest or a
       boon turns it on, so other Valeeras are unchanged. -->
  <CEffectSet id="ValeeraEviscerateInitialSet">
    <EffectArray index="0" value="ValeeraGoldenEviscerateHitSet" />
  </CEffectSet>
  <CEffectSet id="ValeeraGoldenEviscerateHitSet">
    <EffectArray value="ValeeraGoldenFullComboApply" />
    <EffectArray value="ValeeraGoldenTwoComboApply" />
    <EffectArray value="ValeeraEviscerateDamage" />
    <EffectArray value="ValeeraGoldenDominoSearch" />
    <EffectArray value="ValeeraGoldenRefundSwitch" />
    <EffectArray value="ValeeraGoldenSlowApply" />
    <EffectArray value="ValeeraGoldenKidneyApply" />
    <EffectArray value="ValeeraGoldenFeintApply" />
    <EffectArray value="ValeeraGoldenShroudApply" />
  </CEffectSet>
  <!-- Cut quest: only an Eviscerate with 3 Combo Points counts; this mark (put on Valeera before the damage, while the
       points are still there) tells the script -->
  <CBehaviorBuff id="ValeeraGoldenFullCombo">
    <Duration value="0.25" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenFullComboApply">
    <ValidatorArray value="ValeeraHas3CP" />
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenFullCombo" />
  </CEffectApplyBehavior>
  <!-- Recruit (Scared Assassin talent): an Eviscerate with 2 Combo Points (this mark) or 3 gives back all but one -->
  <CBehaviorBuff id="ValeeraGoldenTwoCombo">
    <Duration value="0.25" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenTwoComboApply">
    <ValidatorArray value="ValeeraHas2CP" />
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenTwoCombo" />
  </CEffectApplyBehavior>
  <!-- Edge stacks 1-40: Eviscerate Slows 1% each for 2 seconds (the quest adds the Slow and turns the Chance on) -->
  <CBehaviorBuff id="ValeeraGoldenEviscerateSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_valeera_eviscerate.dds" />
    <Duration value="2" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenSlowApply">
    <Chance value="0" />
    <Behavior value="ValeeraGoldenEviscerateSlow" />
  </CEffectApplyBehavior>
  <!-- Edge stacks 81-100: 1% chance each to refund the Combo Points Eviscerate spent. The switch reads them before the
       reset; the refund behavior's final effect gives them back 0.25 seconds later. -->
  <CEffectSwitch id="ValeeraGoldenRefundSwitch">
    <Chance value="0" />
    <CaseArray Validator="ValeeraHas3CP" Effect="ValeeraGoldenRefund3Apply" />
    <CaseArray Validator="ValeeraHas2CP" Effect="ValeeraGoldenRefund2Apply" />
    <CaseDefault value="ValeeraGoldenRefund1Apply" />
  </CEffectSwitch>
  <CEffectApplyBehavior id="ValeeraGoldenRefund1Apply">
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenRefund1" />
  </CEffectApplyBehavior>
  <CEffectApplyBehavior id="ValeeraGoldenRefund2Apply">
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenRefund2" />
  </CEffectApplyBehavior>
  <CEffectApplyBehavior id="ValeeraGoldenRefund3Apply">
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenRefund3" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="ValeeraGoldenRefund1">
    <Duration value="0.25" />
    <FinalEffect value="ValeeraGoldenRefund1Set" />
  </CBehaviorBuff>
  <CBehaviorBuff id="ValeeraGoldenRefund2">
    <Duration value="0.25" />
    <FinalEffect value="ValeeraGoldenRefund2Set" />
  </CBehaviorBuff>
  <CBehaviorBuff id="ValeeraGoldenRefund3">
    <Duration value="0.25" />
    <FinalEffect value="ValeeraGoldenRefund3Set" />
  </CBehaviorBuff>
  <CEffectModifyTokenCount id="ValeeraGoldenRefund1Token" parent="BaseEffectModifyTokenCount">
    <TokenId value="ValeeraComboPointsToken" />
    <Operation value="Set" />
    <Value value="1" />
  </CEffectModifyTokenCount>
  <CEffectModifyTokenCount id="ValeeraGoldenRefund2Token" parent="BaseEffectModifyTokenCount">
    <TokenId value="ValeeraComboPointsToken" />
    <Operation value="Set" />
    <Value value="2" />
  </CEffectModifyTokenCount>
  <CEffectModifyTokenCount id="ValeeraGoldenRefund3Token" parent="BaseEffectModifyTokenCount">
    <TokenId value="ValeeraComboPointsToken" />
    <Operation value="Set" />
    <Value value="3" />
  </CEffectModifyTokenCount>
  <CEffectApplyBehavior id="ValeeraGoldenRefundPointsApply">
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraComboPoints" />
  </CEffectApplyBehavior>
  <CEffectSet id="ValeeraGoldenRefund1Set">
    <EffectArray value="ValeeraGoldenRefund1Token" />
    <EffectArray value="ValeeraGoldenRefundPointsApply" />
    <EffectArray value="ValeeraInCombatComboPointsApply" />
  </CEffectSet>
  <CEffectSet id="ValeeraGoldenRefund2Set">
    <EffectArray value="ValeeraGoldenRefund2Token" />
    <EffectArray value="ValeeraGoldenRefundPointsApply" />
    <EffectArray value="ValeeraInCombatComboPointsApply" />
  </CEffectSet>
  <CEffectSet id="ValeeraGoldenRefund3Set">
    <EffectArray value="ValeeraGoldenRefund3Token" />
    <EffectArray value="ValeeraGoldenRefundPointsApply" />
    <EffectArray value="ValeeraInCombatComboPointsApply" />
  </CEffectSet>
  <!-- Feint (Uncommon): Eviscerating an enemy Hero gives 30 Armor for 10 seconds (Chance 0, the boon turns it on) -->
  <CBehaviorBuff id="ValeeraGoldenFeint" parent="StormArmor">
    <Alignment value="Positive" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_valeera_eviscerate.dds" />
    <Duration value="10" />
    <ArmorModification>
      <AllArmorBonus value="30" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenFeintApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenFeint" />
  </CEffectApplyBehavior>
  <!-- Shadow Shroud (Rare): Eviscerating an enemy Hero Shields Valeera for 30% of her maximum Health for 10 seconds -->
  <CBehaviorBuff id="ValeeraGoldenShroud" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_valeera_cloakofshadows.dds" />
    <Duration value="10" />
    <DamageResponse>
      <ModifyLimitVitalMaxFractionArray index="Life" value="0.3" />
    </DamageResponse>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenShroudApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenShroud" />
  </CEffectApplyBehavior>
  <!-- Kidney Shot (Epic): Eviscerate Stuns for 0.25 seconds -->
  <CBehaviorBuff id="ValeeraGoldenKidneyStun" parent="StormStun">
    <Duration value="0.25" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenKidneyApply">
    <Chance value="0" />
    <Behavior value="ValeeraGoldenKidneyStun" />
  </CEffectApplyBehavior>
  <!-- Domino Effect (Legendary): non-Heroes within 5 of the target (not the target itself) take 60% -->
  <CEffectEnumArea id="ValeeraGoldenDominoSearch">
    <Chance value="0" />
    <ImpactLocation Value="TargetUnit" />
    <SearchFilters value="-;Player,Ally,Neutral,Heroic,Structure,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <ExcludeArray Effect="ValeeraEviscerateInitialSet" Value="Target" />
    <AreaArray Effect="ValeeraGoldenDominoDamage">
      <Radius value="5" />
    </AreaArray>
  </CEffectEnumArea>
  <CActorModel id="ValeeraGoldenDominoImpact" parent="StormModelAnimationStyleOneShotUnit">
    <Remove Terms="ActorCreation" Send="AnimBracketStart BSD Birth Stand Death ContentPlayOnce" />
    <On Terms="Effect.ValeeraGoldenDominoDamage.Start; At Target" Send="Create" />
    <On Terms="ActorCreation" Send="AnimPlay Birth Birth" />
    <On Terms="AnimDone; AnimName Birth" Send="Destroy" />
    <HostSiteOps Ops="SOpAttachCenter" />
    <Model value="ValeeraEviscerateImpact" />
  </CActorModel>
  <!-- ===== Garrote Specialist ===== -->
  <!-- Vanish's charges: its end-of-stealth cooldown (the ability's Cooldown, 0.5 seconds) only spaces the charges -->
  <!-- Shadow Dance (Legendary): Garrote makes Valeera Invulnerable for 0.75 seconds (Chance 0, the boon turns it on) -->
  <CBehaviorBuff id="ValeeraGoldenShadowDance" parent="StormInvulnerable">
    <Duration value="0.75" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenShadowDanceApply">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="ValeeraGoldenShadowDance" />
  </CEffectApplyBehavior>
  <CEffectSet id="ValeeraGarroteImpactSet">
    <EffectArray value="ValeeraGoldenShadowDanceApply" />
    <EffectArray value="ValeeraGoldenExposedApply" />
  </CEffectSet>
  <!-- ===== Scared Assassin ===== -->
  <!-- Valeera deals no damage to enemy Heroes -->
  <CBehaviorBuff id="ValeeraGoldenPacifist" parent="CarryBehaviorParent">
    <DamageResponse Chance="1" Location="Attacker" TargetFilters="Heroic;Player,Ally" ModifyFraction="0" />
  </CBehaviorBuff>
  <!-- stealth openers (Ambush, Cheap Shot, Garrote; the teleport versions use the same sets) expose enemy Heroes: they take
       100% more damage from non-Hero, non-structure attackers for 6 seconds (Chance 0, the starter turns it on; the script
       sets the fraction from the quests) -->
  <CBehaviorBuff id="ValeeraGoldenExposed">
    <Alignment value="Negative" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_valeera_vanish.dds" />
    <Duration value="6" />
    <DamageResponse Chance="1" TargetFilters="-;Heroic,Structure" ModifyFraction="2" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="ValeeraGoldenExposedApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="ValeeraGoldenExposed" />
  </CEffectApplyBehavior>
  <CEffectSet id="ValeeraAmbushInitialSet">
    <EffectArray value="ValeeraGoldenExposedApply" />
  </CEffectSet>
  <CEffectSet id="ValeeraCheapShotImpactSet">
    <EffectArray value="ValeeraGoldenExposedApply" />
  </CEffectSet>
  <!-- allied minions and mercenaries near an exposed Hero are ordered to attack it; this keeps their AI from re-ordering
       them while it lasts (the script refreshes it) -->
  <CBehaviorBuff id="ValeeraGoldenFocused">
    <Duration value="0.5" />
    <Modification>
      <ModifyFlags index="OrdersUninterruptible" value="1" />
      <StateFlags index="Uncommandable" value="1" />
    </Modification>
  </CBehaviorBuff>
  <!-- while stealthed (script, every 0.25 seconds): allied non-Heroes in range heal 3% of their maximum Health per second
       (6% at 100 Shelter), and get the Shelter Attack Speed and Armor and a copy of Valeera's general boons (the script sets
       the values for every player and refreshes the buffs) -->
  <CEffectModifyUnit id="ValeeraGoldenShadowMend">
    <ImpactUnit Value="Target" />
    <VitalArray index="Life">
      <ChangeFraction value="0.0075" />
    </VitalArray>
  </CEffectModifyUnit>
  <CBehaviorBuff id="ValeeraGoldenShadowAura" parent="StormArmor">
    <Alignment value="Positive" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_valeera_vanish.dds" />
    <Duration value="0.5" />
    <Modification>
      <AdditiveAttackSpeedFactor value="0" />
      <DamageDealtFraction index="Basic" value="0.25" />
      <DamageDealtFraction index="Ability" value="0.25" />
      <VitalMaxFractionArray index="Life" value="0.25" />
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
    <ArmorModification>
      <AllArmorBonus value="0" />
    </ArmorModification>
    <!-- 40% less damage from Heroes (55% with Bulwark; the script sets it) -->
    <DamageResponse Chance="1" TargetFilters="Heroic;-" ModifyFraction="0.6" />
  </CBehaviorBuff>
  <CBehaviorBuff id="ValeeraGoldenShadowBoons" parent="StormArmor">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_valeera_vanish.dds" />
    <Duration value="0.5" />
    <Modification>
      <MoveSpeedMultiplier value="1" />
    </Modification>
  </CBehaviorBuff>
  <!-- Scared Assassin talents (shown only with the starter): Bribe (the generic talent) at level 1, Recruit at 4, Call to Arms
       (a heroic in Smoke Bomb's place: the script turns Smoke Bomb's effects off and Call to Arms on) at 10, Bulwark at 13 -->
  <CTalent id="ValeeraGoldenRecruit">
    <Face value="ValeeraGoldenRecruit" />
    <Abil value="ValeeraEviscerate" />
  </CTalent>
  <CButton id="ValeeraGoldenRecruit" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_eviscerate.dds" />
  </CButton>
  <CTalent id="ValeeraGoldenCallToArms">
    <Face value="ValeeraGoldenCallToArms" />
    <Abil value="ValeeraSmokeBomb" />
    <RankArray>
      <BehaviorArray value="Ultimate1Unlocked" />
    </RankArray>
    <Active value="1" />
  </CTalent>
  <CButton id="ValeeraGoldenCallToArms" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_vanish.dds" />
  </CButton>
  <CTalent id="ValeeraGoldenBulwark">
    <Face value="ValeeraGoldenBulwark" />
  </CTalent>
  <CButton id="ValeeraGoldenBulwark" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_valeera_cloakofshadows.dds" />
  </CButton>
  <CEffectSet id="ValeeraGoldenCallToArmsSet">
    <Chance value="0" />
  </CEffectSet>
  <CEffectSet id="ValeeraSmokeBombInitialSet">
    <EffectArray value="ValeeraGoldenCallToArmsSet" />
  </CEffectSet>
  <!-- Bribe on the Active bar (key 1): the base talent's button behavior is gone, so the script adds this one with it -->
  <CUnit id="HeroValeera">
    <AbilArray Link="TalentBucketBribe" />
  </CUnit>
  <CBehaviorAbility id="ValeeraGoldenBribeButton">
    <Face value="ValeeraGoldenBribe" />
    <Buttons Face="ValeeraGoldenBribe" Type="AbilCmd" AbilCmd="TalentBucketBribe,Execute" />
  </CBehaviorAbility>
  <CButton id="ValeeraGoldenBribe" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_talent_bribe.dds" />
  </CButton>
  <CButton id="GenericBribeTalent" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_talent_bribe.dds" />
  </CButton>
  <!-- Recruit: a converted minion keeps its enemy buffs (Sappers and the rest, see libAffx_UnitKeepsEnemyBuffs) -->
  <CBehaviorBuff id="ValeeraGoldenRecruited" parent="CarryBehaviorParent" />
