<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Azmodan. Starters: Lord of Annihilation (Globe of Annihilation), Lord of Sin (All Shall Burn) and General of the Burning Hells (Demon Warriors, no Globe). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script; past the cap the takedown quest adds 2.5% to all of Azmodan's damage). Hits, quests and script boons are in HeroTriggers/Azmodan.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="AzmodanGlobeMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanSinMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanGenMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanSplinteringDoomMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanAnnihilatorMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanSinSpreaderMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanBurningLegionMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanLieutenantsRallyMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="AzmodanEndlessLegionMarker" parent="CarryBehaviorParent" />

  <!-- ===== Lord of Annihilation ===== -->
  <!-- Globe of Annihilation has 2 charges with a 10 second recharge, costs half Mana (35), has 25% more range (30 to 37.5) and deals 20% more damage; Wrath and Total Annihilation. Doom quest (50% kept): 1.5% Globe damage per Globe hit on an enemy Hero. Lord of Destruction quest: takedowns within 3 seconds of a Globe hit; stacks 1-40 cut 1% of the recharge each, 41-80 make the cast 1% shorter and the blast 0.5% larger each, 81-100 add 1% range each, 100 unlocks the echo (the blast again 1 s later for 50%), then 2.5% all damage each. -->
  <CBehaviorTokenCounter id="AzmodanGoldenDoomTokenCounter" parent="StormQuestToken">
    <Face value="AzmodanGoldenDoomTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="AzmodanGoldenDestructionTokenCounter" parent="StormQuestToken">
    <Face value="AzmodanGoldenDestructionTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="AzmodanGoldenDoomTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="AzmodanGoldenDoomTokenCounter" />
    <Scale value="0.015" />
  </CAccumulatorToken>
  <CEffectDamage id="AzmodanGlobeOfAnnihilationDamage">
    <MultiplicativeModifierArray index="AzmodanGlobePower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeHit" Accumulator="AzmodanGoldenDoomTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanGlobeLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGoldenEcho" Validator="AzmodanGoldenCasterEchoing" Modifier="-0.5" />
    <MultiplicativeModifierArray index="AzmodanGoldenAnnihilator" Validator="AzmodanGoldenCasterAnnihilating" Modifier="1" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanGlobeOfAnnihilationTideOfSinTalentDamage">
    <MultiplicativeModifierArray index="AzmodanGlobePower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeHit" Accumulator="AzmodanGoldenDoomTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanGlobeLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGoldenEcho" Validator="AzmodanGoldenCasterEchoing" Modifier="-0.5" />
    <MultiplicativeModifierArray index="AzmodanGoldenAnnihilator" Validator="AzmodanGoldenCasterAnnihilating" Modifier="1" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanGlobeOfAnnihilationTotalAnnihilationTalentDamage">
    <MultiplicativeModifierArray index="AzmodanGlobePower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeHit" Accumulator="AzmodanGoldenDoomTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanGlobeLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGoldenEcho" Validator="AzmodanGoldenCasterEchoing" Modifier="-0.5" />
    <MultiplicativeModifierArray index="AzmodanGoldenAnnihilator" Validator="AzmodanGoldenCasterAnnihilating" Modifier="1" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanGoldenSplinterDamage">
    <MultiplicativeModifierArray index="AzmodanGlobePower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGlobeHit" Accumulator="AzmodanGoldenDoomTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanGlobeLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGoldenAnnihilator" Validator="AzmodanGoldenCasterAnnihilating" Modifier="1" />
  </CEffectDamage>
  <CButton id="AzmodanGoldenDoomTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_azmodan_globeofannihilation.dds" />
  </CButton>
  <CButton id="AzmodanGoldenDestructionTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_azmodan_globeofannihilation.dds" />
  </CButton>

  <!-- ===== Lord of Sin ===== -->
  <!-- All Shall Burn has 2 charges with a 6 second recharge, costs half Mana (12.5), has 30% more range and stretch (7.5 to 9.75 cast, 9.75 to 12 leash) and deals 25% more damage; Cydaea's Kiss and Sin's Grasp (its cooldown cut goes on the recharge, by script). Burning Sin quest (50% kept): 0.2% All Shall Burn damage per beam tick on an enemy Hero, added 10 at a time. Sinful Harvest quest: takedowns within 3 seconds of a beam tick; stacks 1-40 cut 1% of the recharge each, 41-80 add 1% range and stretch each, 81-100 add 1% Movement Speed while channeling each, 100 unlocks the fork (each tick also burns the nearest other enemy Hero within 5 for 50%), then 2.5% all damage each. -->
  <CBehaviorTokenCounter id="AzmodanGoldenBurnTokenCounter" parent="StormQuestToken">
    <Face value="AzmodanGoldenBurnTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="AzmodanGoldenSinTokenCounter" parent="StormQuestToken">
    <Face value="AzmodanGoldenSinTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="AzmodanGoldenBurnTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="AzmodanGoldenBurnTokenCounter" />
    <Scale value="0.002" />
  </CAccumulatorToken>
  <CEffectDamage id="AzmodanAllShallBurnDamage">
    <MultiplicativeModifierArray index="AzmodanSinPower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinHit" Accumulator="AzmodanGoldenBurnTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanSinLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanAllShallBurnFinalExplosionDamage">
    <MultiplicativeModifierArray index="AzmodanSinPower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinHit" Accumulator="AzmodanGoldenBurnTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanSinLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanAllShallBurnMasterOfDestructionTalentDamage">
    <MultiplicativeModifierArray index="AzmodanSinPower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinHit" Accumulator="AzmodanGoldenBurnTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanSinLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanGoldenForkDamage">
    <MultiplicativeModifierArray index="AzmodanSinPower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanSinHit" Accumulator="AzmodanGoldenBurnTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="AzmodanSinLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="AzmodanGoldenBurnTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_azmodan_allshallburn.dds" />
  </CButton>
  <CButton id="AzmodanGoldenSinTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_azmodan_allshallburn.dds" />
  </CButton>

  <!-- ===== General of the Burning Hells ===== -->
  <!-- No Globe of Annihilation. Summon Demon Warrior has 4 charges with a 6 second recharge; Demon Warriors no longer decay, have 30% more Health and carry Azmodan's damage boons at full strength (script); at most 6 are alive (the oldest dies). Demonic Invasion at level 1 (Tide of Sin disabled). Legion of Hell quest (no hit quest): takedowns within 3 seconds of a Demon Warrior hit; stacks 1-80 add 1% Demon Warrior damage and Health each, then 2.5% all damage each. -->
  <CBehaviorTokenCounter id="AzmodanGoldenLegionTokenCounter" parent="StormQuestToken">
    <Face value="AzmodanGoldenLegionTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectDamage id="AzmodanSummonDemonWarriorWeaponDamage">
    <MultiplicativeModifierArray index="AzmodanGenPower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGenCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGenLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGoldenLegion" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanSummonDemonWarriorPeriodicDamage">
    <MultiplicativeModifierArray index="AzmodanGenPower" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGenCommon" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGenLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGoldenLegion" Modifier="0" />
  </CEffectDamage>
  <CButton id="AzmodanGoldenLegionTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_azmodan_generalofhell.dds" />
  </CButton>

  <!-- ===== Takedown quest damage past the cap, also on these effects ===== -->
  <CEffectDamage id="AzmodanAllShallBurnDamage">
    <MultiplicativeModifierArray index="AzmodanGlobeLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="AzmodanGenLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="AzmodanAllShallBurnFinalExplosionDamage">
    <MultiplicativeModifierArray index="AzmodanGlobeLegacy" Modifier="0" />
