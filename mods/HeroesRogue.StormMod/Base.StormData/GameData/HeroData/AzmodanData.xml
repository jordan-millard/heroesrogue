  <!-- ===== Boons ===== -->
  <!-- ===== Lord of Annihilation ===== -->
  <!-- Globe echo (takedown quest 100): the Globe's impact goes off again 1 second later at the same point; while the
       script casts it, this marker on Azmodan halves the damage -->
  <CBehaviorBuff id="AzmodanGoldenEchoMarker">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.0625" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="AzmodanGoldenCasterEchoing">
    <WhichUnit Value="Caster" />
    <Behavior value="AzmodanGoldenEchoMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- Splintering Doom (Epic): 3 small globes (1.5 radius) around a Hero the Globe hit, 30% damage each. The script
       copies the Globe's current Amount (level scaling) into this effect. -->
  <CEffectDamage id="AzmodanGoldenSplinterDamage" parent="StormSpell">
    <MultiplicativeModifierArray index="Splinter" Modifier="-0.7" />
    <MultiplicativeModifierArray index="MinionMerc" Validator="GlobeofAnnihilationPvEDamageCheckCombine" Modifier="-0.5" />
    <MultiplicativeModifierArray index="Structure" Validator="IsStructureTarget" Modifier="-0.5" />
    <FlatModifierArray index="Globe" Accumulator="AzmodanGlobeOfAnnihilationDamageAccumulator" />
    <FlatModifierArray index="Pride" Validator="AzmodanHasPrideCarry" Modifier="$AzmodanPrideBonusDamage" />
    <Amount value="176" />
    <SourceButtonFace value="AzmodanGlobeOfAnnihilation" />
  </CEffectDamage>
  <CEffectEnumArea id="AzmodanGoldenSplinterSearch">
    <SearchFilters value="-;Player,Ally,ImmuneToAOE,Missile,Item,Stasis,Dead,Invulnerable" />
    <AreaArray Effect="AzmodanGoldenSplinterDamage">
      <Radius value="1.5" />
    </AreaArray>
  </CEffectEnumArea>
  <!-- Annihilator (Legendary): a Globe killing blow on a Hero gives a charge back and doubles Globe damage for 4 s -->
  <CBehaviorBuff id="AzmodanGoldenAnnihilatorBuff">
    <InfoIcon value="Assets\Textures\storm_ui_icon_azmodan_globeofannihilation_b.dds" />
    <Duration value="4" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="AzmodanGoldenCasterAnnihilating">
    <WhichUnit Value="Caster" />
    <Behavior value="AzmodanGoldenAnnihilatorBuff" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- ===== Lord of Sin ===== -->
  <!-- Beam fork (takedown quest 100): each beam tick on a Hero also burns the nearest other enemy Hero within 5 for 50%.
       The script copies the beam tick's current Amount into this effect. -->
  <CEffectDamage id="AzmodanGoldenForkDamage" parent="StormSpell">
    <MultiplicativeModifierArray index="Fork" Modifier="-0.5" />
    <Amount value="32" />
    <SourceButtonFace value="AzmodanAllShallBurn" />
  </CEffectDamage>
  <!-- Sin Spreader (Epic): an enemy Hero killed by All Shall Burn explodes: the final explosion on enemies within 4 -->
  <CEffectEnumArea id="AzmodanGoldenSinSpreaderSearch">
    <SearchFilters value="-;Player,Ally,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="AzmodanAllShallBurnFinalExplosionDamage">
      <Radius value="4" />
    </AreaArray>
  </CEffectEnumArea>
  <!-- Burning Legion (Legendary): Demon Warriors near Azmodan while he channels attack 50% faster and take 50% less -->
  <CBehaviorBuff id="AzmodanGoldenBurningLegionBuff">
    <InfoIcon value="Assets\Textures\storm_ui_icon_azmodan_allshallburn.dds" />
    <Duration value="1" />
    <Modification>
      <UnifiedAttackSpeedFactor value="0.5" />
    </Modification>
    <DamageResponse>
      <Chance value="1" />
      <ModifyFraction value="0.5" />
    </DamageResponse>
  </CBehaviorBuff>
  <!-- ===== General of the Burning Hells ===== -->
  <CBehaviorBuff id="AzmodanGoldenGeneralRestrictions" parent="CarryBehaviorParent">
    <Modification>
      <AbilLinkDisableArray value="AzmodanGlobeOfAnnihilation" />
    </Modification>
  </CBehaviorBuff>
  <!-- added by the script to every Demon Warrior: +30% Health, +1% per Legion of Hell stack -->
  <CBehaviorBuff id="AzmodanGoldenWarriorHealth">
    <InfoFlags index="Hidden" value="1" />
    <Modification>
      <VitalMaxFractionArray index="Life" value="0.3" />
    </Modification>
  </CBehaviorBuff>
  <!-- Lieutenant's Rally (Epic): every 4th Demon Warrior is a lieutenant with double Health and an aura of +20% Attack
       Speed for Demon Warriors within 5 -->
  <CBehaviorBuff id="AzmodanGoldenLieutenant">
    <InfoIcon value="Assets\Textures\storm_ui_icon_azmodan_generalofhell.dds" />
    <Modification>
      <VitalMaxFractionArray index="Life" value="1" />
    </Modification>
    <Period value="0.5" />
    <PeriodicEffect value="AzmodanGoldenRallySearch" />
  </CBehaviorBuff>
  <CValidatorUnitType id="AzmodanGoldenTargetIsDemonWarrior">
    <Value value="AzmodanDemonWarrior" />
  </CValidatorUnitType>
  <CEffectEnumArea id="AzmodanGoldenRallySearch">
    <SearchFilters value="-;Enemy,Neutral,Structure,Missile,Item,Stasis,Dead,Hidden" />
    <AreaArray Effect="AzmodanGoldenRallyApply">
      <Radius value="5" />
    </AreaArray>
  </CEffectEnumArea>
  <CEffectApplyBehavior id="AzmodanGoldenRallyApply">
    <ValidatorArray value="AzmodanGoldenTargetIsDemonWarrior" />
    <Behavior value="AzmodanGoldenRallyBuff" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="AzmodanGoldenRallyBuff">
    <InfoIcon value="Assets\Textures\storm_ui_icon_azmodan_generalofhell.dds" />
    <Duration value="1" />
    <Modification>
      <UnifiedAttackSpeedFactor value="0.2" />
    </Modification>
  </CBehaviorBuff>
  <!-- Endless Legion (Legendary): a Demon Warrior that came back once does not come back again -->
  <CBehaviorBuff id="AzmodanGoldenRisen">
    <InfoFlags index="Hidden" value="1" />
  </CBehaviorBuff>
</Catalog>
