<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Greymane. Starters: Gilnean Alchemist (Gilnean Cocktail burns for 25% of maximum Health), Feral Ripper (Razor Swipe charges, healing on Hero hits) and Silver Hunter (Cursed Bullet from level 1, half cooldown, heals for its damage). Each damage effect has its own multipliers: starter power, Common boon, hit quest (unused: Kindling is a damage response) and takedown quest past its cap (unused: past 100 the script adds a damage buff). Hits, quests and buffs are in HeroTriggers/GreymaneGolden.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="GreymaneAlchemistMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GreymaneRipperMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GreymaneSilverMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GreymaneJugularMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GreymaneWildfireMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GreymaneBleedOutMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GreymaneLordOfTheHuntMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GreymanePiercingMarker" parent="CarryBehaviorParent" />
  <!-- Gilnean Alchemist burn ticks (10 over 10 seconds): 2.5% of maximum Health, or for Structures, Mercenaries and bosses a
       tenth of the splash damage (the script sets the Amount) -->
  <CEffectDamage id="GreymaneGoldenCocktailBurnDamage" parent="StormSpellDotPercentDamage">
    <VitalFractionMax index="Life" value="0.025" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenCocktailBurnFlatDamage" parent="StormSpellDot">
    <Amount value="22" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenCocktailEruptDamage" parent="StormSpell">
    <Amount value="110" />
  </CEffectDamage>
  <!-- Silver Hunter: Cursed Bullet deals the larger of 35% of current Health (uncapped, unlike the base 1277.85 cap) and 20% of
       maximum Health, and heals Greymane for the damage -->
  <CEffectDamage id="GreymaneGoldenBulletCurrentDamage" parent="StormSpellPercentDamage">
    <FlatModifierArray index="Current" Accumulator="GreymaneGoldenBulletCurrentAccumulator" />
    <LeechFraction index="Life" value="1" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenBulletMaxDamage" parent="StormSpellPercentDamage">
    <VitalFractionMax index="Life" value="0.2" />
    <LeechFraction index="Life" value="1" />
  </CEffectDamage>
  <!-- Feral Ripper, Bleed Out (Epic): 3 ticks of a tenth of Razor Swipe's damage (the script sets the Amount) -->
  <CEffectDamage id="GreymaneGoldenBleedDamage" parent="StormSpellDot">
    <Amount value="12.6" />
  </CEffectDamage>

  <!-- ===== Gilnean Alchemist ===== -->
  <!-- Gilnean Cocktail stores 2 charges (7 second recharge) and costs half Mana; every enemy it damages burns for 25% of maximum Health over 10 seconds (Structures, Mercenaries and bosses for the splash damage, script); it always splashes at the end of its flight; gain Perfect Aim and Incendiary Elixir. Kindling quest (50% kept): 1% damage to burning enemies per Cocktail hit on an enemy Hero (script). Distillation quest: takedowns within 3 seconds of a Cocktail hit or burn tick; stacks 1-40 a Shield per hit (script), 41-80 the flask flies 1% faster each, 81-100 the splash is 1% larger each, at 100 an eruption 1 second later for 50% (script), then 2% damage each (script). -->
  <CBehaviorTokenCounter id="GreymaneGoldenKindlingTokenCounter" parent="StormQuestToken">
    <Face value="GreymaneGoldenKindlingTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="GreymaneGoldenDistillationTokenCounter" parent="StormQuestToken">
    <Face value="GreymaneGoldenDistillationTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GreymaneGoldenKindlingTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GreymaneGoldenKindlingTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="GreymaneGilneanCocktailDamage">
    <MultiplicativeModifierArray index="GreymaneAlchemistPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGilneanCocktailSpreadDamage">
    <MultiplicativeModifierArray index="GreymaneAlchemistPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenCocktailBurnDamage">
    <MultiplicativeModifierArray index="GreymaneAlchemistPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenCocktailBurnFlatDamage">
    <MultiplicativeModifierArray index="GreymaneAlchemistPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenCocktailEruptDamage">
    <MultiplicativeModifierArray index="GreymaneAlchemistPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneAlchemistLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="GreymaneGoldenKindlingTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Greymane_QAttack.dds" />
  </CButton>
  <CButton id="GreymaneGoldenDistillationTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Greymane_QAttack.dds" />
  </CButton>

  <!-- ===== Feral Ripper ===== -->
  <!-- Razor Swipe stores 2 charges (4 second recharge), costs half Mana, dashes 20% farther and deals 20% more damage; each enemy Hero hit heals 5% of maximum Health; gain Unfettered Assault and Viciousness. Savagery quest (50% kept): 1% Razor Swipe damage per enemy Hero hit. Feral Hunt quest: takedowns within 3 seconds of a hit; stacks 1-40 make Razor Swipe recharge 1% faster each, 41-80 make the dash 1% longer and wider each, 81-100 add 0.1% healing each, at 100 each Razor Swipe Stealths for 4 seconds (script), then 2% damage each (script). -->
  <CBehaviorTokenCounter id="GreymaneGoldenSavageryTokenCounter" parent="StormQuestToken">
    <Face value="GreymaneGoldenSavageryTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="GreymaneGoldenFeralHuntTokenCounter" parent="StormQuestToken">
    <Face value="GreymaneGoldenFeralHuntTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GreymaneGoldenSavageryTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GreymaneGoldenSavageryTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="GreymaneRazorSwipeDamage">
    <MultiplicativeModifierArray index="GreymaneRipperPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneRipperCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneRipperHit" Accumulator="GreymaneGoldenSavageryTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="GreymaneRipperLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenBleedDamage">
    <MultiplicativeModifierArray index="GreymaneRipperPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneRipperCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneRipperHit" Accumulator="GreymaneGoldenSavageryTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="GreymaneRipperLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="GreymaneRipperHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.05" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="GreymaneGoldenSavageryTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Greymane_Swipe.dds" />
  </CButton>
  <CButton id="GreymaneGoldenFeralHuntTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Greymane_Swipe.dds" />
  </CButton>

  <!-- ===== Silver Hunter ===== -->
  <!-- Gain Cursed Bullet at level 1 (Go for the Throat can't be taken); its cooldown is halved to 15 seconds, a hit on a Hero sets it to 4, it deals the larger of 35% of current and 20% of maximum Health and Greymane heals for its damage. Silvered quest (50% kept): 5% damage to non-Heroes per Cursed Bullet hit on an enemy Hero (script). Hunter's Resolve quest: takedowns within 6 seconds of a hit; stacks 1-40 add 1 Armor each, 41-80 make crowd control 1% shorter each (script), at 100 Cursed Bullet ricochets to another Hero within 7 (script), then 2% damage each (script). -->
  <CBehaviorTokenCounter id="GreymaneGoldenSilverTokenCounter" parent="StormQuestToken">
    <Face value="GreymaneGoldenSilverTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="GreymaneGoldenResolveTokenCounter" parent="StormQuestToken">
    <Face value="GreymaneGoldenResolveTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GreymaneGoldenSilverTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GreymaneGoldenSilverTokenCounter" />
    <Scale value="0.05" />
  </CAccumulatorToken>
  <CEffectDamage id="GreymaneGoldenBulletCurrentDamage">
    <MultiplicativeModifierArray index="GreymaneSilverPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneSilverCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneSilverLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GreymaneGoldenBulletMaxDamage">
    <MultiplicativeModifierArray index="GreymaneSilverPower" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneSilverCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GreymaneSilverLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="GreymaneGoldenSilverTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Greymane_Snapshot.dds" />
  </CButton>
  <CButton id="GreymaneGoldenResolveTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Greymane_Snapshot.dds" />
  </CButton>

  <!-- ===== Boons ===== -->
  <!-- Gilnean Alchemist: every enemy Gilnean Cocktail damages burns for 10 seconds (the script adds the burn on its damage
       events). Wildfire (Epic) lets the burn stack instead of refresh. -->
  <CBehaviorBuff id="GreymaneGoldenCocktailBurn" parent="StormDot">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Greymane_QAttack.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <Duration value="10.0625" />
    <Period value="1" />
    <PeriodCount value="10" />
    <PeriodicEffect value="GreymaneGoldenCocktailBurnDamage" />
    <PeriodicDisplayEffect value="GreymaneGoldenCocktailBurnDamage" />
  </CBehaviorBuff>
  <CBehaviorBuff id="GreymaneGoldenCocktailBurnFlat" parent="StormDot">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Greymane_QAttack.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <Duration value="10.0625" />
    <Period value="1" />
    <PeriodCount value="10" />
    <PeriodicEffect value="GreymaneGoldenCocktailBurnFlatDamage" />
    <PeriodicDisplayEffect value="GreymaneGoldenCocktailBurnFlatDamage" />
  </CBehaviorBuff>
  <!-- the first enemy hit: its damage period becomes this set (damage, then the 100 stack eruption) -->
  <CEffectSet id="GreymaneGoldenCocktailPrimarySet">
    <EffectArray value="GreymaneGilneanCocktailDamage" />
    <EffectArray value="GreymaneGoldenCocktailEruptPersistent" />
  </CEffectSet>
  <CEffectCreatePersistent id="GreymaneGilneanCocktailImpactSetPersistent">
    <PeriodicEffectArray index="1" value="GreymaneGoldenCocktailPrimarySet" />
  </CEffectCreatePersistent>
  <!-- a Cocktail that reaches the end of its flight without hitting anything still splashes around that spot (the
       splash's own damage and quest; Chance 0, the starter turns it on; the script casts it, libAffx_GreymaneCocktailLaunch_Func) -->
  <CEffectEnumArea id="GreymaneGoldenCocktailBurstSearch">
    <Chance value="0" />
    <ImpactLocation Value="TargetPoint" />
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="GreymaneGilneanCocktailSpreadImpactSet">
      <Radius value="3" />
    </AreaArray>
  </CEffectEnumArea>
  <!-- Kindling quest: Greymane deals more damage to burning enemies (the script sets the fraction and re-adds it) -->
  <CValidatorUnitCompareBehaviorCount id="GreymaneGoldenTargetBurningPercent">
    <WhichUnit Value="Target" />
    <Compare value="GE" />
    <Value value="1" />
    <Behavior value="GreymaneGoldenCocktailBurn" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="GreymaneGoldenTargetBurningFlat">
    <WhichUnit Value="Target" />
    <Compare value="GE" />
    <Value value="1" />
    <Behavior value="GreymaneGoldenCocktailBurnFlat" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorCombine id="GreymaneGoldenTargetBurning">
    <Type value="Or" />
    <CombineArray value="GreymaneGoldenTargetBurningPercent" />
    <CombineArray value="GreymaneGoldenTargetBurningFlat" />
  </CValidatorCombine>
  <CBehaviorBuff id="GreymaneGoldenKindling" parent="CarryBehaviorParent">
    <DamageResponse Chance="1" Location="Attacker" ModifyFraction="1">
      <ValidatorArray value="GreymaneGoldenTargetBurning" />
    </DamageResponse>
  </CBehaviorBuff>
  <!-- Distillation stacks 1-40: Cocktail hits on Heroes add to this Shield; no duration (the script sets ModifyLimit) -->
  <CBehaviorBuff id="GreymaneGoldenCocktailShield" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Greymane_QAttack.dds" />
    <Duration value="0" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <!-- Distillation at 100: 1 second after the Cocktail lands, the spot erupts for half the splash damage (Chance and Amount set
       by the script) -->
  <CEffectCreatePersistent id="GreymaneGoldenCocktailEruptPersistent">
    <Chance value="0" />
    <WhichLocation Value="TargetPoint" />
    <PeriodCount value="1" />
    <PeriodicPeriodArray value="1" />
    <PeriodicEffectArray value="GreymaneGoldenCocktailEruptSearch" />
  </CEffectCreatePersistent>
  <CEffectEnumArea id="GreymaneGoldenCocktailEruptSearch">
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="GreymaneGoldenCocktailEruptDamage">
      <Radius value="2.5" />
    </AreaArray>
  </CEffectEnumArea>
  <CActorModel id="GreymaneGilneanCocktailImpact">
    <On Terms="Effect.GreymaneGoldenCocktailEruptDamage.Start; At Target" Send="Create" />
  </CActorModel>
  <!-- ===== Feral Ripper ===== -->
  <!-- charges: Unfettered Assault's Basic Attacks also shorten the recharge -->
  <CEffectModifyUnit id="GreymaneRazorSwipeUnfetteredAssaultModifyCooldown">
    <Cost Abil="GreymaneRazorSwipe,Execute" CooldownOperation="Add" CooldownTimeUse="-1.5" ChargeTimeUse="-1.5" />
  </CEffectModifyUnit>
  <!-- Feral Hunt at 100: each Razor Swipe Stealths Greymane for 4 seconds. Not a temporary cloak, so his attacks and abilities
       don't remove it; taking damage does, except during the first 2 seconds (an unrevealable cloak, as Eyes in the Dark's
       decloak safety). Neither holds fire. Chance 0: the script turns them on. -->
  <CBehaviorBuff id="GreymaneGoldenProwl" parent="StormCloak">
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_Greymane_Swipe.dds" />
    <Duration value="4" />
    <InitialEffect value="HeroGenericCasterUpdateVisibility" />
    <FinalEffect value="HeroGenericCasterUpdateVisibility" />
    <Modification>
      <StateFlags index="SuppressDamageVisibilityAttacker" value="1" />
      <BehaviorLinkDisableArray value="AttackReveal" />
    </Modification>
    <DamageResponse Chance="1" Handled="GreymaneGoldenProwlRemove" Priority="97">
      <ValidatorArray value="SourceNotUnrevealable" />
    </DamageResponse>
  </CBehaviorBuff>
  <CEffectRemoveBehavior id="GreymaneGoldenProwlRemove">
    <WhichUnit Value="Source" />
    <BehaviorLink value="GreymaneGoldenProwl" />
  </CEffectRemoveBehavior>
  <CBehaviorBuff id="GreymaneGoldenProwlGuard" parent="StormUnrevealableCloak">
    <Duration value="2" />
    <InitialEffect value="HeroGenericCasterUpdateVisibility" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="GreymaneGoldenProwlApply">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="GreymaneGoldenProwl" />
  </CEffectApplyBehavior>
  <CEffectApplyBehavior id="GreymaneGoldenProwlGuardApply">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="GreymaneGoldenProwlGuard" />
  </CEffectApplyBehavior>
  <CEffectSet id="GreymaneRazorSwipeSet">
    <EffectArray value="GreymaneGoldenProwlGuardApply" />
    <EffectArray value="GreymaneGoldenProwlApply" />
  </CEffectSet>
  <!-- Bleed Out (Epic): enemies Razor Swipe hits bleed for 30% of its damage over 3 seconds (the script adds it) -->
  <CBehaviorBuff id="GreymaneGoldenBleed" parent="StormDot">
    <InfoIcon value="Assets\Textures\storm_ui_icon_Greymane_Swipe.dds" />
    <Duration value="3.0625" />
    <Period value="1" />
    <PeriodCount value="3" />
    <PeriodicEffect value="GreymaneGoldenBleedDamage" />
    <PeriodicDisplayEffect value="GreymaneGoldenBleedDamage" />
  </CBehaviorBuff>
  <!-- Lord of the Hunt (Legendary): a Feral Hunt takedown resets Darkflight (and Disengage, which shares its cooldown) -->
  <CEffectModifyUnit id="GreymaneGoldenDarkflightReset">
    <ImpactUnit Value="Caster" />
    <Cost Abil="GreymaneDarkflight,Execute" CooldownOperation="Set" CooldownTimeUse="0" />
  </CEffectModifyUnit>
  <!-- Feral Hunt past 100 stacks: Greymane's damage (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="GreymaneGoldenRipperOverdrive" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- ===== Silver Hunter ===== -->
  <CAccumulatorVitals id="GreymaneGoldenBulletCurrentAccumulator" parent="BaseVitalAccumulator">
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <Ratio value="0.35" />
    <VitalType value="Life" />
    <UnitSource Value="Target" />
    <ModificationType value="PerUnit" />
  </CAccumulatorVitals>
  <!-- 35% of current is the larger at 4/7 of maximum Health or more -->
  <CValidatorUnitCompareVital id="GreymaneGoldenTargetLifeGE4Sevenths">
    <WhichUnit Value="Target" />
    <Type value="Fraction" />
    <Compare value="GE" />
    <Value value="0.5714" />
  </CValidatorUnitCompareVital>
  <CValidatorUnitCompareBehaviorCount id="GreymaneGoldenCasterNotSilver">
    <WhichUnit Value="Caster" />
    <Compare value="EQ" />
    <Value value="0" />
    <Behavior value="GreymaneSilverMarker" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- Cursed Bullet's damage (and the ricochet's): the base damage without Silver Hunter -->
  <CEffectSwitch id="GreymaneGoldenBulletDamageSwitch">
    <CaseArray Validator="GreymaneGoldenCasterNotSilver" Effect="GreymaneCursedBulletDamagePercentDamage" />
    <CaseArray Validator="GreymaneGoldenTargetLifeGE4Sevenths" Effect="GreymaneGoldenBulletCurrentDamage" />
    <CaseDefault value="GreymaneGoldenBulletMaxDamage" />
  </CEffectSwitch>
  <!-- Silver Hunter: a Cursed Bullet hit on an enemy Hero sets its cooldown to 4 seconds (the script runs it) -->
  <CEffectModifyUnit id="GreymaneGoldenBulletCooldownReset">
    <ImpactUnit Value="Caster" />
    <Cost Abil="GreymaneCursedBullet,Execute" CooldownOperation="Set" CooldownTimeUse="4" />
  </CEffectModifyUnit>
  <!-- Silvered quest: Greymane deals more damage to non-Heroes (the script sets the fraction and re-adds it) -->
  <CBehaviorBuff id="GreymaneGoldenSilverbane" parent="CarryBehaviorParent">
    <DamageResponse Chance="1" Location="Attacker" TargetFilters="-;Heroic" ModifyFraction="1" />
  </CBehaviorBuff>
  <!-- Hunter's Resolve stacks 1-40: 1 Armor per behavior stack, on top of Worgen form's (the script sets the stack count) -->
  <CBehaviorBuff id="GreymaneGoldenSilverArmor" parent="StormArmor">
    <MaxStackCount value="40" />
    <BehaviorFlags index="Permanent" value="1" />
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_Greymane_Snapshot.dds" />
    <ArmorModification StackCount="40">
      <AllArmorBonus value="1" />
    </ArmorModification>
  </CBehaviorBuff>
  <!-- Hunter's Resolve at 100: Cursed Bullet ricochets from its target to the nearest other enemy Hero within 7 (Chance 0: the
       script turns it on) -->
  <CEffectEnumArea id="GreymaneGoldenRicochetSearch">
    <Chance value="0" />
    <ImpactLocation Value="TargetUnit" />
    <SearchFilters value="Heroic;Player,Ally,Neutral,Missile,Item,Stasis,Dead,Hidden,Invulnerable" />
    <ExcludeArray Value="Target" />
    <AreaArray MaxCount="1" Effect="GreymaneGoldenRicochetLaunch">
      <Radius value="7" />
    </AreaArray>
  </CEffectEnumArea>
  <CEffectLaunchMissile id="GreymaneGoldenRicochetLaunch">
    <LaunchLocation Effect="GreymaneGoldenRicochetSearch" Value="TargetUnit" />
    <ImpactLocation Value="TargetUnit" />
    <ImpactEffect value="GreymaneGoldenRicochetImpactSet" />
    <AmmoUnit value="GreymaneCursedBulletMissile" />
    <Movers Link="CursedBulletMissile" />
  </CEffectLaunchMissile>
  <CEffectSet id="GreymaneGoldenRicochetImpactSet">
    <ValidatorArray value="NotVehicle" />
    <EffectArray value="GreymaneGoldenBulletDamageSwitch" />
  </CEffectSet>
  <CEffectSet id="GreymaneCursedBulletImpactSet">
    <EffectArray index="0" value="GreymaneGoldenBulletDamageSwitch" />
    <EffectArray index="3" value="GreymaneGoldenBulletStopSet" />
    <EffectArray value="GreymaneGoldenRicochetSearch" />
  </CEffectSet>
  <!-- Silver Piercer (Uncommon): Cursed Bullet keeps flying through Heroes (its hit no longer destroys the missile, and the
       scan takes up to 10 Heroes; the missile's marker keeps each Hero to one hit) -->
  <CValidatorUnitCompareBehaviorCount id="GreymaneGoldenCasterNotPiercing">
    <WhichUnit Value="Caster" />
    <Compare value="EQ" />
    <Value value="0" />
    <Behavior value="GreymanePiercingMarker" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectSet id="GreymaneGoldenBulletStopSet">
    <ValidatorArray value="GreymaneGoldenCasterNotPiercing" />
    <EffectArray value="GreymaneCursedBulletDestroyMissileSet" />
  </CEffectSet>
  <!-- Hunter's Resolve past 100 stacks: Greymane's damage (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="GreymaneGoldenSilverOverdrive" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Distillation past 100 stacks: Greymane's damage (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="GreymaneGoldenOverdrive" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
</Catalog>
