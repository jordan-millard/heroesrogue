<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- Golden Lunara (Dryad). Quest stacks carry over between games: see HeroTriggers/Lunara.galaxy -->

  <!-- Poisoner: Crippling Spores bursts the poison stored on enemies instead of extending it; Hero kills by the burst
       grant stacks, and stacks add Nature's Toxin damage. Script: burst, duration and stacks -->
  <CBehaviorTokenCounter id="DryadPoisonerTokenCounter" parent="StormQuestToken">
    <Face value="DryadPoisonerTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="DryadPoisonerAccumulator" parent="BaseAccumulator">
    <SourceEffect value="DryadNaturesToxinDamage" />
    <ApplicationRule value="Add" />
    <TokenId value="DryadPoisonerTokenCounter" />
    <Scale value="0.03" />
    <MaxAccumulation value="100000" />
  </CAccumulatorToken>
  <CAccumulatorToken id="DryadPoisonerBurstAccumulator" parent="DryadPoisonerAccumulator">
    <SourceEffect value="DryadPoisonerSporesDamage" />
  </CAccumulatorToken>
  <CEffectSwitch id="DryadPoisonerSporesSwitch">
    <CaseArray Validator="DryadHasPoisoner" Effect="DryadPoisonerSporesBurst" />
    <CaseDefault value="DryadNaturesToxinDebuffSet" />
  </CEffectSwitch>
  <CEffectSet id="DryadCripplingSporesImpactSet">
    <EffectArray index="1" value="DryadPoisonerSporesSwitch" />
  </CEffectSet>
  <!-- Script hook: deals the stored poison through DryadPoisonerSporesDamage and removes the poison -->
  <CEffectModifyUnit id="DryadPoisonerSporesBurst" />
  <!-- The burst has every bonus a Nature's Toxin tick has, so it matches the poison shown on the Health bar
       (DryadPoisonerToxinDisplayDamage). Unfair Advantage applies because Spores slows the target first. -->
  <CEffectDamage id="DryadPoisonerSporesDamage" parent="StormSpell">
    <Amount value="0" />
    <MultiplicativeModifierArray index="IntensifyingToxinModifier" Validator="DryadIntensifyingToxinCombine" Modifier="0.4" Crit="1" />
    <MultiplicativeModifierArray index="NaturesCullingModifier" Validator="DryadHasNaturesCullingandTargetisnotHero" Modifier="1.25" />
    <MultiplicativeModifierArray index="UnfairAdvantageModifier" Validator="DryadHasUnfairAdvantageandEnemyHeroisSlowedCombine" Modifier="0.6" Crit="1" />
    <MultiplicativeModifierArray index="Poisoner" Accumulator="DryadPoisonerBurstAccumulator" />
  </CEffectDamage>
  <!-- Poisoner: the poison shown on enemy Health bars is what Crippling Spores would burst. It's one Nature's Toxin tick
       (Amount kept equal to DryadNaturesToxinDamage by script) with Unfair Advantage counted against any Hero that
       Spores can slow, since the burst lands after Spores' slow. Script sets it as Nature's Toxin's display effect. -->
  <CValidatorCombine id="DryadPoisonerUnfairAdvantageOnBurst">
    <Type value="And" />
    <CombineArray value="DryadHasUnfairAdvantageTalent" />
    <CombineArray value="TargetNotUnstoppable" />
    <CombineArray value="TargetIsHero" />
  </CValidatorCombine>
  <!-- Poisoner lethal marker (script): hidden probes that mark which of Nature's Toxin's bonuses apply, so the script can
       tell a tick's bonuses apart from what's left (Spell Power, armor, the quest). Tick probes run in each tick before
       its damage, with the tick's own validators; burst probes run from script with the burst's (Unfair Advantage
       counted against any Hero Spores can slow). -->
  <CBehaviorBuff id="DryadPoisonerTickProbeIntensifying">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="DryadPoisonerTickProbeIntensifyingApply">
    <ValidatorArray value="DryadIntensifyingToxinCombine" />
    <Behavior value="DryadPoisonerTickProbeIntensifying" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="DryadPoisonerTickProbeUnfair">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="DryadPoisonerTickProbeUnfairApply">
    <ValidatorArray value="DryadHasUnfairAdvantageandEnemyHeroisSlowedCombine" />
    <Behavior value="DryadPoisonerTickProbeUnfair" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="DryadPoisonerTickProbeCulling">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="DryadPoisonerTickProbeCullingApply">
    <ValidatorArray value="DryadHasNaturesCullingandTargetisnotHero" />
    <Behavior value="DryadPoisonerTickProbeCulling" />
  </CEffectApplyBehavior>
  <CEffectSet id="DryadPoisonerTickProbeSet">
    <ValidatorArray value="DryadHasPoisoner" />
    <EffectArray value="DryadPoisonerTickProbeIntensifyingApply" />
    <EffectArray value="DryadPoisonerTickProbeUnfairApply" />
    <EffectArray value="DryadPoisonerTickProbeCullingApply" />
  </CEffectSet>
  <CBehaviorBuff id="DryadPoisonerBurstProbeIntensifying">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="DryadPoisonerBurstProbeIntensifyingApply">
    <ValidatorArray value="DryadIntensifyingToxinCombine" />
    <Behavior value="DryadPoisonerBurstProbeIntensifying" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="DryadPoisonerBurstProbeUnfair">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="DryadPoisonerBurstProbeUnfairApply">
    <ValidatorArray value="DryadPoisonerUnfairAdvantageOnBurst" />
    <Behavior value="DryadPoisonerBurstProbeUnfair" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="DryadPoisonerBurstProbeCulling">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.5" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="DryadPoisonerBurstProbeCullingApply">
    <ValidatorArray value="DryadHasNaturesCullingandTargetisnotHero" />
    <Behavior value="DryadPoisonerBurstProbeCulling" />
  </CEffectApplyBehavior>
  <CEffectSet id="DryadPoisonerBurstProbeSet">
    <ValidatorArray value="DryadHasPoisoner" />
    <EffectArray value="DryadPoisonerBurstProbeIntensifyingApply" />
    <EffectArray value="DryadPoisonerBurstProbeUnfairApply" />
    <EffectArray value="DryadPoisonerBurstProbeCullingApply" />
  </CEffectSet>
  <!-- Poisoner lethal marker: on an enemy Hero while Crippling Spores' burst would kill them (script). It shows
       Malthael's Last Rites kill marker, which only the behavior's caster sees. -->
  <CBehaviorBuff id="DryadPoisonerLethalTarget">
    <InfoFlags index="Hidden" value="1" />
    <RemoveValidatorArray value="TargetNotDead" />
  </CBehaviorBuff>
  <CActorModel id="ViableKillMarker">
    <On Terms="Behavior.DryadPoisonerLethalTarget.On" Send="Create" />
    <On Terms="Behavior.DryadPoisonerLethalTarget.Off" Send="AnimBracketStop BSD" />
  </CActorModel>
  <CEffectSet id="DryadNaturesToxinPeriodicSet">
    <EffectArray index="0" value="DryadPoisonerTickProbeSet" />
    <EffectArray value="DryadNaturesToxinDamage" />
  </CEffectSet>
  <CEffectDamage id="DryadPoisonerToxinDisplayDamage" parent="StormSpellDot">
    <Amount value="33" />
    <MultiplicativeModifierArray index="IntensifyingToxinModifier" Validator="DryadIntensifyingToxinCombine" Modifier="0.4" Crit="1" />
    <MultiplicativeModifierArray index="NaturesCullingModifier" Validator="DryadHasNaturesCullingandTargetisnotHero" Modifier="1.25" />
    <MultiplicativeModifierArray index="UnfairAdvantageModifier" Validator="DryadPoisonerUnfairAdvantageOnBurst" Modifier="0.6" Crit="1" />
    <MultiplicativeModifierArray index="Poisoner" Accumulator="DryadPoisonerAccumulator" />
  </CEffectDamage>
  <!-- Poisoner: Basic Attacks splash their damage and Nature's Toxin onto nearby enemies -->
  <CEffectEnumArea id="DryadPoisonerSplashSearch">
    <ValidatorArray value="DryadHasPoisoner" />
    <SearchFilters value="-;Self,Player,Ally,ImmuneToAOE,Missile,Stasis,Dead,Hidden,Invulnerable" />
    <ExcludeArray Value="Target" />
    <AreaArray Effect="DryadPoisonerSplashSet">
      <Radius value="4" />
    </AreaArray>
  </CEffectEnumArea>
  <CEffectSet id="DryadPoisonerSplashSet">
    <EffectArray value="DryadHeroWeaponDamage" />
    <EffectArray value="DryadNaturesToxinDebuffSet" />
  </CEffectSet>
  <CEffectSet id="DryadHeroWeaponImpactSet">
    <EffectArray value="DryadPoisonerSplashSearch" />
  </CEffectSet>
  <CEffectSet id="DryadHeroWeaponImpactSetSplinteredSpearMastery">
    <EffectArray value="DryadPoisonerSplashSearch" />
  </CEffectSet>
  <!-- Poisoner: Basic Attacks deal 90% less damage -->
  <!-- Marks a Poisoner Lunara. The quest token counter can not be used: its count is its stacks, so it reads 0
       before the first stack -->
  <CBehaviorBuff id="DryadPoisonerMarker" parent="CarryBehaviorParent" />
  <CValidatorUnitCompareBehaviorCount id="DryadHasPoisoner">
    <WhichUnit Value="Caster" />
    <Behavior value="DryadPoisonerMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectDamage id="DryadNaturesToxinDamage">
    <MultiplicativeModifierArray index="Poisoner" Accumulator="DryadPoisonerAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="DryadNaturesToxinUnfairAdvantageMasteryDamage">
    <MultiplicativeModifierArray index="Poisoner" Accumulator="DryadPoisonerAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="DryadNaturesToxinNaturesCullingMasteryDamage">
    <MultiplicativeModifierArray index="Poisoner" Accumulator="DryadPoisonerAccumulator" />
  </CEffectDamage>

  <!-- Splintered Huntress: Crippling Spores hitting enemy Heroes grants stacks; stacks add Attack Damage -->
  <CBehaviorTokenCounter id="DryadHuntressTokenCounter" parent="StormQuestToken">
    <Face value="DryadHuntressTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectModifyTokenCount id="DryadHuntressAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <EffectCategory index="Quest" value="1" />
    <TokenId value="DryadHuntressTokenCounter" />
  </CEffectModifyTokenCount>
  <CEffectSet id="DryadCripplingSporesImpactSet">
    <EffectArray value="DryadHuntressAddToken" />
  </CEffectSet>
  <CAccumulatorToken id="DryadHuntressAccumulator" parent="BaseAccumulator">
    <SourceEffect value="DryadHeroWeaponDamage" />
    <ApplicationRule value="Add" />
    <TokenId value="DryadHuntressTokenCounter" />
    <Scale value="0.3" />
    <MaxAccumulation value="100000" />
  </CAccumulatorToken>
  <CEffectDamage id="DryadHeroWeaponDamage">
    <MultiplicativeModifierArray index="PoisonerPenalty" Validator="DryadHasPoisoner" Modifier="-0.9" />
    <Amount>
      <AccumulatorArray value="DryadHuntressAccumulator" />
    </Amount>
  </CEffectDamage>
  <CEffectDamage id="DryadHeroWeaponDamageSplinteredSpearMastery">
    <MultiplicativeModifierArray index="PoisonerPenalty" Validator="DryadHasPoisoner" Modifier="-0.9" />
    <Amount>
      <AccumulatorArray value="DryadHuntressAccumulator" />
    </Amount>
  </CEffectDamage>

  <!-- Pollinator: Noxious Blossom hitting enemy Heroes grants stacks; stacks add Noxious Blossom damage -->
  <CBehaviorTokenCounter id="DryadPollinatorTokenCounter" parent="StormQuestToken">
    <Face value="DryadPollinatorTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectModifyTokenCount id="DryadPollinatorAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <EffectCategory index="Quest" value="1" />
    <TokenId value="DryadPollinatorTokenCounter" />
  </CEffectModifyTokenCount>
  <CEffectSet id="DryadNoxiousBlossomImpactSet">
    <EffectArray value="DryadPollinatorAddToken" />
  </CEffectSet>
  <CAccumulatorToken id="DryadPollinatorAccumulator" parent="BaseAccumulator">
    <SourceEffect value="DryadNoxiousBlossomDamage" />
    <ApplicationRule value="Add" />
    <TokenId value="DryadPollinatorTokenCounter" />
    <Scale value="0.01" />
    <MaxAccumulation value="100000" />
  </CAccumulatorToken>
  <CEffectDamage id="DryadNoxiousBlossomDamage">
    <MultiplicativeModifierArray index="Pollinator" Accumulator="DryadPollinatorAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="DryadNoxiousBlossomChokingPollenMasteryDamage">
    <MultiplicativeModifierArray index="Pollinator" Accumulator="DryadPollinatorAccumulator" />
  </CEffectDamage>

  <!-- Pollinator reward: Noxious Blossom explodes a second time 1 second later. Reruns the whole delayed
       blossom so the second explosion has its visuals -->
  <CBehaviorBuff id="DryadPollinatorSecondBloom" parent="CarryBehaviorParent" />
  <CValidatorUnitCompareBehaviorCount id="DryadHasPollinatorSecondBloom">
    <WhichUnit Value="Caster" />
    <Behavior value="DryadPollinatorSecondBloom" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectCreatePersistent id="DryadPollinatorSecondBloomPersistent">
    <ValidatorArray value="DryadHasPollinatorSecondBloom" />
    <InitialDelay value="1" />
    <PeriodCount value="1" />
    <PeriodicEffectArray value="DryadNoxiousBlossomCreatePersistent" />
    <PeriodicPeriodArray value="0" />
  </CEffectCreatePersistent>
  <CEffectSet id="DryadNoxiousBlossomCastSet">
    <EffectArray value="DryadPollinatorSecondBloomPersistent" />
  </CEffectSet>

  <CButton id="DryadPoisonerTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_lunara_pollencloud_b.dds" />
  </CButton>
  <CButton id="DryadHuntressTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Lunara_WildSpear.dds" />
  </CButton>
  <CButton id="DryadPollinatorTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_lunara_fullbloom.dds" />
  </CButton>
</Catalog>
