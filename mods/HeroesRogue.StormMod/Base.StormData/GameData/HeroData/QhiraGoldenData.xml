<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Qhira. Starters: Whirling Huntress (Revolving Sweep: 8 second cooldown, 25 Mana, Booming Kick and Lingering Ailment), Grapple Hunter (Grappling Hook: 2 charges, 8 second recharge, 3x damage, Utility Belt and Upstage) and Bounty Hunter (one enemy Hero at a time is the Bounty: 2x damage to it, 90% less to other Heroes; Final Strike at level 1). Each damage effect has its own multipliers: starter power, the Uncommon boon, hit quest (accumulator) and takedown quest past its cap; the 3x is a LibAffx multiplier, and the 2x and 0.1x are attacker damage responses on Qhira (both multiply everything else). Hits, quests and script boons are in HeroTriggers/QhiraGolden.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="QhiraWhirlMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="QhiraGrappleMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="QhiraBountyMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="QhiraHuntersMarkMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="QhiraDoubleContractMarker" parent="CarryBehaviorParent" />

  <!-- ===== Whirling Huntress ===== -->
  <!-- Revolving Sweep has an 8 second cooldown (16) and costs 25 Mana (70); gain Booming Kick and Lingering Ailment. Whirl quest (25% of each map gains kept for good): 1% Revolving Sweep damage per enemy Hero hit (once per Hero per cast). Huntress quest: takedowns within 6 seconds of a hit; stacks 1-40 Slow the attached Hero 1% each while Qhira swings, 41-80 add 1% bleed damage while swinging each, 81-100 heal 1% of maximum Health per stack over each swing, at 100 the attached Hero is Stunned while she swings (script), then 2% damage each. -->
  <CBehaviorTokenCounter id="QhiraGoldenWhirlTokenCounter" parent="StormQuestToken">
    <Face value="QhiraGoldenWhirlTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="QhiraGoldenHuntressTokenCounter" parent="StormQuestToken">
    <Face value="QhiraGoldenHuntressTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="QhiraGoldenWhirlTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="QhiraGoldenWhirlTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="NexusHunterRevolvingSweepInitialDamage">
    <MultiplicativeModifierArray index="QhiraWhirlPower" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraWhirlCommon" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraWhirlHit" Accumulator="QhiraGoldenWhirlTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="QhiraWhirlLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="NexusHunterRevolvingSweepPersistentDamage">
    <MultiplicativeModifierArray index="QhiraWhirlPower" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraWhirlCommon" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraWhirlHit" Accumulator="QhiraGoldenWhirlTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="QhiraWhirlLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="NexusHunterRevolvingSweepFinalDamage">
    <MultiplicativeModifierArray index="QhiraWhirlPower" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraWhirlCommon" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraWhirlHit" Accumulator="QhiraGoldenWhirlTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="QhiraWhirlLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="QhiraGoldenWhirlTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_nexushunter_e.dds" />
  </CButton>
  <CButton id="QhiraGoldenHuntressTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_nexushunter_e.dds" />
  </CButton>

  <!-- ===== Grapple Hunter ===== -->
  <!-- Grappling Hook stores 2 charges (8 second recharge, from a 20 second cooldown) and deals 3x damage (a LibAffx multiplier: it multiplies the hit quest and boons too); gain Utility Belt and Upstage. Hookshot quest (25% of each map gains kept for good): 2.5% Grappling Hook and Basic Attack damage per enemy Hero hit (Basic Attacks through their own accumulator entries). Snare quest: takedowns within 6 seconds of a hit; stacks 1-40 make Grappling Hook recharge 1% faster each, 41-80 make the hook fly 1% faster and 1% wider each, 81-100 make a hook hit on an enemy Hero Shield Qhira for 1% of her maximum Health each until it breaks (script), at 100 arriving on a Hero sets off a free Revolving Sweep (script), then 2% damage each. -->
  <CBehaviorTokenCounter id="QhiraGoldenHookshotTokenCounter" parent="StormQuestToken">
    <Face value="QhiraGoldenHookshotTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="QhiraGoldenSnareTokenCounter" parent="StormQuestToken">
    <Face value="QhiraGoldenSnareTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="QhiraGoldenHookshotTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="QhiraGoldenHookshotTokenCounter" />
    <Scale value="0.025" />
  </CAccumulatorToken>
  <CEffectDamage id="NexusHunterGrapplingHookDamage">
    <MultiplicativeModifierArray index="QhiraGrapplePower" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraGrappleCommon" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraGrappleHit" Accumulator="QhiraGoldenHookshotTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="QhiraGrappleLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="NexusHunterGrapplingHookKickDamage">
    <MultiplicativeModifierArray index="QhiraGrapplePower" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraGrappleCommon" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraGrappleHit" Accumulator="QhiraGoldenHookshotTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="QhiraGrappleLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="QhiraGoldenHookshotTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_nexushunter_d.dds" />
  </CButton>
  <CButton id="QhiraGoldenSnareTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_nexushunter_d.dds" />
  </CButton>

  <!-- ===== Bounty Hunter ===== -->
  <!-- A random enemy Hero (not the last Bounty, if possible) becomes the Bounty until it dies or Qhira dies (marked with Butcher's brand and revealed): Qhira deals 2x damage to it and 0.1x to other enemy Heroes, and takes 35% less damage from everything else (damage responses on all her damage, so they multiply everything else; minions, camps and structures are unchanged); a Bounty takedown heals her to full and picks a new Bounty; Final Strike at level 1 (no Unrelenting Strikes); 15% Movement Speed while facing a Bounty within 15 (script, every 0.25 seconds, 60 degree cone); +80% Mount Speed. Blood Money quest (25% of each map gains kept for good): 1% more Blood Rage bleed damage (against every target) per hit on the Bounty (not bleed or Revolving Sweep ticks), added in batches of 10. Trophies quest (100% kept): Bounty takedowns (script); stacks 1-40 Slow the Bounty 1% each, 41-80 drain up to 1% of its maximum Health per second (both only while Qhira is within 15 of it), 81-100 add 1% life leech against it each (script), at 100 instant mount, no dismount from damage and 75 Armor while mounted (script), then 2% damage each. -->
  <CBehaviorTokenCounter id="QhiraGoldenBloodMoneyTokenCounter" parent="StormQuestToken">
    <Face value="QhiraGoldenBloodMoneyTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="QhiraGoldenTrophyTokenCounter" parent="StormQuestToken">
    <Face value="QhiraGoldenTrophyTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="QhiraGoldenBloodMoneyTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="QhiraGoldenBloodMoneyTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="NexusHunterWeaponDamage">
    <MultiplicativeModifierArray index="QhiraBountyPower" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraBountyCommon" Modifier="0" />
    <MultiplicativeModifierArray index="QhiraBountyLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="QhiraGoldenBloodMoneyTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_nexushunter_passive_alt_1.dds" />
  </CButton>
  <CButton id="QhiraGoldenTrophyTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_nexushunter_passive_alt_1.dds" />
  </CButton>
  <!-- Whirling Huntress: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="QhiraWhirlPastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Grapple Hunter: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="QhiraGrapplePastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Bounty Hunter: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="QhiraBountyPastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>

  <!-- ===== Boons ===== -->
  <!-- ===== Whirling Huntress ===== -->
  <!-- Huntress 1-40: the attached Hero is Slowed while Qhira swings around it (the quest sets the amount) -->
  <CBehaviorBuff id="QhiraGoldenSweepSlow" parent="StormSlowParent">
    <Duration value="3600" />
    <RemoveValidatorArray value="NexusHunterRevolvingSweepCasterHasMainBehavior" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="QhiraGoldenSweepSlowApply">
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="QhiraGoldenSweepSlow" />
  </CEffectApplyBehavior>
  <!-- Huntress at 100: the attached Hero is Stunned while Qhira swings around it (the script turns it on) -->
  <CBehaviorBuff id="QhiraGoldenSweepHold" parent="StormStun">
    <Duration value="3600" />
    <RemoveValidatorArray value="NexusHunterRevolvingSweepCasterHasMainBehavior" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="QhiraGoldenSweepHoldApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="QhiraGoldenSweepHold" />
  </CEffectApplyBehavior>
  <!-- Huntress 81-100: Qhira heals while swinging, 1% of her maximum Health per stack over the 2.75 second swing (11
       ticks; the quest sets the amount) -->
  <CEffectModifyUnit id="QhiraGoldenSwingHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0" />
    </VitalArray>
  </CEffectModifyUnit>
  <CBehaviorBuff id="QhiraGoldenSwingHealBuff">
    <Duration value="3600" />
    <Period value="0.25" />
    <PeriodicEffect value="QhiraGoldenSwingHeal" />
    <RemoveValidatorArray value="NexusHunterRevolvingSweepCasterHasMainBehavior" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="QhiraGoldenSwingHealApply">
    <WhichUnit Value="Caster" />
    <Behavior value="QhiraGoldenSwingHealBuff" />
  </CEffectApplyBehavior>
  <!-- Rending Rotation (Epic): the attached Hero loses 4% of its maximum Health per second while Qhira swings
       around it (1% every 0.25 seconds; Chance 0, the boon turns it on) -->
  <CEffectDamage id="QhiraGoldenSwingRendDamage" parent="StormSpellPercentDamage">
    <ValidatorArray value="TargetIsHero" />
    <VitalFractionMax index="Life" value="0.01" />
    <SourceButtonFace value="NexusHunterRevolvingSweep" />
  </CEffectDamage>
  <CBehaviorBuff id="QhiraGoldenSwingRend">
    <Alignment value="Negative" />
    <Duration value="3600" />
    <Period value="0.25" />
    <PeriodicEffect value="QhiraGoldenSwingRendDamage" />
    <RemoveValidatorArray value="NexusHunterRevolvingSweepCasterHasMainBehavior" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="QhiraGoldenSwingRendApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="QhiraGoldenSwingRend" />
  </CEffectApplyBehavior>
  <!-- the attach: after the base effects (Qhira has her swing behavior by then) -->
  <CEffectSet id="NexusHunterRevolvingSweepImpactSet">
    <EffectArray value="QhiraGoldenSwingRendApply" />
    <EffectArray value="QhiraGoldenSweepSlowApply" />
    <EffectArray value="QhiraGoldenSweepHoldApply" />
    <EffectArray value="QhiraGoldenSwingHealApply" />
  </CEffectSet>
  <!-- Huntress 41-80: Blood Rage's bleed deals more damage while Qhira swings (the quest sets the amount) -->
  <CEffectDamage id="NexusHunterBloodRageDoTDamage">
    <MultiplicativeModifierArray index="QhiraGoldenSwingBleed" Validator="NexusHunterRevolvingSweepCasterHasMainBehavior" Modifier="0" />
  </CEffectDamage>
  <!-- Bloody Whirl (charges): the swing's cooldown reductions also work on charges -->
  <CEffectModifyUnit id="NexusHunterRevolvingSweepSwingLifeAwayCooldownReduction">
    <Cost Abil="NexusHunterRevolvingSweep,Execute" CooldownOperation="Add" CooldownTimeUse="-0.1562" ChargeTimeUse="-0.1562" />
  </CEffectModifyUnit>
  <CEffectModifyUnit id="NexusHunterRevolvingSweepFuelTheFireCDR">
    <Cost Abil="NexusHunterRevolvingSweep,Execute" CooldownOperation="Add" CooldownTimeUse="-2" ChargeTimeUse="-2" />
  </CEffectModifyUnit>
  <!-- ===== Grapple Hunter ===== -->
  <!-- Snare 81-100: hooking an enemy Hero Shields Qhira until the Shield breaks (the script sets the amount) -->
  <CBehaviorBuff id="QhiraGoldenHookShield" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_nexushunter_d.dds" />
    <Duration value="0" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <!-- Hookshot (hit quest): Basic Attacks get the same bonus as Grappling Hook -->
  <CEffectDamage id="NexusHunterWeaponDamage">
    <MultiplicativeModifierArray index="QhiraGrappleHitAttack" Accumulator="QhiraGoldenHookshotTokenCounterAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="NexusHunterPureStrikesWeaponDamage">
    <MultiplicativeModifierArray index="QhiraGrappleHitAttack" Accumulator="QhiraGoldenHookshotTokenCounterAccumulator" />
  </CEffectDamage>
  <!-- Anchor Point (Epic): a hooked Hero is Slowed by 75% for 1.5 seconds (Chance 0, the boon turns it on) -->
  <CBehaviorBuff id="QhiraGoldenAnchorSlow" parent="StormSlowParent">
    <Duration value="1.5" />
    <Modification>
      <UnifiedMoveSpeedFactor value="-0.75" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="QhiraGoldenAnchorApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="QhiraGoldenAnchorSlow" />
  </CEffectApplyBehavior>
  <CEffectSet id="NexusHunterGrapplingHookUnitSearchImpactSet">
    <EffectArray value="QhiraGoldenAnchorApply" />
  </CEffectSet>
  <!-- Chain Grapple (Legendary): arriving on the hooked Hero Stuns it for 0.75 seconds and makes Qhira Unstoppable for 2
       seconds (Chance 0, the boon turns it on) -->
  <CBehaviorBuff id="QhiraGoldenChainStun" parent="StormStun">
    <Duration value="0.75" />
  </CBehaviorBuff>
  <CBehaviorBuff id="QhiraGoldenChainUnstoppable" parent="StormUnstoppableParent">
    <Duration value="2" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="QhiraGoldenChainStunApply">
    <Behavior value="QhiraGoldenChainStun" />
  </CEffectApplyBehavior>
  <CEffectApplyBehavior id="QhiraGoldenChainUnstoppableApply">
    <WhichUnit Value="Caster" />
    <Behavior value="QhiraGoldenChainUnstoppable" />
  </CEffectApplyBehavior>
  <CEffectSet id="QhiraGoldenChainSet">
    <Chance value="0" />
    <EffectArray value="QhiraGoldenChainStunApply" />
    <EffectArray value="QhiraGoldenChainUnstoppableApply" />
  </CEffectSet>
  <CEffectSet id="NexusHunterGrapplingHookDamageSet">
    <EffectArray value="QhiraGoldenChainSet" />
  </CEffectSet>
  <!-- ===== Bounty Hunter ===== -->
  <!-- the Bounty: marked (Butcher's brand) and revealed; the script picks it -->
  <CBehaviorBuff id="QhiraGoldenBounty">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_nexushunter_passive_alt_1.dds" />
    <InfoFlags index="Hidden" value="0" />
    <Period value="0.5" />
    <PeriodicEffect value="QhiraGoldenBountyRevealApply" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="QhiraGoldenBountyRevealApply">
    <Behavior value="QhiraGoldenBountyRevealed" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="QhiraGoldenBountyRevealed" parent="StormReveal">
    <Duration value="0.75" />
  </CBehaviorBuff>
  <CActorModel id="QhiraGoldenBountyMark" parent="StormModelAnimationStyleContinuousUnit">
    <On Terms="Behavior.QhiraGoldenBounty.On" Send="Create" />
    <On Terms="Behavior.QhiraGoldenBounty.Off" Send="Destroy" />
    <Model value="ButcherButchersBrandDebuffLoud" />
    <HostSiteOps Ops="SOpAttachOverhead" />
  </CActorModel>
  <CValidatorUnitCompareBehaviorCount id="QhiraGoldenTargetIsBounty">
    <WhichUnit Value="Target" />
    <Compare value="GT" />
    <Value value="0" />
    <Behavior value="QhiraGoldenBounty" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="QhiraGoldenTargetNotBounty">
    <WhichUnit Value="Target" />
    <Compare value="EQ" />
    <Value value="0" />
    <Behavior value="QhiraGoldenBounty" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorCombine id="QhiraGoldenTargetIsOtherHero">
    <Type value="And" />
    <CombineArray value="TargetIsHero" />
    <CombineArray value="QhiraGoldenTargetNotBounty" />
  </CValidatorCombine>
  <!-- Bounty Hunter: Qhira's damage to the Bounty is multiplied by 2 (the script folds in Contract and re-adds it) and to other enemy Heroes by 0.1. Attacker damage responses act on the final damage, so they multiply
       every other bonus. -->
  <CBehaviorBuff id="QhiraGoldenBountyHunt" parent="CarryBehaviorParent">
    <DamageResponse>
      <Chance value="1" />
      <Location value="Attacker" />
      <ModifyFraction value="2" />
      <ValidatorArray value="QhiraGoldenTargetIsBounty" />
    </DamageResponse>
  </CBehaviorBuff>
  <!-- Blood Money (hit quest): Blood Rage's bleed deals 1% more damage per stack, against every target -->
  <CEffectDamage id="NexusHunterBloodRageDoTDamage">
    <MultiplicativeModifierArray index="QhiraBountyHit" Accumulator="QhiraGoldenBloodMoneyTokenCounterAccumulator" />
  </CEffectDamage>
  <!-- Bounty Hunter: Qhira takes 35% less damage from anything but the Bounty (the effect's caster is the attacker) -->
  <CValidatorUnitCompareBehaviorCount id="QhiraGoldenAttackerNotBounty">
    <WhichUnit Value="Caster" />
    <Compare value="EQ" />
    <Value value="0" />
    <Behavior value="QhiraGoldenBounty" />
  </CValidatorUnitCompareBehaviorCount>
  <CBehaviorBuff id="QhiraGoldenBountyGuard" parent="CarryBehaviorParent">
    <DamageResponse>
      <Chance value="1" />
      <ModifyFraction value="0.65" />
      <ValidatorArray value="QhiraGoldenAttackerNotBounty" />
    </DamageResponse>
  </CBehaviorBuff>
  <CBehaviorBuff id="QhiraGoldenBountyFocus" parent="CarryBehaviorParent">
    <DamageResponse>
      <Chance value="1" />
      <Location value="Attacker" />
      <ModifyFraction value="0.1" />
      <ValidatorArray value="QhiraGoldenTargetIsOtherHero" />
    </DamageResponse>
  </CBehaviorBuff>
  <!-- Contract (Uncommon): its stacks are kept here (never counted) and the script folds them into the Bounty multiplier -->
  <CEffectDamage id="NexusHunterWeaponDamage">
    <MultiplicativeModifierArray index="QhiraContract" Validator="GoldenMultNever" Modifier="0" />
  </CEffectDamage>
  <!-- Trophies 1-40: the Bounty is Slowed (the quest sets the amount; the script re-adds it) -->
  <CBehaviorBuff id="QhiraGoldenBountySlow" parent="StormSlowParent">
    <Duration value="0" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Trophies 41-80: the Bounty loses up to 1% of its maximum Health per second (the script casts it every second) -->
  <CEffectDamage id="QhiraGoldenBountyDrain" parent="StormSpellPercentDamage">
    <ValidatorArray value="TargetIsHero" />
    <VitalFractionMax index="Life" value="0" />
    <SourceButtonFace value="NexusHunterHuntersVengeanceNoSanctuary" />
  </CEffectDamage>
  <!-- Hunter's Mark (Epic): the Bounty deals 30% less damage -->
  <CBehaviorBuff id="QhiraGoldenBountyWeaken">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_nexushunter_passive_alt_1.dds" />
    <InfoFlags index="Hidden" value="0" />
    <BehaviorCategories index="DebuffAbilityPower" value="1" />
    <BehaviorCategories index="DebuffAutoattackDPS" value="1" />
    <Modification>
      <DamageDealtFraction index="Splash" value="-0.3" />
      <DamageDealtFraction index="Basic" value="-0.3" />
      <DamageDealtFraction index="Ability" value="-0.3" />
    </Modification>
  </CBehaviorBuff>
  <!-- Bounty Hunter: 15% Movement Speed while Qhira faces a Bounty within 15 (the script adds and removes it) -->
  <CBehaviorBuff id="QhiraGoldenBountyChase" parent="CarryBehaviorParent">
    <Modification>
      <UnifiedMoveSpeedFactor value="0.15" />
    </Modification>
  </CBehaviorBuff>
  <!-- Bounty Hunter: +80% Mount Speed (the mount's own bonus is 30%; the highest bonus counts) -->
  <CBehaviorBuff id="QhiraGoldenBountyMount" parent="CarryBehaviorParent">
    <DisableValidatorArray value="IsMounted" />
    <Modification>
      <UnifiedMoveSpeedFactor value="1.1" />
    </Modification>
  </CBehaviorBuff>
  <!-- Trophies at 100: damage doesn't dismount Qhira, and she has 75 Armor while mounted (the script adds the buff; the
       mount's cast time is set to 0 by the script) -->
  <CBehaviorBuff id="QhiraGoldenSteadyMount" parent="StormArmor">
    <BehaviorFlags index="Permanent" value="1" />
    <DisableValidatorArray value="IsMounted" />
    <ArmorModification>
      <AllArmorBonus value="75" />
    </ArmorModification>
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="QhiraGoldenCasterSteadyMount">
    <WhichUnit Value="Caster" />
    <Compare value="GT" />
    <Value value="0" />
    <Behavior value="QhiraGoldenSteadyMount" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorCombine id="NotinCombatorHasSwiftStormCombine">
    <CombineArray value="QhiraGoldenCasterSteadyMount" />
  </CValidatorCombine>
</Catalog>
