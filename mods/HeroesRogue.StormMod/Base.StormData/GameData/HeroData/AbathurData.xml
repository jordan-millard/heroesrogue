<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Abathur, Minefield: Toxic Nests are no longer cast. HeroTriggers/Abathur.galaxy drops one under Abathur on a timer
       (every 3 seconds, 2 with Rapid Gestation, 0.5 during Frenzy). Nest lifetime, Health and arming time are
       set in AffixData.xml. Both quests are counted in the script; their damage is applied here. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="AbathurMinefieldMarker" parent="CarryBehaviorParent">
    <Modification>
      <AbilLinkDisableArray value="AbathurToxicNest" />
      <AbilLinkDisableArray value="AbathurSymbiote" />
    </Modification>
  </CBehaviorBuff>
  <!-- Rapid Gestation (Rare): nests drop every 2 seconds instead of 3 -->
  <CBehaviorBuff id="AbathurRapidGestationMarker" parent="CarryBehaviorParent" />
  <!-- Parasitic Slap (Epic): Slapathur's Stun on a Hero drops a nest under them (script) -->
  <CBehaviorBuff id="AbathurParasiticSlapMarker" parent="CarryBehaviorParent" />
  <!-- Endless Hive (Legendary): Frenzy no longer removes Abathur's nests (script) -->
  <CBehaviorBuff id="AbathurEndlessHiveMarker" parent="CarryBehaviorParent" />

  <!-- 15% Movement Speed for 1.5 seconds after each dropped nest (re-applied by the script on every drop). A
       multiplier, so it stacks with other Movement Speed bonuses instead of only the highest counting -->
  <CBehaviorBuff id="AbathurMinefieldDropSpeed">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_abathur_toxicNest.dds" />
    <Duration value="1.5" />
    <Modification>
      <MoveSpeedMultiplier value="1.15" />
    </Modification>
  </CBehaviorBuff>
  <!-- Chitinous Bulwark (level 4 talent): each enemy Hero hit by a nest explosion adds a 5% max Health shield stack
       (up to 6) that doesn't expire, the same way Falstad's Wildhammer's Bulwark stacks -->
  <CBehaviorBuff id="AbathurMinefieldShield" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_abathur_carapace.dds" />
    <MaxStackCount value="6" />
    <DamageResponse>
      <ModifyLimitVitalMaxFractionArray index="Life" value="0.05" />
    </DamageResponse>
  </CBehaviorBuff>

  <!-- Hit quest: each token is 1% Toxic Nest damage (2 per enemy Hero hit) -->
  <CBehaviorTokenCounter id="AbathurMinefieldTokenCounter" parent="StormQuestToken">
    <Face value="AbathurMinefieldTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="AbathurMinefieldPercentAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="AbathurMinefieldTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <!-- Slapathur quest: each token is 2 flat Toxic Nest damage, plus 30 maximum Health from AbathurSlapathurQuestLife
       (one stack per token), 1% Slapathur Stun duration and 3% Locust Health, all applied by the script -->
  <CBehaviorBuff id="AbathurSlapathurQuestLife" parent="CarryBehaviorParent">
    <MaxStackCount value="10000" />
    <Modification>
      <VitalMaxArray index="Life" value="30" />
    </Modification>
  </CBehaviorBuff>
  <CBehaviorTokenCounter id="AbathurMinefieldTakedownTokenCounter" parent="StormQuestToken">
    <Face value="AbathurMinefieldTakedownTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>

  <CAccumulatorToken id="AbathurMinefieldFlatAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="AbathurMinefieldTakedownTokenCounter" />
    <Scale value="2" />
  </CAccumulatorToken>

  <CEffectDamage id="ToxicNestDamage">
    <FlatModifierArray index="AbathurMinefield" Accumulator="AbathurMinefieldFlatAccumulator" />
    <MultiplicativeModifierArray index="AbathurMinefield" Accumulator="AbathurMinefieldPercentAccumulator" />
  </CEffectDamage>

  <!-- 75 Spell Armor on every new Toxic Nest. The spawn effect becomes a set that still arms the nest; the armor is
       only enabled for the starter. -->
  <CBehaviorBuff id="AbathurMinefieldNestSpellArmor" parent="StormArmor">
    <BehaviorFlags index="Permanent" value="1" />
    <ArmorModification>
      <ArmorSet index="Hero">
        <ArmorMitigationTable index="Ability" value="75" />
      </ArmorSet>
      <ArmorSet index="Merc">
        <ArmorMitigationTable index="Ability" value="75" />
      </ArmorSet>
      <ArmorSet index="Monster">
        <ArmorMitigationTable index="Ability" value="75" />
      </ArmorSet>
      <ArmorSet index="Summon">
        <ArmorMitigationTable index="Ability" value="75" />
      </ArmorSet>
      <ArmorSet index="Structure">
        <ArmorMitigationTable index="Ability" value="75" />
      </ArmorSet>
      <ArmorSet index="Minion">
        <ArmorMitigationTable index="Ability" value="75" />
      </ArmorSet>
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AbathurMinefieldApplyNestSpellArmor">
    <Chance value="0" />
    <Behavior value="AbathurMinefieldNestSpellArmor" />
  </CEffectApplyBehavior>
  <CEffectSet id="AbathurMinefieldNestSpawnSet">
    <EffectArray value="AbathurToxicNestApplyArmingBehavior" />
    <EffectArray value="AbathurMinefieldApplyNestSpellArmor" />
  </CEffectSet>
  <CEffectCreateUnit id="ToxicNestCreateUnit">
    <SpawnEffect value="AbathurMinefieldNestSpawnSet" />
  </CEffectCreateUnit>

  <!-- Frenzy: Minefield's Heroic, available from level 1 (the starter grants AbathurMinefieldFrenzyUnlocked). It replaces
       Ultimate Evolution and Evolve Monstrosity, which the starter disables. 3 seconds of Unstoppable; the script drops a
       nest every 0.5 seconds meanwhile. 4 seconds, 90 second cooldown; activating it removes all of Abathur's nests.
       The level 10 talents Prolonged Frenzy and Overgrowth upgrade it. -->
  <CBehaviorBuff id="AbathurMinefieldFrenzyUnlocked">
    <BehaviorFlags index="Permanent" value="1" />
    <BehaviorFlags index="EnabledWhileDead" value="1" />
  </CBehaviorBuff>
  <CRequirementCountBehavior id="CountBehaviorAbathurMinefieldFrenzyUnlockedAtUnit">
    <Flags index="TechTreeCheat" value="0" />
    <Count Link="AbathurMinefieldFrenzyUnlocked" State="CompleteOnlyAtUnit" />
  </CRequirementCountBehavior>
  <CRequirementGTE id="GTECountBehaviorAbathurMinefieldFrenzyUnlockedAtUnit1">
    <OperandArray index="0" value="CountBehaviorAbathurMinefieldFrenzyUnlockedAtUnit" />
    <OperandArray index="1" value="1" />
  </CRequirementGTE>
  <CRequirement id="AbathurMinefieldFrenzyUnlocked">
    <NodeArray index="Use" Link="EqCountBehaviorHeroGenericPregameAbilitySuppressionCompleteOnlyAtUnit0" />
    <NodeArray index="Show" Link="GTECountBehaviorAbathurMinefieldFrenzyUnlockedAtUnit1" />
  </CRequirement>
  <CAbilEffectInstant id="AbathurMinefieldFrenzy">
    <Effect value="AbathurMinefieldFrenzySet" />
    <Cost>
      <Cooldown TimeUse="90" />
    </Cost>
    <CmdButtonArray index="Execute" DefaultButtonFace="AbathurMinefieldFrenzy" Requirements="AbathurMinefieldFrenzyUnlocked" />
  </CAbilEffectInstant>
  <CEffectSet id="AbathurMinefieldFrenzySet">
    <EffectArray value="AbathurMinefieldFrenzyApplyUnstoppable" />
    <EffectArray value="AbathurMinefieldFrenzyApplyBuff" />
    <EffectArray value="AbathurMinefieldFrenzyApplySpeed" />
  </CEffectSet>
  <CBehaviorBuff id="AbathurMinefieldFrenzyUnstoppable" parent="StormUnstoppableParent">
    <Duration value="4" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AbathurMinefieldFrenzyApplyUnstoppable">
    <WhichUnit Value="Caster" />
    <Behavior value="AbathurMinefieldFrenzyUnstoppable" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="AbathurMinefieldFrenzyBuff">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_abathur_toxicNest.dds" />
    <Duration value="4" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AbathurMinefieldFrenzyApplyBuff">
    <WhichUnit Value="Caster" />
    <Behavior value="AbathurMinefieldFrenzyBuff" />
  </CEffectApplyBehavior>
  <!-- Prolonged Frenzy only: 30% Movement Speed for the (6 second) Frenzy -->
  <CBehaviorBuff id="AbathurMinefieldFrenzySpeed">
    <Alignment value="Positive" />
    <Duration value="6" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0.3" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="AbathurMinefieldFrenzyApplySpeed">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="AbathurMinefieldFrenzySpeed" />
  </CEffectApplyBehavior>
  <CButton id="AbathurMinefieldFrenzy" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_abathur_evolvemonstrosity.dds" />
  </CButton>
  <!-- Level 10 talents. Prolonged Frenzy: +2 seconds and 30% Movement Speed. Overgrowth: 120 second cooldown and 1 second
       shorter; Frenzy drops about 22 nests (script) that only last 30 seconds. -->
  <CBehaviorBuff id="AbathurOvergrowthNestLifetime">
    <Duration value="30" />
    <DisplayDuration index="Self" value="1" />
    <DisplayDuration index="Ally" value="1" />
    <ExpireEffect value="ToxicNestSuicideSet" />
  </CBehaviorBuff>
  <CTalent id="AbathurProlongedFrenzy">
    <Face value="AbathurProlongedFrenzy" />
    <Abil value="AbathurMinefieldFrenzy" />
    <AbilityModificationArray>
      <Modifications>
        <Type value="FlatModification" />
        <Catalog value="Behavior" />
        <Entry value="AbathurMinefieldFrenzyUnstoppable" />
        <Field value="Duration" />
        <Value value="2.000000" />
      </Modifications>
      <Modifications>
        <Type value="FlatModification" />
        <Catalog value="Behavior" />
        <Entry value="AbathurMinefieldFrenzyBuff" />
        <Field value="Duration" />
        <Value value="2.000000" />
      </Modifications>
      <Modifications>
        <Type value="FlatModification" />
        <Catalog value="Effect" />
        <Entry value="AbathurMinefieldFrenzyApplySpeed" />
        <Field value="Chance" />
        <Value value="1.000000" />
      </Modifications>
    </AbilityModificationArray>
  </CTalent>
  <CButton id="AbathurProlongedFrenzy" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_abathur_evolvemonstrosity.dds" />
  </CButton>
  <CTalent id="AbathurOvergrowth">
    <Face value="AbathurOvergrowth" />
    <Abil value="AbathurMinefieldFrenzy" />
    <AbilityModificationArray>
      <Modifications>
        <Type value="FlatModification" />
        <Catalog value="Behavior" />
        <Entry value="AbathurMinefieldFrenzyUnstoppable" />
        <Field value="Duration" />
        <Value value="-1.000000" />
      </Modifications>
      <Modifications>
        <Type value="FlatModification" />
        <Catalog value="Behavior" />
        <Entry value="AbathurMinefieldFrenzyBuff" />
        <Field value="Duration" />
        <Value value="-1.000000" />
      </Modifications>
      <Modifications>
        <Type value="FlatModification" />
        <Catalog value="Abil" />
        <Entry value="AbathurMinefieldFrenzy" />
        <Field value="Cost[0].Cooldown.TimeUse" />
        <Value value="30.000000" />
      </Modifications>
    </AbilityModificationArray>
  </CTalent>
  <CButton id="AbathurOvergrowth" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_abathur_toxicNest.dds" />
  </CButton>
  <!-- The locked Heroic placeholder (CardLayouts slot 0, requirement UltimateNotUnlocked) only hides for the base
       Ultimate1/2/3Unlocked behaviors or SuppressLockedHeroicButton, so the starter grants the latter. Nothing
       else uses it; make it survive death like the Ultimate behaviors. -->
  <CBehaviorBuff id="SuppressLockedHeroicButton">
    <BehaviorFlags index="Permanent" value="1" />
    <BehaviorFlags index="EnabledWhileDead" value="1" />
  </CBehaviorBuff>
  <CUnit id="HeroAbathur">
    <AbilArray Link="AbathurMinefieldFrenzy" />
    <CardLayouts index="0">
      <LayoutButtons index="30" Face="AbathurMinefieldFrenzy" Type="AbilCmd" AbilCmd="AbathurMinefieldFrenzy,Execute" Slot="Heroic" />
    </CardLayouts>
  </CUnit>

  <!-- Talents shown only with the starter (TalentsShow): Prolonged Frenzy and Overgrowth replace both Heroics, and Chitinous Bulwark and
       Nesting Instinct fill the level 4 and level 13 tiers, which lose every other talent once the Symbiote talents are
       disabled. Both are handled in HeroTriggers/Abathur.galaxy. -->
  <CTalent id="AbathurChitinousBulwark">
    <Face value="AbathurChitinousBulwark" />
  </CTalent>
  <CButton id="AbathurChitinousBulwark" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_abathur_carapace.dds" />
  </CButton>
  <CTalent id="AbathurNestingInstinct">
    <Face value="AbathurNestingInstinct" />
  </CTalent>
  <CButton id="AbathurNestingInstinct" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_abathur_toxicNest.dds" />
  </CButton>
  <CHero id="Abathur">
    <TalentTreeArray Talent="AbathurChitinousBulwark" Tier="2" Column="5" />
    <TalentTreeArray Talent="AbathurProlongedFrenzy" Tier="4" Column="3" />
    <TalentTreeArray Talent="AbathurOvergrowth" Tier="4" Column="4" />
    <TalentTreeArray Talent="AbathurNestingInstinct" Tier="5" Column="4" />
    <!-- The ability bar is built from HeroAbilArray, so Frenzy needs an entry here as well as the command card button -->
    <HeroAbilArray Abil="AbathurMinefieldFrenzy" Button="AbathurMinefieldFrenzy">
      <Flags index="AffectedByCooldownReduction" value="1" />
      <Flags index="Heroic" value="1" />
    </HeroAbilArray>
  </CHero>

  <!-- Locust Strain (Rare): +15% Locust damage; the range is added in AffixData.xml -->
  <CEffectDamage id="AbathurLocustBombardWeaponDamage">
    <MultiplicativeModifierArray index="AbathurLocustStrain" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="AbathurLocustBombardWeaponCloseRangeDamage">
    <MultiplicativeModifierArray index="AbathurLocustStrain" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="AbathurLocustWeaponDamage">
    <MultiplicativeModifierArray index="AbathurLocustStrain" Modifier="0" />
  </CEffectDamage>

  <!-- Minefield drops a nest every few seconds and they never expire, so the owner's spawn, arming and armed-loop sounds
       stack into constant noise. Filter them out for the owner (Self); enemies still hear them, and the explosion
       warning sound is unchanged. -->
  <CActorSound id="AbathurToxicNestSpawnSoundFriendly">
    <Filter index="Self" value="1" />
  </CActorSound>
  <CActorSound id="AbathurToxicNestArmingSound">
    <Filter index="Self" value="1" />
  </CActorSound>
  <CActorSound id="AbathurToxicNestArmedSound">
    <Filter index="Self" value="1" />
  </CActorSound>

  <!-- Burrowed Hunter (Rare): permanent Stealth, the same as Tyrande's Shadowstalker and the base stealth Heroes. Attacks and
       abilities with a decloak prep effect reveal Abathur briefly; nests come from the script, so dropping them doesn't. -->
  <CBehaviorBuff id="AbathurPermanentCloakDisableController" parent="StormPersistentCloakController" />
  <CBehaviorBuff id="AbathurPermanentCloak" parent="StormPersistentCloak">
    <Period value="0.0625" />
    <EnableEffect value="HoldFireApplyInitialBehavior" />
    <DisableEffect value="ApplyGenericDecloakCaster" />
  </CBehaviorBuff>

  <!-- Brutal Slap (Legendary): Slapathur's Stun on a Hero also deals 10% of the Hero's maximum Health. Added to the
       Hero branch, which only runs when the Stun lands (not on the per-Hero internal cooldown, not Unstoppable). -->
  <CEffectDamage id="AbathurBrutalSlapDamage" parent="StormSpell">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <VitalFractionMax index="Life" value="0.1" />
  </CEffectDamage>
  <CEffectSet id="AbathurSlapathurApplyStunSetHero">
    <EffectArray value="AbathurBrutalSlapDamage" />
  </CEffectSet>

  <CButton id="AbathurMinefieldTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_abathur_toxicNest.dds" />
  </CButton>
  <CButton id="AbathurMinefieldTakedownTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_abathur_toxicNest.dds" />
  </CButton>
</Catalog>
