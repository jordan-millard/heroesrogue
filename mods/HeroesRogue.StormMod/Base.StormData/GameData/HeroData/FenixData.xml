  <!-- ===== Plasma Executor ===== -->
  <!-- Plasma Cutter has 2 charges (12 second recharge), deals 20% more damage and its beam is 20% longer (1.4 to 1.68); Divert Power: Weapons and Secondary Fire. Focused Plasma quest (50% kept): 1% Plasma Cutter damage per enemy Hero hit. Execution quest: takedowns within 3 seconds of a hit; stacks 1-40 1% of the recharge each, 41-80 1% beam length each, 81-100 1% faster sweep each, 100 every hit is cut again 0.5 seconds later for 50%, then 2% damage each past 100. -->
  <CBehaviorTokenCounter id="FenixGoldenFocusedPlasmaTokenCounter" parent="StormQuestToken">
    <Face value="FenixGoldenFocusedPlasmaTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
