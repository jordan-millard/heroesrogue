  <!-- ===== Warp Striker ===== -->
  <!-- After a Warp, the next 3 Basic Attacks (up to 7 with Warp Doctrine) deal 50% more damage: each attack fired while
       empowered tags its missile, and a tagged missile's hit adds a second damage of half the attack's (the script copies
       the attacks' Amounts) -->
  <CBehaviorBuff id="FenixGoldenWarpEmpowered">
    <InfoIcon value="Assets\Textures\storm_ui_icon_fenix_teleport.dds" />
    <Alignment value="Positive" />
    <MaxStackCount value="7" />
  </CBehaviorBuff>
  <CBehaviorBuff id="FenixGoldenWarpShotMissile" />
  <CEffectRemoveBehavior id="FenixGoldenWarpEmpoweredClear">
    <WhichUnit Value="Caster" />
    <BehaviorLink value="FenixGoldenWarpEmpowered" />
  </CEffectRemoveBehavior>
  <CEffectApplyBehavior id="FenixGoldenWarpEmpoweredApply">
    <WhichUnit Value="Caster" />
    <Behavior value="FenixGoldenWarpEmpowered" />
    <Count value="3" />
  </CEffectApplyBehavior>
  <CEffectApplyBehavior id="FenixGoldenWarpShotTag">
    <ValidatorArray value="FenixGoldenCasterIsEmpowered" />
    <WhichUnit Value="Source" />
    <Behavior value="FenixGoldenWarpShotMissile" />
  </CEffectApplyBehavior>
  <CEffectRemoveBehavior id="FenixGoldenWarpShotConsume">
    <ValidatorArray value="FenixGoldenCasterIsEmpowered" />
    <WhichUnit Value="Caster" />
    <BehaviorLink value="FenixGoldenWarpEmpowered" />
    <Count value="1" />
  </CEffectRemoveBehavior>
