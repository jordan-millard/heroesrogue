  </CEffectEnumArea>
  <!-- Shield Phase (Epic): arriving with Warp restores 25% of Fenix's Shields -->
  <CEffectModifyUnit id="FenixGoldenShieldPhaseRestore">
    <ValidatorArray value="FenixGoldenCasterHasShieldPhase" />
    <ImpactUnit Value="Caster" />
    <VitalArray index="Shields">
      <ChangeFraction value="0.25" />
    </VitalArray>
  </CEffectModifyUnit>

  <!-- ===== Twin Arsenal ===== -->
  <!-- No weapon swap (Fenix stays on the Repeater Cannon), Shield Capacitor regenerates twice as fast. The script adds a
       Phase Bomb to every 3rd attack. -->
  <CBehaviorBuff id="FenixGoldenTwinArsenal" parent="CarryBehaviorParent">
    <Modification>
      <AbilLinkDisableArray value="FenixPhaseBomb" />
      <VitalRegenMultiplier index="Shields" value="1" />
    </Modification>
  </CBehaviorBuff>
  <!-- Arsenal Mastery stacks 1-40: 0.5% Attack Speed each (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="FenixGoldenTwinSpeed" parent="CarryBehaviorParent">
    <Modification>
      <AdditiveAttackSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- the extra Phase Bomb: Phase Bomb's own launch, without the attack's launch effects -->
  <CEffectSet id="FenixGoldenFreeBombSet">
    <EffectArray value="FenixHeroWeaponPhaseBombLaunchMissile" />
    <EffectArray value="FenixPhaseBombRemoveArsenalSynergyBehavior" />
    <EffectArray value="FenixPhaseBombArsenalSynergyDecrementToken" />
    <EffectArray value="FenixPhaseBombInhibitingEnergyTalentApplyCooldown" />
  </CEffectSet>
  <!-- Capacitors (Common, up to 3): 2% Attack Speed each -->
  <CBehaviorBuff id="FenixGoldenCapacitors" parent="CarryBehaviorParent">
    <MaxStackCount value="3" />
    <Modification>
      <AdditiveAttackSpeedFactor value="0.02" />
    </Modification>
  </CBehaviorBuff>
  <!-- Overload Shells (Epic): Phase Bombs Slow by 25% for 1 second -->
  <CEffectSet id="FenixPhaseBombPrimaryWeaponPostImpactSet">
    <EffectArray value="FenixGoldenOverloadSlowApply" />
  </CEffectSet>
  <CEffectSet id="FenixPhaseBombSplashWeaponPostImpactSet">
    <EffectArray value="FenixGoldenOverloadSlowApply" />
  </CEffectSet>
  <CBehaviorBuff id="FenixGoldenOverloadSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_fenix_w_2.dds" />
    <Duration value="1" />
    <Modification>
      <UnifiedMoveSpeedFactor value="-0.25" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="FenixGoldenOverloadSlowApply" parent="StormSlowApply">
    <ValidatorArray value="FenixGoldenCasterHasOverloadShells" />
    <Behavior value="FenixGoldenOverloadSlow" />
  </CEffectApplyBehavior>
</Catalog>
