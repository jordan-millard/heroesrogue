<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Hogger. Starters: Brute (Staggering Blow: 3 seconds less cooldown, pulls and always Stuns, Basic Attacks on Heroes take 2 seconds off it), Hogwild (Hogg Wild: 2 charges; Pummel, Dust Devil and Bloodthirst) and Hoard King (Hoardapult and Secret Stash at level 1; Meat fills Rage, Rage adds damage, Hoard adds max Rage). Each damage effect has its own multipliers: starter power, hit quest (accumulator) and takedown quest past its cap. Hits, quests and script boons are in HeroTriggers/HoggerGolden.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="HoggerGoldenBruteMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="HoggerGoldenWildMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="HoggerGoldenKingMarker" parent="CarryBehaviorParent" />
  <!-- Brute, Brawn 81-100: Staggering Blow deals 0.5% of Hogger's missing Health per stack as bonus damage (the script sets the
       amount on each cast and turns it on from 81) -->
  <CEffectDamage id="HoggerGoldenBruteMissingDamage" parent="StormSpell">
    <Chance value="0" />
    <Amount value="0" />
  </CEffectDamage>

  <!-- ===== Brute ===== -->
  <!-- Staggering Blow has 3 seconds less cooldown, pulls enemies in instead of knocking them away and Stuns everything it moves when the pull ends; Basic Attacks against enemy Heroes take 2 seconds off it. Swing quest (10% of each map's gains kept for good): 1% Staggering Blow damage per enemy Hero hit. Brawn quest: takedowns within 6 seconds of a Staggering Blow hit; stacks 1-40 make its area 1% larger each, 41-80 make enemy Heroes hit deal 1% less damage each for 3 seconds (script turns it on at 41), 81-100 add 0.5% of Hogger's missing Health as damage each (script), at 100 it kills lane minions (script), then 2% damage each. -->
  <CBehaviorTokenCounter id="HoggerGoldenSwingTokenCounter" parent="StormQuestToken">
    <Face value="HoggerGoldenSwingTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="HoggerGoldenBrawnTokenCounter" parent="StormQuestToken">
    <Face value="HoggerGoldenBrawnTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="HoggerGoldenSwingTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="HoggerGoldenSwingTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="HoggerStaggeringBlowDamage">
    <MultiplicativeModifierArray index="HoggerBrutePower" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteCommon" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteHit" Accumulator="HoggerGoldenSwingTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="HoggerBruteLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="HoggerStaggeringBlowProcDamage">
    <MultiplicativeModifierArray index="HoggerBrutePower" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteCommon" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteHit" Accumulator="HoggerGoldenSwingTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="HoggerBruteLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="HoggerStaggeringBlowHeadbangerTalentDamage">
    <MultiplicativeModifierArray index="HoggerBrutePower" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteCommon" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteHit" Accumulator="HoggerGoldenSwingTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="HoggerBruteLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="HoggerGoldenBruteMissingDamage">
    <MultiplicativeModifierArray index="HoggerBrutePower" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteCommon" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerBruteHit" Accumulator="HoggerGoldenSwingTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="HoggerBruteLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="HoggerGoldenSwingTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_hogger_q.dds" />
  </CButton>
  <CButton id="HoggerGoldenBrawnTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_hogger_q.dds" />
  </CButton>

  <!-- ===== Hogwild ===== -->
  <!-- Hogg Wild stores 2 charges (8 second recharge); gain Pummel, Dust Devil and Bloodthirst. Rampage quest (10% of each map's gains kept for good): 1% Hogg Wild damage per enemy Hero hit, once per Hero per cast. Stampede quest: takedowns within 6 seconds of a Hogg Wild hit; stacks 1-40 make its area 1% larger each, 41-80 make each hit deal 1% more damage (the engine ticks at most 16 times a second, so faster ticks become harder ones), 81-100 Slow enemies hit 1% each for 1 second (script turns it on at 81), at 100 Hogg Wild has no wind-up (script), then 2% damage each. -->
  <CBehaviorTokenCounter id="HoggerGoldenRampageTokenCounter" parent="StormQuestToken">
    <Face value="HoggerGoldenRampageTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="HoggerGoldenStampedeTokenCounter" parent="StormQuestToken">
    <Face value="HoggerGoldenStampedeTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="HoggerGoldenRampageTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="HoggerGoldenRampageTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="HoggerHoggWildDamage">
    <MultiplicativeModifierArray index="HoggerWildPower" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerWildCommon" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerWildHit" Accumulator="HoggerGoldenRampageTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="HoggerWildLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerGoldenWildTempo" Modifier="0" />
  </CEffectDamage>
  <CButton id="HoggerGoldenRampageTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_hogger_e.dds" />
  </CButton>
  <CButton id="HoggerGoldenStampedeTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_hogger_e.dds" />
  </CButton>

  <!-- ===== Hoard King ===== -->
  <!-- Gain Hoardapult and Secret Stash at level 1 (Shockwave can't be picked). Picking up Meat gives 50% of max Rage, and each point of Rage adds 1% to all damage (script). Hoard quest (10% of each map's gains kept for good): 1 per Meat picked up; every 5 add 1 maximum Rage (script). Plunder quest: every enemy Hero takedown (no hit window); stacks 1-40 cut crowd control on Hogger by 1% per 2 current Rage at 40 (up to 75%), 41-80 give 1% Movement Speed per point of Rage at 80, 81-100 give 1% Life Steal per 10 Rage at 100 (each stage grows over its stacks; all script), then 2% damage each. -->
  <CBehaviorTokenCounter id="HoggerGoldenHoardTokenCounter" parent="StormQuestToken">
    <Face value="HoggerGoldenHoardTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="HoggerGoldenPlunderTokenCounter" parent="StormQuestToken">
    <Face value="HoggerGoldenPlunderTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="HoggerGoldenHoardTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="HoggerGoldenHoardTokenCounter" />
    <Scale value="0" />
  </CAccumulatorToken>
  <CEffectDamage id="HoggerLootHoardGroundImpactDamage">
    <MultiplicativeModifierArray index="HoggerKingPower" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerKingCommon" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerKingLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="HoggerHoardapultHoggerGroundImpactDamage">
    <MultiplicativeModifierArray index="HoggerKingPower" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerKingCommon" Modifier="0" />
    <MultiplicativeModifierArray index="HoggerKingLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="HoggerGoldenHoardTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_hogger_trait.dds" />
  </CButton>
  <CButton id="HoggerGoldenPlunderTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_hogger_trait.dds" />
  </CButton>
  <!-- Brute: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="HoggerBrutePastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Hogwild: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="HoggerWildPastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Hoard King: takedown quest stacks past the cap add damage to all of the hero's damage -->
  <CBehaviorBuff id="HoggerKingPastCapDamage" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>

  <!-- ===== Boons ===== -->
  <!-- Brute: Basic Attacks against enemy Heroes take 2 seconds off Staggering Blow's cooldown (Chance 0: the starter turns it
       on) -->
  <CEffectModifyUnit id="HoggerGoldenAttackBlowCooldown">
    <Chance value="0" />
    <ValidatorArray value="CasterNotBlindedAndTargetNotEvading" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="HoggerStaggeringBlow,Execute" CooldownOperation="Add" CooldownTimeUse="-2" />
  </CEffectModifyUnit>
  <CEffectSet id="HoggerWeaponPreImpactSet">
    <EffectArray value="HoggerGoldenAttackBlowCooldown" />
  </CEffectSet>
  <!-- Brute, Brawn 41-80: enemy Heroes hit by Staggering Blow deal 1% less damage per stack for 3 seconds (up to 40%; the
       script turns it on from 41) -->
  <CBehaviorBuff id="HoggerGoldenBruteWeaken">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_hogger_q.dds" />
    <BehaviorCategories index="DebuffAbilityPower" value="1" />
    <BehaviorCategories index="DebuffAutoattackDPS" value="1" />
    <Duration value="3" />
    <Modification>
      <DamageDealtFraction index="Splash" value="0" />
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="HoggerGoldenBruteWeakenApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="HoggerGoldenBruteWeaken" />
  </CEffectApplyBehavior>
  <!-- Brute, Brawn at 100: Staggering Blow kills lane minions (the script turns it on) -->
  <CEffectDamage id="HoggerGoldenBruteMinionKill" parent="StormSpell">
    <Chance value="0" />
    <ValidatorArray value="TargetIsMinionAndNotMercLaner" />
    <Amount value="100000" />
  </CEffectDamage>
  <!-- Feedback Loop (Epic): each enemy Hero hit by Staggering Blow takes 1.5 seconds off its cooldown -->
  <CEffectModifyUnit id="HoggerGoldenFeedbackLoop">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="HoggerStaggeringBlow,Execute" CooldownOperation="Add" CooldownTimeUse="-1.5" />
  </CEffectModifyUnit>
  <CEffectSet id="HoggerStaggeringBlowSearchImpactSet">
    <EffectArray value="HoggerGoldenBruteWeakenApply" />
    <EffectArray value="HoggerGoldenBruteMissingDamage" />
    <EffectArray value="HoggerGoldenBruteMinionKill" />
    <EffectArray value="HoggerGoldenFeedbackLoop" />
  </CEffectSet>
  <!-- Brute: Staggering Blow pulls enemies in instead of knocking them away (the starter flips the force), and Stuns
       everything it moves when the pull ends (Chance 0: the starter turns it on) -->
  <CEffectApplyBehavior id="HoggerGoldenPullHitStun">
    <Chance value="0" />
    <ValidatorArray index="0" value="TargetNotUnstoppable" />
    <Behavior value="HoggerStaggeringBlowProcStun" />
  </CEffectApplyBehavior>
  <!-- Fuel Hit (Legendary): an enemy Hero Stunned by the pull drops a chunk of Meat -->
  <CEffectSet id="HoggerGoldenFuelHit">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <EffectArray value="HoggerLootHoardCreateMeatUnitTargetPoint" />
  </CEffectSet>
  <CEffectSet id="HoggerStaggeringBlowKnockbackPersistentFinalSet">
    <EffectArray value="HoggerGoldenPullHitStun" />
    <EffectArray value="HoggerGoldenFuelHit" />
  </CEffectSet>
  <!-- Hogwild: base Hogg Wild sets its cooldown to 100% of the base 14 s when the tornado ends or is cancelled; with
       the starter it is set back to the starter's 0.5 s right after (the charges keep the 8 s recharge) -->
  <CValidatorUnitCompareBehaviorCount id="HoggerGoldenCasterIsHogwild">
    <WhichUnit Value="Caster" />
    <Compare value="GT" />
    <Behavior value="HoggerGoldenWildMarker" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectModifyUnit id="HoggerGoldenWildEndCooldown">
    <ValidatorArray value="HoggerGoldenCasterIsHogwild" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="HoggerHoggWild,Execute" CooldownOperation="Set" CooldownTimeUse="0.5" />
  </CEffectModifyUnit>
  <CEffectSet id="HoggerHoggWildCasterBuffFinalSet">
    <EffectArray value="HoggerGoldenWildEndCooldown" />
  </CEffectSet>
  <CEffectSet id="HoggerCancelHoggWildInitialSet">
    <EffectArray value="HoggerGoldenWildEndCooldown" />
  </CEffectSet>
  <!-- Hogwild, Stampede 81-100: enemies hit by Hogg Wild are Slowed 1% per stack for 1 second (the script turns it on from 81) -->
  <CBehaviorBuff id="HoggerGoldenWildSlow" parent="StormSlowParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_hogger_e.dds" />
    <Duration value="1" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="HoggerGoldenWildSlowApply" parent="StormSlowApply">
    <Chance value="0" />
    <Behavior value="HoggerGoldenWildSlow" />
  </CEffectApplyBehavior>
  <!-- Sewage (Epic): enemy Heroes hit by Hogg Wild receive 50% less healing for 3 seconds -->
  <CBehaviorBuff id="HoggerGoldenSewage">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_hogger_e.dds" />
    <Duration value="3" />
    <Modification>
      <HealTakenAdditiveMultiplier index="Life" value="-0.5" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="HoggerGoldenSewageApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="HoggerGoldenSewage" />
  </CEffectApplyBehavior>
  <CEffectSet id="HoggerHoggWildImpactSet">
    <EffectArray value="HoggerGoldenWildSlowApply" />
    <EffectArray value="HoggerGoldenSewageApply" />
  </CEffectSet>
  <!-- Hoard King: every 5 Hoard stacks add 1 maximum Rage; each point of Rage adds 1% to all damage, and Plunder adds Movement
       Speed and Life Steal from Rage (the script sets them all) -->
  <CBehaviorBuff id="HoggerGoldenKingHoard" parent="CarryBehaviorParent">
    <Modification>
      <VitalMaxIncreaseAffectsCurrentArray index="Energy" value="0" />
      <VitalMaxArray index="Energy" value="0" />
    </Modification>
  </CBehaviorBuff>
  <CBehaviorBuff id="HoggerGoldenKingFury" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
      <UnifiedMoveSpeedFactor value="0" />
      <VitalDamageLeechArray index="Life">
        <KindArray index="Basic" value="0" />
        <KindArray index="Ability" value="0" />
      </VitalDamageLeechArray>
      <VitalDamageLeechScoreArray Value="Healing" />
    </Modification>
  </CBehaviorBuff>
  <!-- Loot Rain (Epic): the Hoardapult's pile drops 3 more chunks of Meat around it as it lands -->
  <CEffectCreatePersistent id="HoggerGoldenLootRain">
    <Chance value="0" />
    <WhichLocation Value="TargetPoint" />
    <PeriodCount value="3" />
    <PeriodicEffectArray value="HoggerLootHoardCreateMeatUnitTargetPoint" />
    <PeriodicEffectArray value="HoggerLootHoardCreateMeatUnitTargetPoint" />
    <PeriodicEffectArray value="HoggerLootHoardCreateMeatUnitTargetPoint" />
    <PeriodicOffsetArray X="2.5" Y="0" />
    <PeriodicOffsetArray X="-1.25" Y="2.165" />
    <PeriodicOffsetArray X="-1.25" Y="-2.165" />
    <PeriodicPeriodArray value="0" />
    <PeriodicPeriodArray value="0" />
    <PeriodicPeriodArray value="0" />
  </CEffectCreatePersistent>
  <CEffectSet id="HoggerHoardapultMissileGroundImpactSet">
    <EffectArray value="HoggerGoldenLootRain" />
  </CEffectSet>
  <!-- Heavy Loot (Legendary): Loot Hoard and Hoardapult Stun enemies they hit for 3 seconds -->
  <CBehaviorBuff id="HoggerGoldenHeavyLootStun" parent="StormStun">
    <Duration value="3" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="HoggerGoldenHeavyLootApply">
    <Chance value="0" />
    <ValidatorArray value="TargetNotUnstoppable" />
    <Behavior value="HoggerGoldenHeavyLootStun" />
  </CEffectApplyBehavior>
  <CEffectSet id="HoggerRiverpawLootHoardGroundImpactSet">
    <EffectArray value="HoggerGoldenHeavyLootApply" />
  </CEffectSet>
  <CEffectSet id="HoggerHoardapultHoggerGroundImpactSet">
    <EffectArray value="HoggerGoldenHeavyLootApply" />
  </CEffectSet>
</Catalog>
