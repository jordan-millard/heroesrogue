<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Murky. Starters: Slime King (Slime), Big Tuna (Pufferfish) and Mrrgl Warrior (Basic Attacks and Safety
       Bubble). Takedown quests and the script-driven boons are in HeroTriggers/Murky.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="MurkySlimeKingMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MurkyBigTunaMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MurkyMrrglWarriorMarker" parent="CarryBehaviorParent" />
  <!-- Boon markers handled by the script -->
  <CBehaviorBuff id="MurkyChainReactionMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MurkyShellShockMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MurkyPanicBubbleMarker" parent="CarryBehaviorParent" />

  <!-- Panic Bubble (Common, any Murky): Safety Bubble can be used while Stunned. Stuns (StormStun and the 100+ hero stuns
       built on it) let Safety Bubble through for everyone, and the Bubble's effect then refuses the cast while Stunned
       unless Murky has the marker. -->
  <CBehaviorBuff id="StormStun">
    <Modification>
      <AbilLinkEnableArray value="MurkySafetyBubble" />
    </Modification>
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="MurkyCasterNotStunned">
    <WhichUnit Value="Caster" />
    <Compare value="EQ" />
    <Value value="0" />
    <Categories index="Stun" value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorUnitCompareBehaviorCount id="MurkyCasterHasPanicBubble">
    <WhichUnit Value="Caster" />
    <Behavior value="MurkyPanicBubbleMarker" />
    <Compare value="GE" />
    <Value value="1" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorCombine id="MurkySafetyBubbleStunCheck">
    <Type value="Or" />
    <CombineArray value="MurkyCasterNotStunned" />
    <CombineArray value="MurkyCasterHasPanicBubble" />
  </CValidatorCombine>
  <CEffectSet id="SafetyBubbleApplyBehaviorsSet">
    <ValidatorArray value="MurkySafetyBubbleStunCheck" />
  </CEffectSet>
  <!-- Stuns also pause orders, so a normal Bubble order would wait for the stun to end. A Transient ability runs at once
       without the order queue (Auriel's Resurrect Self works through death the same way). -->
  <CAbilEffectInstant id="MurkySafetyBubble">
    <Flags index="Transient" value="1" />
  </CAbilEffectInstant>

  <!-- ===== Slime King ===== -->
  <!-- Ooze quest (50% kept between games): each enemy Hero hit by Slime, 1% Slime damage each.
       Slime Mountain quest: an enemy Hero takedown within 3 seconds of a Slime hit, 1% Slime radius each up to 75%,
       then 1% Slime damage each (script). -->
  <CBehaviorTokenCounter id="MurkyOozeTokenCounter" parent="StormQuestToken">
    <Face value="MurkyOozeTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="MurkyOozeAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="MurkyOozeTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectModifyTokenCount id="MurkyOozeAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <TokenId value="MurkyOozeTokenCounter" />
  </CEffectModifyTokenCount>
  <CBehaviorTokenCounter id="MurkySlimeMountainTokenCounter" parent="StormQuestToken">
    <Face value="MurkySlimeMountainTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <!-- Slime King itself: +50% Slime damage (MurkySlimeKingPower, set by the affix). Gooey (Common): its own multiplier,
       15% per stack. -->
  <CEffectDamage id="MurkySlimeDamage">
    <MultiplicativeModifierArray index="MurkyOoze" Accumulator="MurkyOozeAccumulator" />
    <MultiplicativeModifierArray index="MurkySlimeMountain" Modifier="0" />
    <MultiplicativeModifierArray index="MurkySlimeKingPower" Modifier="0" />
    <MultiplicativeModifierArray index="MurkyGooey" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="MurkySlimeBonusDamage">
    <MultiplicativeModifierArray index="MurkyOoze" Accumulator="MurkyOozeAccumulator" />
    <MultiplicativeModifierArray index="MurkySlimeMountain" Modifier="0" />
    <MultiplicativeModifierArray index="MurkySlimeKingPower" Modifier="0" />
    <MultiplicativeModifierArray index="MurkyGooey" Modifier="0" />
  </CEffectDamage>
  <!-- Slime Rush (Rare): each enemy Hero hit by Slime reduces its cooldown by 1 second -->
  <CEffectModifyUnit id="MurkySlimeRushModifyCooldown">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="MurkySlime,Execute" CooldownOperation="Add" CooldownTimeUse="-1" ChargeTimeUse="-1" />
  </CEffectModifyUnit>
  <!-- Corrosive Slime (Epic): enemy Heroes hit by Slime lose 20 Armor for 3 seconds -->
  <CBehaviorBuff id="MurkyCorrosiveSlimeDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_Murky_Slime.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <Duration value="3" />
    <ArmorModification>
      <AllArmorBonus value="-20" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="MurkyCorrosiveSlimeApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="MurkyCorrosiveSlimeDebuff" />
  </CEffectApplyBehavior>
  <CEffectSet id="MurkySlimeImpactSet">
    <EffectArray value="MurkyOozeAddToken" />
    <EffectArray value="MurkySlimeRushModifyCooldown" />
    <EffectArray value="MurkyCorrosiveSlimeApply" />
  </CEffectSet>
  <CEffectSet id="MurkySlimeImpactSetUnstoppableTarget">
    <EffectArray value="MurkyOozeAddToken" />
    <EffectArray value="MurkySlimeRushModifyCooldown" />
    <EffectArray value="MurkyCorrosiveSlimeApply" />
  </CEffectSet>
  <!-- Primordial Ooze (Legendary): Slime is cast again at the same spot 1 second later. Slime's ability effect becomes a
       set holding the normal search plus the delayed copy, which stays off (Chance 0) unless the boon is taken. -->
  <CEffectCreatePersistent id="MurkyPrimordialOozePersistent">
    <Chance value="0" />
    <WhichLocation Value="CasterPoint" />
    <ExpireDelay value="1" />
    <ExpireEffect value="MurkySlimeSearch" />
  </CEffectCreatePersistent>
  <CEffectSet id="MurkyGoldenSlimeSet">
    <EffectArray value="MurkySlimeSearch" />
    <EffectArray value="MurkyPrimordialOozePersistent" />
  </CEffectSet>
  <CAbilEffectInstant id="MurkySlime">
    <Effect value="MurkyGoldenSlimeSet" />
  </CAbilEffectInstant>
  <!-- Hindering Slime: a cut talent granted by Slime King, so it needs a button -->
  <!-- Slime King: a thin ring always shows Slime's radius around Murky. The script adds and removes the indicator
       behavior, and sets the ring's Scale to Slime's current radius before each add. -->
  <CBehaviorBuff id="MurkySlimeKingRadiusIndicator">
    <InfoFlags index="Hidden" value="1" />
  </CBehaviorBuff>
  <CActorSplat id="MurkySlimeKingRadiusSplat" parent="StormRangeSplat">
    <On Terms="Behavior.MurkySlimeKingRadiusIndicator.On" Send="Create" />
    <On Terms="Behavior.MurkySlimeKingRadiusIndicator.Off" Send="Destroy" />
    <Scale value="3.9" />
  </CActorSplat>
  <CButton id="MurkyHinderingSlimeTalent" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_Slime.dds" />
    <HotkeyAlias value="MurkySlime" />
  </CButton>

  <!-- ===== Big Tuna ===== -->
  <!-- Blowfish quest (50% kept between games): each enemy Hero hit by Pufferfish, 2% Pufferfish damage each.
       Catch of the Day quest: an enemy Hero takedown within 4 seconds of a Pufferfish hit (script), 1% Pufferfish radius
       each up to 75%, then 1% Pufferfish damage each (MurkyCatchOfTheDay, set by script). -->
  <CBehaviorTokenCounter id="MurkyBlowfishTokenCounter" parent="StormQuestToken">
    <Face value="MurkyBlowfishTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="MurkyBlowfishAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="MurkyBlowfishTokenCounter" />
    <Scale value="0.02" />
  </CAccumulatorToken>
  <CEffectModifyTokenCount id="MurkyBlowfishAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <TokenId value="MurkyBlowfishTokenCounter" />
  </CEffectModifyTokenCount>
  <CBehaviorTokenCounter id="MurkyCatchOfTheDayTokenCounter" parent="StormQuestToken">
    <Face value="MurkyCatchOfTheDayTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <!-- Big Tuna itself: +50% Pufferfish damage (MurkyBigTunaPower, set by the affix). Spiny (Common): its own multiplier,
       15% per stack. -->
  <CEffectDamage id="MurkyPufferfishDamage">
    <MultiplicativeModifierArray index="MurkyBlowfish" Accumulator="MurkyBlowfishAccumulator" />
    <MultiplicativeModifierArray index="MurkyCatchOfTheDay" Modifier="0" />
    <MultiplicativeModifierArray index="MurkyFinFury" Accumulator="MurkyFinFuryAccumulator" />
    <MultiplicativeModifierArray index="MurkyBigTunaPower" Modifier="0" />
    <MultiplicativeModifierArray index="MurkySpiny" Modifier="0" />
  </CEffectDamage>
  <!-- Fish Frenzy (Epic): each enemy Hero hit by Pufferfish reduces its cooldown by 2 seconds -->
  <CEffectModifyUnit id="MurkyFishFrenzyModifyCooldown">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="MurkyPufferfish,Execute" CooldownOperation="Add" CooldownTimeUse="-2" ChargeTimeUse="-2" />
  </CEffectModifyUnit>
  <CEffectSet id="MurkyPufferfishExplosionImpactSet">
    <EffectArray value="MurkyBlowfishAddToken" />
    <EffectArray value="MurkyFishFrenzyModifyCooldown" />
  </CEffectSet>
  <!-- Chain Reaction (Legendary): the second explosion from an enemy Hero hit by Pufferfish (script) -->
  <CEffectDamage id="MurkyChainReactionDamage" parent="StormSpell">
    <Flags index="NoFractionDealtBonus" value="1" />
    <Amount value="0" />
    <SourceButtonFace value="MurkyPufferfish" />
  </CEffectDamage>
  <!-- Compressed Air: a cut talent granted by Big Tuna, so it needs a button -->
  <CButton id="MurkyPufferfishCompressedAirTalent" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_Pufferfish.dds" />
    <HotkeyAlias value="MurkyPufferfish" />
  </CButton>

  <!-- ===== Mrrgl Warrior ===== -->
  <!-- Fin Fury quest (50% kept between games): each Basic Attack on an enemy Hero, 0.4% Basic Attack and Pufferfish
       damage each.
       Living Legend quest: an enemy Hero takedown within 3 seconds of a Basic Attack on them (script), Rejuvenating
       Bubble heals 0.25% more of Murky's maximum Health per tick (4 ticks a Bubble, so 1% a Bubble) each, and 0.5%
       maximum Health each (MurkyLivingLegendHealth stacks, kept equal to the quest stacks by script). -->
  <CBehaviorTokenCounter id="MurkyFinFuryTokenCounter" parent="StormQuestToken">
    <Face value="MurkyFinFuryTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="MurkyFinFuryAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="MurkyFinFuryTokenCounter" />
    <Scale value="0.004" />
  </CAccumulatorToken>
  <CEffectModifyTokenCount id="MurkyFinFuryAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ValidatorArray value="CasterNotBlindedAndTargetNotEvading" />
    <WhichUnit Value="Caster" />
    <TokenId value="MurkyFinFuryTokenCounter" />
  </CEffectModifyTokenCount>
  <CBehaviorTokenCounter id="MurkyLivingLegendTokenCounter" parent="StormQuestToken">
    <Face value="MurkyLivingLegendTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="MurkyLivingLegendAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="MurkyLivingLegendTokenCounter" />
    <Scale value="0.0025" />
  </CAccumulatorToken>
  <CEffectCreateHealer id="MurkySafetyBubbleCreateRejuvenatingBubbleMasteryHealer">
    <RechargeVitalFraction>
      <AccumulatorArray value="MurkyLivingLegendAccumulator" />
    </RechargeVitalFraction>
  </CEffectCreateHealer>
  <CBehaviorBuff id="MurkyLivingLegendHealth">
    <InfoFlags index="Hidden" value="1" />
    <BehaviorFlags index="Permanent" value="1" />
    <BehaviorFlags index="EnabledWhileDead" value="1" />
    <MaxStackCount value="1000" />
    <Modification>
      <VitalMaxAdditiveMultiplierArray index="Life" value="0.005" />
    </Modification>
  </CBehaviorBuff>
  <!-- Mrrgl Warrior's emergency Bubble: when a hit would kill Murky (this damage response, which cancels the hit the way
       Artanis's Shield Overload does) or leaves him below 30% Health (script), Murky gets a free Safety Bubble. It works
       while Stunned and has its own 20 second cooldown, shown as a debuff; it doesn't use Safety Bubble's charges
       (spending one through CEffectModifyUnit stopped the charges from recharging). -->
  <CBehaviorBuff id="MurkyEmergencyBubbleLockout">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_Murky_SafetyBubble.dds" />
    <DisplayDuration index="Self" value="1" />
    <BehaviorFlags index="EnabledWhileDead" value="1" />
    <Duration value="20" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="MurkyEmergencyBubbleNotLocked">
    <WhichUnit Value="Caster" />
    <Behavior value="MurkyEmergencyBubbleLockout" />
    <Compare value="EQ" />
    <Value value="0" />
  </CValidatorUnitCompareBehaviorCount>
  <CValidatorCombine id="MurkyEmergencyBubbleReady">
    <Type value="And" />
    <CombineArray value="MurkyEmergencyBubbleNotLocked" />
  </CValidatorCombine>
  <CEffectApplyBehavior id="MurkyEmergencyBubbleApplyLockout">
    <WhichUnit Value="Caster" />
    <Behavior value="MurkyEmergencyBubbleLockout" />
  </CEffectApplyBehavior>
  <CEffectSet id="MurkyEmergencyBubbleSet">
    <ValidatorArray value="MurkyEmergencyBubbleReady" />
    <EffectArray value="ApplySafetyBubble" />
    <EffectArray value="ApplySafetyBubbleMoveSpeedMastery" />
    <EffectArray value="MurkyEmergencyBubbleApplyLockout" />
  </CEffectSet>
  <CBehaviorBuff id="MurkyEmergencyBubble" parent="CarryBehaviorParent">
    <DamageResponse>
      <Chance value="1" />
      <Handled value="MurkyEmergencyBubbleSet" />
      <Priority value="80" />
      <Fatal value="1" />
      <RestoreLifeAfterFatal value="1" />
    </DamageResponse>
    <DisableValidatorArray value="MurkyEmergencyBubbleReady" />
  </CBehaviorBuff>
  <!-- Mrrgl Warrior itself: +75% Basic Attack damage (MurkyMrrglWarriorPower, set by the affix). Sharp Fins (Common): its
       own multiplier, 15% per stack. -->
  <CEffectDamage id="MurkyWeaponDamage">
    <MultiplicativeModifierArray index="MurkyFinFury" Accumulator="MurkyFinFuryAccumulator" />
    <MultiplicativeModifierArray index="MurkyMrrglWarriorPower" Modifier="0" />
    <MultiplicativeModifierArray index="MurkySharpFins" Modifier="0" />
  </CEffectDamage>
  <CEffectSet id="MurkyWeaponPostImpactSet">
    <EffectArray value="MurkyFinFuryAddToken" />
  </CEffectSet>
  <!-- Bubble Burst (Epic): when Safety Bubble ends, Murky gains 50% Attack Speed for 4 seconds, and his Basic Attacks
       heal him for 20% of their damage meanwhile (script) -->
  <CBehaviorBuff id="MurkyBubbleBurstBuff">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_Murky_SafetyBubble.dds" />
    <Duration value="4" />
    <Modification>
      <AdditiveAttackSpeedFactor value="0.5" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="MurkyBubbleBurstApply">
    <Chance value="0" />
    <Behavior value="MurkyBubbleBurstBuff" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="MurkySafetyBubble">
    <FinalEffect value="MurkyBubbleBurstApply" />
  </CBehaviorBuff>
  <!-- Shell Shock (Legendary): the splash from a Basic Attack, 75% within 3 range (script) -->
  <CEffectDamage id="MurkyShellShockDamage" parent="StormSpell">
    <Flags index="NoFractionDealtBonus" value="1" />
    <Amount value="0" />
  </CEffectDamage>

  <CButton id="MurkyOozeTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_Slime.dds" />
  </CButton>
  <CButton id="MurkySlimeMountainTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_Slime.dds" />
  </CButton>
  <CButton id="MurkyBlowfishTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_Pufferfish.dds" />
  </CButton>
  <CButton id="MurkyCatchOfTheDayTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_Pufferfish.dds" />
  </CButton>
  <CButton id="MurkyFinFuryTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_FishTank.dds" />
  </CButton>
  <CButton id="MurkyLivingLegendTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_Murky_SafetyBubble.dds" />
  </CButton>
</Catalog>
