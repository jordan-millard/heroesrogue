  <!-- Dragon Master: Unstoppable while Unleashed -->
  <CBehaviorBuff id="GenjiDragonFuryUnstoppable" parent="StormUnstoppableParent">
    <InfoIcon value="Assets\Textures\storm_ui_icon_genji_dragonblade.dds" />
    <RemoveValidatorArray value="GenjiCasterHasDragonMasterUnleash" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="GenjiDragonFuryUnstoppableApply">
    <Chance value="0" />
    <Behavior value="GenjiDragonFuryUnstoppable" />
  </CEffectApplyBehavior>

  <CButton id="GenjiHailOfSteelTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_genji_Shurikens.dds" />
