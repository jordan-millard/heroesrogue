<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Genji. Starters: Shuriken Storm (Shuriken), Blade of the Shimada (Swift Strike) and Dragon's Fury
       (Dragonblade from level 1). Each damage effect has its own multipliers: the starter's power (set by the affix),
       its Common boon (15% per stack), the hit quest (accumulator) and the takedown quest (accumulator, or a Modifier
       the script sets for stacks past a cooldown cap). Takedown quests and the script-driven boons are in
       HeroTriggers/Genji.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="GenjiShurikenStormMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GenjiBladeMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GenjiDragonMarker" parent="CarryBehaviorParent" />
  <!-- Boon markers handled by the script -->
  <CBehaviorBuff id="GenjiThousandBladesMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GenjiIaidoMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GenjiShadowExecutionMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="GenjiEndlessDragonMarker" parent="CarryBehaviorParent" />

  <!-- ===== Shuriken Storm ===== -->
  <!-- Hail of Steel quest (50% kept between games): each Shuriken hitting an enemy Hero, 0.5% Shuriken damage each.
       Thousand Cuts quest: an enemy Hero takedown within 3 seconds of a Shuriken hit, 1% Shuriken damage each, and
       every 15 stacks 1 more Shuriken per throw, up to 3 (script). -->
  <CBehaviorTokenCounter id="GenjiHailOfSteelTokenCounter" parent="StormQuestToken">
    <Face value="GenjiHailOfSteelTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GenjiHailOfSteelAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GenjiHailOfSteelTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectModifyTokenCount id="GenjiHailOfSteelAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <TokenId value="GenjiHailOfSteelTokenCounter" />
  </CEffectModifyTokenCount>
  <!-- Shuriken Storm: each Shuriken hitting an enemy Hero heals Genji for 4% of his maximum Health -->
  <CEffectModifyUnit id="GenjiShurikenStormHeal">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.04" />
    </VitalArray>
  </CEffectModifyUnit>
  <CBehaviorTokenCounter id="GenjiThousandCutsTokenCounter" parent="StormQuestToken">
    <Face value="GenjiThousandCutsTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GenjiThousandCutsAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GenjiThousandCutsTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="GenjiShurikenDamage">
    <MultiplicativeModifierArray index="GenjiShurikenPower" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiShurikenCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiHailOfSteel" Accumulator="GenjiHailOfSteelAccumulator" />
    <MultiplicativeModifierArray index="GenjiThousandCuts" Accumulator="GenjiThousandCutsAccumulator" />
  </CEffectDamage>
  <CEffectDamage id="GenjiShurikenShinganBonusDamage">
    <MultiplicativeModifierArray index="GenjiShurikenPower" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiShurikenCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiHailOfSteel" Accumulator="GenjiHailOfSteelAccumulator" />
    <MultiplicativeModifierArray index="GenjiThousandCuts" Accumulator="GenjiThousandCutsAccumulator" />
  </CEffectDamage>
  <!-- Thousand Cuts milestones: up to 3 more Shuriken per throw, at 20 degrees left, 20 right and 30 left (base: 0 and 10
       each side). The throw's persistent fires one periodic effect per period; the extra ones are Chance 0 sets the
       script turns on per player, so every other Genji's throw is unchanged. -->
  <CEffectSet id="GenjiShurikenExtra1">
    <Chance value="0" />
    <EffectArray value="GenjiShurikenLaunchMissileLeft" />
  </CEffectSet>
  <CEffectSet id="GenjiShurikenExtra2">
    <Chance value="0" />
    <EffectArray value="GenjiShurikenLaunchMissileRight" />
  </CEffectSet>
  <CEffectSet id="GenjiShurikenExtra3">
    <Chance value="0" />
    <EffectArray value="GenjiShurikenLaunchMissileLeft" />
  </CEffectSet>
  <CEffectCreatePersistent id="GenjiShurikenLaunchPersistent">
    <PeriodCount value="8" />
    <PeriodicEffectArray index="5" value="GenjiShurikenExtra1" />
    <PeriodicEffectArray index="6" value="GenjiShurikenExtra2" />
    <PeriodicEffectArray index="7" value="GenjiShurikenExtra3" />
    <PeriodicOffsetArray index="3" Y="-11" />
    <PeriodicOffsetArray index="4" Y="-11" />
    <PeriodicOffsetArray index="5" X="3.762" Y="-10.337" />
    <PeriodicOffsetArray index="6" X="-3.762" Y="-10.337" />
    <PeriodicOffsetArray index="7" X="5.5" Y="-9.526" />
  </CEffectCreatePersistent>
  <!-- Targeting guide lines for the extra Shuriken, shown once Thousand Cuts reaches each milestone (copies of the base
       GenjiShurikenGuideLeft/Right actors, rotated like their missiles) -->
  <CValidatorUnitCompareTokenCount id="GenjiCasterHasThousandCuts15">
    <WhichUnit Value="Caster" />
    <Compare value="GE" />
    <Value value="15" />
    <TokenId value="GenjiThousandCutsTokenCounter" />
  </CValidatorUnitCompareTokenCount>
  <CActorSiteOpRotationExplicit id="SOpGenjiShurikenExtra1Rotate">
    <Forward X="0.342000" Y="-0.940000" />
    <IsLocal value="1" />
  </CActorSiteOpRotationExplicit>
  <CActorQuad id="GenjiShurikenGuideExtra1" parent="StormGuideVisualQuadDownFantasy" abil="GenjiShuriken">
    <Aliases value="_GuideVisualExtra1" />
    <Height value="11.000000" />
    <Width value="0.250000" />
    <On Terms="ActorCreation; IsActorLocalPlayer; ValidateUnit GenjiCasterHasThousandCuts15" Send="Create GenjiShurikenGuideRegionExtra1" />
    <On Terms="ActorCreation; !ValidateUnit GenjiCasterHasThousandCuts15" Send="SetVisibility" />
    <Remove Terms="ActorCreation" Send="Create StormGuideRegionQuadDown" />
    <Host Subject="_GuideRegionExtra1" />
  </CActorQuad>
  <CActorRegionQuad id="GenjiShurikenGuideRegionExtra1" parent="StormGuideRegionClosest">
    <Aliases value="_GuideRegionExtra1" />
    <On Terms="ActorOrphan" Send="Destroy" />
    <On Terms="RegionSubject.*.AddedFirst" Target="_GuideVisualExtra1" Send="ClearTintColor 0.100000 BaseTint" />
    <On Terms="RegionSubject.*.AddedFirst" Target="_GuideVisualExtra1" Send="SetTintColor 0,255,0 0.100000 OneShot Active" />
    <On Terms="RegionSubject.*.RemovedLast" Target="_GuideVisualExtra1" Send="SetTintColor 225,160,25 0.000000 OneShot BaseTint" />
    <On Terms="RegionSubject.*.RemovedLast" Target="_GuideVisualExtra1" Send="ClearTintColor 0.100000 Active" />
    <Remove Terms="RegionSubject.*.AddedFirst" Target="_GuideVisual" Send="ClearTintColor 0.100000 BaseTint" />
    <Remove Terms="RegionSubject.*.AddedFirst" Target="_GuideVisual" Send="SetTintColor 0,255,0 0.100000 OneShot Active" />
    <Remove Terms="RegionSubject.*.RemovedLast" Target="_GuideVisual" Send="SetTintColor 225,160,25 0.000000 OneShot BaseTint" />
    <Remove Terms="RegionSubject.*.RemovedLast" Target="_GuideVisual" Send="ClearTintColor 0.100000 Active" />
    <HostSiteOps Ops="SOpGenjiShurikenExtra1Rotate" />
    <RegionFlags index="UseEffectRange" value="1" />
  </CActorRegionQuad>
  <CValidatorUnitCompareTokenCount id="GenjiCasterHasThousandCuts30">
    <WhichUnit Value="Caster" />
    <Compare value="GE" />
    <Value value="30" />
    <TokenId value="GenjiThousandCutsTokenCounter" />
  </CValidatorUnitCompareTokenCount>
  <CActorSiteOpRotationExplicit id="SOpGenjiShurikenExtra2Rotate">
    <Forward X="-0.342000" Y="-0.940000" />
    <IsLocal value="1" />
  </CActorSiteOpRotationExplicit>
  <CActorQuad id="GenjiShurikenGuideExtra2" parent="StormGuideVisualQuadDownFantasy" abil="GenjiShuriken">
    <Aliases value="_GuideVisualExtra2" />
    <Height value="11.000000" />
    <Width value="0.250000" />
    <On Terms="ActorCreation; IsActorLocalPlayer; ValidateUnit GenjiCasterHasThousandCuts30" Send="Create GenjiShurikenGuideRegionExtra2" />
    <On Terms="ActorCreation; !ValidateUnit GenjiCasterHasThousandCuts30" Send="SetVisibility" />
    <Remove Terms="ActorCreation" Send="Create StormGuideRegionQuadDown" />
    <Host Subject="_GuideRegionExtra2" />
  </CActorQuad>
  <CActorRegionQuad id="GenjiShurikenGuideRegionExtra2" parent="StormGuideRegionClosest">
    <Aliases value="_GuideRegionExtra2" />
    <On Terms="ActorOrphan" Send="Destroy" />
    <On Terms="RegionSubject.*.AddedFirst" Target="_GuideVisualExtra2" Send="ClearTintColor 0.100000 BaseTint" />
    <On Terms="RegionSubject.*.AddedFirst" Target="_GuideVisualExtra2" Send="SetTintColor 0,255,0 0.100000 OneShot Active" />
    <On Terms="RegionSubject.*.RemovedLast" Target="_GuideVisualExtra2" Send="SetTintColor 225,160,25 0.000000 OneShot BaseTint" />
    <On Terms="RegionSubject.*.RemovedLast" Target="_GuideVisualExtra2" Send="ClearTintColor 0.100000 Active" />
    <Remove Terms="RegionSubject.*.AddedFirst" Target="_GuideVisual" Send="ClearTintColor 0.100000 BaseTint" />
    <Remove Terms="RegionSubject.*.AddedFirst" Target="_GuideVisual" Send="SetTintColor 0,255,0 0.100000 OneShot Active" />
    <Remove Terms="RegionSubject.*.RemovedLast" Target="_GuideVisual" Send="SetTintColor 225,160,25 0.000000 OneShot BaseTint" />
    <Remove Terms="RegionSubject.*.RemovedLast" Target="_GuideVisual" Send="ClearTintColor 0.100000 Active" />
    <HostSiteOps Ops="SOpGenjiShurikenExtra2Rotate" />
    <RegionFlags index="UseEffectRange" value="1" />
  </CActorRegionQuad>
  <CValidatorUnitCompareTokenCount id="GenjiCasterHasThousandCuts45">
    <WhichUnit Value="Caster" />
    <Compare value="GE" />
    <Value value="45" />
    <TokenId value="GenjiThousandCutsTokenCounter" />
  </CValidatorUnitCompareTokenCount>
  <CActorSiteOpRotationExplicit id="SOpGenjiShurikenExtra3Rotate">
    <Forward X="0.500000" Y="-0.866000" />
    <IsLocal value="1" />
  </CActorSiteOpRotationExplicit>
  <CActorQuad id="GenjiShurikenGuideExtra3" parent="StormGuideVisualQuadDownFantasy" abil="GenjiShuriken">
    <Aliases value="_GuideVisualExtra3" />
    <Height value="11.000000" />
    <Width value="0.250000" />
    <On Terms="ActorCreation; IsActorLocalPlayer; ValidateUnit GenjiCasterHasThousandCuts45" Send="Create GenjiShurikenGuideRegionExtra3" />
    <On Terms="ActorCreation; !ValidateUnit GenjiCasterHasThousandCuts45" Send="SetVisibility" />
    <Remove Terms="ActorCreation" Send="Create StormGuideRegionQuadDown" />
    <Host Subject="_GuideRegionExtra3" />
  </CActorQuad>
  <CActorRegionQuad id="GenjiShurikenGuideRegionExtra3" parent="StormGuideRegionClosest">
    <Aliases value="_GuideRegionExtra3" />
    <On Terms="ActorOrphan" Send="Destroy" />
    <On Terms="RegionSubject.*.AddedFirst" Target="_GuideVisualExtra3" Send="ClearTintColor 0.100000 BaseTint" />
    <On Terms="RegionSubject.*.AddedFirst" Target="_GuideVisualExtra3" Send="SetTintColor 0,255,0 0.100000 OneShot Active" />
    <On Terms="RegionSubject.*.RemovedLast" Target="_GuideVisualExtra3" Send="SetTintColor 225,160,25 0.000000 OneShot BaseTint" />
    <On Terms="RegionSubject.*.RemovedLast" Target="_GuideVisualExtra3" Send="ClearTintColor 0.100000 Active" />
    <Remove Terms="RegionSubject.*.AddedFirst" Target="_GuideVisual" Send="ClearTintColor 0.100000 BaseTint" />
    <Remove Terms="RegionSubject.*.AddedFirst" Target="_GuideVisual" Send="SetTintColor 0,255,0 0.100000 OneShot Active" />
    <Remove Terms="RegionSubject.*.RemovedLast" Target="_GuideVisual" Send="SetTintColor 225,160,25 0.000000 OneShot BaseTint" />
    <Remove Terms="RegionSubject.*.RemovedLast" Target="_GuideVisual" Send="ClearTintColor 0.100000 Active" />
    <HostSiteOps Ops="SOpGenjiShurikenExtra3Rotate" />
    <RegionFlags index="UseEffectRange" value="1" />
  </CActorRegionQuad>
  <!-- Shuriken Storm: Hail of Steel also adds Deflect damage, and Thousand Cuts lengthens Deflect (script) -->
  <CEffectDamage id="GenjiDeflectDamage">
    <MultiplicativeModifierArray index="GenjiHailOfSteel" Accumulator="GenjiHailOfSteelAccumulator" />
  </CEffectDamage>
  <!-- Ricochet (Rare): each Shuriken hitting an enemy Hero speeds up Shuriken's recharge by 0.5 seconds -->
  <CEffectModifyUnit id="GenjiRicochetModifyCooldown">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="GenjiShuriken,Execute" CooldownOperation="Add" CooldownTimeUse="-0.5" ChargeTimeUse="-0.5" />
  </CEffectModifyUnit>
  <!-- Shred (Epic): each Shuriken hitting an enemy Hero takes 5 Armor for 4 seconds, stacking up to 4 times -->
  <CBehaviorBuff id="GenjiShredDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_genji_Shurikens.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <MaxStackCount value="4" />
    <Duration value="4" />
    <ArmorModification>
      <AllArmorBonus value="-5" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="GenjiShredApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <Behavior value="GenjiShredDebuff" />
  </CEffectApplyBehavior>
  <CEffectSet id="GenjiShurikenImpactSetCenter">
    <EffectArray value="GenjiHailOfSteelAddToken" />
    <EffectArray value="GenjiShurikenStormHeal" />
    <EffectArray value="GenjiRicochetModifyCooldown" />
    <EffectArray value="GenjiShredApply" />
  </CEffectSet>
  <CEffectSet id="GenjiShurikenImpactSetLeft">
    <EffectArray value="GenjiHailOfSteelAddToken" />
    <EffectArray value="GenjiShurikenStormHeal" />
    <EffectArray value="GenjiRicochetModifyCooldown" />
    <EffectArray value="GenjiShredApply" />
  </CEffectSet>
  <CEffectSet id="GenjiShurikenImpactSetRight">
    <EffectArray value="GenjiHailOfSteelAddToken" />
    <EffectArray value="GenjiShurikenStormHeal" />
    <EffectArray value="GenjiRicochetModifyCooldown" />
    <EffectArray value="GenjiShredApply" />
  </CEffectSet>

  <!-- ===== Blade of the Shimada ===== -->
  <!-- Precision quest (50% kept between games): each enemy Hero hit by Swift Strike, 2% Swift Strike damage each.
       Shimada Legacy quest: an enemy Hero takedown within 3 seconds of a Swift Strike hit, 1% of Swift Strike's
       8 second cooldown each up to 25%, then 1% Swift Strike damage each (script). -->
  <CBehaviorTokenCounter id="GenjiPrecisionTokenCounter" parent="StormQuestToken">
    <Face value="GenjiPrecisionTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GenjiPrecisionAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GenjiPrecisionTokenCounter" />
    <Scale value="0.02" />
  </CAccumulatorToken>
  <CEffectModifyTokenCount id="GenjiPrecisionAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <TokenId value="GenjiPrecisionTokenCounter" />
  </CEffectModifyTokenCount>
  <CBehaviorTokenCounter id="GenjiShimadaLegacyTokenCounter" parent="StormQuestToken">
    <Face value="GenjiShimadaLegacyTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectDamage id="GenjiSwiftStrikeDamage">
    <MultiplicativeModifierArray index="GenjiSwiftPower" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiSwiftCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiPrecision" Accumulator="GenjiPrecisionAccumulator" />
    <MultiplicativeModifierArray index="GenjiShimadaLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GenjiSwiftStrikeStrikeAtTheHeartDamage">
    <MultiplicativeModifierArray index="GenjiSwiftPower" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiSwiftCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiPrecision" Accumulator="GenjiPrecisionAccumulator" />
    <MultiplicativeModifierArray index="GenjiShimadaLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="GenjiSwiftStrikeFinalCutDamage">
    <MultiplicativeModifierArray index="GenjiSwiftPower" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiSwiftCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiPrecision" Accumulator="GenjiPrecisionAccumulator" />
    <MultiplicativeModifierArray index="GenjiShimadaLegacy" Modifier="0" />
  </CEffectDamage>
  <!-- Blade of the Shimada: Swift Strike kills lane minions outright -->
  <CEffectDamage id="GenjiSwiftStrikeMinionKill" parent="StormSpell">
    <Chance value="0" />
    <ValidatorArray value="TargetIsMinionAndNotMercLaner" />
    <Flags index="Kill" value="1" />
  </CEffectDamage>
  <CEffectSet id="GenjiSwiftStrikeImpactSet">
    <EffectArray value="GenjiPrecisionAddToken" />
    <EffectArray value="GenjiSwiftStrikeMinionKill" />
  </CEffectSet>
  <!-- Iaido (Epic): Swift Strike also deals 8% of enemy Heroes' maximum Health (script) -->
  <CEffectDamage id="GenjiIaidoDamage" parent="StormSpell">
    <Amount value="0" />
  </CEffectDamage>

  <!-- ===== Dragon Master (affix GenjiDragonsFury) ===== -->
  <!-- Genji never leaves Dragonblade: the script keeps GenjiDragonbladeActive on him (no duration for this player), so
       Shuriken and Basic Attacks are gone and Q and R both slash, while Unleash is an Active on key 1. Slashes deal half
       damage, have a 2 second cooldown, and drop to 0.5 seconds when they hit an enemy Hero. Unleash (key 1, 60 second
       cooldown): 8 seconds of double slash damage and Unstoppable.
       Dragon's Hunger quest (50% kept between games): each enemy Hero hit by a slash, 0.25% slash damage each.
       Dragon Soul quest: an enemy Hero takedown within 3 seconds of a slash hit, 1% of Unleash's 60 second cooldown
       each up to 40%, then 1% slash damage each (script). -->
  <CBehaviorTokenCounter id="GenjiDragonHungerTokenCounter" parent="StormQuestToken">
    <Face value="GenjiDragonHungerTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="GenjiDragonHungerAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="GenjiDragonHungerTokenCounter" />
    <Scale value="0.0025" />
  </CAccumulatorToken>
  <CEffectModifyTokenCount id="GenjiDragonHungerAddToken" parent="BaseEffectModifyTokenCount">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <TokenId value="GenjiDragonHungerTokenCounter" />
  </CEffectModifyTokenCount>
  <CBehaviorTokenCounter id="GenjiDragonSoulTokenCounter" parent="StormQuestToken">
    <Face value="GenjiDragonSoulTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CEffectDamage id="GenjiDragonbladeAttackDamage">
    <MultiplicativeModifierArray index="GenjiDragonPower" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiDragonCommon" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiDragonHunger" Accumulator="GenjiDragonHungerAccumulator" />
    <MultiplicativeModifierArray index="GenjiDragonSoul" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiDragonMaster" Modifier="0" />
    <MultiplicativeModifierArray index="GenjiDragonUnleash" Validator="GenjiCasterHasDragonMasterUnleash" Modifier="0" />
  </CEffectDamage>
  <!-- A slash that hits an enemy Hero is ready again after 0.5 seconds (its cooldown is set when the slash starts) -->
  <CEffectModifyUnit id="GenjiDragonMasterChain">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ImpactUnit Value="Caster" />
    <Cost Abil="GenjiDragonbladeAttack,Execute" CooldownOperation="Set" CooldownTimeUse="0.5" />
  </CEffectModifyUnit>
  <CEffectSet id="GenjiDragonbladeAttackImpactSet">
    <EffectArray value="GenjiDragonHungerAddToken" />
    <EffectArray value="GenjiDragonMasterChain" />
  </CEffectSet>
  <!-- The permanent form, applied by the script -->
  <CEffectApplyBehavior id="GenjiDragonMasterFormApply">
    <WhichUnit Value="Caster" />
    <Behavior value="GenjiDragonbladeActive" />
  </CEffectApplyBehavior>
  <!-- Unleash: an Active on key 1, granted by the GenjiDragonMasterUnleashButton behavior like an Active talent.
       Dragonblade's own button also applies Unleash (String catalog modification), in case it's ever reachable. -->
  <CAbilEffectInstant id="GenjiDragonMasterUnleash">
    <PrepEffect value="DismountDecloakCasterSet" />
    <Effect value="GenjiDragonMasterUnleashApply" />
    <Flags index="Transient" value="1" />
    <Cost>
      <Cooldown TimeUse="60" />
    </Cost>
    <CmdButtonArray index="Execute" DefaultButtonFace="GenjiDragonMasterUnleash" Requirements="HeroHasNoDeadBehavior" />
    <SharedFlags index="AllowQuickCastCustomization" value="0" />
  </CAbilEffectInstant>
  <CBehaviorAbility id="GenjiDragonMasterUnleashButton">
    <Buttons Face="GenjiDragonMasterUnleash" Type="AbilCmd" AbilCmd="GenjiDragonMasterUnleash,Execute" />
  </CBehaviorAbility>
  <CButton id="GenjiDragonMasterUnleash" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_genji_dragonblade.dds" />
  </CButton>
  <CEffectApplyBehavior id="GenjiDragonMasterUnleashApply">
    <WhichUnit Value="Caster" />
    <Behavior value="GenjiDragonMasterUnleash" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="GenjiDragonMasterUnleash">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_genji_dragonblade.dds" />
    <Duration value="8" />
    <InitialEffect value="GenjiDragonMasterUnleashInitialSet" />
  </CBehaviorBuff>
  <CEffectSet id="GenjiDragonMasterUnleashInitialSet">
    <EffectArray value="GenjiDragonbladeAttackSetCooldown" />
    <EffectArray value="GenjiDragonScalesApply" />
    <EffectArray value="GenjiDragonFuryUnstoppableApply" />
  </CEffectSet>
  <CValidatorUnitCompareBehaviorCount id="GenjiCasterHasDragonMasterUnleash">
    <WhichUnit Value="Caster" />
    <Compare value="GT" />
    <Behavior value="GenjiDragonMasterUnleash" />
  </CValidatorUnitCompareBehaviorCount>
  <!-- Dragon Scales (Epic): 25 Armor while Unleashed -->
  <CBehaviorBuff id="GenjiDragonScalesBuff" parent="StormArmor">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_genji_dragonblade.dds" />
    <RemoveValidatorArray value="GenjiCasterHasDragonMasterUnleash" />
