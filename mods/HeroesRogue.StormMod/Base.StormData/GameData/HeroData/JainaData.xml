    <MultiplicativeModifierArray index="JainaElementalCommon" Modifier="0" />
    <MultiplicativeModifierArray index="JainaElementalHit" Accumulator="JainaUndertowTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="JainaElementalLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="JainaWaterElementalWeaponSplashDamage">
