  <!-- ===== Boons ===== -->
  <!-- Shatter (Rare, Frost Mage): Frostbolt hits on Heroes take 1 second off Cone of Cold -->
  <CEffectModifyUnit id="JainaShatterModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="JainaConeOfCold,Execute" CooldownOperation="Add" CooldownTimeUse="-1" ChargeTimeUse="-1" />
  </CEffectModifyUnit>
  <!-- Brittle (Epic): Frostbolt hits on Heroes take 5 Armor for 4 seconds, stacking up to 4 times -->
  <CBehaviorBuff id="JainaBrittleDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_jaina_frostbolt.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <MaxStackCount value="4" />
    <Duration value="4" />
    <ArmorModification>
      <AllArmorBonus value="-5" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="JainaBrittleApply">
    <Behavior value="JainaBrittleDebuff" />
  </CEffectApplyBehavior>
  <!-- Blizzard Caller gives Blizzard charges: the base effects that cut its cooldown also cut the recharge -->
  <CEffectModifyUnit id="JainaIcefuryWandModifyBlizzardCooldownNonHeroTarget">
    <Cost index="0" Abil="JainaBlizzard,Execute" CooldownOperation="Add" CooldownTimeUse="-1.25" ChargeTimeUse="-1.25" />
  </CEffectModifyUnit>
  <CEffectModifyUnit id="JainaIcefuryWandModifyBlizzardCooldownHeroTarget">
    <Cost index="0" Abil="JainaBlizzard,Execute" CooldownOperation="Add" CooldownTimeUse="-2.5" ChargeTimeUse="-2.5" />
  </CEffectModifyUnit>
  <CEffectModifyUnit id="JainaIcyVeinsModifyUnit">
    <Cost index="0" Abil="JainaBlizzard,Execute" CooldownOperation="Add" CooldownTimeUse="-0.25" ChargeTimeUse="-0.25" />
  </CEffectModifyUnit>
  <!-- Whiteout (Rare, Blizzard Caller): Blizzard hits on Heroes take 0.5 seconds off Frostbolt -->
  <CEffectModifyUnit id="JainaWhiteoutModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="JainaFrostbolt,Execute" CooldownOperation="Add" CooldownTimeUse="-0.5" ChargeTimeUse="-0.5" />
  </CEffectModifyUnit>
  <!-- Deep Freeze (Epic): Blizzard hits on Heroes take 4 Armor for 3 seconds, stacking up to 3 times -->
  <CBehaviorBuff id="JainaDeepFreezeDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_jaina_blizzard.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <MaxStackCount value="3" />
    <Duration value="3" />
    <ArmorModification>
      <AllArmorBonus value="-4" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="JainaDeepFreezeApply">
    <Behavior value="JainaDeepFreezeDebuff" />
  </CEffectApplyBehavior>
  <!-- Tidal Bond (Rare, Elementalist): Water Elemental hits on Heroes take 0.5 seconds off Summon Water Elemental -->
  <CEffectModifyUnit id="JainaTidalBondModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="JainaSummonWaterElemental,Execute" CooldownOperation="Add" CooldownTimeUse="-0.5" ChargeTimeUse="-0.5" />
  </CEffectModifyUnit>
  <!-- Glacial Spike (Legendary, Elementalist): Water Elemental hits on Heroes also deal 1.5% of their maximum Health (script) -->
  <CEffectDamage id="JainaGlacialSpikeDamage" parent="StormSpell">
    <Amount value="0" />
  </CEffectDamage>
</Catalog>
