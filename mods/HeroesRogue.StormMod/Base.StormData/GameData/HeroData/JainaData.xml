<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Jaina. Starters: Frost Mage (Frostbolt), Blizzard Caller (Blizzard) and Elementalist (Summon Water Elemental from level 1). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script). Hits, quests and script boons are in HeroTriggers/Jaina.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="JainaFrostboltMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaBlizzardMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaElementalMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaShatterMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaBrittleMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaFrostVolleyMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaWhiteoutMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaDeepFreezeMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaEternalWinterMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaTidalBondMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="JainaGlacialSpikeMarker" parent="CarryBehaviorParent" />

  <!-- ===== Frost Mage ===== -->
  <!-- Ice Shards quest (50% kept): 0.5% Frostbolt damage per enemy Hero hit. Cold Front quest: takedowns within 3 seconds of a hit; 1% off Blizzard and Cone of Cold cooldowns each up to 25%, then 1% Frostbolt damage each (script). -->
  <CBehaviorTokenCounter id="JainaIceShardsTokenCounter" parent="StormQuestToken">
    <Face value="JainaIceShardsTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="JainaColdFrontTokenCounter" parent="StormQuestToken">
    <Face value="JainaColdFrontTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="JainaIceShardsTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="JainaIceShardsTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="JainaFrostboltDamage">
    <MultiplicativeModifierArray index="JainaFrostboltPower" Modifier="0" />
    <MultiplicativeModifierArray index="JainaFrostboltCommon" Modifier="0" />
    <MultiplicativeModifierArray index="JainaFrostboltHit" Accumulator="JainaIceShardsTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="JainaFrostboltLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="JainaFrostboltDamageChilled">
    <MultiplicativeModifierArray index="JainaFrostboltPower" Modifier="0" />
    <MultiplicativeModifierArray index="JainaFrostboltCommon" Modifier="0" />
    <MultiplicativeModifierArray index="JainaFrostboltHit" Accumulator="JainaIceShardsTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="JainaFrostboltLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="JainaFrostboltHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.02" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="JainaIceShardsTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_jaina_frostbolt.dds" />
  </CButton>
  <CButton id="JainaColdFrontTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_jaina_frostbolt.dds" />
  </CButton>

  <!-- ===== Blizzard Caller ===== -->
  <!-- Whiteout quest (50% kept): 0.25% Blizzard damage per enemy Hero hit. Endless Winter quest: takedowns within 3 seconds of a hit; 1% of the 9 second cooldown each up to 40%, then 1% damage each (script). -->
  <CBehaviorTokenCounter id="JainaSnowfallTokenCounter" parent="StormQuestToken">
    <Face value="JainaSnowfallTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="JainaEndlessWinterTokenCounter" parent="StormQuestToken">
    <Face value="JainaEndlessWinterTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="JainaSnowfallTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="JainaSnowfallTokenCounter" />
    <Scale value="0.0025" />
  </CAccumulatorToken>
  <CEffectDamage id="JainaBlizzardDamage">
    <MultiplicativeModifierArray index="JainaBlizzardPower" Modifier="0" />
    <MultiplicativeModifierArray index="JainaBlizzardCommon" Modifier="0" />
    <MultiplicativeModifierArray index="JainaBlizzardHit" Accumulator="JainaSnowfallTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="JainaBlizzardLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="JainaBlizzardDamageChilled">
    <MultiplicativeModifierArray index="JainaBlizzardPower" Modifier="0" />
    <MultiplicativeModifierArray index="JainaBlizzardCommon" Modifier="0" />
    <MultiplicativeModifierArray index="JainaBlizzardHit" Accumulator="JainaSnowfallTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="JainaBlizzardLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="JainaBlizzardHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.015" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="JainaSnowfallTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_jaina_blizzard.dds" />
  </CButton>
  <CButton id="JainaEndlessWinterTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_jaina_blizzard.dds" />
  </CButton>

  <!-- ===== Elementalist ===== -->
  <!-- Summon Water Elemental from level 1. Undertow quest (50% kept): 0.25% elemental damage per enemy Hero hit. Tidecaller quest: takedowns within 3 seconds of an elemental hit; 1% of the 20 second cooldown each up to 40%, then 1% damage each (script). -->
  <CBehaviorTokenCounter id="JainaUndertowTokenCounter" parent="StormQuestToken">
    <Face value="JainaUndertowTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="JainaTidecallerTokenCounter" parent="StormQuestToken">
    <Face value="JainaTidecallerTokenCounter" />
