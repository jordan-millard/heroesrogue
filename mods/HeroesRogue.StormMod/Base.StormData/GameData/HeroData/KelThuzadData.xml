<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Kel'Thuzad. Starters: Lord of Decay (Death and Decay), Frostbinder (Frost Nova) and Chains of the Lich (Chains of Kel'Thuzad). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script). Hits, quests and script boons are in HeroTriggers/KelThuzad.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="KelThuzadDecayMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KelThuzadNovaMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KelThuzadChainsMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KelThuzadGripOfDeathMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KelThuzadLichKingsGraspMarker" parent="CarryBehaviorParent" />

  <!-- ===== Lord of Decay ===== -->
  <!-- Pestilence quest (50% kept): 0.5% Death and Decay damage per enemy Hero hit by its explosion. Plague quest: takedowns within 3 seconds of a hit; stacks 1-40 cut 1% of the 5 second cooldown each, 41-80 make the explosion and pool 1% larger each, then 3% damage each (Heroics too). -->
  <CBehaviorTokenCounter id="KelThuzadPestilenceTokenCounter" parent="StormQuestToken">
    <Face value="KelThuzadPestilenceTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KelThuzadPlagueTokenCounter" parent="StormQuestToken">
    <Face value="KelThuzadPlagueTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KelThuzadPestilenceTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KelThuzadPestilenceTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="KelThuzadDeathAndDecayDamage">
    <MultiplicativeModifierArray index="KelThuzadDecayPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayHit" Accumulator="KelThuzadPestilenceTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadDecayLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadDeathAndDecayRotDamage">
    <MultiplicativeModifierArray index="KelThuzadDecayPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayHit" Accumulator="KelThuzadPestilenceTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadDecayLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadDeathAndDecayShadeDamage">
    <MultiplicativeModifierArray index="KelThuzadDecayPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayHit" Accumulator="KelThuzadPestilenceTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadDecayLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadDeathAndDecayShadeRotDamage">
    <MultiplicativeModifierArray index="KelThuzadDecayPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadDecayHit" Accumulator="KelThuzadPestilenceTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadDecayLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="KelThuzadDecayHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.01" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="KelThuzadPestilenceTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kel'thuzad_deathanddecay.dds" />
  </CButton>
  <CButton id="KelThuzadPlagueTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kel'thuzad_deathanddecay.dds" />
  </CButton>

  <!-- ===== Frostbinder ===== -->
  <!-- Rime quest (50% kept): 0.5% Frost Nova damage per enemy Hero hit. Winter quest: takedowns within 3 seconds of a hit; stacks 1-40 cut 1% of the 8 second cooldown each, 41-80 make it 1% larger each, then 3% damage each (Heroics too). -->
  <CBehaviorTokenCounter id="KelThuzadRimeTokenCounter" parent="StormQuestToken">
    <Face value="KelThuzadRimeTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KelThuzadWinterTokenCounter" parent="StormQuestToken">
    <Face value="KelThuzadWinterTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KelThuzadRimeTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KelThuzadRimeTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="KelThuzadFrostNovaDamage">
    <MultiplicativeModifierArray index="KelThuzadNovaPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaHit" Accumulator="KelThuzadRimeTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadNovaLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadFrostNovaRootDamage">
    <MultiplicativeModifierArray index="KelThuzadNovaPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaHit" Accumulator="KelThuzadRimeTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadNovaLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadFrostNovaSlowDamage">
    <MultiplicativeModifierArray index="KelThuzadNovaPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaHit" Accumulator="KelThuzadRimeTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadNovaLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="KelThuzadNovaHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.01" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="KelThuzadRimeTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kel'thuzad_frostnova.dds" />
  </CButton>
  <CButton id="KelThuzadWinterTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kel'thuzad_frostnova.dds" />
  </CButton>

  <!-- ===== Chains of the Lich ===== -->
  <!-- Shackle quest (50% kept): 1% Chains damage per enemy Hero hit. Bondage quest: takedowns within 3 seconds of a hit; stacks 1-40 cut 1% of the 10 second cooldown each, 41-80 make the chains 2% wider each, then 3% damage each (Heroics too). -->
  <CBehaviorTokenCounter id="KelThuzadShackleTokenCounter" parent="StormQuestToken">
    <Face value="KelThuzadShackleTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KelThuzadBondageTokenCounter" parent="StormQuestToken">
    <Face value="KelThuzadBondageTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KelThuzadShackleTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KelThuzadShackleTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="KelThuzadChainsDamage">
    <MultiplicativeModifierArray index="KelThuzadChainsPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadChainsCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadChainsHit" Accumulator="KelThuzadShackleTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadChainsLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadChainsLinkDamage">
    <MultiplicativeModifierArray index="KelThuzadChainsPower" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadChainsCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadChainsHit" Accumulator="KelThuzadShackleTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KelThuzadChainsLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="KelThuzadChainsHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.02" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="KelThuzadShackleTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kel'thuzad_chains.dds" />
  </CButton>
  <CButton id="KelThuzadBondageTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kel'thuzad_chains.dds" />
  </CButton>

  <!-- ===== Takedown quest damage past the cap, also on these effects ===== -->
  <CEffectDamage id="KelThuzadFrozenTombDamage">
    <MultiplicativeModifierArray index="KelThuzadDecayLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadChainsLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadFrozenTombExplosionDamage">
    <MultiplicativeModifierArray index="KelThuzadDecayLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadChainsLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KelThuzadShadowFissureDamage">
    <MultiplicativeModifierArray index="KelThuzadDecayLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadNovaLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="KelThuzadChainsLegacy" Modifier="0" />
  </CEffectDamage>

  <!-- ===== Boons ===== -->
  <!-- Lich King's Grasp (Legendary, Chains of the Lich): Chains hits on Heroes take 3 seconds off Frost Nova -->
  <CEffectModifyUnit id="KelThuzadLichKingsGraspFrostNova">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KelThuzadFrostNova,Execute" CooldownOperation="Add" CooldownTimeUse="-3" ChargeTimeUse="-3" />
  </CEffectModifyUnit>
  <!-- Lich King's Grasp: and 3 seconds off Death and Decay -->
  <CEffectModifyUnit id="KelThuzadLichKingsGraspDeathAndDecay">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KelThuzadDeathAndDecay,Execute" CooldownOperation="Add" CooldownTimeUse="-3" ChargeTimeUse="-3" />
  </CEffectModifyUnit>
</Catalog>
