<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Mephisto. Starters: Skull Caller (Skull Missile: 2 charges, half Mana, 20% width and damage, Unyielding Power and Abhorred Skull), Storm of Hatred (Lightning Nova: 2 seconds less cooldown, half Mana, 20% thicker ring, Furious Spark, Static Field and Static Barrier) and Sith Lord (Basic Attacks have a 33% chance to fire a free Skull Missile, 50% leech, attack speed on Hero hits, Shard of Hate; Skull Missile cannot be cast). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (unused: past 100 the script adds a damage buff). Hits, quests and script boons are in HeroTriggers/MephistoGolden.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="MephistoSkullMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MephistoNovaMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MephistoSithMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MephistoSkullRainMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MephistoSkullStormMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="MephistoShadowShieldMarker" parent="CarryBehaviorParent" />
  <!-- Skull Caller, Dread at 100: the returning skull's damage, 50% -->
  <CEffectDamage id="MephistoGoldenSkullEchoDamage" parent="MephistoSkullMissileDamage">
    <MultiplicativeModifierArray index="MephistoGoldenEcho" Modifier="-0.5" />
  </CEffectDamage>
  <!-- Storm of Hatred, Conductive: the stationary nova's damage (as Lightning Nova's; its per-cast ramp is gone by then) -->
  <CEffectDamage id="MephistoGoldenNovaFieldDamage" parent="MephistoLightningNovaDamage" />

  <!-- ===== Skull Caller ===== -->
  <!-- Skull Missile stores 2 charges (5 second recharge), costs half Mana and is 20% wider with 20% more damage; gain Unyielding Power (its reward is a 3rd charge) and Abhorred Skull. Malice quest (50% kept): 1% Skull Missile damage per enemy Hero hit. Dread quest: takedowns within 6 seconds of a hit; stacks 1-40 make Skull Missile recharge 1% faster each, 41-80 make the skull fly 1% faster and 1% wider each, 81-100 make it reach 1% farther each, at 100 the skull flies back its full range for 50% (script), then 2% damage each (script). -->
  <CBehaviorTokenCounter id="MephistoGoldenMaliceTokenCounter" parent="StormQuestToken">
    <Face value="MephistoGoldenMaliceTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="MephistoGoldenDreadTokenCounter" parent="StormQuestToken">
    <Face value="MephistoGoldenDreadTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="MephistoGoldenMaliceTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="MephistoGoldenMaliceTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="MephistoSkullMissileDamage">
    <MultiplicativeModifierArray index="MephistoSkullPower" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSkullCommon" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSkullHit" Accumulator="MephistoGoldenMaliceTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="MephistoSkullLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="MephistoGoldenSkullEchoDamage">
    <MultiplicativeModifierArray index="MephistoSkullPower" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSkullCommon" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSkullHit" Accumulator="MephistoGoldenMaliceTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="MephistoSkullLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="MephistoGoldenMaliceTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_mephisto_skull.dds" />
  </CButton>
  <CButton id="MephistoGoldenDreadTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_mephisto_skull.dds" />
  </CButton>

  <!-- ===== Storm of Hatred ===== -->
  <!-- Lightning Nova has 2 seconds less cooldown (12), costs half Mana and has a 20% thicker ring; gain Furious Spark, Static Field and Static Barrier. Charge quest (50% kept): 0.2% Lightning Nova damage per enemy Hero hit. Tempest quest: takedowns within 6 seconds of a hit; stacks 1-40 make Lightning Nova recharge 1% faster each, 41-80 add 0.25% life leech each (10%), 81-100 add 5% damage to non-Heroes each (100%), at 100 hits on non-Heroes trigger Lord of Hatred (script), then 2% damage each (script). -->
  <CBehaviorTokenCounter id="MephistoGoldenChargeTokenCounter" parent="StormQuestToken">
    <Face value="MephistoGoldenChargeTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="MephistoGoldenTempestTokenCounter" parent="StormQuestToken">
    <Face value="MephistoGoldenTempestTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="MephistoGoldenChargeTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="MephistoGoldenChargeTokenCounter" />
    <Scale value="0.002" />
  </CAccumulatorToken>
  <CEffectDamage id="MephistoLightningNovaDamage">
    <MultiplicativeModifierArray index="MephistoNovaPower" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoNovaCommon" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoNovaHit" Accumulator="MephistoGoldenChargeTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="MephistoNovaLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoGoldenNonHero" Validator="TargetNotHero" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="MephistoGoldenNovaFieldDamage">
    <MultiplicativeModifierArray index="MephistoNovaPower" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoNovaCommon" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoNovaHit" Accumulator="MephistoGoldenChargeTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="MephistoNovaLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoGoldenNonHero" Validator="TargetNotHero" Modifier="0" />
  </CEffectDamage>
  <CButton id="MephistoGoldenChargeTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_mephisto_lightning.dds" />
  </CButton>
  <CButton id="MephistoGoldenTempestTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_mephisto_lightning.dds" />
  </CButton>

  <!-- ===== Sith Lord ===== -->
  <!-- Basic Attacks have a 33% chance to fire a free Skull Missile at their target (script) and leech 50% of their damage; Basic Attacks on Heroes give 40% Attack Speed for 10 seconds; Skull Missile can't be cast; gain Shard of Hate. Rage quest (50% kept): 0.2% Basic Attack damage per Basic Attack hit on an enemy Hero. Dominion quest: takedowns within 6 seconds of a hit; stacks 1-40 add 0.1 Basic Attack range and skull reach each, 41-80 add 1% Movement Speed for 6 seconds after attacking each, at 100 Basic Attacks weaken enemies 30% (script), then 2% damage each (script). -->
  <CBehaviorTokenCounter id="MephistoGoldenRageTokenCounter" parent="StormQuestToken">
    <Face value="MephistoGoldenRageTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="MephistoGoldenDominionTokenCounter" parent="StormQuestToken">
    <Face value="MephistoGoldenDominionTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="MephistoGoldenRageTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="MephistoGoldenRageTokenCounter" />
    <Scale value="0.002" />
  </CAccumulatorToken>
  <CEffectDamage id="MephistoWeaponDamage">
    <MultiplicativeModifierArray index="MephistoSithPower" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSithCommon" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSithHit" Accumulator="MephistoGoldenRageTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="MephistoSithLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="MephistoWeaponShardOfHateDamage">
    <MultiplicativeModifierArray index="MephistoSithPower" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSithCommon" Modifier="0" />
    <MultiplicativeModifierArray index="MephistoSithHit" Accumulator="MephistoGoldenRageTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="MephistoSithLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="MephistoGoldenRageTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_mephisto_hatred.dds" />
  </CButton>
  <CButton id="MephistoGoldenDominionTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_mephisto_hatred.dds" />
  </CButton>

  <!-- ===== Boons ===== -->
  <!-- Dread at 100: when a Skull Missile ends, the script creates a skull where it stopped and it flies back to Mephisto,
       hitting each enemy in its path again (its own marker, so the forward skull's hits don't block it). It flies the skull's
       full range back along the line, through the point Mephisto stood on when it turned around. As the base skull, the launch runs as a behavior's expire effect on the skull
       unit: launched straight from the spawn effect, the missile was Mephisto, and its arrival killed him. -->
  <CEffectCreateUnit id="MephistoGoldenSkullReturnCreateUnit">
    <WhichLocation Value="TargetPoint" />
    <CreateFlags index="Placement" value="0" />
    <CreateFlags index="NormalizeSpawnOffset" value="0" />
    <SpawnEffect value="MephistoGoldenSkullReturnSpawnSet" />
    <SpawnUnit value="MephistoSkullMissileMissile" />
  </CEffectCreateUnit>
  <CEffectSet id="MephistoGoldenSkullReturnSpawnSet">
    <EffectArray value="MephistoGoldenSkullReturnSetFacing" />
    <EffectArray value="MephistoGoldenSkullReturnApplyDelay" />
  </CEffectSet>
  <CEffectModifyUnit id="MephistoGoldenSkullReturnSetFacing">
    <FacingLocation Effect="MephistoGoldenSkullReturnCreateUnit" Value="CasterPoint" />
  </CEffectModifyUnit>
  <CEffectApplyBehavior id="MephistoGoldenSkullReturnApplyDelay">
    <Behavior value="MephistoGoldenSkullReturnDelay" />
  </CEffectApplyBehavior>
  <CBehaviorBuff id="MephistoGoldenSkullReturnDelay">
    <Duration value="0.0625" />
    <ExpireEffect value="MephistoGoldenSkullReturnLaunch" />
  </CBehaviorBuff>
  <CEffectLaunchMissileAdvanced id="MephistoGoldenSkullReturnLaunch">
    <Marker>
      <MatchFlags index="Id" value="1" />
    </Marker>
    <ImpactLocation>
      <Effect value="MephistoGoldenSkullReturnCreateUnit" />
      <Value value="CasterPoint" />
      <ProjectionMultiplier value="1" />
      <ProjectionSourceValue value="TargetPoint" />
      <ProjectionTargetValue value="CasterPoint" />
      <UsesLineDash value="1" />
      <LineDashType value="AllowedInUnpathable" />
      <ProjectionDistanceScale value="12.5" />
    </ImpactLocation>
    <SharedFlags index="DynamicSearchArea" value="1" />
    <Movers Link="MephistoSkullMissileMissile" />
    <SearchEffect value="MephistoGoldenSkullReturnSearch" />
  </CEffectLaunchMissileAdvanced>
  <CEffectEnumArea id="MephistoGoldenSkullReturnSearch" parent="MephistoSkullMissileSearch">
    <AreaArray index="0" Effect="MephistoGoldenSkullReturnImpactSet" />
  </CEffectEnumArea>
  <CEffectSet id="MephistoGoldenSkullReturnImpactSet">
    <ValidatorArray value="noMarkers" />
    <EffectArray value="MephistoLordOfHatedSkullMissileShadeOfMephistoCDRSet" />
    <EffectArray value="MephistoGoldenSkullEchoDamage" />
    <EffectArray value="MephistoSkullMissileApplySlowSwitch" />
    <EffectArray value="MephistoSkullMissileAbhorredSkullApplyBehavior" />
    <EffectArray value="MephistoSkullMissileUnyieldingPowerAddToken" />
    <EffectArray value="ApplyAbilityImpactReveal" />
    <EffectArray value="MephistoShadeOfMephistoMaliciousIntentAddTokenCount" />
    <EffectArray value="MephistoShadeOfMephistoTrickeryAddTokenCount" />
    <EffectArray value="MephistoSkullMissileHatefulMendingManaRestoration" />
  </CEffectSet>
  <CActorModel id="MephistoGoldenSkullEchoImpactFX" parent="StormModelAnimationStyleOneShotUnit">
    <On Terms="Effect.MephistoGoldenSkullEchoDamage.Start; At Target" Send="Create" />
    <Model value="MephistoSkullMissileImpactFX" />
    <HostSiteOps Ops="SOpAttachCenter" HoldPosition="1" HoldRotation="1" />
  </CActorModel>
  <CActorSound id="MephistoGoldenSkullEchoImpactSound" parent="SoundOneShot">
    <On Terms="Effect.MephistoGoldenSkullEchoDamage.Start; At Target" Send="Create" />
    <Sound value="MephistoSkullMissileImpactSound" />
    <Sharing value="Always" />
    <ScopeBearingsTracking value="ForceOn" />
    <SoundFlags index="UpdateVisibility" value="0" />
  </CActorSound>
  <!-- Dread past 100 stacks: Mephisto's damage (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="MephistoGoldenOverdrive" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- ===== Storm of Hatred ===== -->
  <!-- Tempest at 100: Lightning Nova hits on non-Heroes also trigger Lord of Hatred's cooldown reduction (Chance 0, the script
       turns it on) -->
  <CEffectSet id="MephistoGoldenNovaTraitSet">
    <Chance value="0" />
    <ValidatorArray value="TargetNotHero" />
    <EffectArray value="MephistoLordOfHatredLightningNovaCDR" />
    <EffectArray value="MephistoLordOfHatredHysteriaLightningNovaCDR" />
  </CEffectSet>
  <CEffectSet id="MephistoLightningNovaImpactSet">
    <EffectArray value="MephistoGoldenNovaTraitSet" />
  </CEffectSet>
  <!-- Conductive (Epic): when Lightning Nova ends, a stationary nova stays where it ended for 3 seconds (Chance 0, the boon
       turns it on) -->
  <CEffectSet id="MephistoLightningNovaFinalSet">
    <EffectArray value="MephistoGoldenNovaFieldPersistent" />
  </CEffectSet>
  <CEffectCreatePersistent id="MephistoGoldenNovaFieldPersistent">
    <Chance value="0" />
    <WhichLocation Value="TargetPoint" />
    <PeriodicEffectArray value="MephistoGoldenNovaFieldSearchSet" />
    <PeriodicPeriodArray value="0.25" />
    <PeriodCount value="12" />
  </CEffectCreatePersistent>
  <CEffectSet id="MephistoGoldenNovaFieldSearchSet">
    <Marker Duration="0.25">
      <MatchFlags index="Id" value="1" />
    </Marker>
    <EffectArray value="MephistoGoldenNovaFieldSearch" />
  </CEffectSet>
  <CEffectEnumArea id="MephistoGoldenNovaFieldSearch" parent="MephistoLightningNovaLoopSearch">
    <AreaArray index="0" Effect="MephistoGoldenNovaFieldImpactSet" />
  </CEffectEnumArea>
  <CEffectSet id="MephistoGoldenNovaFieldImpactSet">
    <ValidatorArray value="noMarkers" />
    <EffectArray value="MephistoGoldenNovaFieldDamage" />
    <EffectArray value="MephistoLordOfHatredLightningNovaCDRSet" />
    <EffectArray value="MephistoGoldenNovaTraitSet" />
  </CEffectSet>
  <CActorModel id="MephistoGoldenNovaFieldFX" parent="StormModelAnimationStyleContinuous">
    <On Terms="Effect.MephistoGoldenNovaFieldPersistent.Start" Send="Create" />
    <On Terms="Effect.MephistoGoldenNovaFieldPersistent.Stop" Send="AnimBracketStop BSD" />
    <Model value="MephistoLightningNovaCastFX" />
  </CActorModel>
  <CActorModel id="MephistoGoldenNovaFieldImpactFX" parent="StormModelAnimationStyleOneShotUnit">
    <On Terms="Effect.MephistoGoldenNovaFieldDamage.Start; At Target" Send="Create" />
    <Model value="MephistoLightningNovaImpactFX" />
    <HostSiteOps Ops="SOpAttachCenter" HoldPosition="1" HoldRotation="1" />
  </CActorModel>
  <!-- Tempest past 100 stacks: Mephisto's damage (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="MephistoGoldenNovaOverdrive" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- ===== Sith Lord ===== -->
  <!-- Basic Attack effects (Chance 0: the starter, quest and boons turn them on). On the attacked unit: -->
  <CEffectSet id="MephistoWeaponPostImpactSet">
    <EffectArray value="MephistoGoldenFrenzyApply" />
    <EffectArray value="MephistoGoldenStrideApply" />
    <EffectArray value="MephistoGoldenWeakenApply" />
    <EffectArray value="MephistoGoldenTrickeryDamage" />
    <EffectArray value="MephistoGoldenTerrorSet" />
  </CEffectSet>
  <!-- and on Shard of Hate's splash targets: Weaken -->
  <CEffectSet id="MephistoShardOfHateWeaponPostImpactSet">
    <EffectArray value="MephistoGoldenWeakenApply" />
  </CEffectSet>
  <!-- Basic Attacks on Heroes: 40% Attack Speed for 10 seconds -->
  <CBehaviorBuff id="MephistoGoldenFrenzy">
    <Alignment value="Positive" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_hatred.dds" />
    <Duration value="10" />
    <Modification>
      <UnifiedAttackSpeedFactor value="0.4" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="MephistoGoldenFrenzyApply">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <WhichUnit Value="Caster" />
    <Behavior value="MephistoGoldenFrenzy" />
  </CEffectApplyBehavior>
  <!-- Dominion 41-80: Movement Speed for 6 seconds after attacking (the quest adds 1% per stack) -->
  <CBehaviorBuff id="MephistoGoldenStride">
    <Duration value="6" />
    <Modification>
      <UnifiedMoveSpeedFactor value="0" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="MephistoGoldenStrideApply">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="MephistoGoldenStride" />
  </CEffectApplyBehavior>
  <!-- Dominion at 100: Basic Attacks weaken enemies (30% less damage dealt for 3 seconds) -->
  <CBehaviorBuff id="MephistoGoldenWeaken">
    <Alignment value="Negative" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_hatred.dds" />
    <BehaviorCategories index="DebuffAbilityPower" value="1" />
    <BehaviorCategories index="DebuffAutoattackDPS" value="1" />
    <Duration value="3" />
    <Modification>
      <DamageDealtFraction index="Splash" value="-0.3" />
      <DamageDealtFraction index="Basic" value="-0.3" />
      <DamageDealtFraction index="Ability" value="-0.3" />
    </Modification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="MephistoGoldenWeakenApply">
    <Chance value="0" />
    <Behavior value="MephistoGoldenWeaken" />
  </CEffectApplyBehavior>
  <!-- Trickery (Rare): Basic Attacks on Heroes also deal 1% of their maximum Health -->
  <CEffectDamage id="MephistoGoldenTrickeryDamage" parent="StormSpellPercentDamage">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <VitalFractionMax index="Life" value="0.01" />
    <SourceButtonFace value="Attack" />
  </CEffectDamage>
  <!-- Lord of Terror (Legendary): Basic Attacks Stun an enemy Hero for 1.5 seconds, once every 5 seconds per Hero -->
  <CBehaviorBuff id="MephistoGoldenTerrorStun" parent="StormStun">
    <Duration value="1.5" />
  </CBehaviorBuff>
  <CBehaviorBuff id="MephistoGoldenTerrorCooldown">
    <Duration value="5" />
  </CBehaviorBuff>
  <CValidatorUnitCompareBehaviorCount id="MephistoGoldenTargetNotTerrorCooldown">
    <Compare value="EQ" />
    <Value value="0" />
    <Behavior value="MephistoGoldenTerrorCooldown" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectApplyBehavior id="MephistoGoldenTerrorStunApply">
    <Behavior value="MephistoGoldenTerrorStun" />
  </CEffectApplyBehavior>
  <CEffectApplyBehavior id="MephistoGoldenTerrorCooldownApply">
    <Behavior value="MephistoGoldenTerrorCooldown" />
  </CEffectApplyBehavior>
  <CEffectSet id="MephistoGoldenTerrorSet">
    <Chance value="0" />
    <ValidatorArray value="TargetIsHero" />
    <ValidatorArray value="MephistoGoldenTargetNotTerrorCooldown" />
    <EffectArray value="MephistoGoldenTerrorCooldownApply" />
    <EffectArray value="MephistoGoldenTerrorStunApply" />
  </CEffectSet>
  <!-- Shadow Shield (Epic): Basic Attacks on Heroes shield Mephisto for 30% of his maximum Health, decaying to nothing over
       1.5 seconds: 6 shields of 5% each expire one every 0.25 seconds (the script sets the amounts and re-adds them) -->
  <CBehaviorBuff id="MephistoGoldenShadowShield1" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_shade.dds" />
    <Duration value="0.25" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <CBehaviorBuff id="MephistoGoldenShadowShield2" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_shade.dds" />
    <Duration value="0.5" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <CBehaviorBuff id="MephistoGoldenShadowShield3" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_shade.dds" />
    <Duration value="0.75" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <CBehaviorBuff id="MephistoGoldenShadowShield4" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_shade.dds" />
    <Duration value="1.0" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <CBehaviorBuff id="MephistoGoldenShadowShield5" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_shade.dds" />
    <Duration value="1.25" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <CBehaviorBuff id="MephistoGoldenShadowShield6" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_shade.dds" />
    <Duration value="1.5" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <!-- Sith Lord can't cast Skull Missile itself -->
  <CBehaviorBuff id="MephistoGoldenSkullSealed">
    <BehaviorFlags index="Permanent" value="1" />
    <Modification>
      <AbilLinkDisableArray value="MephistoSkullMissile" />
    </Modification>
  </CBehaviorBuff>
  <!-- Dominion past 100 stacks: Mephisto's damage (the script sets the amount and re-adds it) -->
  <CBehaviorBuff id="MephistoGoldenSithOverdrive" parent="CarryBehaviorParent">
    <Modification>
      <DamageDealtFraction index="Basic" value="0" />
      <DamageDealtFraction index="Ability" value="0" />
    </Modification>
  </CBehaviorBuff>
  <!-- Skull Storm (Legendary): shown while it's ready -->
  <CBehaviorBuff id="MephistoGoldenSkullStormReady">
    <Alignment value="Positive" />
    <InfoFlags index="Hidden" value="0" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_mephisto_skull.dds" />
    <BehaviorFlags index="Permanent" value="1" />
  </CBehaviorBuff>
</Catalog>
