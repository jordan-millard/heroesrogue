  <!-- ===== Boons ===== -->
  <!-- Barbed Arrows (Epic, Hungering Hunter): Hungering Arrow hits on Heroes take 5 Armor for 4 seconds, up to 4 times -->
  <CBehaviorBuff id="VallaBarbedArrowsDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_valla_hungeringarrow.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <MaxStackCount value="4" />
    <Duration value="4" />
    <ArmorModification>
      <AllArmorBonus value="-5" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="VallaBarbedArrowsApply">
    <Behavior value="VallaBarbedArrowsDebuff" />
  </CEffectApplyBehavior>
  <!-- Bloodhound (Rare): Hungering Arrow hits on Heroes take 2 seconds off Vault's recharge -->
  <CEffectModifyUnit id="VallaBloodhoundModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="DemonHunterVault,Execute" CooldownOperation="Add" CooldownTimeUse="-2" ChargeTimeUse="-2" />
  </CEffectModifyUnit>
  <!-- Insatiable (Legendary): a takedown within 3 seconds of a Hungering Arrow hit refills Hungering Arrow's charges -->
  <CEffectModifyUnit id="VallaInsatiableRefill">
    <ImpactUnit Value="Caster" />
    <Cost Abil="DemonHunterHungeringArrow,Execute" ChargeCountUse="-5" CooldownOperation="Set" CooldownTimeUse="0" />
  </CEffectModifyUnit>
  <!-- Hail of Arrows (Rare, Multishot Marksman): Multishot hits on Heroes take 1.5 seconds off Hungering Arrow -->
  <CEffectModifyUnit id="VallaHailOfArrowsModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="DemonHunterHungeringArrow,Execute" CooldownOperation="Add" CooldownTimeUse="-1.5" ChargeTimeUse="-1.5" />
  </CEffectModifyUnit>
  <!-- Marked for Death (Epic): Multishot hits on Heroes take 10 Armor for 3 seconds -->
  <CBehaviorBuff id="VallaMarkedForDeathDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_valla_multishot.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <Duration value="3" />
    <ArmorModification>
      <AllArmorBonus value="-10" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="VallaMarkedForDeathApply">
    <Behavior value="VallaMarkedForDeathDebuff" />
  </CEffectApplyBehavior>
  <!-- Tumble (Rare, Strafe Queen): Strafe hits on Heroes take 0.5 seconds off Vault's recharge -->
  <CEffectModifyUnit id="VallaTumbleModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="DemonHunterVault,Execute" CooldownOperation="Add" CooldownTimeUse="-0.5" ChargeTimeUse="-0.5" />
  </CEffectModifyUnit>
  <!-- Shadow Cloak (Epic): 25 Armor while Strafing (Strafe's initial set applies it; the boon turns it on) -->
  <CBehaviorBuff id="VallaShadowCloakBuff" parent="StormArmor">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_valla_strafe.dds" />
    <RemoveValidatorArray value="DemonHunterHasStrafeBuff" />
    <ArmorModification>
      <AllArmorBonus value="25" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="VallaShadowCloakApply">
    <Chance value="0" />
    <WhichUnit Value="Caster" />
    <Behavior value="VallaShadowCloakBuff" />
  </CEffectApplyBehavior>
  <CEffectSet id="StrafeInitialSet">
    <EffectArray value="VallaShadowCloakApply" />
  </CEffectSet>
</Catalog>
