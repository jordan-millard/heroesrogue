  <!-- ===== Strafe Queen ===== -->
  <!-- Strafe from level 1. Rapid Fire quest (50% kept): 0.1% Strafe damage per enemy Hero hit. Endless Hunt quest: takedowns within 3 seconds of a hit; 0.1 seconds of Strafe each up to 2 seconds, then 1% damage each (script). -->
  <CBehaviorTokenCounter id="VallaRapidFireTokenCounter" parent="StormQuestToken">
    <Face value="VallaRapidFireTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="VallaEndlessHuntTokenCounter" parent="StormQuestToken">
    <Face value="VallaEndlessHuntTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="VallaRapidFireTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="VallaRapidFireTokenCounter" />
    <Scale value="0.001" />
  </CAccumulatorToken>
  <CEffectDamage id="DemonHunterStrafeBasicWeaponDamage">
    <MultiplicativeModifierArray index="VallaStrafePower" Modifier="0" />
    <MultiplicativeModifierArray index="VallaStrafeCommon" Modifier="0" />
    <MultiplicativeModifierArray index="VallaStrafeHit" Accumulator="VallaRapidFireTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="VallaStrafeLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="DemonHunterStrafeDeathSiphonDamage">
    <MultiplicativeModifierArray index="VallaStrafePower" Modifier="0" />
    <MultiplicativeModifierArray index="VallaStrafeCommon" Modifier="0" />
    <MultiplicativeModifierArray index="VallaStrafeHit" Accumulator="VallaRapidFireTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="VallaStrafeLegacy" Modifier="0" />
  </CEffectDamage>
