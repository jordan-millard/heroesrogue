  <!-- ============================================================ -->
  <!-- Golden Valla. Starters: Hungering Hunter (Hungering Arrow), Multishot Marksman (Multishot) and Strafe Queen (Strafe from level 1). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script). Hits, quests and script boons are in HeroTriggers/Valla.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="VallaHungerMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaVolleyMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaStrafeMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaBarbedArrowsMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaBloodhoundMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaInsatiableMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaHailOfArrowsMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaMarkedForDeathMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaVolleyOfHatredMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaTumbleMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="VallaRelentlessMarker" parent="CarryBehaviorParent" />

  <!-- ===== Hungering Hunter ===== -->
  <!-- Hunger quest (50% kept): 0.5% Hungering Arrow damage per enemy Hero hit. Trophy Hunter quest: takedowns within 3 seconds of a hit; every 15 stacks 1 more charge (up to 2), past 30 stacks 1% damage each (script). -->
  <CBehaviorTokenCounter id="VallaHungerTokenCounter" parent="StormQuestToken">
    <Face value="VallaHungerTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="VallaTrophyHunterTokenCounter" parent="StormQuestToken">
    <Face value="VallaTrophyHunterTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="VallaHungerTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="VallaHungerTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="HungeringArrowDamage1">
    <MultiplicativeModifierArray index="VallaHungerPower" Modifier="0" />
    <MultiplicativeModifierArray index="VallaHungerCommon" Modifier="0" />
    <MultiplicativeModifierArray index="VallaHungerHit" Accumulator="VallaHungerTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="VallaHungerLegacy" Modifier="0" />
