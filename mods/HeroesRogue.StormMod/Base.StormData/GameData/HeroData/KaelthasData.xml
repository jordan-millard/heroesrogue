<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Kael'thas. Starters: Sunfire (Flamestrike), Bombardier (Living Bomb) and Pyromancer (Pyroblast from level 1). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script). Hits, quests and script boons are in HeroTriggers/Kaelthas.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="KaelthasFlamestrikeMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasBombMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasPyroMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasKindlingMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasScorchMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasTwinSunsMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasChainReactionMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasSearingMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasPyroclasmMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasMeteorStrikeMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KaelthasInfernoMarker" parent="CarryBehaviorParent" />

  <!-- ===== Sunfire ===== -->
  <!-- Ember quest (50% kept): 0.5% Flamestrike damage per enemy Hero hit. Sunwell quest: takedowns within 3 seconds of a hit; 1% Flamestrike radius each up to 30%, then 1% Flamestrike damage each (script). -->
  <CBehaviorTokenCounter id="KaelthasEmberTokenCounter" parent="StormQuestToken">
    <Face value="KaelthasEmberTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KaelthasSunwellTokenCounter" parent="StormQuestToken">
    <Face value="KaelthasSunwellTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KaelthasEmberTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KaelthasEmberTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="KaelthasFlamestrikeDamage">
    <MultiplicativeModifierArray index="KaelthasFlamestrikePower" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasFlamestrikeCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasFlamestrikeHit" Accumulator="KaelthasEmberTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KaelthasFlamestrikeLegacy" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasSunfireRing1" Validator="KaelthasSunfireTargetRing1" Modifier="-0.25" />
    <MultiplicativeModifierArray index="KaelthasSunfireRing2" Validator="KaelthasSunfireTargetRing2" Modifier="-0.5" />
  </CEffectDamage>
  <CEffectModifyUnit id="KaelthasFlamestrikeHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.02" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="KaelthasEmberTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kaelthas_flamestrike.dds" />
  </CButton>
  <CButton id="KaelthasSunwellTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kaelthas_flamestrike.dds" />
  </CButton>

  <!-- ===== Bombardier ===== -->
  <!-- Fuse quest (50% kept): 0.5% Living Bomb damage per enemy Hero hit. Chain Detonation quest: takedowns within 3 seconds of a hit; every 15 stacks 1 more charge (up to 2), past 30 stacks 1% damage each (script). -->
  <CBehaviorTokenCounter id="KaelthasFuseTokenCounter" parent="StormQuestToken">
    <Face value="KaelthasFuseTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KaelthasChainDetonationTokenCounter" parent="StormQuestToken">
    <Face value="KaelthasChainDetonationTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KaelthasFuseTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KaelthasFuseTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="KaelthasLivingBombImpactDamage">
    <MultiplicativeModifierArray index="KaelthasBombPower" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasBombCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasBombHit" Accumulator="KaelthasFuseTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KaelthasBombLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KaelthasLivingBombDoTDamage">
    <MultiplicativeModifierArray index="KaelthasBombPower" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasBombCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasBombHit" Accumulator="KaelthasFuseTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KaelthasBombLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KaelthasLivingBombExplosionDamage">
    <MultiplicativeModifierArray index="KaelthasBombPower" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasBombCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasBombHit" Accumulator="KaelthasFuseTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KaelthasBombLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="KaelthasBombHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.015" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="KaelthasFuseTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kaelthas_livingbomb.dds" />
  </CButton>
  <CButton id="KaelthasChainDetonationTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kaelthas_livingbomb.dds" />
  </CButton>

  <!-- ===== Pyromancer ===== -->
  <!-- Pyroblast from level 1. Firestorm quest (50% kept): 1% Pyroblast damage per enemy Hero hit. Phoenix Fire quest: takedowns within 3 seconds of a hit; 1% of the 20 second cooldown each up to 40%, then 1% damage each (script). -->
  <CBehaviorTokenCounter id="KaelthasFirestormTokenCounter" parent="StormQuestToken">
    <Face value="KaelthasFirestormTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KaelthasPhoenixFireTokenCounter" parent="StormQuestToken">
    <Face value="KaelthasPhoenixFireTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KaelthasFirestormTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KaelthasFirestormTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="KaelthasPyroblastDamage">
    <MultiplicativeModifierArray index="KaelthasPyroPower" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasPyroCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasPyroHit" Accumulator="KaelthasFirestormTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KaelthasPyroLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KaelthasPyroblastSplashDamage">
    <MultiplicativeModifierArray index="KaelthasPyroPower" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasPyroCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KaelthasPyroHit" Accumulator="KaelthasFirestormTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KaelthasPyroLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectModifyUnit id="KaelthasPyroHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.05" />
    </VitalArray>
  </CEffectModifyUnit>
  <CButton id="KaelthasFirestormTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kaelthas_pyroblast.dds" />
  </CButton>
  <CButton id="KaelthasPhoenixFireTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kaelthas_pyroblast.dds" />
  </CButton>

  <!-- ===== Boons ===== -->
  <!-- Kindling (Rare, Sunfire): Flamestrike hits on Heroes take 1 second off Living Bomb -->
  <CEffectModifyUnit id="KaelthasKindlingModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KaelthasLivingBomb,Execute" CooldownOperation="Add" CooldownTimeUse="-1" ChargeTimeUse="-1" />
  </CEffectModifyUnit>
  <!-- Scorch (Epic): Flamestrike hits on Heroes take 10 Armor for 3 seconds -->
  <CBehaviorBuff id="KaelthasScorchDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_kaelthas_flamestrike.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <Duration value="3" />
    <ArmorModification>
      <AllArmorBonus value="-10" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="KaelthasScorchApply">
    <Behavior value="KaelthasScorchDebuff" />
  </CEffectApplyBehavior>
  <!-- Chain Reaction (Rare, Bombardier): Living Bomb explosion hits on Heroes take 1 second off Flamestrike -->
  <CEffectModifyUnit id="KaelthasChainReactionModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KaelthasFlamestrike,Execute" CooldownOperation="Add" CooldownTimeUse="-1" ChargeTimeUse="-1" />
  </CEffectModifyUnit>
  <!-- Searing Bomb (Epic): Living Bomb hits on Heroes take 5 Armor for 4 seconds, stacking up to 3 times -->
  <CBehaviorBuff id="KaelthasSearingDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_kaelthas_livingbomb.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <MaxStackCount value="3" />
    <Duration value="4" />
    <ArmorModification>
      <AllArmorBonus value="-5" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="KaelthasSearingApply">
    <Behavior value="KaelthasSearingDebuff" />
  </CEffectApplyBehavior>
  <!-- Pyroclasm (Rare, Pyromancer): Pyroblast hits on Heroes restore 40 Mana -->
  <CEffectModifyUnit id="KaelthasPyroclasmMana">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Energy" Change="40" />
  </CEffectModifyUnit>
  <!-- Bombardier: Verdant Spheres normally zeroes Living Bomb's cooldown for the empowered cast, which does nothing
       once Living Bomb uses charges, so the script refunds the charge instead -->
  <CEffectModifyUnit id="KaelthasBombVerdantRefund">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KaelthasLivingBomb,Execute" ChargeCountUse="-1" CooldownOperation="Set" CooldownTimeUse="0" />
  </CEffectModifyUnit>
  <!-- Sunfire, Sunwell quest: the script gives one level of this upgrade per 5 stacks (up to 6 at 30), and each level
       scales the Flamestrike warning and ground fire models 5% more for that player, to match the bigger radius -->
  <CUpgrade id="KaelthasSunwellScaleUpgrade">
    <MaxLevel value="6" />
  </CUpgrade>
  <CRequirementCountUpgrade id="KaelthasCountUpgradeSunwellScale">
    <Flags index="TechTreeCheat" value="0" />
    <Count Link="KaelthasSunwellScaleUpgrade" State="QueuedOrBetter" />
  </CRequirementCountUpgrade>
  <CRequirementGTE id="KaelthasGTECountUpgradeSunwellScale1">
    <OperandArray index="0" value="KaelthasCountUpgradeSunwellScale" />
    <OperandArray index="1" value="1" />
  </CRequirementGTE>
  <CRequirement id="KaelthasHasSunwellScale1Upgrade">
    <NodeArray index="Use" Link="KaelthasGTECountUpgradeSunwellScale1" />
    <NodeArray index="Show" Link="KaelthasGTECountUpgradeSunwellScale1" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KaelthasHasSunwellScale1">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KaelthasHasSunwellScale1Upgrade" />
  </CValidatorPlayerRequirement>
  <CRequirementGTE id="KaelthasGTECountUpgradeSunwellScale2">
    <OperandArray index="0" value="KaelthasCountUpgradeSunwellScale" />
    <OperandArray index="1" value="2" />
  </CRequirementGTE>
  <CRequirement id="KaelthasHasSunwellScale2Upgrade">
    <NodeArray index="Use" Link="KaelthasGTECountUpgradeSunwellScale2" />
    <NodeArray index="Show" Link="KaelthasGTECountUpgradeSunwellScale2" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KaelthasHasSunwellScale2">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KaelthasHasSunwellScale2Upgrade" />
  </CValidatorPlayerRequirement>
  <CRequirementGTE id="KaelthasGTECountUpgradeSunwellScale3">
    <OperandArray index="0" value="KaelthasCountUpgradeSunwellScale" />
    <OperandArray index="1" value="3" />
  </CRequirementGTE>
  <CRequirement id="KaelthasHasSunwellScale3Upgrade">
    <NodeArray index="Use" Link="KaelthasGTECountUpgradeSunwellScale3" />
    <NodeArray index="Show" Link="KaelthasGTECountUpgradeSunwellScale3" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KaelthasHasSunwellScale3">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KaelthasHasSunwellScale3Upgrade" />
  </CValidatorPlayerRequirement>
  <CRequirementGTE id="KaelthasGTECountUpgradeSunwellScale4">
    <OperandArray index="0" value="KaelthasCountUpgradeSunwellScale" />
    <OperandArray index="1" value="4" />
  </CRequirementGTE>
  <CRequirement id="KaelthasHasSunwellScale4Upgrade">
    <NodeArray index="Use" Link="KaelthasGTECountUpgradeSunwellScale4" />
    <NodeArray index="Show" Link="KaelthasGTECountUpgradeSunwellScale4" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KaelthasHasSunwellScale4">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KaelthasHasSunwellScale4Upgrade" />
  </CValidatorPlayerRequirement>
  <CRequirementGTE id="KaelthasGTECountUpgradeSunwellScale5">
    <OperandArray index="0" value="KaelthasCountUpgradeSunwellScale" />
    <OperandArray index="1" value="5" />
  </CRequirementGTE>
  <CRequirement id="KaelthasHasSunwellScale5Upgrade">
    <NodeArray index="Use" Link="KaelthasGTECountUpgradeSunwellScale5" />
    <NodeArray index="Show" Link="KaelthasGTECountUpgradeSunwellScale5" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KaelthasHasSunwellScale5">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KaelthasHasSunwellScale5Upgrade" />
  </CValidatorPlayerRequirement>
  <CRequirementGTE id="KaelthasGTECountUpgradeSunwellScale6">
    <OperandArray index="0" value="KaelthasCountUpgradeSunwellScale" />
    <OperandArray index="1" value="6" />
  </CRequirementGTE>
  <CRequirement id="KaelthasHasSunwellScale6Upgrade">
    <NodeArray index="Use" Link="KaelthasGTECountUpgradeSunwellScale6" />
    <NodeArray index="Show" Link="KaelthasGTECountUpgradeSunwellScale6" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KaelthasHasSunwellScale6">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KaelthasHasSunwellScale6Upgrade" />
  </CValidatorPlayerRequirement>
  <CActorModel id="KaelthasFlamestrikeWarning">
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale1" Send="SetScale 1.05" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale2" Send="SetScale 1.10" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale3" Send="SetScale 1.15" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale4" Send="SetScale 1.20" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale5" Send="SetScale 1.25" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale6" Send="SetScale 1.30" />
  </CActorModel>
  <CActorModel id="KaelthasFlamestrikeGroundImpact">
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale1" Send="SetScale 1.05" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale2" Send="SetScale 1.10" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale3" Send="SetScale 1.15" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale4" Send="SetScale 1.20" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale5" Send="SetScale 1.25" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale6" Send="SetScale 1.30" />
  </CActorModel>
  <CActorModel id="KaelthasFlamestrikeVerdantSpheresWarning">
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunfireRings" Send="SetScale 0.67" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale1" Send="SetScale 0.70" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale2" Send="SetScale 0.74" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale3" Send="SetScale 0.77" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale4" Send="SetScale 0.80" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale5" Send="SetScale 0.84" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale6" Send="SetScale 0.87" />
  </CActorModel>
  <CActorModel id="KaelthasFlamestrikeVerdantSpheresGroundImpact">
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunfireRings" Send="SetScale 0.67" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale1" Send="SetScale 0.70" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale2" Send="SetScale 0.74" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale3" Send="SetScale 0.77" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale4" Send="SetScale 0.80" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale5" Send="SetScale 0.84" />
    <On Terms="ActorCreation; ValidatePlayer KaelthasHasSunwellScale6" Send="SetScale 0.87" />
  </CActorModel>
  <!-- Sunfire: a Verdant Spheres Flamestrike lands at normal size (radius 2), then the script sends out a ring of fire
       from 2 to 4 and another from 4 to 6, 0.35 seconds apart. Each ring hits only what is past its inner edge, with the
       Verdant Spheres Flamestrike impact. The Sunwell quest grows every radius (script). -->
  <CUpgrade id="KaelthasSunfireRingsUpgrade" />
  <CRequirementCountUpgrade id="KaelthasCountUpgradeSunfireRings">
    <Flags index="TechTreeCheat" value="0" />
    <Count Link="KaelthasSunfireRingsUpgrade" State="QueuedOrBetter" />
  </CRequirementCountUpgrade>
  <CRequirementGTE id="KaelthasGTECountUpgradeSunfireRings1">
    <OperandArray index="0" value="KaelthasCountUpgradeSunfireRings" />
    <OperandArray index="1" value="1" />
  </CRequirementGTE>
  <CRequirement id="KaelthasHasSunfireRingsUpgrade">
    <NodeArray index="Use" Link="KaelthasGTECountUpgradeSunfireRings1" />
    <NodeArray index="Show" Link="KaelthasGTECountUpgradeSunfireRings1" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KaelthasHasSunfireRings">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KaelthasHasSunfireRingsUpgrade" />
  </CValidatorPlayerRequirement>
  <CValidatorLocationCompareRange id="KaelthasSunfireRing1Outside">
    <WhichLocation Value="TargetUnit" />
    <Compare value="GT" />
    <Range value="2" />
    <Value Effect="KaelthasSunfireRing1Search" Value="TargetPoint" />
  </CValidatorLocationCompareRange>
  <!-- ring 1 deals 75% damage: it marks what it hits for a moment, and Flamestrike damage checks the mark -->
  <CBehaviorBuff id="KaelthasSunfireRing1Hit">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.0625" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="KaelthasSunfireRing1Mark">
    <Behavior value="KaelthasSunfireRing1Hit" />
  </CEffectApplyBehavior>
  <CValidatorUnitCompareBehaviorCount id="KaelthasSunfireTargetRing1">
    <Compare value="GE" />
    <Value value="1" />
    <Behavior value="KaelthasSunfireRing1Hit" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectSet id="KaelthasSunfireRing1Set">
    <ValidatorArray value="KaelthasSunfireRing1Outside" />
    <EffectArray value="KaelthasSunfireRing1Mark" />
    <EffectArray value="KaelthasFlamestrikeVerdantSpheresImpactSet" />
  </CEffectSet>
  <CEffectEnumArea id="KaelthasSunfireRing1Search">
    <ImpactLocation Value="TargetPoint" />
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="KaelthasSunfireRing1Set">
      <Radius value="4" />
    </AreaArray>
    <SearchFlags index="DoActorSearch" value="1" />
  </CEffectEnumArea>
  <CValidatorLocationCompareRange id="KaelthasSunfireRing2Outside">
    <WhichLocation Value="TargetUnit" />
    <Compare value="GT" />
    <Range value="4" />
    <Value Effect="KaelthasSunfireRing2Search" Value="TargetPoint" />
  </CValidatorLocationCompareRange>
  <!-- ring 2 deals 50% damage: it marks what it hits for a moment, and Flamestrike damage checks the mark -->
  <CBehaviorBuff id="KaelthasSunfireRing2Hit">
    <InfoFlags index="Hidden" value="1" />
    <Duration value="0.0625" />
  </CBehaviorBuff>
  <CEffectApplyBehavior id="KaelthasSunfireRing2Mark">
    <Behavior value="KaelthasSunfireRing2Hit" />
  </CEffectApplyBehavior>
  <CValidatorUnitCompareBehaviorCount id="KaelthasSunfireTargetRing2">
    <Compare value="GE" />
    <Value value="1" />
    <Behavior value="KaelthasSunfireRing2Hit" />
  </CValidatorUnitCompareBehaviorCount>
  <CEffectSet id="KaelthasSunfireRing2Set">
    <ValidatorArray value="KaelthasSunfireRing2Outside" />
    <EffectArray value="KaelthasSunfireRing2Mark" />
    <EffectArray value="KaelthasFlamestrikeVerdantSpheresImpactSet" />
  </CEffectSet>
  <CEffectEnumArea id="KaelthasSunfireRing2Search">
    <ImpactLocation Value="TargetPoint" />
    <SearchFilters value="-;Player,Ally,Neutral,ImmuneToAOE,Missile,Stasis,Dead,Hidden,Invulnerable" />
    <AreaArray Effect="KaelthasSunfireRing2Set">
      <Radius value="6" />
    </AreaArray>
    <SearchFlags index="DoActorSearch" value="1" />
  </CEffectEnumArea>
  <!-- ring visuals: small copies of the Flamestrike ground fire placed around each ring (script) -->
  <CEffectCreatePersistent id="KaelthasSunfireRingBlast">
    <WhichLocation Value="TargetPoint" />
  </CEffectCreatePersistent>
  <CActorModel id="KaelthasSunfireRingBlast" parent="KaelthasFlamestrikeGroundImpact">
    <Remove Terms="Effect.KaelthasFlamestrikeSearchArea.Start; At Effect" Send="Create" />
    <On Terms="Effect.KaelthasSunfireRingBlast.Start; At Effect" Send="Create" />
    <On Terms="ActorCreation" Send="SetScale 0.6" />
  </CActorModel>
  <CActorSound id="KaelthasSunfireRingSound" parent="SoundOneShot">
    <On Terms="Effect.KaelthasSunfireRing1Search.Start; At Effect" Send="Create" />
    <On Terms="Effect.KaelthasSunfireRing2Search.Start; At Effect" Send="Create" />
    <Sound value="Kaelthas_Flamestrike_Impact" />
