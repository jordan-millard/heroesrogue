<?xml version="1.0" encoding="us-ascii"?>
<Catalog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/jamiephan/HeroesOfTheStorm_Gamedata/master/xsd/latest.xsd">

  <!-- ============================================================ -->
  <!-- Golden Kerrigan. Starters: Queen of Blades (Ravage), Impaler (Impaling Blades) and Brood Mother (Summon Ultralisk from level 1). Each damage effect has its own multipliers: starter power, Common boon, hit quest (accumulator) and takedown quest past its cap (Modifier set by the script). Hits, quests and script boons are in HeroTriggers/Kerrigan.galaxy. -->
  <!-- ============================================================ -->
  <CBehaviorBuff id="KerriganRavageMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganBladesMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganUltraMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganBladedFuryMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganRendMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganEndlessHungerMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganImpaleMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganSkeweredMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganTwinBladesMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganPrimalRageMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganCorrosiveMarker" parent="CarryBehaviorParent" />
  <CBehaviorBuff id="KerriganBroodExpansionMarker" parent="CarryBehaviorParent" />

  <!-- ===== Queen of Blades ===== -->
  <!-- Ravage hits on enemy Heroes heal 10% maximum Health over 5 seconds. Bloodlust quest (50% kept): 1% Ravage damage per enemy Hero hit. Swarm Queen quest: takedowns within 3 seconds of a hit; 1% Ravage range and 1% more Ravage healing each, up to 50 stacks, then 1% damage each (script). -->
  <CBehaviorTokenCounter id="KerriganBloodlustTokenCounter" parent="StormQuestToken">
    <Face value="KerriganBloodlustTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KerriganSwarmQueenTokenCounter" parent="StormQuestToken">
    <Face value="KerriganSwarmQueenTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KerriganBloodlustTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KerriganBloodlustTokenCounter" />
    <Scale value="0.01" />
  </CAccumulatorToken>
  <CEffectDamage id="KerriganRavageDamage">
    <MultiplicativeModifierArray index="KerriganRavagePower" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganRavageCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganRavageHit" Accumulator="KerriganBloodlustTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KerriganRavageLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="KerriganBloodlustTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kerrigan_ravage.dds" />
  </CButton>
  <CButton id="KerriganSwarmQueenTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kerrigan_ravage.dds" />
  </CButton>

  <!-- ===== Impaler ===== -->
  <!-- Impaling Blades: radius 2.5 (from 1.65), erupts after 0.5 seconds (from 1); hitting 2 or more enemy Heroes at once refunds it (script). Spikes quest (50% kept): 0.5% Impaling Blades damage per enemy Hero hit. Kinetic Storm quest: takedowns within 3 seconds of a hit; 1% off Impaling Blades and Primal Grasp cooldowns each up to 30%, then 1% damage each (script). -->
  <CBehaviorTokenCounter id="KerriganSpikesTokenCounter" parent="StormQuestToken">
    <Face value="KerriganSpikesTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KerriganKineticStormTokenCounter" parent="StormQuestToken">
    <Face value="KerriganKineticStormTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KerriganSpikesTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KerriganSpikesTokenCounter" />
    <Scale value="0.005" />
  </CAccumulatorToken>
  <CEffectDamage id="KerriganImpalingBladesDamage">
    <MultiplicativeModifierArray index="KerriganBladesPower" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganBladesCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganBladesHit" Accumulator="KerriganSpikesTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KerriganBladesLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KerriganImpalingBladesPainfulSpikesDamage">
    <MultiplicativeModifierArray index="KerriganBladesPower" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganBladesCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganBladesHit" Accumulator="KerriganSpikesTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KerriganBladesLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="KerriganSpikesTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kerrigan_impalingblades.dds" />
  </CButton>
  <CButton id="KerriganKineticStormTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kerrigan_impalingblades.dds" />
  </CButton>

  <!-- ===== Brood Mother ===== -->
  <!-- Summon Ultralisk from level 1. Ultralisk hits on enemy Heroes grant Shields for 40% of the damage (script). Brood quest (50% kept): 0.25% Ultralisk damage per enemy Hero hit. Hive Mind quest: takedowns within 3 seconds of an Ultralisk hit; 1% of the 20 second cooldown each up to 40%, then 1% damage each (script). -->
  <CBehaviorTokenCounter id="KerriganBroodTokenCounter" parent="StormQuestToken">
    <Face value="KerriganBroodTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CBehaviorTokenCounter id="KerriganHiveMindTokenCounter" parent="StormQuestToken">
    <Face value="KerriganHiveMindTokenCounter" />
    <Max value="100000" />
  </CBehaviorTokenCounter>
  <CAccumulatorToken id="KerriganBroodTokenCounterAccumulator" parent="BaseTokenAccumulator">
    <MinAccumulation value="0" />
    <MaxAccumulation value="100000" />
    <ApplicationRule value="Add" />
    <TokenId value="KerriganBroodTokenCounter" />
    <Scale value="0.0025" />
  </CAccumulatorToken>
  <CEffectDamage id="KerriganUltraliskWeaponDamage">
    <MultiplicativeModifierArray index="KerriganUltraPower" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganUltraCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganUltraHit" Accumulator="KerriganBroodTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KerriganUltraLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KerriganUltraliskWeaponSplashDamage">
    <MultiplicativeModifierArray index="KerriganUltraPower" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganUltraCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganUltraHit" Accumulator="KerriganBroodTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KerriganUltraLegacy" Modifier="0" />
  </CEffectDamage>
  <CEffectDamage id="KerriganUltraliskChargeDamage">
    <MultiplicativeModifierArray index="KerriganUltraPower" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganUltraCommon" Modifier="0" />
    <MultiplicativeModifierArray index="KerriganUltraHit" Accumulator="KerriganBroodTokenCounterAccumulator" />
    <MultiplicativeModifierArray index="KerriganUltraLegacy" Modifier="0" />
  </CEffectDamage>
  <CButton id="KerriganBroodTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kerrigan_ultralisk.dds" />
  </CButton>
  <CButton id="KerriganHiveMindTokenCounter" parent="StormButtonParent">
    <Icon value="Assets\Textures\storm_ui_icon_kerrigan_ultralisk.dds" />
  </CButton>

  <!-- ===== Boons ===== -->
  <!-- Bladed Fury (Rare, Queen of Blades): Ravage hits on Heroes take 1 second off Impaling Blades -->
  <CEffectModifyUnit id="KerriganBladedFuryModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KerriganImpalingBlades,Execute" CooldownOperation="Add" CooldownTimeUse="-1" ChargeTimeUse="-1" />
  </CEffectModifyUnit>
  <!-- Rend (Epic): Ravage hits on Heroes take 5 Armor for 4 seconds, stacking up to 4 times -->
  <CBehaviorBuff id="KerriganRendDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_kerrigan_ravage.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <MaxStackCount value="4" />
    <Duration value="4" />
    <ArmorModification>
      <AllArmorBonus value="-5" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="KerriganRendApply">
    <Behavior value="KerriganRendDebuff" />
  </CEffectApplyBehavior>
  <!-- Endless Hunger (Legendary): a takedown within 3 seconds of a Ravage hit refills Ravage -->
  <CEffectModifyUnit id="KerriganEndlessHungerRefill">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KerriganRavage,Execute" ChargeCountUse="-5" CooldownOperation="Set" CooldownTimeUse="0" />
  </CEffectModifyUnit>
  <!-- Impale (Rare, Impaler): Impaling Blades hits on Heroes take 1.5 seconds off Ravage's recharge -->
  <CEffectModifyUnit id="KerriganImpaleModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KerriganRavage,Execute" CooldownOperation="Add" CooldownTimeUse="-1.5" ChargeTimeUse="-1.5" />
  </CEffectModifyUnit>
  <!-- Skewered (Epic): Impaling Blades hits on Heroes take 10 Armor for 3 seconds -->
  <CBehaviorBuff id="KerriganSkeweredDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_kerrigan_impalingblades.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <Duration value="3" />
    <ArmorModification>
      <AllArmorBonus value="-10" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="KerriganSkeweredApply">
    <Behavior value="KerriganSkeweredDebuff" />
  </CEffectApplyBehavior>
  <!-- Primal Rage (Rare, Brood Mother): Ultralisk hits on Heroes take 0.5 seconds off Ravage's recharge -->
  <CEffectModifyUnit id="KerriganPrimalRageModifyCooldown">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KerriganRavage,Execute" CooldownOperation="Add" CooldownTimeUse="-0.5" ChargeTimeUse="-0.5" />
  </CEffectModifyUnit>
  <!-- Corrosive Swarm (Epic): Ultralisk hits on Heroes take 5 Armor for 4 seconds, stacking up to 3 times -->
  <CBehaviorBuff id="KerriganCorrosiveDebuff" parent="StormArmor">
    <Alignment value="Negative" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_kerrigan_ultralisk.dds" />
    <BehaviorCategories index="DebuffVulnerable" value="1" />
    <MaxStackCount value="3" />
    <Duration value="4" />
    <ArmorModification>
      <AllArmorBonus value="-5" />
    </ArmorModification>
  </CBehaviorBuff>
  <CEffectApplyBehavior id="KerriganCorrosiveApply">
    <Behavior value="KerriganCorrosiveDebuff" />
  </CEffectApplyBehavior>
  <!-- Queen of Blades: each Ravage hit on an enemy Hero heals 10% of maximum Health over 5 seconds; hits stack. The
       Swarm Queen quest raises the heal by 1% per stack, up to 50% (script sets ChangeFraction and adds the buff) -->
  <CEffectModifyUnit id="KerriganQueenOfBladesRegenHeal">
    <ImpactUnit Value="Caster" />
    <VitalArray index="Life">
      <ChangeFraction value="0.02" />
    </VitalArray>
  </CEffectModifyUnit>
  <CBehaviorBuff id="KerriganQueenOfBladesRegen">
    <Alignment value="Positive" />
    <InfoIcon value="Assets\Textures\storm_ui_icon_kerrigan_ravage.dds" />
    <MaxStackCount value="4" />
    <Duration value="5" />
    <Period value="1" />
    <PeriodicEffect value="KerriganQueenOfBladesRegenHeal" />
  </CBehaviorBuff>
  <!-- Impaler: hitting 2 or more enemy Heroes with one Impaling Blades refunds it (script) -->
  <CEffectModifyUnit id="KerriganImpalerRefund">
    <ImpactUnit Value="Caster" />
    <Cost Abil="KerriganImpalingBlades,Execute" CooldownOperation="Set" CooldownTimeUse="0" ChargeCountUse="-1" />
  </CEffectModifyUnit>
  <!-- Impaler: the starter sets Impaling Blades' radius to 2.5 (from 1.65); the script grants this upgrade so the
       warning and eruption models scale to match (1.5x) for that player only -->
  <CUpgrade id="KerriganImpalerUpgrade" />
  <CRequirementCountUpgrade id="KerriganCountUpgradeImpaler">
    <Flags index="TechTreeCheat" value="0" />
    <Count Link="KerriganImpalerUpgrade" State="QueuedOrBetter" />
  </CRequirementCountUpgrade>
  <CRequirementGTE id="KerriganGTECountUpgradeImpaler1">
    <OperandArray index="0" value="KerriganCountUpgradeImpaler" />
    <OperandArray index="1" value="1" />
  </CRequirementGTE>
  <CRequirement id="KerriganHasImpalerUpgrade">
    <NodeArray index="Use" Link="KerriganGTECountUpgradeImpaler1" />
    <NodeArray index="Show" Link="KerriganGTECountUpgradeImpaler1" />
  </CRequirement>
  <CValidatorPlayerRequirement id="KerriganHasImpaler">
    <WhichPlayer Value="Caster" />
    <Find value="1" />
    <Value value="KerriganHasImpalerUpgrade" />
  </CValidatorPlayerRequirement>
  <CActorModel id="KerriganImpalingBladesWarningModel">
    <On Terms="ActorCreation; ValidatePlayer KerriganHasImpaler" Send="SetScale 1.5" />
  </CActorModel>
  <CActorModel id="KerriganImpalingBladesExplode">
    <On Terms="ActorCreation; ValidatePlayer KerriganHasImpaler" Send="SetScale 1.5" />
  </CActorModel>
  <!-- Brood Mother: Ultralisk hits on enemy Heroes grant Kerrigan Shields for 40% of the damage (double Assimilation's
       20% against Heroes) for 6 seconds, added to what is left (script sets ModifyLimit, as Jaina's Ice Barrier) -->
  <CBehaviorBuff id="KerriganBroodShield" parent="StormShield">
    <InfoIcon value="Assets\Textures\storm_ui_icon_kerrigan_assimilation.dds" />
    <Duration value="6" />
    <DamageResponse ModifyLimit="0" />
  </CBehaviorBuff>
  <!-- Brood Expansion (Legendary, Brood Mother): Ultralisk hits on Heroes also deal 1% of their maximum Health (script) -->
  <CEffectDamage id="KerriganBroodExpansionDamage" parent="StormSpell">
    <Amount value="0" />
  </CEffectDamage>
</Catalog>
