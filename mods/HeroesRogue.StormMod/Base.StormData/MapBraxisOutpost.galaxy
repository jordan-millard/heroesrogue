// ============================================================
// Braxis Outpost: pausing the map's timers while the game is paused (boon picks).
// Included by the Braxis Outpost map script only, since it uses that map's libraries.
// ============================================================

// Run by libAffx_Pause each time the game pauses or unpauses: minion scaling
bool libAffx_MapPause_Func (bool testConds, bool runActions) {
    bool pause = libAffx_gamePaused;
    if (!runActions) {
        return true;
    }
    libAffx_PauseTimerIfRunning(lib566061C9_gv_mMSC_ScalingTimer, pause);
    return true;
}
