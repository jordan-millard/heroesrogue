// ============================================================
// ARAM challenges: after winning round 4 and round 8 (with Extra maps on, each can be turned off in the
// options), the player picks one of 3 ARAM maps and plays alone against 3 AI: ranged assassins after
// round 4, tanks with +20% Health after round 8. A challenge doesn't count as a round and has no boons
// or curses. Winning gives an Uncommon or better boon next game; dying once or losing gives a curse.
// ============================================================

const int libAffx_aramRound1 = 4;
const int libAffx_aramRound2 = 8;

bool libAffx_aramActive;
int libAffx_aramTicks;
trigger libAffx_aramTickTrigger;
trigger libAffx_aramHeroDiedTrigger;

bool libAffx_AramIsActive() {
    return libAffx_aramActive;
}

// 1 after round 4, 2 after round 8. The round doesn't advance during a challenge, so this also holds in the match.
int libAffx_AramChallengeIndex() {
    if (libAffx_currentRun == libAffx_aramRound2) {
        return 2;
    }
    return 1;
}

// The challenge options only matter with Extra maps on
void libAffx_AramUpdateOptions() {
    bool enabled = libAffx_MapChoiceExtraMapsEnabled();
    int i;
    for (i = 1; i <= libAffx_dialogOptions.optionIndex; i += 1) {
        if (libAffx_dialogOptions.option[i].checkbox == libAffx_dialogControlOptionsAram1 || libAffx_dialogOptions.option[i].checkbox == libAffx_dialogControlOptionsAram2) {
            libAffx_SetDialogControlEnabled(libAffx_dialogOptions.option[i].checkbox, enabled);
            libAffx_SetDialogControlEnabled(libAffx_dialogOptions.option[i].label, enabled);
        }
    }
}

// Map init, once the save bank is loaded
void libAffx_AramChallengeMapInit() {
    libAffx_aramActive = libAffx_MapChoiceIsAramMap(libAffx_currentMap);
}

// Offered instead of the regular map choice after the challenge rounds
bool libAffx_AramShouldOffer() {
    string hero = libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[libAffx_player]);
    if (!libAffx_MapChoiceExtraMapsEnabled()) {
        return false;
    }
    if (hero == "Cho" || hero == "Gall") {
        return false; // the partner needs an allied slot, and ARAM challenge maps have none
    }
    if (libAffx_currentRun == libAffx_aramRound1) {
        return libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsAram1, libAffx_player);
    }
    if (libAffx_currentRun == libAffx_aramRound2) {
        return libNtve_gf_DialogItemIsChecked(libAffx_dialogControlOptionsAram2, libAffx_player);
    }
    return false;
}
void libAffx_AramChoiceRun() {
    libAffx_mapChoiceAram = true;
    libAffx_MapChoiceRun();
    libAffx_mapChoiceAram = false;
}

// Handles the end of an ARAM challenge. Returns false when this wasn't one.
bool libAffx_AramGameOver(int winningTeam) {
    if (!libAffx_aramActive) {
        return false;
    }
    if (winningTeam == libAffx_teamOrderIndex) {
        libAffx_BankSaveValueString("AramReward", "Boon");
        libAffx_DisplayChatMessage(StringExternal("Message/AramChallengeWon"));
    } else {
        libAffx_BankSaveValueString("AramReward", "Curse");
        libAffx_DisplayChatMessage(StringExternal("Message/AramChallengeLost"));
    }
    // Boons and curses missed in the previous round carry on past the challenge
    libAffx_boonsNextGame = libAffx_boonsQueued;
    libAffx_cursesNextGame = libAffx_cursesQueued;
    libAffx_MapChoiceRun();
    libAffx_SaveBank();
    return true;
}

// Next regular game: hand out the challenge result
void libAffx_AramQueueRewardBoon() {
    if (libAffx_BankLoadValueString("AramReward") != "Boon") {
        return;
    }
    libAffx_BankSaveValueString("AramReward", "");
    libAffx_DisplayChatMessage(StringExternal("Message/AramRewardBoon"));
    libAffx_QueueBoon(libAffx_rarityUncommon, 1, false, false);
}
void libAffx_AramQueueRewardCurse() {
    if (libAffx_BankLoadValueString("AramReward") != "Curse") {
        return;
    }
    libAffx_BankSaveValueString("AramReward", "");
    libAffx_DisplayChatMessage(StringExternal("Message/AramRewardCurse"));
    libAffx_QueueCurse(1, false);
}

// Explains the rules once the match starts, and keeps talents on: ARAM maps turn talent picking off
// after HeroesRogue turns it on. Runs on real time because game time is frozen while paused.
void libAffx_AramApplyTankHealth() {
    int player;
    unit hero;
    fixed lifePercent;
    for (player = libAffx_aramFirstEnemy; player <= libAffx_aramLastEnemy; player += 1) {
        hero = libGame_gv_players[player].lv_heroUnit;
        if (hero == null || !UnitIsAlive(hero) || UnitHasBehavior2(hero, "AffixAramTankHealth")) {
            continue;
        }
        lifePercent = UnitGetPropertyFixed(hero, c_unitPropLifePercent, c_unitPropCurrent);
        UnitBehaviorAdd(hero, "AffixAramTankHealth", hero, 1);
        UnitSetPropertyFixed(hero, c_unitPropLifePercent, lifePercent); // keep a full hero at full Health
    }
}

bool libAffx_AramTick_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (!libAffx_aramActive || libGame_gv_gameOver) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_aramTicks += 1;
    if (libAffx_aramTicks == 6) {
        libAffx_DisplayChatMessage(StringExternal("Message/AramChallengeRules" + IntToString(libAffx_AramChallengeIndex())));
    }
    if (!libAffx_gamePaused) {
        SetTalentsEnabled(true);
    }
    if (libAffx_AramChallengeIndex() == 2) {
        libAffx_AramApplyTankHealth();
    }
    return true;
}

// Dying once loses the challenge
bool libAffx_AramHeroDied_Func (bool testConds, bool runActions) {
    unit core = libGame_gv_teams[libAffx_teamOrderIndex].lv_core;
    if (testConds) {
        if (!libAffx_aramActive || libGame_gv_gameOver || EventUnit() != libGame_gv_players[libAffx_player].lv_heroUnit) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_DisplayChatMessage(StringExternal("Message/AramChallengeDied"));
    UnitBehaviorRemove(core, "CoreInvulnerability", c_unitBehaviorCountAll);
    libNtve_gf_MakeUnitInvulnerable(core, false);
    UnitKill(core);
    return true;
}

void libAffx_AramChallengeTriggers_Init() {
    libAffx_aramTickTrigger = TriggerCreate("libAffx_AramTick_Func");
    TriggerAddEventTimePeriodic(libAffx_aramTickTrigger, 0.5, c_timeReal);
    libAffx_aramHeroDiedTrigger = TriggerCreate("libAffx_AramHeroDied_Func");
    TriggerAddEventUnitDied(libAffx_aramHeroDiedTrigger, null);
}
