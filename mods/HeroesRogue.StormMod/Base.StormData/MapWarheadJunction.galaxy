// ============================================================
// Warhead Junction: pausing the map's timers while the game is paused (boon picks).
// Included by the Warhead Junction map script only, since it uses that map's libraries.
// ============================================================

// Run by libAffx_Pause each time the game pauses or unpauses: the warhead event and preview, warhead reminders, nuke damage scaling and minion scaling
bool libAffx_MapPause_Func (bool testConds, bool runActions) {
    bool pause = libAffx_gamePaused;
    if (!runActions) {
        return true;
    }
    libAffx_PauseTimerIfRunning(libMSC2_gv_mMSC2TerrazineMainEventTimer, pause);
    libAffx_PauseTimerIfRunning(libMSC2_gv_mMSC2ObjectivePreviewTimer, pause);
    libAffx_PauseTimerIfRunning(libMSC2_gv_mMSC2BuiltWarheadReminderTimer, pause);
    libAffx_PauseTimerIfRunning(libMSC2_gv_mMSC2DroppedWarheadReminderTimer, pause);
    libAffx_PauseTimerIfRunning(libMSC2_gv_mMSC2NukeDamageScalingTimer, pause);
    libAffx_PauseTimerIfRunning(lib566061C9_gv_mMSC_ScalingTimer, pause);
    return true;
}
