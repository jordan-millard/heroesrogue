// ============================================================
// Braxis Holdout: objective results, and pausing the map's timers while the game is paused (boon picks).
// Included by the Braxis Holdout map script only, since it uses that map's Zerg wave data.
// ============================================================

fixed libAffx_braxisLastRelease = -1000.0;

bool libAffx_BraxisZergReleased_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (GameGetMissionTime() - libAffx_braxisLastRelease < 10.0) {
            return false; // both waves are released at once; handle each release once
        }
    }
    if (!runActions) {
        return true;
    }

    libAffx_braxisLastRelease = GameGetMissionTime();
    // The waves are released when a team fills its beacons to 100%
    if (libSCHO_gv_mMHO_TeamProgress[libGame_gv_teamOrderIndex_C] >= 100.0) {
        libAffx_MapObjectiveReport(libGame_gv_teamOrderIndex_C);
    } else if (libSCHO_gv_mMHO_TeamProgress[libGame_gv_teamChaosIndex_C] >= 100.0) {
        libAffx_MapObjectiveReport(libGame_gv_teamChaosIndex_C);
    }
    return true;
}

// Run by libAffx_Pause each time the game pauses or unpauses: beacons, Zerg waves, scaling, the boss elevator, the
// camp factories and drop pods
bool libAffx_MapPause_Func (bool testConds, bool runActions) {
    int i;
    bool pause = libAffx_gamePaused;
    if (!runActions) {
        return true;
    }
    libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_AttackEventTimer, pause);
    libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_AttackEventWarningTimer, pause);
    libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_AttackWaveTimer, pause);
    libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_ScalingTimer, pause);
    libAffx_PauseTimerIfRunning(lib566061C9_gv_mMSC_ScalingTimer, pause);
    libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_Elevator.lv_elevatorInitialRaiseTimer, pause);
    libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_Elevator.lv_elevatorRaiseTimer, pause);
    libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_Elevator.lv_elevatorLowerTimer, pause);
    for (i = 0; i <= 6; i += 1) {
        libAffx_PauseTimerIfRunning(libSCHO_gv_mMHO_Factory_Timer[i].lv_animationTimer, pause);
    }
    for (i = 0; i <= libCore_gv_bALMaxTeams; i += 1) {
        libAffx_PauseTimerIfRunning(libSCHO_gv_zergDropPodCooldowns[i], pause);
    }
    return true;
}

bool libAffx_BraxisHoldoutStart_Func (bool testConds, bool runActions) {
    trigger t = TriggerCreate("libAffx_BraxisZergReleased_Func");
    TriggerAddEventUnitBehaviorChange(t, null, "ZergStasisBehavior", c_unitBehaviorChangeDestroy);
    return true;
}
