include "AffixTriggers"

// ============================================================
// Golden Hogger. Brute: Staggering Blow hits on enemy Heroes add Swing; takedowns add Brawn: knockback distance,
// then a Slow after the Stun, then missing-Health damage, then at 100 it kills lane minions, then 2% damage per stack.
// ============================================================

const fixed libAffx_HoggerTakedownWindow = 3.0;
const fixed libAffx_HoggerPastCapDamagePerStack = 0.01;
bool libAffx_HoggerStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_HoggerBruteTime; // per enemy player, last Brute hit
int libAffx_HoggerBruteAdded; // Brute: takedown stacks already applied to the catalog this game
int libAffx_HoggerBruteAdded2; // Brute: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_HoggerBruteAdded3; // Brute: takedown quest stage 3 stacks already applied to the catalog this game
int libAffx_HoggerBrutePastApplied; // Brute: takedown quest stacks past the cap applied as damage this game

unit libAffx_HoggerHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_HoggerIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_HoggerStacks(string tokenId) {
    unit hero = libAffx_HoggerHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_HoggerQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_HoggerInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_HoggerTakedownWindow;
}
// HoggerGoldenBrawnTokenCounter: stacks 1-40: the knockback is 1% farther each; 41-80 Slow after the Stun, 81-100 missing-Health damage, 100 kills minions (script), then damage
void libAffx_HoggerSyncBrute () {
    unit hero = libAffx_HoggerHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "HoggerGoldenBruteMarker")) {
        return;
    }
    stacks = libAffx_HoggerStacks("HoggerGoldenBrawnTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_HoggerBruteAdded) {
        libAffx_CatalogReferenceModify("Behavior,HoggerStaggeringBlowKnockback,Modification.MoveSpeedMaximum", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HoggerBruteAdded) * 0.1700, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,HoggerStaggeringBlowKnockback,Modification.MoveSpeedMinimum", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HoggerBruteAdded) * 0.1700, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_HoggerBruteAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): enemies Stunned by Staggering Blow are Slowed 2% more each after the Stun (on from 41: libAffx_HoggerBlowCast_Func)
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_HoggerBruteAdded2) {
        libAffx_CatalogReferenceModify("Behavior,HoggerGoldenBruteDaze,Modification.UnifiedMoveSpeedFactor", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HoggerBruteAdded2) * -0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_HoggerBruteAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): 0.5% of Hogger's missing Health as damage each (libAffx_HoggerBlowCast_Func sets it on each cast)
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_HoggerBruteAdded3) {
        libAffx_HoggerBruteAdded3 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_HoggerBrutePastApplied) {
        libAffx_HoggerBrutePastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "HoggerBrutePastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "HoggerBrutePastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "HoggerBrutePastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "HoggerBrutePastCapDamage")) {
        UnitBehaviorAdd(hero, "HoggerBrutePastCapDamage", hero, 1);
    }
}
bool libAffx_HoggerSync_Func (bool testConds, bool runActions) {
    libAffx_HoggerSyncBrute();
    return true;
}
// Brute: Staggering Blow is cast. Brawn turns on its later rewards: 41 the Slow after the Stun, 81 the missing-Health
// damage (0.5% of Hogger's missing Health per stack past 80, set for this cast), 100 killing lane minions.
bool libAffx_HoggerBlowCast_Func (bool testConds, bool runActions) {
    unit hero = libAffx_HoggerHero();
    int stacks;
    fixed missing;
    if (hero == null || !UnitHasBehavior2(hero, "HoggerGoldenBruteMarker")) {
        return false;
    }
    stacks = libAffx_HoggerStacks("HoggerGoldenBrawnTokenCounter");
    if (stacks > 40) {
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "HoggerGoldenBruteDazeApply", "Chance", libAffx_player, 1.0);
    }
    if (stacks > 80) {
        missing = MaxF(0.0, UnitGetPropertyFixed(hero, c_unitPropLifeMax, c_unitPropCurrent) - UnitGetPropertyFixed(hero, c_unitPropLife, c_unitPropCurrent));
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "HoggerGoldenBruteMissingDamage", "Amount", libAffx_player, missing * 0.005 * IntToFixed(MinI(stacks - 80, 20)));
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "HoggerGoldenBruteMissingDamage", "Chance", libAffx_player, 1.0);
    }
    if (stacks >= 100) {
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "HoggerGoldenBruteMinionKill", "Chance", libAffx_player, 1.0);
    }
    return true;
}
// Brute hit on an enemy Hero: takedown window, HoggerGoldenSwingTokenCounter, the heal, and on-hit boons
bool libAffx_HoggerBruteHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_HoggerHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_HoggerIsEnemyHero(victim) || !UnitHasBehavior2(hero, "HoggerGoldenBruteMarker")) {
        return false;
    }
    libAffx_HoggerBruteTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "HoggerGoldenSwingTokenCounter", hero);
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[2] libAffx_HoggerTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_HoggerTakedownCrossStart () {
    unit hero = libAffx_HoggerHero();
    if (hero == null) {
        return;
    }
    libAffx_HoggerTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "HoggerGoldenBrawnTokenCounter"));
}
void libAffx_HoggerTakedownCross () {
    unit hero = libAffx_HoggerHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "HoggerGoldenBrawnTokenCounter")) == libAffx_HoggerTakedownBefore[1]) {
        return;
    }
    if (UnitHasBehavior2(hero, "HoggerGoldenBruteMarker") && FixedToInt(UnitGetTokenCount(hero, "HoggerGoldenBrawnTokenCounter")) == libAffx_HoggerTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "HoggerGoldenBrawnTokenCounter", hero);
        libAffx_HoggerSyncBrute();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_HoggerTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_HoggerHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_HoggerTakedownCrossStart();
    if (UnitHasBehavior2(hero, "HoggerGoldenBruteMarker") && libAffx_HoggerBruteTime[killedPlayer] > 0.0 && now - libAffx_HoggerBruteTime[killedPlayer] <= 6.0) {
        libAffx_HoggerBruteTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "HoggerGoldenBrawnTokenCounter", hero);
        libAffx_HoggerSyncBrute();
        libAffx_HoggerQuestDing();
    }
    libAffx_HoggerTakedownCross();
    return true;
}
bool libAffx_HoggerStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_HoggerStarted) {
        return true;
    }
    libAffx_HoggerStarted = true;
    trig = TriggerCreate("libAffx_HoggerBruteHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "HoggerStaggeringBlowDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_HoggerBlowCast_Func"), libAffx_player, "HoggerStaggeringBlowInitialSet");
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_HoggerSync_Func"), 1.0, c_timeGame);
    return true;
}
