include "AffixTriggers"

// ============================================================
// Golden Kerrigan. Each starter: hits on enemy Heroes open a 3 second takedown window, add the hit quest token
// and heal; takedowns in the window add the takedown token.
// Queen of Blades: Ravage hits on Heroes heal 10% maximum Health over 5 seconds. Swarm Queen quest: 1% Ravage
// range and 1% more of that healing per stack, up to 50; past 50 stacks 1% damage each.
// Endless Hunger (Legendary): those takedowns refill Ravage.
// Impaler: wider, faster Impaling Blades; hitting 2+ Heroes at once refunds it.
// Kinetic Storm quest: 1% off Impaling Blades' and Primal Grasp's cooldowns per stack, up to 30%; then 1%
// Impaling Blades damage each. Twin Blades (Legendary): each Impaling Blades is cast again 0.5 seconds later.
// Brood Mother: Ultralisk hits on Heroes grant Shields for 40% of the damage. Hive Mind quest: 1% of Summon Ultralisk's 20 second cooldown per stack, up to 40%; then 1% damage.
// ============================================================

const fixed libAffx_KerriganTakedownWindow = 3.0;
const fixed libAffx_KerriganPastCapDamagePerStack = 0.01;
bool libAffx_KerriganStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KerriganRavageTime; // per enemy player, last Queen of Blades hit
int libAffx_KerriganRavageAdded; // Queen of Blades: takedown stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KerriganBladesTime; // per enemy player, last Impaler hit
int libAffx_KerriganBladesAdded; // Impaler: takedown stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KerriganUltraTime; // per enemy player, last Brood Mother hit
int libAffx_KerriganUltraAdded; // Brood Mother: takedown stacks already applied to the catalog this game
const fixed libAffx_KerriganBroodShieldFraction = 0.4; // double Assimilation against Heroes
fixed libAffx_KerriganBladesCastTime = -1.0; // game time of the Impaling Blades eruption being counted
int libAffx_KerriganBladesCastHits; // enemy Heroes hit by that eruption
bool libAffx_KerriganImpalerVisual;

unit libAffx_KerriganHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_KerriganIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_KerriganStacks(string tokenId) {
    unit hero = libAffx_KerriganHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_KerriganQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_KerriganInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_KerriganTakedownWindow;
}
// KerriganSwarmQueenTokenCounter: 1% Ravage range (of 5.5) and 1% more Ravage healing (of 2% per second) per stack, up to 50, then damage
void libAffx_KerriganSyncRavage () {
    unit hero = libAffx_KerriganHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KerriganRavageMarker")) {
        return;
    }
    stacks = libAffx_KerriganStacks("KerriganSwarmQueenTokenCounter");
    wanted = MinI(stacks, 50);
    if (wanted != libAffx_KerriganRavageAdded) {
        libAffx_CatalogReferenceModify("Abil,KerriganRavage,Range", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KerriganRavageAdded) * 0.055, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,KerriganQueenOfBladesRegenHeal,VitalArray[Life].ChangeFraction", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KerriganRavageAdded) * 0.0002, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KerriganRavageAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 50)) * libAffx_KerriganPastCapDamagePerStack, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "KerriganRavageDamage", "MultiplicativeModifierArray[KerriganRavageLegacy].Modifier", libAffx_player, bonus);
}
// KerriganKineticStormTokenCounter: 1% off Impaling Blades and Primal Grasp cooldowns per stack, up to 30%, then Impaling Blades damage
void libAffx_KerriganSyncBlades () {
    unit hero = libAffx_KerriganHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KerriganBladesMarker")) {
        return;
    }
    stacks = libAffx_KerriganStacks("KerriganKineticStormTokenCounter");
    wanted = MinI(stacks, 30);
    if (wanted != libAffx_KerriganBladesAdded) {
        libAffx_CatalogReferenceModify("Abil,KerriganImpalingBlades,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KerriganBladesAdded) * -0.06, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Abil,KerriganPrimalGrasp,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KerriganBladesAdded) * -0.08, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KerriganBladesAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 30)) * libAffx_KerriganPastCapDamagePerStack, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "KerriganImpalingBladesDamage", "MultiplicativeModifierArray[KerriganBladesLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KerriganImpalingBladesPainfulSpikesDamage", "MultiplicativeModifierArray[KerriganBladesLegacy].Modifier", libAffx_player, bonus);
}
// KerriganHiveMindTokenCounter: 1% of the 20 second cooldown per stack, up to 40%, then damage
void libAffx_KerriganSyncUltra () {
    unit hero = libAffx_KerriganHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KerriganUltraMarker")) {
        return;
    }
    stacks = libAffx_KerriganStacks("KerriganHiveMindTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_KerriganUltraAdded) {
        libAffx_CatalogReferenceModify("Abil,KerriganSummonUltralisk,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KerriganUltraAdded) * -0.2, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KerriganUltraAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 40)) * libAffx_KerriganPastCapDamagePerStack, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "KerriganUltraliskWeaponDamage", "MultiplicativeModifierArray[KerriganUltraLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KerriganUltraliskWeaponSplashDamage", "MultiplicativeModifierArray[KerriganUltraLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KerriganUltraliskChargeDamage", "MultiplicativeModifierArray[KerriganUltraLegacy].Modifier", libAffx_player, bonus);
}
bool libAffx_KerriganSync_Func (bool testConds, bool runActions) {
    libAffx_KerriganSyncRavage();
    libAffx_KerriganSyncBlades();
    libAffx_KerriganSyncUltra();
    return true;
}
fixed libAffx_KerriganKerriganImpalingBladesInitialCreatePersistentLastEcho = -1.0;
// KerriganTwinBladesMarker: KerriganImpalingBladesInitialCreatePersistent is cast again toward the same point 0.5 seconds later. The echo is skipped by its own event.
bool libAffx_KerriganKerriganImpalingBladesInitialCreatePersistentEcho_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KerriganHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    if (hero == null || !UnitHasBehavior2(hero, "KerriganTwinBladesMarker") || GameGetMissionTime() == libAffx_KerriganKerriganImpalingBladesInitialCreatePersistentLastEcho) {
        return false;
    }
    Wait(0.5, c_timeGame);
    if (!UnitIsAlive(hero) || target == null) {
        return true;
    }
    libAffx_KerriganKerriganImpalingBladesInitialCreatePersistentLastEcho = GameGetMissionTime();
    UnitCreateEffectPoint(hero, "KerriganImpalingBladesInitialCreatePersistent", target);
    return true;
}
// Brood Mother: Shields for part of an Ultralisk hit, added to what Kerrigan has left, refreshed to 6 seconds
void libAffx_KerriganBroodShieldAdd (unit hero, fixed amount) {
    fixed current = 0.0;
    if (!UnitIsAlive(hero) || amount <= 0.0) {
        return;
    }
    if (UnitHasBehavior2(hero, "KerriganBroodShield")) {
        current = UnitBehaviorDamageModifyRemaining(hero, "KerriganBroodShield");
    }
    CatalogFieldValueSetFixed(c_gameCatalogBehavior, "KerriganBroodShield", "DamageResponse.ModifyLimit", libAffx_player, current + amount * libAffx_KerriganBroodShieldFraction);
    UnitBehaviorAdd(hero, "KerriganBroodShield", hero, 1);
}
// Impaler: grants the upgrade that scales the Impaling Blades models once the starter is on
bool libAffx_KerriganImpalerVisual_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KerriganHero();
    if (libAffx_KerriganImpalerVisual || hero == null || !UnitHasBehavior2(hero, "KerriganBladesMarker")) {
        return false;
    }
    libAffx_KerriganImpalerVisual = true;
    TechTreeUpgradeAddLevel(libAffx_player, "KerriganImpalerUpgrade", 1);
    return true;
}
// Queen of Blades hit on an enemy Hero: takedown window, KerriganBloodlustTokenCounter, the heal, and on-hit boons
bool libAffx_KerriganRavageHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KerriganHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KerriganIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KerriganRavageMarker")) {
        return false;
    }
    libAffx_KerriganRavageTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KerriganBloodlustTokenCounter", hero);
    if (UnitHasBehavior2(hero, "KerriganBladedFuryMarker")) {
        UnitCreateEffectUnit(hero, "KerriganBladedFuryModifyCooldown", hero);
    }
    if (UnitHasBehavior2(hero, "KerriganRendMarker")) {
        UnitCreateEffectUnit(hero, "KerriganRendApply", victim);
    }
    if (UnitIsAlive(hero)) {
        UnitBehaviorAdd(hero, "KerriganQueenOfBladesRegen", hero, 1);
    }
    return true;
}
// Impaler hit on an enemy Hero: takedown window, KerriganSpikesTokenCounter, the heal, and on-hit boons
bool libAffx_KerriganBladesHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KerriganHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KerriganIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KerriganBladesMarker")) {
        return false;
    }
    libAffx_KerriganBladesTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KerriganSpikesTokenCounter", hero);
    if (UnitHasBehavior2(hero, "KerriganImpaleMarker")) {
        UnitCreateEffectUnit(hero, "KerriganImpaleModifyCooldown", hero);
    }
    if (UnitHasBehavior2(hero, "KerriganSkeweredMarker")) {
        UnitCreateEffectUnit(hero, "KerriganSkeweredApply", victim);
    }
    // the 2nd enemy Hero hit by the same eruption refunds Impaling Blades
    if (GameGetMissionTime() != libAffx_KerriganBladesCastTime) {
        libAffx_KerriganBladesCastTime = GameGetMissionTime();
        libAffx_KerriganBladesCastHits = 0;
    }
    libAffx_KerriganBladesCastHits = libAffx_KerriganBladesCastHits + 1;
    if (libAffx_KerriganBladesCastHits == 2) {
        UnitCreateEffectUnit(hero, "KerriganImpalerRefund", hero);
    }
    return true;
}
// Brood Mother hit on an enemy Hero: takedown window, KerriganBroodTokenCounter, the heal, and on-hit boons
bool libAffx_KerriganUltraHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KerriganHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KerriganIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KerriganUltraMarker")) {
        return false;
    }
    libAffx_KerriganUltraTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KerriganBroodTokenCounter", hero);
    if (UnitHasBehavior2(hero, "KerriganPrimalRageMarker")) {
        UnitCreateEffectUnit(hero, "KerriganPrimalRageModifyCooldown", hero);
    }
    if (UnitHasBehavior2(hero, "KerriganCorrosiveMarker")) {
        UnitCreateEffectUnit(hero, "KerriganCorrosiveApply", victim);
    }
    libAffx_KerriganBroodShieldAdd(hero, EventUnitDamageAmount() + EventUnitDamageBehaviorShield());
    if (UnitHasBehavior2(hero, "KerriganBroodExpansionMarker") && UnitIsAlive(victim)) {
        UnitDamage(hero, "KerriganBroodExpansionDamage", victim, UnitGetPropertyFixed(victim, c_unitPropLifeMax, c_unitPropCurrent) * 0.01);
    }
    return true;
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_KerriganTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_KerriganHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    if (UnitHasBehavior2(hero, "KerriganRavageMarker") && libAffx_KerriganInWindow(libAffx_KerriganRavageTime[killedPlayer], now)) {
        libAffx_KerriganRavageTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KerriganSwarmQueenTokenCounter", hero);
        libAffx_KerriganSyncRavage();
        libAffx_KerriganQuestDing();
        if (UnitHasBehavior2(hero, "KerriganEndlessHungerMarker")) {
            UnitCreateEffectUnit(hero, "KerriganEndlessHungerRefill", hero);
        }
    }
    if (UnitHasBehavior2(hero, "KerriganBladesMarker") && libAffx_KerriganInWindow(libAffx_KerriganBladesTime[killedPlayer], now)) {
        libAffx_KerriganBladesTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KerriganKineticStormTokenCounter", hero);
        libAffx_KerriganSyncBlades();
        libAffx_KerriganQuestDing();
    }
    if (UnitHasBehavior2(hero, "KerriganUltraMarker") && libAffx_KerriganInWindow(libAffx_KerriganUltraTime[killedPlayer], now)) {
        libAffx_KerriganUltraTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KerriganHiveMindTokenCounter", hero);
        libAffx_KerriganSyncUltra();
        libAffx_KerriganQuestDing();
    }
    return true;
}
bool libAffx_KerriganStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_KerriganStarted) {
        return true;
    }
    libAffx_KerriganStarted = true;
    trig = TriggerCreate("libAffx_KerriganRavageHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KerriganRavageDamage");
    trig = TriggerCreate("libAffx_KerriganBladesHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KerriganImpalingBladesDamage");
    trig = TriggerCreate("libAffx_KerriganUltraHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KerriganUltraliskWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KerriganUltraliskChargeDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_KerriganKerriganImpalingBladesInitialCreatePersistentEcho_Func"), libAffx_player, "KerriganImpalingBladesInitialCreatePersistent");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_KerriganImpalerVisual_Func"), 0.5, c_timeGame);
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_KerriganSync_Func"), 1.0, c_timeGame);
    return true;
}
