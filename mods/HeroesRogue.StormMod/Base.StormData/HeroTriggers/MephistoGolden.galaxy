        libAffx_CatalogReferenceModify("Effect,MephistoGoldenSkullReturnLaunch,ImpactLocation.ProjectionDistanceScale", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MephistoSithAdded) * 0.1, c_fixedPrecisionAny), c_upgradeOperationAdd);
