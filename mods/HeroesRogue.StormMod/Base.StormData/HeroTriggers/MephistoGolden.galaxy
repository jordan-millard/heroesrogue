        libAffx_CatalogReferenceModify("Effect,MephistoGoldenNovaFieldDamage,LeechFraction[Life]", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MephistoNovaAdded2) * 0.0025, c_fixedPrecisionAny), c_upgradeOperationAdd);
