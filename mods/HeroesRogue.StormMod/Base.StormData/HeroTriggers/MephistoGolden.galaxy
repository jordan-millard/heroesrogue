        libAffx_CatalogReferenceModify("Effect,MephistoGoldenNovaFieldDamage,MultiplicativeModifierArray[MephistoGoldenNonHero].Modifier", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MephistoNovaAdded3) * 0.05, c_fixedPrecisionAny), c_upgradeOperationAdd);
