// Sith Lord: each Basic Attack rolls twice: a fan of 3 free Skull Missiles at the target (40% on Heroes, 20% on anything
// else) and starting or refreshing Lightning Nova (30% on Heroes, 15% on anything else)
bool libAffx_MephistoSithAttack_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MephistoHero();
    unit target = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    point origin;
    fixed facing;
    fixed dist;
    int skullChance = 20;
    int novaChance = 15;
    int k;
    if (hero == null || target == null || EventPlayerEffectUsedUnit(c_effectUnitCaster) != hero || !UnitHasBehavior2(hero, "MephistoSithMarker") || !UnitIsAlive(hero)) {
        return false;
    }
    if (UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        skullChance = 40;
        novaChance = 30;
    }
    if (RandomInt(1, 100) <= skullChance) {
        origin = UnitGetPosition(hero);
        facing = AngleBetweenPoints(origin, UnitGetPosition(target));
        dist = MaxF(1.0, DistanceBetweenPoints(origin, UnitGetPosition(target)));
        for (k = -1; k <= 1; k += 1) {
            UnitCreateEffectPoint(hero, "MephistoSkullMissileCastSet", PointWithOffsetPolar(origin, dist, facing + 20.0 * IntToFixed(k)));
        }
    }
    if (RandomInt(1, 100) <= novaChance) {
        UnitCreateEffectUnit(hero, "MephistoLightningNovaCastSet", hero);
    }
    return true;
}
// Shadow Shield (Epic): a Basic Attack on a Hero shields Mephisto for 30% of his maximum Health, decaying over 1.5 seconds
// (6 shields of 5%, the k-th lasting 0.25 * k seconds; all are refilled on each hit)
void libAffx_MephistoShadowShield (unit hero) {
    int k;
    string shield;
    if (!UnitHasBehavior2(hero, "MephistoShadowShieldMarker") || !UnitIsAlive(hero)) {
        return;
    }
    for (k = 1; k <= 6; k += 1) {
        shield = "MephistoGoldenShadowShield" + IntToString(k);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, shield, "DamageResponse.ModifyLimit", libAffx_player, 0.05 * UnitGetPropertyFixed(hero, c_unitPropLifeMax, c_unitPropCurrent));
        UnitBehaviorRemove(hero, shield, 1);
        UnitBehaviorAdd(hero, shield, hero, 1);
    }
}
bool libAffx_MephistoSkullTick_Func (bool testConds, bool runActions) {
    libAffx_MephistoSkullSync();
    libAffx_MephistoNovaSync();
    libAffx_MephistoSithSync();
    return true;
}
// Dread at 100: a Skull Missile is launched (the skull unit itself flies). Follow it until it dies or stops, then a skull
// flies back from there to Mephisto for 50% damage (libAffx: MephistoGoldenSkullReturnCreateUnit).
bool libAffx_MephistoSkullLaunch_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MephistoHero();
    unit skull = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    point last;
    point here;
    int ticks = 0;
    if (hero == null || !UnitHasBehavior2(hero, "MephistoSkullMarker") || libAffx_MephistoStacks("MephistoGoldenDreadTokenCounter") < 100) {
        return false;
    }
    if (skull == null || UnitGetType(skull) != "MephistoSkullMissileMissile") {
        skull = EventPlayerEffectUsedUnit(c_effectUnitSource);
    }
    if (skull == null || UnitGetType(skull) != "MephistoSkullMissileMissile") {
        return false;
    }
    last = UnitGetPosition(skull);
    while (ticks < 48) {
        Wait(0.0625, c_timeGame);
        ticks += 1;
        if (!UnitIsAlive(skull)) {
            break;
        }
        here = UnitGetPosition(skull);
        if (ticks > 2 && DistanceBetweenPoints(here, last) < 0.05) {
            break;
        }
        last = here;
    }
    if (!UnitIsAlive(hero)) {
        return true;
    }
    UnitCreateEffectPoint(hero, "MephistoGoldenSkullReturnCreateUnit", last);
    return true;
}
// Skull Rain (Epic): casting Shade of Mephisto refreshes all Skull Missile charges
bool libAffx_MephistoSkullRain_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MephistoHero();
    if (hero == null || !UnitHasBehavior2(hero, "MephistoSkullRainMarker")) {
        return false;
    }
    UnitAbilityAddChargeUsed(hero, "MephistoSkullMissile", "Abil/MephistoSkullMissile", -1.0 * UnitAbilityGetChargeUsed(hero, "MephistoSkullMissile", "Abil/MephistoSkullMissile"));
    return true;
}
// Skull Storm (Legendary): taking damage below 50% Health fires a Skull Missile at every enemy Hero within 10, once every
// 30 seconds (it waits until there's a Hero in range)
bool libAffx_MephistoSkullStorm_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MephistoHero();
    unitgroup foes;
    int i;
    if (hero == null || EventUnit() != hero || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "MephistoSkullStormMarker")) {
        return false;
    }
    if (GameGetMissionTime() - libAffx_MephistoSkullStormLast < 30.0 || UnitGetPropertyFixed(hero, c_unitPropLifePercent, c_unitPropCurrent) >= 50.0) {
        return false;
    }
    foes = UnitGroupAlliance(libAffx_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(hero), 10.0), UnitFilter((1 << c_targetFilterHeroic) | (1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterStasis - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
    if (UnitGroupCount(foes, c_unitCountAlive) == 0) {
        return false;
    }
    libAffx_MephistoSkullStormLast = GameGetMissionTime();
    UnitBehaviorRemove(hero, "MephistoGoldenSkullStormReady", 1);
    i = 1;
    while (i <= UnitGroupCount(foes, c_unitCountAll)) {
        if (UnitIsAlive(UnitGroupUnit(foes, i))) {
            UnitCreateEffectPoint(hero, "MephistoSkullMissileCastSet", UnitGetPosition(UnitGroupUnit(foes, i)));
        }
        i += 1;
    }
    return true;
}
// Skull Caller hit on an enemy Hero: takedown window, MephistoGoldenMaliceTokenCounter, the heal, and on-hit boons
bool libAffx_MephistoSkullHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MephistoHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_MephistoIsEnemyHero(victim) || !UnitHasBehavior2(hero, "MephistoSkullMarker")) {
        return false;
    }
    libAffx_MephistoSkullTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "MephistoGoldenMaliceTokenCounter", hero);
    return true;
}
// Storm of Hatred hit on an enemy Hero: takedown window, MephistoGoldenChargeTokenCounter, the heal, and on-hit boons
bool libAffx_MephistoNovaHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MephistoHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_MephistoIsEnemyHero(victim) || !UnitHasBehavior2(hero, "MephistoNovaMarker")) {
        return false;
    }
    libAffx_MephistoNovaTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "MephistoGoldenChargeTokenCounter", hero);
    return true;
}
// Sith Lord hit on an enemy Hero: takedown window, MephistoGoldenRageTokenCounter, the heal, and on-hit boons
bool libAffx_MephistoSithHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MephistoHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_MephistoIsEnemyHero(victim) || !UnitHasBehavior2(hero, "MephistoSithMarker")) {
        return false;
    }
    libAffx_MephistoSithTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "MephistoGoldenRageTokenCounter", hero);
    libAffx_MephistoShadowShield(hero);
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[4] libAffx_MephistoTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_MephistoTakedownCrossStart () {
    unit hero = libAffx_MephistoHero();
    if (hero == null) {
        return;
    }
    libAffx_MephistoTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenDreadTokenCounter"));
    libAffx_MephistoTakedownBefore[2] = FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenTempestTokenCounter"));
    libAffx_MephistoTakedownBefore[3] = FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenDominionTokenCounter"));
}
void libAffx_MephistoTakedownCross () {
    unit hero = libAffx_MephistoHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenDreadTokenCounter")) == libAffx_MephistoTakedownBefore[1] && FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenTempestTokenCounter")) == libAffx_MephistoTakedownBefore[2] && FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenDominionTokenCounter")) == libAffx_MephistoTakedownBefore[3]) {
        return;
    }
    if (UnitHasBehavior2(hero, "MephistoSkullMarker") && FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenDreadTokenCounter")) == libAffx_MephistoTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "MephistoGoldenDreadTokenCounter", hero);
        libAffx_MephistoSyncSkull();
        libAffx_MephistoSkullSync();
    }
    if (UnitHasBehavior2(hero, "MephistoNovaMarker") && FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenTempestTokenCounter")) == libAffx_MephistoTakedownBefore[2]) {
        libGame_gf_ModifyTokenCount(1, "MephistoGoldenTempestTokenCounter", hero);
        libAffx_MephistoSyncNova();
        libAffx_MephistoNovaSync();
    }
    if (UnitHasBehavior2(hero, "MephistoSithMarker") && FixedToInt(UnitGetTokenCount(hero, "MephistoGoldenDominionTokenCounter")) == libAffx_MephistoTakedownBefore[3]) {
        libGame_gf_ModifyTokenCount(1, "MephistoGoldenDominionTokenCounter", hero);
        libAffx_MephistoSyncSith();
        libAffx_MephistoSithSync();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_MephistoTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_MephistoHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_MephistoTakedownCrossStart();
    if (UnitHasBehavior2(hero, "MephistoSkullMarker") && libAffx_MephistoSkullTime[killedPlayer] > 0.0 && now - libAffx_MephistoSkullTime[killedPlayer] <= 6.0) {
        libAffx_MephistoSkullTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "MephistoGoldenDreadTokenCounter", hero);
        libAffx_MephistoSyncSkull();
        libAffx_MephistoQuestDing();
        libAffx_MephistoSkullSync();
    }
    if (UnitHasBehavior2(hero, "MephistoNovaMarker") && libAffx_MephistoNovaTime[killedPlayer] > 0.0 && now - libAffx_MephistoNovaTime[killedPlayer] <= 6.0) {
        libAffx_MephistoNovaTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "MephistoGoldenTempestTokenCounter", hero);
        libAffx_MephistoSyncNova();
        libAffx_MephistoQuestDing();
        libAffx_MephistoNovaSync();
    }
    if (UnitHasBehavior2(hero, "MephistoSithMarker") && libAffx_MephistoSithTime[killedPlayer] > 0.0 && now - libAffx_MephistoSithTime[killedPlayer] <= 6.0) {
        libAffx_MephistoSithTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "MephistoGoldenDominionTokenCounter", hero);
        libAffx_MephistoSyncSith();
        libAffx_MephistoQuestDing();
        libAffx_MephistoSithSync();
    }
    libAffx_MephistoTakedownCross();
    return true;
}
bool libAffx_MephistoStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_MephistoStarted) {
        return true;
    }
    libAffx_MephistoStarted = true;
    trig = TriggerCreate("libAffx_MephistoSkullHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MephistoSkullMissileDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MephistoGoldenSkullEchoDamage");
    trig = TriggerCreate("libAffx_MephistoNovaHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MephistoLightningNovaDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MephistoGoldenNovaFieldDamage");
    trig = TriggerCreate("libAffx_MephistoSithHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MephistoWeaponDamage");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_MephistoSkullTick_Func"), 1.0, c_timeGame);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_MephistoSkullLaunch_Func"), libAffx_player, "MephistoSkullMissileLaunchMissile");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_MephistoSkullRain_Func"), libAffx_player, "MephistoShadeOfMephistoInitialSet");
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_MephistoSkullStorm_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_MephistoSithAttack_Func"), libAffx_player, "MephistoWeaponInitialSet");
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_MephistoSync_Func"), 1.0, c_timeGame);
    return true;
}
