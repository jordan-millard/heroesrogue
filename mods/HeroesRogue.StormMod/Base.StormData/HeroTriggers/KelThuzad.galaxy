        libAffx_CatalogReferenceModify("Effect,KelThuzadChainsLinkEnemySearch,AreaArray[0].RectangleWidth", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KelThuzadChainsAdded2) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KelThuzadChainsAdded2 = wanted;
