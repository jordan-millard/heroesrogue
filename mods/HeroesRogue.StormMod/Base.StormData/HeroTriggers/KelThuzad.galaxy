}
bool libAffx_KelThuzadSync_Func (bool testConds, bool runActions) {
    libAffx_KelThuzadSyncDecay();
    libAffx_KelThuzadSyncNova();
    libAffx_KelThuzadSyncChains();
    return true;
}
// Lord of Decay hit on an enemy Hero: takedown window, KelThuzadPestilenceTokenCounter, the heal, and on-hit boons
bool libAffx_KelThuzadDecayHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KelThuzadHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KelThuzadIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KelThuzadDecayMarker")) {
        return false;
    }
    libAffx_KelThuzadDecayTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KelThuzadPestilenceTokenCounter", hero);
    if (UnitHasBehavior2(hero, "KelThuzadGripOfDeathMarker") && (EventUnitDamageEffect() == "KelThuzadDeathAndDecayDamage" || EventUnitDamageEffect() == "KelThuzadDeathAndDecayShadeDamage")) {
        UnitCreateEffectUnit(hero, "KelThuzadFrostNovaApplyRoot", victim);
    }
    return true;
}
// Frostbinder hit on an enemy Hero: takedown window, KelThuzadRimeTokenCounter, the heal, and on-hit boons
bool libAffx_KelThuzadNovaHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KelThuzadHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KelThuzadIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KelThuzadNovaMarker")) {
        return false;
    }
    libAffx_KelThuzadNovaTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KelThuzadRimeTokenCounter", hero);
    if (EventUnitDamageEffect() == "KelThuzadFrostNovaRootDamage") {
        libGame_gf_ModifyTokenCount(4, "KelThuzadRimeTokenCounter", hero);
    }
    return true;
}
// Chains of the Lich hit on an enemy Hero: takedown window, KelThuzadShackleTokenCounter, the heal, and on-hit boons
bool libAffx_KelThuzadChainsHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KelThuzadHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KelThuzadIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KelThuzadChainsMarker")) {
        return false;
    }
    libAffx_KelThuzadChainsTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KelThuzadShackleTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "KelThuzadChainsHeal", hero);
    }
    if (UnitHasBehavior2(hero, "KelThuzadLichKingsGraspMarker")) {
        UnitCreateEffectUnit(hero, "KelThuzadLichKingsGraspFrostNova", hero);
    }
    if (UnitHasBehavior2(hero, "KelThuzadLichKingsGraspMarker")) {
        UnitCreateEffectUnit(hero, "KelThuzadLichKingsGraspDeathAndDecay", hero);
    }
    return true;
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_KelThuzadTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_KelThuzadHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    if (UnitHasBehavior2(hero, "KelThuzadDecayMarker") && libAffx_KelThuzadInWindow(libAffx_KelThuzadDecayTime[killedPlayer], now)) {
        libAffx_KelThuzadDecayTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KelThuzadPlagueTokenCounter", hero);
        libAffx_KelThuzadSyncDecay();
        libAffx_KelThuzadQuestDing();
    }
    if (UnitHasBehavior2(hero, "KelThuzadNovaMarker") && libAffx_KelThuzadInWindow(libAffx_KelThuzadNovaTime[killedPlayer], now)) {
        libAffx_KelThuzadNovaTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KelThuzadWinterTokenCounter", hero);
        libAffx_KelThuzadSyncNova();
        libAffx_KelThuzadQuestDing();
    }
    if (UnitHasBehavior2(hero, "KelThuzadChainsMarker") && libAffx_KelThuzadInWindow(libAffx_KelThuzadChainsTime[killedPlayer], now)) {
        libAffx_KelThuzadChainsTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KelThuzadBondageTokenCounter", hero);
        libAffx_KelThuzadSyncChains();
        libAffx_KelThuzadQuestDing();
    }
    return true;
}
bool libAffx_KelThuzadStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_KelThuzadStarted) {
        return true;
    }
    libAffx_KelThuzadStarted = true;
    trig = TriggerCreate("libAffx_KelThuzadDecayHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadDeathAndDecayDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadDeathAndDecayRotDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadDeathAndDecayShadeDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadDeathAndDecayShadeRotDamage");
    trig = TriggerCreate("libAffx_KelThuzadNovaHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadFrostNovaDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadFrostNovaRootDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadFrostNovaSlowDamage");
    trig = TriggerCreate("libAffx_KelThuzadChainsHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadChainsDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KelThuzadChainsLinkDamage");
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_KelThuzadSync_Func"), 1.0, c_timeGame);
    return true;
}
