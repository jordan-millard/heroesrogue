    unit hero = libAffx_KelThuzadHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KelThuzadChainsMarker")) {
        return;
    }
    stacks = libAffx_KelThuzadStacks("KelThuzadBondageTokenCounter");
