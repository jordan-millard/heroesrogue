include "AffixTriggers"

// ============================================================
// Golden Kel'Thuzad. Each starter: hits on enemy Heroes open a takedown window, add the hit quest token and heal;
// takedowns in the window add the takedown token: stacks 1-40 and 41-80 each improve the ability in two ways, then
// 3% damage per stack, Heroics too.
// ============================================================

const fixed libAffx_KelThuzadTakedownWindow = 3.0;
const fixed libAffx_KelThuzadPastCapDamagePerStack = 0.01;
bool libAffx_KelThuzadStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KelThuzadDecayTime; // per enemy player, last Lord of Decay hit
int libAffx_KelThuzadDecayAdded; // Lord of Decay: takedown stacks already applied to the catalog this game
int libAffx_KelThuzadDecayAdded2; // Lord of Decay: takedown quest stage 2 stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KelThuzadNovaTime; // per enemy player, last Frostbinder hit
int libAffx_KelThuzadNovaAdded; // Frostbinder: takedown stacks already applied to the catalog this game
int libAffx_KelThuzadNovaAdded2; // Frostbinder: takedown quest stage 2 stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KelThuzadChainsTime; // per enemy player, last Chains of the Lich hit
int libAffx_KelThuzadChainsAdded; // Chains of the Lich: takedown stacks already applied to the catalog this game
int libAffx_KelThuzadChainsAdded2; // Chains of the Lich: takedown quest stage 2 stacks already applied to the catalog this game

unit libAffx_KelThuzadHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_KelThuzadIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_KelThuzadStacks(string tokenId) {
    unit hero = libAffx_KelThuzadHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_KelThuzadQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_KelThuzadInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_KelThuzadTakedownWindow;
}
// KelThuzadPlagueTokenCounter: stacks 1-40: 1% of the 5 second cooldown each; 41-80: 1% larger explosion and pool each; then 3% damage each, Heroics too
void libAffx_KelThuzadSyncDecay () {
    unit hero = libAffx_KelThuzadHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KelThuzadDecayMarker")) {
        return;
    }
    stacks = libAffx_KelThuzadStacks("KelThuzadPlagueTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_KelThuzadDecayAdded) {
        libAffx_CatalogReferenceModify("Abil,KelThuzadDeathAndDecay,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KelThuzadDecayAdded) * -0.05, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KelThuzadDecayAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 1% of the explosion (2.5) and pool (2) radius each, the Shade's too
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_KelThuzadDecayAdded2) {
        libAffx_CatalogReferenceModify("Effect,KelThuzadDeathAndDecayDamageSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KelThuzadDecayAdded2) * 0.025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,KelThuzadDeathAndDecayShadeDamageSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KelThuzadDecayAdded2) * 0.025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,KelThuzadDeathAndDecayRotSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KelThuzadDecayAdded2) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,KelThuzadDeathAndDecayShadeRotSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KelThuzadDecayAdded2) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KelThuzadDecayAdded2 = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 80)) * 0.03, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "KelThuzadDeathAndDecayDamage", "MultiplicativeModifierArray[KelThuzadDecayLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KelThuzadDeathAndDecayRotDamage", "MultiplicativeModifierArray[KelThuzadDecayLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KelThuzadDeathAndDecayShadeDamage", "MultiplicativeModifierArray[KelThuzadDecayLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KelThuzadDeathAndDecayShadeRotDamage", "MultiplicativeModifierArray[KelThuzadDecayLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KelThuzadFrozenTombDamage", "MultiplicativeModifierArray[KelThuzadDecayLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KelThuzadFrozenTombExplosionDamage", "MultiplicativeModifierArray[KelThuzadDecayLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KelThuzadShadowFissureDamage", "MultiplicativeModifierArray[KelThuzadDecayLegacy].Modifier", libAffx_player, bonus);
}
// KelThuzadWinterTokenCounter: stacks 1-40: 1% of the 8 second cooldown each; 41-80: 2% of the 1 second Root each; then 3% damage each, Heroics too
