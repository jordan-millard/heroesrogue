bool libAffx_StitchesSync_Func (bool testConds, bool runActions) {
    libAffx_StitchesSyncHooker();
    libAffx_StitchesSyncSlammer();
    libAffx_StitchesSyncGasBag();
    return true;
}
fixed libAffx_StitchesStitchesSlamInitialSetLastEcho = -1.0;
// StitchesGoldenSlamEchoMarker: StitchesSlamInitialSet is cast again toward the same point 0.5 seconds later. The echo is skipped by its own event.
bool libAffx_StitchesStitchesSlamInitialSetEcho_Func (bool testConds, bool runActions) {
    unit hero = libAffx_StitchesHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    if (hero == null || !UnitHasBehavior2(hero, "StitchesGoldenSlamEchoMarker") || GameGetMissionTime() == libAffx_StitchesStitchesSlamInitialSetLastEcho) {
        return false;
    }
    Wait(0.5, c_timeGame);
    if (!UnitIsAlive(hero) || target == null) {
        return true;
    }
    libAffx_StitchesStitchesSlamInitialSetLastEcho = GameGetMissionTime();
    UnitCreateEffectPoint(hero, "StitchesSlamInitialSet", target);
    return true;
}
// an enemy-team Hero (the base hero test counts allies too)
bool libAffx_StitchesIsFoe (unit target) {
    if (!libAffx_StitchesIsEnemyHero(target)) {
        return false;
    }
    return libGame_gf_TeamNumberOfPlayer(UnitGetOwner(target)) != libGame_gf_TeamNumberOfPlayer(libAffx_player);
}
// Reel at 100: 0.75 seconds of Invulnerability
void libAffx_StitchesHookInvulnerable () {
    unit hero = libAffx_StitchesHero();
    if (hero == null || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "StitchesGoldenHookerMarker") || libAffx_StitchesStacks("StitchesGoldenReelTokenCounter") < 100) {
        return;
    }
    UnitBehaviorAdd(hero, "StitchesGoldenHookInvulnerable", hero, 1);
}
// Hooker: Hook cast
bool libAffx_StitchesHookCast_Func (bool testConds, bool runActions) {
    libAffx_StitchesHookInvulnerable();
    return true;
}
// Hooker: an enemy Hero a hook pulled in arrives (the pull's end removes StitchesHooked): Reel's Slow (stacks 81-100),
// Hook Slam (a free Slam toward it) and Fresh Catch (1 second Stun, 10% of its max Health)
bool libAffx_StitchesHookArrive_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_StitchesHero();
    if (hero == null || !UnitIsAlive(hero) || !UnitIsAlive(victim) || !UnitHasBehavior2(hero, "StitchesGoldenHookerMarker") || !libAffx_StitchesIsFoe(victim)) {
        return false;
    }
    if (libAffx_StitchesStacks("StitchesGoldenReelTokenCounter") > 80) {
        UnitBehaviorAdd(victim, "StitchesGoldenHookSlow", hero, 1);
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenFreshCatchMarker")) {
        UnitBehaviorAdd(victim, "StitchesGoldenFreshCatchStun", hero, 1);
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenHookSlamMarker")) {
        UnitCreateEffectPoint(hero, "StitchesSlamInitialSet", UnitGetPosition(victim));
    }
    return true;
}
// Every second: Slammer's echo at 100 Quake; Gas Bag's gas damage (1% of maximum Health per tick, tripled in data while surging; the burst 10%) and
// maximum Health (Stench 41-80 and Bloated); Deflated's size
bool libAffx_StitchesTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_StitchesHero();
    fixed life;
    fixed health;
    if (hero == null) {
        return false;
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenSlammerMarker") && libAffx_StitchesStacks("StitchesGoldenQuakeTokenCounter") >= 100 && !UnitHasBehavior2(hero, "StitchesGoldenSlamEchoMarker")) {
        UnitBehaviorAdd(hero, "StitchesGoldenSlamEchoMarker", hero, 1);
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker")) {
        life = UnitGetPropertyFixed(hero, c_unitPropLifeMax, c_unitPropCurrent);
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "StitchesGoldenGasDamage", "Amount", libAffx_player, life * 0.01);
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "StitchesGoldenGasBurstDamage", "Amount", libAffx_player, life * 0.1);
        health = IntToFixed(MaxI(0, MinI(libAffx_StitchesStacks("StitchesGoldenStenchTokenCounter") - 40, 40))) * 0.01;
        health += StringToFixed(CatalogFieldValueGet(c_gameCatalogBehavior, "StitchesGoldenBloatedValue", "Modification.VitalMaxFractionArray[Life]", libAffx_player));
        if (health != libAffx_StitchesHealthApplied) {
            libAffx_StitchesHealthApplied = health;
            CatalogFieldValueSetFixed(c_gameCatalogBehavior, "StitchesGoldenGasBagHealth", "Modification.VitalMaxFractionArray[Life]", libAffx_player, health);
            UnitBehaviorRemove(hero, "StitchesGoldenGasBagHealth", 1);
        }
        if (health > 0.0 && !UnitHasBehavior2(hero, "StitchesGoldenGasBagHealth")) {
            UnitBehaviorAdd(hero, "StitchesGoldenGasBagHealth", hero, 1);
        }
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenDeflatedMarker")) {
        UnitSetScale(hero, 50.0, 50.0, 50.0);
        UnitSetPropertyFixed(hero, c_unitPropRadius, 0.53125);
    }
    return true;
}
// Gas Bag, Leftovers: Gorging an enemy Hero adds 5 (and starts a gas surge)
bool libAffx_StitchesGorgeStart_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_StitchesHero();
    if (hero == null || !UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker") || !libAffx_StitchesIsFoe(victim)) {
        return false;
    }
    libGame_gf_ModifyTokenCount(5, "StitchesGoldenLeftoversTokenCounter", hero);
    // and the gas surges (triple damage) for 6 seconds
    UnitBehaviorAdd(hero, "StitchesGoldenGasSurge", hero, 1);
    return true;
}
// Gas Bag, Stench at 100: the Hero Gorge lets go of is hit by a gas burst
bool libAffx_StitchesGorgeEnd_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_StitchesHero();
    if (hero == null || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker") || !libAffx_StitchesIsFoe(victim) || libAffx_StitchesStacks("StitchesGoldenStenchTokenCounter") < 100) {
        return false;
    }
    UnitCreateEffectPoint(hero, "StitchesGoldenGasBurstSearch", UnitGetPosition(victim));
    return true;
}
// Hooker hit on an enemy Hero: takedown window, StitchesGoldenCatchTokenCounter, the heal, and on-hit boons
bool libAffx_StitchesHookerHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_StitchesHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_StitchesIsEnemyHero(victim) || !UnitHasBehavior2(hero, "StitchesGoldenHookerMarker")) {
        return false;
    }
    libAffx_StitchesHookerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "StitchesGoldenCatchTokenCounter", hero);
    libAffx_StitchesHookInvulnerable();
    return true;
}
// Slammer hit on an enemy Hero: takedown window, StitchesGoldenSmashTokenCounter, the heal, and on-hit boons
bool libAffx_StitchesSlammerHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_StitchesHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_StitchesIsEnemyHero(victim) || !UnitHasBehavior2(hero, "StitchesGoldenSlammerMarker")) {
        return false;
    }
    libAffx_StitchesSlammerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "StitchesGoldenSmashTokenCounter", hero);
    return true;
}
// Gas Bag hit on an enemy Hero: takedown window, StitchesGoldenLeftoversTokenCounter, the heal, and on-hit boons
bool libAffx_StitchesGasBagHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_StitchesHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_StitchesIsEnemyHero(victim) || !UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker")) {
        return false;
    }
    libAffx_StitchesGasBagTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "StitchesGoldenLeftoversTokenCounter", hero);
    return true;
}
// Gas Bag: these effects on an enemy Hero only refresh the takedown window (no quest token, heal or on-hit boons)
bool libAffx_StitchesGasBagWindow_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_StitchesHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_StitchesIsEnemyHero(victim) || !UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker")) {
        return false;
    }
    libAffx_StitchesGasBagTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[4] libAffx_StitchesTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_StitchesTakedownCrossStart () {
    unit hero = libAffx_StitchesHero();
    if (hero == null) {
        return;
    }
    libAffx_StitchesTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenReelTokenCounter"));
    libAffx_StitchesTakedownBefore[2] = FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenQuakeTokenCounter"));
    libAffx_StitchesTakedownBefore[3] = FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenStenchTokenCounter"));
}
void libAffx_StitchesTakedownCross () {
    unit hero = libAffx_StitchesHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenReelTokenCounter")) == libAffx_StitchesTakedownBefore[1] && FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenQuakeTokenCounter")) == libAffx_StitchesTakedownBefore[2] && FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenStenchTokenCounter")) == libAffx_StitchesTakedownBefore[3]) {
        return;
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenHookerMarker") && FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenReelTokenCounter")) == libAffx_StitchesTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "StitchesGoldenReelTokenCounter", hero);
        libAffx_StitchesSyncHooker();
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenSlammerMarker") && FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenQuakeTokenCounter")) == libAffx_StitchesTakedownBefore[2]) {
        libGame_gf_ModifyTokenCount(1, "StitchesGoldenQuakeTokenCounter", hero);
        libAffx_StitchesSyncSlammer();
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker") && FixedToInt(UnitGetTokenCount(hero, "StitchesGoldenStenchTokenCounter")) == libAffx_StitchesTakedownBefore[3]) {
        libGame_gf_ModifyTokenCount(1, "StitchesGoldenStenchTokenCounter", hero);
        libAffx_StitchesSyncGasBag();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_StitchesTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_StitchesHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_StitchesTakedownCrossStart();
    if (UnitHasBehavior2(hero, "StitchesGoldenHookerMarker") && libAffx_StitchesHookerTime[killedPlayer] > 0.0 && now - libAffx_StitchesHookerTime[killedPlayer] <= 6.0) {
        libAffx_StitchesHookerTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "StitchesGoldenReelTokenCounter", hero);
        libAffx_StitchesSyncHooker();
        libAffx_StitchesQuestDing();
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenSlammerMarker") && libAffx_StitchesSlammerTime[killedPlayer] > 0.0 && now - libAffx_StitchesSlammerTime[killedPlayer] <= 6.0) {
        libAffx_StitchesSlammerTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "StitchesGoldenQuakeTokenCounter", hero);
        libAffx_StitchesSyncSlammer();
        libAffx_StitchesQuestDing();
    }
    if (UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker") && libAffx_StitchesGasBagTime[killedPlayer] > 0.0 && now - libAffx_StitchesGasBagTime[killedPlayer] <= 6.0) {
        libAffx_StitchesGasBagTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "StitchesGoldenStenchTokenCounter", hero);
        libAffx_StitchesSyncGasBag();
        libAffx_StitchesQuestDing();
    }
    libAffx_StitchesTakedownCross();
    return true;
}
bool libAffx_StitchesStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_StitchesStarted) {
        return true;
    }
    libAffx_StitchesStarted = true;
    trig = TriggerCreate("libAffx_StitchesHookerHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "StitchesHookDamage");
    trig = TriggerCreate("libAffx_StitchesSlammerHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "StitchesSlamMediumRangeDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "StitchesSlamDamage");
    trig = TriggerCreate("libAffx_StitchesGasBagHit_Func");
    trig = TriggerCreate("libAffx_StitchesGasBagWindow_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "StitchesGoldenGasDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_StitchesStitchesSlamInitialSetEcho_Func"), libAffx_player, "StitchesSlamInitialSet");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_StitchesHookCast_Func"), libAffx_player, "StitchesHookLaunchCreatePersistent");
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_StitchesHookArrive_Func"), null, "StitchesHooked", c_unitBehaviorChangeDestroy);
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_StitchesTick_Func"), 1.0, c_timeGame);
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_StitchesGorgeEnd_Func"), null, "StitchesGorgeInitialTargetBehavior", c_unitBehaviorChangeDestroy);
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_StitchesGorgeStart_Func"), null, "StitchesGorgeInitialTargetBehavior", c_unitBehaviorChangeCreate);
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_StitchesSync_Func"), 1.0, c_timeGame);
    return true;
}
