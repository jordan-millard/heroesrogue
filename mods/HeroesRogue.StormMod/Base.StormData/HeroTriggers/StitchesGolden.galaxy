        libAffx_CatalogReferenceModify("Effect,StitchesGoldenGasSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesGasBagAdded) * 0.03, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_StitchesGasBagAdded = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_StitchesGasBagPastApplied) {
        libAffx_StitchesGasBagPastApplied = power;
