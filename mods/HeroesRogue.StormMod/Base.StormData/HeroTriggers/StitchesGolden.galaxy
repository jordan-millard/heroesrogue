include "AffixTriggers"

// ============================================================
// Golden Stitches. Hooker: enemy Heroes hooked add Catch (Hook and Basic Attack damage) and open a 6 second takedown window.
// Takedowns add Reel: Heroic recharge, then hook speed, then a Slow on arrival, then at 100 Invulnerability on
// casting Hook and on hooking a Hero, then 2% damage per stack.
// Slammer: Slam hits on enemy Heroes add Smash; takedowns add Quake: a speed burst on Hero hits, then Slam size, then
// its Slow, then at 100 a second Slam, then 2% damage per stack.
// Gas Bag: a gas cloud around Stitches; Regeneration Globes (data) and Gorging an enemy Hero (5) add Leftovers; takedowns within 6 seconds of a gas
// hit add Stench: cloud size, then maximum Health, then at 100 a gas burst when Gorge lets go, then 2% damage per stack.
// ============================================================

const fixed libAffx_StitchesTakedownWindow = 3.0;
const fixed libAffx_StitchesPastCapDamagePerStack = 0.01;
bool libAffx_StitchesStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_StitchesHookerTime; // per enemy player, last Hooker hit
int libAffx_StitchesHookerAdded; // Hooker: takedown stacks already applied to the catalog this game
int libAffx_StitchesHookerAdded2; // Hooker: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_StitchesHookerAdded3; // Hooker: takedown quest stage 3 stacks already applied to the catalog this game
int libAffx_StitchesHookerPastApplied; // Hooker: takedown quest stacks past the cap applied as damage this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_StitchesSlammerTime; // per enemy player, last Slammer hit
int libAffx_StitchesSlammerAdded; // Slammer: takedown stacks already applied to the catalog this game
int libAffx_StitchesSlammerAdded2; // Slammer: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_StitchesSlammerAdded3; // Slammer: takedown quest stage 3 stacks already applied to the catalog this game
int libAffx_StitchesSlammerPastApplied; // Slammer: takedown quest stacks past the cap applied as damage this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_StitchesGasBagTime; // per enemy player, last Gas Bag hit
int libAffx_StitchesGasBagAdded; // Gas Bag: takedown stacks already applied to the catalog this game
int libAffx_StitchesGasBagPastApplied; // Gas Bag: takedown quest stacks past the cap applied as damage this game
fixed libAffx_StitchesHealthApplied; // Gas Bag: the maximum Health fraction last applied

unit libAffx_StitchesHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_StitchesIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_StitchesStacks(string tokenId) {
    unit hero = libAffx_StitchesHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_StitchesQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_StitchesInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_StitchesTakedownWindow;
}
// StitchesGoldenReelTokenCounter: stacks 1-40: 1% of Gorge's 65 and Putrid Bile's 75 second cooldowns each; 41-80 hook speed, 81-100 Slow on arrival, 100 Invulnerability (script), then damage
void libAffx_StitchesSyncHooker () {
    unit hero = libAffx_StitchesHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "StitchesGoldenHookerMarker")) {
        return;
    }
    stacks = libAffx_StitchesStacks("StitchesGoldenReelTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_StitchesHookerAdded) {
        libAffx_CatalogReferenceModify("Abil,StitchesGorge,Cost[0].Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesHookerAdded) * -0.65, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Abil,StitchesPutridBile,Cost[0].Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesHookerAdded) * -0.75, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_StitchesHookerAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): Hook flies 1% faster each
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_StitchesHookerAdded2) {
        libAffx_CatalogReferenceModify("Mover,StitchesHookMissile,MotionPhases[0].Speed", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesHookerAdded2) * 0.375, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Mover,StitchesHookMissile,MotionPhases[0].MaxSpeed", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesHookerAdded2) * 0.2, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_StitchesHookerAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): hooked Heroes are Slowed 1% more each on arrival (applied by libAffx_StitchesHookArrive_Func)
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_StitchesHookerAdded3) {
        libAffx_CatalogReferenceModify("Behavior,StitchesGoldenHookSlow,Modification.UnifiedMoveSpeedFactor", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesHookerAdded3) * -0.01, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_StitchesHookerAdded3 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_StitchesHookerPastApplied) {
        libAffx_StitchesHookerPastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "StitchesHookerPastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "StitchesHookerPastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "StitchesHookerPastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "StitchesHookerPastCapDamage")) {
        UnitBehaviorAdd(hero, "StitchesHookerPastCapDamage", hero, 1);
    }
}
// StitchesGoldenQuakeTokenCounter: stacks 1-40: 2% each to the speed burst (the 4 steps get 100%, 75%, 50% and 25% of it); 41-80 Slam size, 81-100 Slow, 100 echo (script), then damage
void libAffx_StitchesSyncSlammer () {
    unit hero = libAffx_StitchesHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "StitchesGoldenSlammerMarker")) {
        return;
    }
    stacks = libAffx_StitchesStacks("StitchesGoldenQuakeTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_StitchesSlammerAdded) {
        libAffx_CatalogReferenceModify("Behavior,StitchesGoldenSlamRush1,Modification.MoveSpeedMultiplier", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesSlammerAdded) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,StitchesGoldenSlamRush2,Modification.MoveSpeedMultiplier", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesSlammerAdded) * 0.015, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,StitchesGoldenSlamRush3,Modification.MoveSpeedMultiplier", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesSlammerAdded) * 0.01, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,StitchesGoldenSlamRush4,Modification.MoveSpeedMultiplier", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesSlammerAdded) * 0.005, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_StitchesSlammerAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): Slam is 1% larger each
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_StitchesSlammerAdded2) {
        libAffx_CatalogReferenceModify("Effect,StitchesSlamMediumSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesSlammerAdded2) * 0.0525, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,StitchesSlamLargeSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesSlammerAdded2) * 0.095, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_StitchesSlammerAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): Slam's Slow is 1% stronger each
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_StitchesSlammerAdded3) {
        libAffx_CatalogReferenceModify("Behavior,StitchesSlamSlow,Modification.UnifiedMoveSpeedFactor", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_StitchesSlammerAdded3) * -0.01, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_StitchesSlammerAdded3 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_StitchesSlammerPastApplied) {
        libAffx_StitchesSlammerPastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "StitchesSlammerPastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "StitchesSlammerPastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "StitchesSlammerPastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "StitchesSlammerPastCapDamage")) {
        UnitBehaviorAdd(hero, "StitchesSlammerPastCapDamage", hero, 1);
    }
}
// StitchesGoldenStenchTokenCounter: stacks 1-40: the gas cloud is 1% larger each; 41-80 maximum Health (libAffx_StitchesTick_Func), 100 gas burst (script), then damage
