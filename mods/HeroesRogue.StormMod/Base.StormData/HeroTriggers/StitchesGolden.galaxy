    unit hero = libAffx_StitchesHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "StitchesGoldenGasBagMarker")) {
        return;
    }
    stacks = libAffx_StitchesStacks("StitchesGoldenStenchTokenCounter");
