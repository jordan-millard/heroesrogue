include "AffixTriggers"

// ============================================================
// Golden Sonya, Spin to Win. Whirlwind hits store bonus damage for the next Whirlwind (1% per non-Hero hit,
// 10% per Hero hit). Whirlwind costs no Fury but spends all of it (SonyaData.xml), and its radius scales with the
// Fury spent: 50% at 0 Fury, normal at 40, double at 80, and on up from there.
// Unstoppable and no Seismic Slam are in SonyaData.xml.
// ============================================================

const fixed libAffx_sonyaWhirlwindRadius = 2.5;
const int libAffx_sonyaSpinHeroHit = 10;
const int libAffx_sonyaSpinOtherHit = 1;
const fixed libAffx_sonyaSpinNormalFury = 40.0; // Fury for the normal radius

bool libAffx_sonyaSpinStarted;
int libAffx_sonyaSpinStored; // % bonus from hits since the last Whirlwind ended, for the next Whirlwind
bool libAffx_sonyaSpinActive; // Whirlwinding
fixed libAffx_sonyaSpinRadius;

unit libAffx_SonyaHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_SonyaHasSpinToWin() {
    unit hero = libAffx_SonyaHero();
    return hero != null && UnitHasBehavior2(hero, "SonyaSpinToWinMarker");
}

void libAffx_SonyaSpinSetBonus(int percent) {
    string value = FixedToString(IntToFixed(percent) / 100.0, 2);
    CatalogFieldValueSet(c_gameCatalogEffect, "BarbarianWhirlwindDamage", "MultiplicativeModifierArray[SonyaSpinToWin].Modifier", libAffx_player, value);
    CatalogFieldValueSet(c_gameCatalogEffect, "BarbarianWhirlwindHeroDamage", "MultiplicativeModifierArray[SonyaSpinToWin].Modifier", libAffx_player, value);
    CatalogFieldValueSet(c_gameCatalogEffect, "BarbarianWhirlwindRuthlessTalentDamage", "MultiplicativeModifierArray[SonyaSpinToWin].Modifier", libAffx_player, value);
}

// The tracker shows the next Whirlwind's bonus
void libAffx_SonyaSpinShow(int percent) {
    unit hero = libAffx_SonyaHero();
    int change = percent - FixedToInt(UnitGetTokenCount(hero, "SonyaSpinToWinTokenCounter"));
    if (change != 0) {
        libGame_gf_ModifyTokenCount(change, "SonyaSpinToWinTokenCounter", hero);
    }
}

void libAffx_SonyaSpinStore(int percent) {
    libAffx_sonyaSpinStored += percent;
    if (libAffx_sonyaSpinActive) {
        libAffx_SonyaSpinShow(libAffx_sonyaSpinStored);
    }
}

bool libAffx_SonyaSpinHitCheck() {
    return EventUnitDamageSourcePlayer() == libAffx_player && libAffx_SonyaHasSpinToWin();
}
bool libAffx_SonyaSpinHeroHit_Func (bool testConds, bool runActions) {
    if (testConds && !libAffx_SonyaSpinHitCheck()) {
        return false;
    }
    if (runActions) {
        libAffx_SonyaSpinStore(libAffx_sonyaSpinHeroHit);
    }
    return true;
}
bool libAffx_SonyaSpinOtherHit_Func (bool testConds, bool runActions) {
    if (testConds && !libAffx_SonyaSpinHitCheck()) {
        return false;
    }
    if (runActions) {
        libAffx_SonyaSpinStore(libAffx_sonyaSpinOtherHit);
    }
    return true;
}

// When a Whirlwind starts, the tracker switches from its bonus to the one being built for the next Whirlwind
bool libAffx_SonyaSpinBegin_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (EventUnit() != libAffx_SonyaHero() || !libAffx_SonyaHasSpinToWin()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_sonyaSpinActive = true;
    libAffx_SonyaSpinShow(libAffx_sonyaSpinStored);
    return true;
}

// When a Whirlwind ends, the damage it stored goes to the next one; the tracker keeps showing it
bool libAffx_SonyaSpinEnd_Func (bool testConds, bool runActions) {
    if (testConds) {
        if (EventUnit() != libAffx_SonyaHero() || !libAffx_SonyaHasSpinToWin()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_sonyaSpinActive = false;
    libAffx_SonyaSpinSetBonus(libAffx_sonyaSpinStored);
    libAffx_SonyaSpinShow(libAffx_sonyaSpinStored);
    libAffx_sonyaSpinStored = 0;
    return true;
}

// Whirlwind's radius follows the Fury held, and stays fixed while Whirlwinding
bool libAffx_SonyaSpinRadius_Func (bool testConds, bool runActions) {
    unit hero = libAffx_SonyaHero();
    fixed radius;
    fixed fury;
    if (hero == null || !UnitIsAlive(hero) || !libAffx_SonyaHasSpinToWin() || libAffx_sonyaSpinActive) {
        return true;
    }
    fury = UnitGetPropertyFixed(hero, c_unitPropEnergy, c_unitPropCurrent);
    if (fury <= libAffx_sonyaSpinNormalFury) {
        radius = libAffx_sonyaWhirlwindRadius * (0.5 + 0.5 * fury / libAffx_sonyaSpinNormalFury);
    } else {
        radius = libAffx_sonyaWhirlwindRadius * (fury / libAffx_sonyaSpinNormalFury);
    }
    if (AbsF(radius - libAffx_sonyaSpinRadius) > 0.01) {
        libAffx_sonyaSpinRadius = radius;
        CatalogFieldValueSet(c_gameCatalogEffect, "BarbarianWhirlwindSearchArea", "AreaArray[0].Radius", libAffx_player, FixedToString(radius, 2));
    }
    return true;
}

// Quest: enemy Hero takedowns grant a stack (Whirlwind damage in SonyaData.xml; carried over by QuestRetain)
bool libAffx_SonyaSpinTakedown (bool testConds, bool runActions) {
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || !libAffx_SonyaHasSpinToWin()) {
            return false;
        }
    }
    libGame_gf_ModifyTokenCount(1, "SonyaSpinToWinQuestTokenCounter", libAffx_SonyaHero());
    return true;
}

// AffixAdded for Spin to Win
bool libAffx_SonyaSpinToWinStart (bool testConds, bool runActions) {
    if (libAffx_sonyaSpinStarted) {
        return true;
    }
    libAffx_sonyaSpinStarted = true;
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_SonyaSpinHeroHit_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, "BarbarianWhirlwindHeroDamage");
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_SonyaSpinOtherHit_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, "BarbarianWhirlwindDamage");
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_SonyaSpinBegin_Func"), null, "BarbarianWhirlwindChannel", c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_SonyaSpinEnd_Func"), null, "BarbarianWhirlwindChannel", c_unitBehaviorChangeDestroy);
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_SonyaSpinRadius_Func"), 0.0625, c_timeGame);
    return true;
}
