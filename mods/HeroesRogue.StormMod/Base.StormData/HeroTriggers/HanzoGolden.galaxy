include "AffixTriggers"

// ============================================================
// Golden Hanzo. Storm Archer: Storm Bow hits on enemy Heroes add Focus (Storm Bow and Basic Attack damage) and open a
// 6 second takedown window. Takedowns add Mastery: recharge, then arrow speed and charge speed, then arrow width,
// then at 100 an echo arrow, then 2% damage per stack. Storm Bow's range is in Hanzo's own script (libHHAN).
// Scatter Master: shard hits on enemy Heroes add Volley (once per Hero per arrow); takedowns add Ricochet: recharge,
// then more shards, then more bounces, then at 100 shards split on Heroes, then 2% damage per stack.
// ============================================================

const fixed libAffx_HanzoTakedownWindow = 3.0;
const fixed libAffx_HanzoPastCapDamagePerStack = 0.01;
bool libAffx_HanzoStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_HanzoArcherTime; // per enemy player, last Storm Archer hit
int libAffx_HanzoArcherAdded; // Storm Archer: takedown stacks already applied to the catalog this game
int libAffx_HanzoArcherAdded2; // Storm Archer: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_HanzoArcherAdded3; // Storm Archer: takedown quest stage 3 stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_HanzoScatterTime; // per enemy player, last Scatter Master hit
int libAffx_HanzoScatterAdded; // Scatter Master: takedown stacks already applied to the catalog this game
int libAffx_HanzoPowerApplied; // Storm Archer: Mastery stacks past 100 applied as damage
fixed libAffx_HanzoChargeStart = -10.0; // Storm Archer: game time Storm Bow last started charging
fixed libAffx_HanzoEchoLast = -1.0; // Storm Archer: game time of the last echo arrow
int libAffx_HanzoBouncesApplied; // Scatter Master: Ricochet stacks applied as shard bounces
bool libAffx_HanzoSplitOn; // Scatter Master: 100 Ricochet stacks reached this game (split turned on)
int libAffx_HanzoScatterPowerApplied; // Scatter Master: Ricochet stacks past 100 applied as damage
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_HanzoVolleyTime; // Scatter Master: per enemy player, last Volley count

unit libAffx_HanzoHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_HanzoIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_HanzoStacks(string tokenId) {
    unit hero = libAffx_HanzoHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_HanzoQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_HanzoInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_HanzoTakedownWindow;
}
// HanzoGoldenMasteryTokenCounter: stacks 1-40: 1% of the 4 second cooldown each; 41-80 arrow and charge speed, 81-100 arrow width, 100 echo, then damage (libAffx_HanzoArcherSync)
void libAffx_HanzoSyncArcher () {
    unit hero = libAffx_HanzoHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "HanzoArcherMarker")) {
        return;
    }
    stacks = libAffx_HanzoStacks("HanzoGoldenMasteryTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_HanzoArcherAdded) {
        libAffx_CatalogReferenceModify("Abil,HanzoStormBowFireTargetPoint,Cost[0].Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HanzoArcherAdded) * -0.04, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_HanzoArcherAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): the arrow flies 1% faster and Storm Bow charges 1% faster each
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_HanzoArcherAdded2) {
        libAffx_CatalogReferenceModify("Mover,HanzoStormBowMissileMover,MotionPhases[0].Speed", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HanzoArcherAdded2) * 0.36, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Mover,HanzoStormBowMissileMover,MotionPhases[0].MaxSpeed", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HanzoArcherAdded2) * 0.36, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,HanzoStormBowCharging,Duration", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HanzoArcherAdded2) * -0.011875, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_HanzoArcherAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): the arrow is 1% wider each
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_HanzoArcherAdded3) {
        libAffx_CatalogReferenceModify("Effect,HanzoStormBowTargetSearch,AreaArray[0].RectangleWidth", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HanzoArcherAdded3) * 0.005, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_HanzoArcherAdded3 = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 100)) * 0.0, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "HanzoStormBowDamage", "MultiplicativeModifierArray[HanzoArcherLegacy].Modifier", libAffx_player, bonus);
}
// HanzoGoldenRicochetTokenCounter: stacks 1-40: 1% of the 8 second recharge each; 41-80 shards, 81-100 bounces, 100 split, then damage (libAffx_HanzoScatterSync)
void libAffx_HanzoSyncScatter () {
    unit hero = libAffx_HanzoHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "HanzoScatterMarker")) {
        return;
    }
    stacks = libAffx_HanzoStacks("HanzoGoldenRicochetTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_HanzoScatterAdded) {
        libAffx_CatalogReferenceModify("Abil,HanzoScatterArrow,Cost[0].Charge.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_HanzoScatterAdded) * -0.08, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_HanzoScatterAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 100)) * 0.0, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "HanzoScatterArrowRicochetDamage", "MultiplicativeModifierArray[HanzoScatterLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "HanzoGoldenSplitDamage", "MultiplicativeModifierArray[HanzoScatterLegacy].Modifier", libAffx_player, bonus);
}
bool libAffx_HanzoSync_Func (bool testConds, bool runActions) {
    libAffx_HanzoSyncArcher();
    libAffx_HanzoSyncScatter();
    return true;
}
// Storm Archer: Storm Bow's charged range (Hanzo's own script grows it from a base to a maximum per player) is 20% longer:
// 7.2 to 15.6 instead of 6 to 13 (Target Practice's 30% bonus kept). Past 100 Mastery: 2% damage per stack.
void libAffx_HanzoArcherSync () {
    unit hero = libAffx_HanzoHero();
    int power;
    fixed maxRange;
    if (hero == null || !UnitHasBehavior2(hero, "HanzoArcherMarker")) {
        return;
    }
    libHHAN_gv_heroHanzoStormBowBaseRangeForPlayer[libAffx_player] = 7.2;
    maxRange = libHHAN_gv_heroHanzoStormBowMaximumRangeForPlayer[libAffx_player];
    if (maxRange == libHHAN_gv_heroHanzoStormBowDefaultMaximumRange) {
        libHHAN_gv_heroHanzoStormBowMaximumRangeForPlayer[libAffx_player] = 15.6;
    } else if (AbsF(maxRange - libHHAN_gv_heroHanzoStormBowDefaultMaximumRange * libHHAN_gv_heroHanzoTargetPracticeRewardRangeMultiplier) < 0.01) {
        libHHAN_gv_heroHanzoStormBowMaximumRangeForPlayer[libAffx_player] = 15.6 * libHHAN_gv_heroHanzoTargetPracticeRewardRangeMultiplier;
    }
    power = MaxI(0, libAffx_HanzoStacks("HanzoGoldenMasteryTokenCounter") - 100);
    if (power != libAffx_HanzoPowerApplied) {
        libAffx_HanzoPowerApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "HanzoGoldenOverdrive", "Modification.DamageDealtFraction[Basic]", libAffx_player, 0.02 * IntToFixed(power));
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "HanzoGoldenOverdrive", "Modification.DamageDealtFraction[Ability]", libAffx_player, 0.02 * IntToFixed(power));
        UnitBehaviorRemove(hero, "HanzoGoldenOverdrive", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "HanzoGoldenOverdrive")) {
        UnitBehaviorAdd(hero, "HanzoGoldenOverdrive", hero, 1);
    }
}
// Scatter Master: extra shards (2, then 1 more per 10 Ricochet stacks 41-80), extra bounces (1 per 10 stacks 81-100), the
// 100 split and past 100 2% damage per stack
void libAffx_HanzoScatterSync () {
    unit hero = libAffx_HanzoHero();
    int stacks;
    int wanted;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "HanzoScatterMarker")) {
        return;
    }
    stacks = libAffx_HanzoStacks("HanzoGoldenRicochetTokenCounter");
    wanted = 2 + MinI(4, MaxI(0, stacks - 40) / 10) - UnitBehaviorCount(hero, "HanzoGoldenExtraShards");
    if (wanted > 0) {
        UnitBehaviorAdd(hero, "HanzoGoldenExtraShards", hero, wanted);
    } else if (wanted < 0) {
        UnitBehaviorRemove(hero, "HanzoGoldenExtraShards", -wanted);
    }
    wanted = MinI(2, MaxI(0, stacks - 80) / 10);
    if (wanted != libAffx_HanzoBouncesApplied) {
        libAffx_CatalogReferenceModify("Behavior,HanzoScatterArrowBounceCounter,Max", libAffx_player, IntToString(wanted - libAffx_HanzoBouncesApplied), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,HanzoScatterArrowBounceCounter,Init", libAffx_player, IntToString(wanted - libAffx_HanzoBouncesApplied), c_upgradeOperationAdd);
        libAffx_HanzoBouncesApplied = wanted;
    }
    if (stacks >= 100 && !libAffx_HanzoSplitOn) {
        libAffx_HanzoSplitOn = true;
        libAffx_CatalogReferenceModify("Effect,HanzoGoldenSplitSet,Chance", libAffx_player, "1", c_upgradeOperationSet);
    }
    power = MaxI(0, stacks - 100);
    if (power != libAffx_HanzoScatterPowerApplied) {
        libAffx_HanzoScatterPowerApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "HanzoGoldenScatterOverdrive", "Modification.DamageDealtFraction[Basic]", libAffx_player, 0.02 * IntToFixed(power));
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "HanzoGoldenScatterOverdrive", "Modification.DamageDealtFraction[Ability]", libAffx_player, 0.02 * IntToFixed(power));
        UnitBehaviorRemove(hero, "HanzoGoldenScatterOverdrive", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "HanzoGoldenScatterOverdrive")) {
        UnitBehaviorAdd(hero, "HanzoGoldenScatterOverdrive", hero, 1);
    }
}
// Scatter Master, Volley quest: a Hero counts once per arrow (its shards land within a second), not once per shard
bool libAffx_HanzoVolleyCounts (unit victim) {
    int owner = UnitGetOwner(victim);
    if (GameGetMissionTime() - libAffx_HanzoVolleyTime[owner] <= 1.0) {
        return false;
    }
    libAffx_HanzoVolleyTime[owner] = GameGetMissionTime();
    return true;
}
bool libAffx_HanzoArcherTick_Func (bool testConds, bool runActions) {
    libAffx_HanzoArcherSync();
    libAffx_HanzoScatterSync();
    return true;
}
// Storm Bow starts charging: remembered for Headshot (fully charged = the charge ran its whole duration)
bool libAffx_HanzoChargeStart_Func (bool testConds, bool runActions) {
    if (EventUnit() != libAffx_HanzoHero()) {
        return false;
    }
    libAffx_HanzoChargeStart = GameGetMissionTime();
    return true;
}
// Storm Bow fired: Headshot readies a fully charged arrow; at 100 Mastery the echo arrow follows 0.4 seconds later toward
// the same point. The echo's own launch is skipped by its time.
bool libAffx_HanzoBowLaunch_Func (bool testConds, bool runActions) {
    unit hero = libAffx_HanzoHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    fixed full;
    if (hero == null || !UnitHasBehavior2(hero, "HanzoArcherMarker") || GameGetMissionTime() == libAffx_HanzoEchoLast) {
        return false;
    }
    full = StringToFixed(CatalogFieldValueGet(c_gameCatalogBehavior, "HanzoStormBowCharging", "Duration", libAffx_player));
    if (UnitHasBehavior2(hero, "HanzoHeadshotMarker") && GameGetMissionTime() - libAffx_HanzoChargeStart >= full - 0.0625) {
        UnitBehaviorAdd(hero, "HanzoGoldenHeadshotReady", hero, 1);
    }
    if (libAffx_HanzoStacks("HanzoGoldenMasteryTokenCounter") < 100 || target == null) {
        return true;
    }
    Wait(0.4, c_timeGame);
    if (!UnitIsAlive(hero)) {
        return true;
    }
    libAffx_HanzoEchoLast = GameGetMissionTime();
    UnitBehaviorAdd(hero, "HanzoGoldenEchoing", hero, 1);
    UnitCreateEffectPoint(hero, "HanzoStormBowLaunchMissile", target);
    return true;
}
// Machine Bow (Legendary): while aiming Storm Bow, Hanzo fires a Basic Attack at the nearest enemy in attack range every
// 0.5 seconds (only units he could attack: visible, not hidden, invulnerable, in stasis or benign)
bool libAffx_HanzoMachineBow_Func (bool testConds, bool runActions) {
    unit hero = libAffx_HanzoHero();
    unitgroup nearby;
    unit target;
    if (hero == null || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "HanzoMachineBowMarker") || !UnitHasBehavior2(hero, "HanzoStormBowTargeting")) {
        return false;
    }
    nearby = UnitGroupAlliance(libAffx_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(hero), UnitWeaponRange(hero, 1) + 0.5), UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterStasis - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32)) | (1 << (c_targetFilterBenign - 32))), 0);
    if (UnitGroupCount(nearby, c_unitCountAlive) == 0) {
        return true;
    }
    target = UnitGroupClosestToPoint(nearby, UnitGetPosition(hero));
    if (target != null && UnitIsAlive(target)) {
        UnitCreateEffectUnit(hero, "HanzoHeroWeaponLaunchMissile", target);
    }
    return true;
}
// Storm Archer hit on an enemy Hero: takedown window, HanzoGoldenFocusTokenCounter, the heal, and on-hit boons
bool libAffx_HanzoArcherHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_HanzoHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_HanzoIsEnemyHero(victim) || !UnitHasBehavior2(hero, "HanzoArcherMarker")) {
        return false;
    }
    libAffx_HanzoArcherTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "HanzoGoldenFocusTokenCounter", hero);
    return true;
}
// Scatter Master hit on an enemy Hero: takedown window, HanzoGoldenVolleyTokenCounter, the heal, and on-hit boons
bool libAffx_HanzoScatterHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_HanzoHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_HanzoIsEnemyHero(victim) || !UnitHasBehavior2(hero, "HanzoScatterMarker")) {
        return false;
    }
    libAffx_HanzoScatterTime[UnitGetOwner(victim)] = GameGetMissionTime();
    if (libAffx_HanzoVolleyCounts(victim)) {
        libGame_gf_ModifyTokenCount(1, "HanzoGoldenVolleyTokenCounter", hero);
    }
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[3] libAffx_HanzoTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_HanzoTakedownCrossStart () {
    unit hero = libAffx_HanzoHero();
    if (hero == null) {
        return;
    }
    libAffx_HanzoTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "HanzoGoldenMasteryTokenCounter"));
    libAffx_HanzoTakedownBefore[2] = FixedToInt(UnitGetTokenCount(hero, "HanzoGoldenRicochetTokenCounter"));
}
void libAffx_HanzoTakedownCross () {
    unit hero = libAffx_HanzoHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "HanzoGoldenMasteryTokenCounter")) == libAffx_HanzoTakedownBefore[1] && FixedToInt(UnitGetTokenCount(hero, "HanzoGoldenRicochetTokenCounter")) == libAffx_HanzoTakedownBefore[2]) {
        return;
    }
    if (UnitHasBehavior2(hero, "HanzoArcherMarker") && FixedToInt(UnitGetTokenCount(hero, "HanzoGoldenMasteryTokenCounter")) == libAffx_HanzoTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "HanzoGoldenMasteryTokenCounter", hero);
        libAffx_HanzoSyncArcher();
        libAffx_HanzoArcherSync();
    }
    if (UnitHasBehavior2(hero, "HanzoScatterMarker") && FixedToInt(UnitGetTokenCount(hero, "HanzoGoldenRicochetTokenCounter")) == libAffx_HanzoTakedownBefore[2]) {
        libGame_gf_ModifyTokenCount(1, "HanzoGoldenRicochetTokenCounter", hero);
        libAffx_HanzoSyncScatter();
        libAffx_HanzoScatterSync();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_HanzoTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_HanzoHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_HanzoTakedownCrossStart();
    if (UnitHasBehavior2(hero, "HanzoArcherMarker") && libAffx_HanzoArcherTime[killedPlayer] > 0.0 && now - libAffx_HanzoArcherTime[killedPlayer] <= 6.0) {
        libAffx_HanzoArcherTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "HanzoGoldenMasteryTokenCounter", hero);
        libAffx_HanzoSyncArcher();
        libAffx_HanzoQuestDing();
        libAffx_HanzoArcherSync();
    }
    if (UnitHasBehavior2(hero, "HanzoScatterMarker") && libAffx_HanzoScatterTime[killedPlayer] > 0.0 && now - libAffx_HanzoScatterTime[killedPlayer] <= 6.0) {
        libAffx_HanzoScatterTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "HanzoGoldenRicochetTokenCounter", hero);
        libAffx_HanzoSyncScatter();
        libAffx_HanzoQuestDing();
        libAffx_HanzoScatterSync();
    }
    libAffx_HanzoTakedownCross();
    return true;
}
bool libAffx_HanzoStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_HanzoStarted) {
        return true;
    }
    libAffx_HanzoStarted = true;
    trig = TriggerCreate("libAffx_HanzoArcherHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "HanzoStormBowDamage");
    trig = TriggerCreate("libAffx_HanzoScatterHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "HanzoScatterArrowRicochetDamage");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_HanzoArcherTick_Func"), 1.0, c_timeGame);
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_HanzoChargeStart_Func"), null, "HanzoStormBowCharging", c_unitBehaviorChangeCreate);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_HanzoBowLaunch_Func"), libAffx_player, "HanzoStormBowLaunchMissile");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_HanzoMachineBow_Func"), 0.5, c_timeGame);
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_HanzoSync_Func"), 1.0, c_timeGame);
    return true;
}
