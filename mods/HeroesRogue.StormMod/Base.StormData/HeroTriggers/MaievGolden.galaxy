include "AffixTriggers"

// ============================================================
// Golden Maiev. Fan Dancer: Fan of Knives hits on enemy Heroes add Edge; takedowns add Flourish: Fan size, then Vault
// duration, then maximum Health damage, then at 100 a second Fan for 50%, then 2% damage per stack.
// Jailer of the Watchers: enemy Heroes tethered by Umbral Bind add Shackles; takedowns add Sentence: Umbral Bind
// CC duration, then Basic Attack cooldown cut, then a stronger pull, then at 100 range and 2 binds, then 2% damage.
// Shadow Warden: spirit hits on enemy Heroes add Vengeance; takedowns add Vigil: Vault recharge, then spirit speed
// and distance, then spirit width, then at 100 a doubled Warden's Cage, then 2% damage per stack.
// ============================================================

const fixed libAffx_MaievTakedownWindow = 3.0;
const fixed libAffx_MaievPastCapDamagePerStack = 0.01;
bool libAffx_MaievStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_MaievFanTime; // per enemy player, last Fan Dancer hit
int libAffx_MaievFanAdded; // Fan Dancer: takedown stacks already applied to the catalog this game
int libAffx_MaievFanAdded2; // Fan Dancer: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_MaievFanAdded3; // Fan Dancer: takedown quest stage 3 stacks already applied to the catalog this game
int libAffx_MaievFanPastApplied; // Fan Dancer: takedown quest stacks past the cap applied as damage this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_MaievJailerTime; // per enemy player, last Jailer of the Watchers hit
int libAffx_MaievJailerAdded; // Jailer of the Watchers: takedown stacks already applied to the catalog this game
int libAffx_MaievJailerAdded2; // Jailer of the Watchers: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_MaievJailerAdded3; // Jailer of the Watchers: takedown quest stage 3 stacks already applied to the catalog this game
int libAffx_MaievJailerPastApplied; // Jailer of the Watchers: takedown quest stacks past the cap applied as damage this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_MaievWardenTime; // per enemy player, last Shadow Warden hit
int libAffx_MaievWardenAdded; // Shadow Warden: takedown stacks already applied to the catalog this game
int libAffx_MaievWardenAdded2; // Shadow Warden: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_MaievWardenAdded3; // Shadow Warden: takedown quest stage 3 stacks already applied to the catalog this game
int libAffx_MaievWardenPastApplied; // Shadow Warden: takedown quest stacks past the cap applied as damage this game
bool libAffx_MaievFanPercentOn; // Fan Dancer: Flourish 81 turned on Fan of Knives' Health damage
trigger libAffx_MaievResolveTrigger; // Jailer of the Watchers: cuts Stuns, Roots and Slows (Sentence 1-40)
string libAffx_MaievResolveLast; // Jailer of the Watchers: the last Stun, Root or Slow cut (one cut per behavior)
fixed libAffx_MaievResolveTime; // Jailer of the Watchers: when it was cut
bool libAffx_MaievCageDoubled; // Shadow Warden: Vigil 100 doubled Warden's Cage

unit libAffx_MaievHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_MaievIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_MaievStacks(string tokenId) {
    unit hero = libAffx_MaievHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_MaievQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_MaievInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_MaievTakedownWindow;
}
// MaievGoldenFlourishTokenCounter: stacks 1-40: Fan of Knives is 1% larger each; 41-80 Vault lasts 2% longer, 81-100 Health damage, 100 echo (script), then damage
void libAffx_MaievSyncFan () {
    unit hero = libAffx_MaievHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "MaievGoldenFanDancerMarker")) {
        return;
    }
    stacks = libAffx_MaievStacks("MaievGoldenFlourishTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_MaievFanAdded) {
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[0].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.033300, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[0].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.009300, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[1].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.035000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[2].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.032336, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[2].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.013393, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[3].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.024748, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[3].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.024748, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[4].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.013393, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[4].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.032336, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[5].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.035000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[6].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.013393, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[6].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.032336, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[7].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.024748, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[7].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.024748, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[8].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.032336, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[8].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.013393, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[9].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.035000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[10].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.033300, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[10].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.009300, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[11].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.030000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[12].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.024000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[12].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.007500, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[13].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.015000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[13].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.014000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[14].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.017000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[15].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.015000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[15].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.014000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[16].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.024000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[16].Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * -0.007500, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievFanOfKnivesSearchArea,AreaArray[0].VertexArray[17].X", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded) * 0.030000, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_MaievFanAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): Vault of the Wardens lasts 2% longer each
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_MaievFanAdded2) {
        libAffx_CatalogReferenceModify("Behavior,MaievVaultOfTheWardensAirborneStasis,Duration", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded2) * 0.015, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,MaievVaultOfTheWardensAirborneStasisEvasion,Duration", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded2) * 0.015, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_MaievFanAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): Fan of Knives deals 0.25% of an enemy Hero's maximum Health more each (on from 81: libAffx_MaievTick_Func)
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_MaievFanAdded3) {
        libAffx_CatalogReferenceModify("Effect,MaievGoldenFanPercentDamage,VitalFractionMax[Life]", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievFanAdded3) * 0.0025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_MaievFanAdded3 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_MaievFanPastApplied) {
        libAffx_MaievFanPastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "MaievFanPastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "MaievFanPastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "MaievFanPastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "MaievFanPastCapDamage")) {
        UnitBehaviorAdd(hero, "MaievFanPastCapDamage", hero, 1);
    }
}
// MaievGoldenSentenceTokenCounter: stacks 1-40: Stuns, Roots and Slows on Maiev 2% shorter each (libAffx_MaievJailerResolve_Func); 41-80 Basic Attack cooldown cut, 81-100 pull strength, 100 range and 2 binds (script), then damage
void libAffx_MaievSyncJailer () {
    unit hero = libAffx_MaievHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "MaievGoldenJailerMarker")) {
        return;
    }
    stacks = libAffx_MaievStacks("MaievGoldenSentenceTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_MaievJailerAdded) {
        libAffx_MaievJailerAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): Basic Attacks against enemy Heroes take 0.025 seconds more off Umbral Bind's cooldown each (2 seconds at 80)
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_MaievJailerAdded2) {
        libAffx_CatalogReferenceModify("Effect,MaievGoldenAttackBindCooldown,Cost[0].CooldownTimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievJailerAdded2) * -0.025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_MaievJailerAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): the pull is 1% faster each over the same time, so it pulls 1% farther
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_MaievJailerAdded3) {
        libAffx_CatalogReferenceModify("Behavior,MaievUmbralBindPull,Modification.MoveSpeedMaximum", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievJailerAdded3) * 0.2105, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,MaievUmbralBindPull,Modification.MoveSpeedMinimum", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievJailerAdded3) * 0.2105, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_MaievJailerAdded3 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_MaievJailerPastApplied) {
        libAffx_MaievJailerPastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "MaievJailerPastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "MaievJailerPastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "MaievJailerPastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "MaievJailerPastCapDamage")) {
        UnitBehaviorAdd(hero, "MaievJailerPastCapDamage", hero, 1);
    }
}
