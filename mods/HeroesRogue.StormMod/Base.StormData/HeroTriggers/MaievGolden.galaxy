    if (wanted != libAffx_MaievWardenAdded3) {
        libAffx_CatalogReferenceModify("Effect,MaievSpiritOfVengeanceMissileScan,AreaArray[0].RectangleWidth", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievWardenAdded3) * 0.03, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,MaievGoldenVaultSpiritSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_MaievWardenAdded3) * 0.025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_MaievWardenAdded3 = wanted;
