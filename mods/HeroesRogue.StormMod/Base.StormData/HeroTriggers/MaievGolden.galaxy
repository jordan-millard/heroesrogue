        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "MaievWardenPastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "MaievWardenPastCapDamage", 1);
