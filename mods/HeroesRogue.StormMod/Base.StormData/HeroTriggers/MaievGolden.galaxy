bool libAffx_MaievSync_Func (bool testConds, bool runActions) {
    libAffx_MaievSyncFan();
    libAffx_MaievSyncJailer();
    libAffx_MaievSyncWarden();
    return true;
}
// an enemy-team Hero (the base hero test counts allies too)
bool libAffx_MaievIsFoe (unit target) {
    if (!libAffx_MaievIsEnemyHero(target)) {
        return false;
    }
    return libGame_gf_TeamNumberOfPlayer(UnitGetOwner(target)) != libGame_gf_TeamNumberOfPlayer(libAffx_player);
}
// Storm of Blades: 6 more fans around Maiev, at the cast's distance, turned 51.4286 degrees apart from the cast's direction
void libAffx_MaievFanCopies (unit hero, point target) {
    point origin = UnitGetPosition(hero);
    fixed angle = AngleBetweenPoints(origin, target);
    fixed dist = DistanceBetweenPoints(origin, target);
    int i;
    for (i = 1; i <= 6; i += 1) {
        UnitCreateEffectPoint(hero, "MaievGoldenFanCopyPersistent", PointWithOffsetPolar(origin, dist, angle + IntToFixed(i) * 51.4286));
    }
}
// Fan Dancer: a Fan of Knives is cast. Storm of Blades throws the other fans; at 100 Flourish a second Fan of Knives (and
// its Storm of Blades fans) follows 0.3 seconds later toward the same point for 50% damage. The echo's own event is skipped.
fixed libAffx_MaievFanLast = -1.0;
bool libAffx_MaievFanCast_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MaievHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    bool storm;
    if (hero == null || target == null || !UnitHasBehavior2(hero, "MaievGoldenFanDancerMarker") || GameGetMissionTime() == libAffx_MaievFanLast) {
        return false;
    }
    libAffx_MaievFanLast = GameGetMissionTime();
    storm = UnitHasBehavior2(hero, "MaievGoldenStormOfBladesMarker");
    if (storm) {
        libAffx_MaievFanCopies(hero, target);
    }
    if (libAffx_MaievStacks("MaievGoldenFlourishTokenCounter") < 100) {
        return true;
    }
    Wait(0.3, c_timeGame);
    if (!UnitIsAlive(hero)) {
        return true;
    }
    libAffx_MaievFanLast = GameGetMissionTime();
    UnitBehaviorAdd(hero, "MaievGoldenFanEcho", hero, 1);
    UnitCreateEffectPoint(hero, "MaievFanOfKnivesInitialPersistent", target);
    if (storm) {
        libAffx_MaievFanCopies(hero, target);
    }
    return true;
}
// Jailer of the Watchers: an enemy Hero is tethered by Umbral Bind: Shackles and the takedown window
bool libAffx_MaievBind_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MaievHero();
    if (hero == null || !UnitHasBehavior2(hero, "MaievGoldenJailerMarker") || !libAffx_MaievIsFoe(victim)) {
        return false;
    }
    libAffx_MaievJailerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "MaievGoldenShacklesTokenCounter", hero);
    return true;
}
// Jailer of the Watchers, Sentence 1-40: Stuns, Roots and Slows on Maiev last 2% shorter each (80% at 40). Their time left
// is cut when they land or are refreshed (a behavior in two of the categories is cut once).
bool libAffx_MaievJailerResolve_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MaievHero();
    string cc = EventUnitBehavior();
    fixed left;
    int stacks;
    if (hero == null || EventUnit() != hero || !UnitHasBehavior2(hero, "MaievGoldenJailerMarker")) {
        return false;
    }
    if (cc == libAffx_MaievResolveLast && GameGetMissionTime() == libAffx_MaievResolveTime) {
        return false;
    }
    stacks = MinI(libAffx_MaievStacks("MaievGoldenSentenceTokenCounter"), 40);
    left = UnitBehaviorDuration(hero, cc);
    if (stacks <= 0 || left <= 0.0) {
        return false;
    }
    libAffx_MaievResolveLast = cc;
    libAffx_MaievResolveTime = GameGetMissionTime();
    UnitBehaviorSetDurationRemaining(hero, cc, left * (1.0 - IntToFixed(stacks) * 0.02));
    return true;
}
// Jailer of the Watchers, Sentence at 100: Umbral Bind empowers 2 Basic Attacks. The first empowered attack gives the
// empowerment back once; Umbral Bind's cooldown restarts when the second is used.
bool libAffx_MaievBindAttack_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MaievHero();
    if (hero == null || !UnitHasBehavior2(hero, "MaievGoldenJailerMarker")) {
        return false;
    }
    if (UnitHasBehavior2(hero, "MaievGoldenJailerSecondBind")) {
        UnitBehaviorRemove(hero, "MaievGoldenJailerSecondBind", 1);
        return true;
    }
    if (libAffx_MaievStacks("MaievGoldenSentenceTokenCounter") < 100) {
        return false;
    }
    UnitBehaviorAdd(hero, "MaievGoldenJailerSecondBind", hero, 1);
    Wait(0.0625, c_timeGame);
    if (UnitIsAlive(hero) && !UnitHasBehavior2(hero, "MaievUmbralBindPrimed")) {
        UnitBehaviorAdd(hero, "MaievUmbralBindPrimed", hero, 1);
    }
    else {
        UnitBehaviorRemove(hero, "MaievGoldenJailerSecondBind", 1);
    }
    return true;
}
// The Hunt (Legendary): Vault Shields Maiev for 100% of her current Health, decaying over 4 seconds (8 Shields of 12.5%, the
// k-th lasting 0.5 * k seconds; all are refilled on each Vault)
bool libAffx_MaievVault_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MaievHero();
    fixed life;
    int k;
    string shield;
    if (hero == null || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "MaievGoldenTheHuntMarker")) {
        return false;
    }
    life = UnitGetPropertyFixed(hero, c_unitPropLife, c_unitPropCurrent);
    for (k = 1; k <= 8; k += 1) {
        shield = "MaievGoldenTheHuntShield" + IntToString(k);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, shield, "DamageResponse.ModifyLimit", libAffx_player, life / IntToFixed(8));
        UnitBehaviorRemove(hero, shield, 1);
        UnitBehaviorAdd(hero, shield, hero, 1);
    }
    return true;
}
// Every second: quest rewards switched on by stack counts (Flourish 81: Fan of Knives' Health damage; Sentence 100: +0.5
// attack range; Vigil 100: Warden's Cage's second ring)
bool libAffx_MaievTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_MaievHero();
    if (hero == null) {
        return false;
    }
    if (!libAffx_MaievFanPercentOn && UnitHasBehavior2(hero, "MaievGoldenFanDancerMarker") && libAffx_MaievStacks("MaievGoldenFlourishTokenCounter") > 80) {
        libAffx_MaievFanPercentOn = true;
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "MaievGoldenFanPercentDamage", "Chance", libAffx_player, 1.0);
    }
    if (UnitHasBehavior2(hero, "MaievGoldenJailerMarker") && libAffx_MaievStacks("MaievGoldenSentenceTokenCounter") >= 100 && !UnitHasBehavior2(hero, "MaievGoldenJailerReach")) {
        UnitBehaviorAdd(hero, "MaievGoldenJailerReach", hero, 1);
    }
    if (!libAffx_MaievCageDoubled && UnitHasBehavior2(hero, "MaievGoldenWardenMarker") && libAffx_MaievStacks("MaievGoldenVigilTokenCounter") >= 100) {
        libAffx_MaievCageDoubled = true;
        CatalogFieldValueSet(c_gameCatalogEffect, "MaievWardensCageInitialPersistent", "PeriodCount", libAffx_player, "16");
    }
    return true;
}
// Fan Dancer hit on an enemy Hero: takedown window, MaievGoldenEdgeTokenCounter, the heal, and on-hit boons
bool libAffx_MaievFanHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MaievHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_MaievIsEnemyHero(victim) || !UnitHasBehavior2(hero, "MaievGoldenFanDancerMarker")) {
        return false;
    }
    libAffx_MaievFanTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "MaievGoldenEdgeTokenCounter", hero);
    return true;
}
// Jailer of the Watchers hit on an enemy Hero: takedown window, MaievGoldenShacklesTokenCounter, the heal, and on-hit boons
bool libAffx_MaievJailerHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MaievHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_MaievIsEnemyHero(victim) || !UnitHasBehavior2(hero, "MaievGoldenJailerMarker")) {
        return false;
    }
    libAffx_MaievJailerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "MaievGoldenShacklesTokenCounter", hero);
    return true;
}
// Jailer of the Watchers: these effects on an enemy Hero only refresh the takedown window (no quest token, heal or on-hit boons)
bool libAffx_MaievJailerWindow_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MaievHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_MaievIsEnemyHero(victim) || !UnitHasBehavior2(hero, "MaievGoldenJailerMarker")) {
        return false;
    }
    libAffx_MaievJailerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}
// Shadow Warden hit on an enemy Hero: takedown window, MaievGoldenVengeanceTokenCounter, the heal, and on-hit boons
bool libAffx_MaievWardenHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_MaievHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_MaievIsEnemyHero(victim) || !UnitHasBehavior2(hero, "MaievGoldenWardenMarker")) {
        return false;
    }
    libAffx_MaievWardenTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "MaievGoldenVengeanceTokenCounter", hero);
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[4] libAffx_MaievTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_MaievTakedownCrossStart () {
    unit hero = libAffx_MaievHero();
    if (hero == null) {
        return;
    }
    libAffx_MaievTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "MaievGoldenFlourishTokenCounter"));
    libAffx_MaievTakedownBefore[2] = FixedToInt(UnitGetTokenCount(hero, "MaievGoldenSentenceTokenCounter"));
    libAffx_MaievTakedownBefore[3] = FixedToInt(UnitGetTokenCount(hero, "MaievGoldenVigilTokenCounter"));
}
void libAffx_MaievTakedownCross () {
    unit hero = libAffx_MaievHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "MaievGoldenFlourishTokenCounter")) == libAffx_MaievTakedownBefore[1] && FixedToInt(UnitGetTokenCount(hero, "MaievGoldenSentenceTokenCounter")) == libAffx_MaievTakedownBefore[2] && FixedToInt(UnitGetTokenCount(hero, "MaievGoldenVigilTokenCounter")) == libAffx_MaievTakedownBefore[3]) {
        return;
    }
    if (UnitHasBehavior2(hero, "MaievGoldenFanDancerMarker") && FixedToInt(UnitGetTokenCount(hero, "MaievGoldenFlourishTokenCounter")) == libAffx_MaievTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "MaievGoldenFlourishTokenCounter", hero);
        libAffx_MaievSyncFan();
    }
    if (UnitHasBehavior2(hero, "MaievGoldenJailerMarker") && FixedToInt(UnitGetTokenCount(hero, "MaievGoldenSentenceTokenCounter")) == libAffx_MaievTakedownBefore[2]) {
        libGame_gf_ModifyTokenCount(1, "MaievGoldenSentenceTokenCounter", hero);
        libAffx_MaievSyncJailer();
    }
    if (UnitHasBehavior2(hero, "MaievGoldenWardenMarker") && FixedToInt(UnitGetTokenCount(hero, "MaievGoldenVigilTokenCounter")) == libAffx_MaievTakedownBefore[3]) {
        libGame_gf_ModifyTokenCount(1, "MaievGoldenVigilTokenCounter", hero);
        libAffx_MaievSyncWarden();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_MaievTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_MaievHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_MaievTakedownCrossStart();
    if (UnitHasBehavior2(hero, "MaievGoldenFanDancerMarker") && libAffx_MaievFanTime[killedPlayer] > 0.0 && now - libAffx_MaievFanTime[killedPlayer] <= 6.0) {
        libAffx_MaievFanTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "MaievGoldenFlourishTokenCounter", hero);
        libAffx_MaievSyncFan();
        libAffx_MaievQuestDing();
    }
    if (UnitHasBehavior2(hero, "MaievGoldenJailerMarker") && libAffx_MaievJailerTime[killedPlayer] > 0.0 && now - libAffx_MaievJailerTime[killedPlayer] <= 6.0) {
        libAffx_MaievJailerTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "MaievGoldenSentenceTokenCounter", hero);
        libAffx_MaievSyncJailer();
        libAffx_MaievQuestDing();
    }
    if (UnitHasBehavior2(hero, "MaievGoldenWardenMarker") && libAffx_MaievWardenTime[killedPlayer] > 0.0 && now - libAffx_MaievWardenTime[killedPlayer] <= 6.0) {
        libAffx_MaievWardenTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "MaievGoldenVigilTokenCounter", hero);
        libAffx_MaievSyncWarden();
        libAffx_MaievQuestDing();
    }
    libAffx_MaievTakedownCross();
    return true;
}
bool libAffx_MaievStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_MaievStarted) {
        return true;
    }
    libAffx_MaievStarted = true;
    trig = TriggerCreate("libAffx_MaievFanHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MaievFanOfKnivesDamage");
    trig = TriggerCreate("libAffx_MaievJailerHit_Func");
    trig = TriggerCreate("libAffx_MaievJailerWindow_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MaievUmbralBindPullDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MaievWeaponUmbralBindDamage");
    trig = TriggerCreate("libAffx_MaievWardenHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MaievSpiritOfVengeanceDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "MaievGoldenVaultSpiritDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_MaievFanCast_Func"), libAffx_player, "MaievFanOfKnivesInitialPersistent");
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_MaievBind_Func"), null, "MaievUmbralBindTetherTimer", c_unitBehaviorChangeCreate);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_MaievBindAttack_Func"), libAffx_player, "MaievWeaponUmbralBindSet");
    libAffx_MaievResolveTrigger = TriggerCreate("libAffx_MaievJailerResolve_Func");
    TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_MaievResolveTrigger, null, c_behaviorCategoryStun, c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_MaievResolveTrigger, null, c_behaviorCategoryStun, c_unitBehaviorChangeRefresh);
    TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_MaievResolveTrigger, null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_MaievResolveTrigger, null, c_behaviorCategoryDebuffRoot, c_unitBehaviorChangeRefresh);
    TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_MaievResolveTrigger, null, c_behaviorCategorySlow, c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChangeFromCategory(libAffx_MaievResolveTrigger, null, c_behaviorCategorySlow, c_unitBehaviorChangeRefresh);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_MaievVault_Func"), libAffx_player, "MaievGoldenVaultSet");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_MaievTick_Func"), 1.0, c_timeGame);
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_MaievSync_Func"), 1.0, c_timeGame);
    return true;
}
