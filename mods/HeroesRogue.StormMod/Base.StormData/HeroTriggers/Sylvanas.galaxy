include "AffixTriggers"

// ============================================================
// Golden Sylvanas. Each starter: hits on enemy Heroes open a takedown window, add the hit quest token and heal;
// takedowns in the window add the takedown token: stacks 1-40 and 41-80 each improve the ability in two ways, then
// 3% damage per stack, Heroics too.
// ============================================================

const fixed libAffx_SylvanasTakedownWindow = 3.0;
const fixed libAffx_SylvanasPastCapDamagePerStack = 0.01;
bool libAffx_SylvanasStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_SylvanasFireTime; // per enemy player, last Dark Ranger hit
int libAffx_SylvanasFireAdded; // Dark Ranger: takedown stacks already applied to the catalog this game
int libAffx_SylvanasFirePastApplied; // Dark Ranger: takedown quest stacks past the cap applied as damage this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_SylvanasDaggerTime; // per enemy player, last Shadow Queen hit
int libAffx_SylvanasDaggerAdded; // Shadow Queen: takedown stacks already applied to the catalog this game
int libAffx_SylvanasDaggerAdded2; // Shadow Queen: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_SylvanasDaggerPastApplied; // Shadow Queen: takedown quest stacks past the cap applied as damage this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_SylvanasWaveTime; // per enemy player, last Banshee hit
int libAffx_SylvanasWaveAdded; // Banshee: takedown stacks already applied to the catalog this game
int libAffx_SylvanasWaveAdded2; // Banshee: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_SylvanasWavePastApplied; // Banshee: takedown quest stacks past the cap applied as damage this game

unit libAffx_SylvanasHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_SylvanasIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_SylvanasStacks(string tokenId) {
    unit hero = libAffx_SylvanasHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_SylvanasQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_SylvanasInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_SylvanasTakedownWindow;
}
// SylvanasBarrageTokenCounter: stacks 1-40: 1% of the 8 second cooldown each; 80: volleys fire again (libAffx_SylvanasVolleyEcho_Func); then 3% damage each, Heroics too
void libAffx_SylvanasSyncFire () {
    unit hero = libAffx_SylvanasHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "SylvanasFireMarker")) {
        return;
    }
    stacks = libAffx_SylvanasStacks("SylvanasBarrageTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_SylvanasFireAdded) {
        libAffx_CatalogReferenceModify("Abil,SylvanasWitheringFire,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_SylvanasFireAdded) * -0.08, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_SylvanasFireAdded = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_SylvanasFirePastApplied) {
        libAffx_SylvanasFirePastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "SylvanasFirePastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "SylvanasFirePastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "SylvanasFirePastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "SylvanasFirePastCapDamage")) {
        UnitBehaviorAdd(hero, "SylvanasFirePastCapDamage", hero, 1);
    }
}
// SylvanasPlagueTokenCounter: stacks 1-40: 1% of the 11 second cooldown each; 41-80: 1% longer damage over time each; then 3% damage each, Heroics too
void libAffx_SylvanasSyncDagger () {
    unit hero = libAffx_SylvanasHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "SylvanasDaggerMarker")) {
        return;
    }
    stacks = libAffx_SylvanasStacks("SylvanasPlagueTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_SylvanasDaggerAdded) {
        libAffx_CatalogReferenceModify("Abil,SylvanasShadowDagger,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_SylvanasDaggerAdded) * -0.11, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_SylvanasDaggerAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 1% of the 2.5 second damage over time each (and its spread window, as Unrelenting Torment)
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_SylvanasDaggerAdded2) {
        libAffx_CatalogReferenceModify("Behavior,SylvanasShadowDaggerTargetEnemyDamage,Duration", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_SylvanasDaggerAdded2) * 0.025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,SylvanasShadowDaggerDummyBuffSpreadBehavior,Duration", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_SylvanasDaggerAdded2) * 0.025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_SylvanasDaggerAdded2 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_SylvanasDaggerPastApplied) {
        libAffx_SylvanasDaggerPastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "SylvanasDaggerPastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "SylvanasDaggerPastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "SylvanasDaggerPastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "SylvanasDaggerPastCapDamage")) {
        UnitBehaviorAdd(hero, "SylvanasDaggerPastCapDamage", hero, 1);
    }
}
// SylvanasHauntingTokenCounter: stacks 1-40: 1% of the 11 second cooldown each; 41-80: 1% of the 75 Mana cost each; then 3% damage each, Heroics too
void libAffx_SylvanasSyncWave () {
    unit hero = libAffx_SylvanasHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "SylvanasWaveMarker")) {
        return;
    }
    stacks = libAffx_SylvanasStacks("SylvanasHauntingTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_SylvanasWaveAdded) {
        libAffx_CatalogReferenceModify("Abil,SylvanasHauntingWave,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_SylvanasWaveAdded) * -0.11, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_SylvanasWaveAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 1% of the 75 Mana cost each
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_SylvanasWaveAdded2) {
        libAffx_CatalogReferenceModify("Abil,SylvanasHauntingWave,Cost.Vital[Energy]", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_SylvanasWaveAdded2) * -0.75, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_SylvanasWaveAdded2 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
    if (power != libAffx_SylvanasWavePastApplied) {
        libAffx_SylvanasWavePastApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "SylvanasWavePastCapDamage", "Modification.DamageDealtFraction[Basic]", libAffx_player, IntToFixed(power) * 0.02);
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "SylvanasWavePastCapDamage", "Modification.DamageDealtFraction[Ability]", libAffx_player, IntToFixed(power) * 0.02);
        UnitBehaviorRemove(hero, "SylvanasWavePastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "SylvanasWavePastCapDamage")) {
        UnitBehaviorAdd(hero, "SylvanasWavePastCapDamage", hero, 1);
    }
}
bool libAffx_SylvanasSync_Func (bool testConds, bool runActions) {
    libAffx_SylvanasSyncFire();
    libAffx_SylvanasSyncDagger();
    libAffx_SylvanasSyncWave();
    return true;
}
bool libAffx_SylvanasVolleyShieldGiven; // Dark Ranger: this volley already gave its Shield
fixed libAffx_SylvanasVolleyEchoLast = -1.0;
// Dark Ranger, Barrage at 80 stacks: once a Withering Fire volley ends it is fired again for free (the cast set, so no
// cost or cooldown). The echo's own event is skipped (same game time), so an echo never echoes itself.
bool libAffx_SylvanasVolleyEcho_Func (bool testConds, bool runActions) {
    unit hero = libAffx_SylvanasHero();
    fixed now = GameGetMissionTime();
    int periods;
    if (hero == null || !UnitHasBehavior2(hero, "SylvanasFireMarker")) {
        return false;
    }
    libAffx_SylvanasVolleyShieldGiven = false;
    if (now == libAffx_SylvanasVolleyEchoLast || UnitGetTokenCount(hero, "SylvanasBarrageTokenCounter") < 80.0) {
        return false;
    }
    // first shot, then one per 0.375 second period (Endless Volley adds periods)
    periods = CatalogFieldValueGetAsInt(c_gameCatalogEffect, "SylvanasWitheringFireConsumeAllCharges", "PeriodCount", libAffx_player);
    Wait(IntToFixed(periods) * 0.375 + 0.25, c_timeGame);
    if (!UnitIsAlive(hero)) {
        return true;
    }
    libAffx_SylvanasVolleyEchoLast = GameGetMissionTime();
    libAffx_SylvanasVolleyShieldGiven = false;
    UnitCreateEffectUnit(hero, "SylvanasWitheringFireCastSet", hero);
    return true;
}
// Dark Ranger: all 5 shots of a volley on one enemy Hero (Barbed Shot's tracker reaches 5) Shield for 15% of maximum
// Health for 4 seconds; a new Shield replaces the old one
void libAffx_SylvanasDarkRangerShieldAdd (unit hero) {
    fixed life = UnitGetPropertyFixed(hero, c_unitPropLifeMax, c_unitPropCurrent);
    if (!UnitIsAlive(hero)) {
        return;
    }
    UnitBehaviorRemove(hero, "SylvanasDarkRangerShield", 1);
    CatalogFieldValueSetFixed(c_gameCatalogBehavior, "SylvanasDarkRangerShield", "DamageResponse.ModifyLimit", libAffx_player, 0.15 * life);
    UnitBehaviorAdd(hero, "SylvanasDarkRangerShield", hero, 1);
}
// Spectral Passage (Rare, Banshee): Protected while the Haunting Wave teleport lasts, then 0.5 seconds more
bool libAffx_SylvanasSpectralPassage_Func (bool testConds, bool runActions) {
    unit hero = EventUnit();
    if (hero != libAffx_SylvanasHero() || !UnitHasBehavior2(hero, "SylvanasSpectralPassageMarker")) {
        return false;
    }
    if (EventUnitBehaviorChange() == c_unitBehaviorChangeCreate) {
        UnitBehaviorAdd(hero, "SylvanasSpectralPassage", hero, 1);
    }
    else {
        UnitBehaviorRemove(hero, "SylvanasSpectralPassage", 1);
        if (UnitIsAlive(hero)) {
            UnitBehaviorAdd(hero, "SylvanasSpectralPassageAfter", hero, 1);
        }
    }
    return true;
}
// Dark Ranger hit on an enemy Hero: takedown window, SylvanasVolleyTokenCounter, the heal, and on-hit boons
bool libAffx_SylvanasFireHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_SylvanasHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_SylvanasIsEnemyHero(victim) || !UnitHasBehavior2(hero, "SylvanasFireMarker")) {
        return false;
    }
    libAffx_SylvanasFireTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "SylvanasVolleyTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "SylvanasFireHeal", hero);
    }
    if (!libAffx_SylvanasVolleyShieldGiven && UnitGetTokenCount(hero, "SylvanasWitheringFireBarbedShotTokenCounter") >= 5.0) {
        libAffx_SylvanasVolleyShieldGiven = true;
        libAffx_SylvanasDarkRangerShieldAdd(hero);
    }
    return true;
}
// Shadow Queen hit on an enemy Hero: takedown window, SylvanasTormentTokenCounter, the heal, and on-hit boons
bool libAffx_SylvanasDaggerHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_SylvanasHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_SylvanasIsEnemyHero(victim) || !UnitHasBehavior2(hero, "SylvanasDaggerMarker")) {
        return false;
    }
    libAffx_SylvanasDaggerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "SylvanasTormentTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "SylvanasDaggerHeal", hero);
    }
    return true;
}
// Banshee hit on an enemy Hero: takedown window, SylvanasWailTokenCounter, the heal, and on-hit boons
bool libAffx_SylvanasWaveHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_SylvanasHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_SylvanasIsEnemyHero(victim) || !UnitHasBehavior2(hero, "SylvanasWaveMarker")) {
        return false;
    }
    libAffx_SylvanasWaveTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "SylvanasWailTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "SylvanasWaveHeal", hero);
    }
    if (UnitHasBehavior2(hero, "SylvanasWindrunnersLegacyMarker")) {
        UnitCreateEffectUnit(hero, "SylvanasWindrunnersLegacyResetCooldown", hero);
    }
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[4] libAffx_SylvanasTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_SylvanasTakedownCrossStart () {
    unit hero = libAffx_SylvanasHero();
    if (hero == null) {
        return;
    }
    libAffx_SylvanasTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "SylvanasBarrageTokenCounter"));
    libAffx_SylvanasTakedownBefore[2] = FixedToInt(UnitGetTokenCount(hero, "SylvanasPlagueTokenCounter"));
    libAffx_SylvanasTakedownBefore[3] = FixedToInt(UnitGetTokenCount(hero, "SylvanasHauntingTokenCounter"));
}
void libAffx_SylvanasTakedownCross () {
    unit hero = libAffx_SylvanasHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "SylvanasBarrageTokenCounter")) == libAffx_SylvanasTakedownBefore[1] && FixedToInt(UnitGetTokenCount(hero, "SylvanasPlagueTokenCounter")) == libAffx_SylvanasTakedownBefore[2] && FixedToInt(UnitGetTokenCount(hero, "SylvanasHauntingTokenCounter")) == libAffx_SylvanasTakedownBefore[3]) {
        return;
    }
    if (UnitHasBehavior2(hero, "SylvanasFireMarker") && FixedToInt(UnitGetTokenCount(hero, "SylvanasBarrageTokenCounter")) == libAffx_SylvanasTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "SylvanasBarrageTokenCounter", hero);
        libAffx_SylvanasSyncFire();
    }
    if (UnitHasBehavior2(hero, "SylvanasDaggerMarker") && FixedToInt(UnitGetTokenCount(hero, "SylvanasPlagueTokenCounter")) == libAffx_SylvanasTakedownBefore[2]) {
        libGame_gf_ModifyTokenCount(1, "SylvanasPlagueTokenCounter", hero);
        libAffx_SylvanasSyncDagger();
    }
    if (UnitHasBehavior2(hero, "SylvanasWaveMarker") && FixedToInt(UnitGetTokenCount(hero, "SylvanasHauntingTokenCounter")) == libAffx_SylvanasTakedownBefore[3]) {
        libGame_gf_ModifyTokenCount(1, "SylvanasHauntingTokenCounter", hero);
        libAffx_SylvanasSyncWave();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_SylvanasTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_SylvanasHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_SylvanasTakedownCrossStart();
    if (UnitHasBehavior2(hero, "SylvanasFireMarker") && libAffx_SylvanasInWindow(libAffx_SylvanasFireTime[killedPlayer], now)) {
        libAffx_SylvanasFireTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "SylvanasBarrageTokenCounter", hero);
        libAffx_SylvanasSyncFire();
        libAffx_SylvanasQuestDing();
    }
    if (UnitHasBehavior2(hero, "SylvanasDaggerMarker") && libAffx_SylvanasDaggerTime[killedPlayer] > 0.0 && now - libAffx_SylvanasDaggerTime[killedPlayer] <= 4) {
        libAffx_SylvanasDaggerTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "SylvanasPlagueTokenCounter", hero);
        libAffx_SylvanasSyncDagger();
        libAffx_SylvanasQuestDing();
    }
    if (UnitHasBehavior2(hero, "SylvanasWaveMarker") && libAffx_SylvanasInWindow(libAffx_SylvanasWaveTime[killedPlayer], now)) {
        libAffx_SylvanasWaveTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "SylvanasHauntingTokenCounter", hero);
        libAffx_SylvanasSyncWave();
        libAffx_SylvanasQuestDing();
    }
    libAffx_SylvanasTakedownCross();
    return true;
}
bool libAffx_SylvanasStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_SylvanasStarted) {
        return true;
    }
    libAffx_SylvanasStarted = true;
    trig = TriggerCreate("libAffx_SylvanasFireHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "SylvanasWitheringFireDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "SylvanasWitheringFireDamageRemorseless");
    trig = TriggerCreate("libAffx_SylvanasDaggerHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "SylvanasShadowDaggerInitialDamage");
    trig = TriggerCreate("libAffx_SylvanasWaveHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "SylvanasHauntingWaveDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_SylvanasVolleyEcho_Func"), libAffx_player, "SylvanasWitheringFireCastSet");
    trig = TriggerCreate("libAffx_SylvanasSpectralPassage_Func");
    TriggerAddEventUnitBehaviorChange(trig, null, "SylvanasHauntingWaveTravel", c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChange(trig, null, "SylvanasHauntingWaveTravel", c_unitBehaviorChangeDestroy);
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_SylvanasSync_Func"), 1.0, c_timeGame);
    return true;
}
