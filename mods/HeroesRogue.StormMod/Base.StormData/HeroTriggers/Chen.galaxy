include "AffixTriggers"

// ============================================================
// Golden Chen.
// Stormstout Inferno, Eternal Flame quest: an enemy Hero takedown while they're Ignited (an Ignite tick within the
// last 1.5 seconds) adds 1% Ignite and Ring of Fire damage (ChenData.xml). Wildfire (Epic): when an Ignited enemy
// dies, the Ignite spreads to enemies within 4.
// Iron Ox: 50% shorter Stuns, Roots and Slows (the base 50PercentCCReduction behavior, read by GameLib's CC
// Recognition), and 150% of incoming damage (800% from non-Hero, non-Structure units) is reflected to the attacker while Chen has Fortifying Brew Shields or is drinking
// Fortifying Brew (doubled by the Legendary Mountain's Wrath). Iron Belly quest: every 1000 damage blocked by Stagger or absorbed by Fortifying Brew Shields adds 5
// maximum Health (ChenIronBellyLife, kept equal to the stack count) and 2% Fortifying Brew Shields (set per player from
// ChenIronBellyShieldReference, which has the same base value and level scaling as ChenFortifyingBrewShield). The Shield
// bonus is full for stacks gained in the first second of a drink, then fades to 25% of itself by 3 seconds. Iron Ox also keeps ChenIronOxArmor (-75 Armor) on Chen; the Unstoppable and never-expiring Shields are
// in ChenData.xml.
// Drunken Master's quest and boons are all in ChenData.xml.
// Stacks carry over between games through QuestRetain.
// ============================================================

const fixed libAffx_chenIgniteWindow = 1.5; // Ignite ticks every second
const fixed libAffx_chenWildfireRadius = 4.0;
const fixed libAffx_chenIronBellyDamagePerStack = 1000.0;
const fixed libAffx_chenReflectFraction = 1.5; // Hero and Structure attackers
const fixed libAffx_chenReflectFractionNonHero = 8.0;
const fixed libAffx_chenReflectLegendaryMultiplier = 2.0; // Mountain's Wrath
const int libAffx_chenIronBellyLifePerStack = 5; // matches ChenIronBellyLife
const fixed libAffx_chenIronBellyShieldPerStack = 0.02;
const fixed libAffx_chenBrewShieldPeriod = 0.5; // ChenFortifyingBrewRegen Period
const fixed libAffx_chenBrewBonusFullTime = 1.0;
const fixed libAffx_chenBrewBonusEndTime = 3.0;
const fixed libAffx_chenBrewBonusFloor = 0.25; // fraction of the bonus kept from BonusEndTime on

bool libAffx_chenStarted;
fixed libAffx_chenIronBellyProgress; // blocked damage toward the next Iron Belly stack
fixed libAffx_chenBrewStart = -10.0; // mission time of the current drink's first Shield stack
fixed libAffx_chenBrewLastStack = -10.0;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_chenIgniteTime; // per enemy player, last Ignite tick

unit libAffx_ChenHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_ChenHas(string behavior) {
    unit hero = libAffx_ChenHero();
    return hero != null && UnitHasBehavior2(hero, behavior);
}
bool libAffx_ChenIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
void libAffx_ChenQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}

// ---------- Stormstout Inferno ----------

// Ignite tick on an enemy Hero: opens the Eternal Flame takedown window
bool libAffx_ChenIgniteTick_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    if (EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_ChenIsEnemyHero(victim)) {
        return false;
    }
    libAffx_chenIgniteTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}

// HeroTakedown for Eternal Flame
bool libAffx_ChenTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    fixed igniteTime;
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || !libAffx_ChenHas("ChenInfernoMarker")) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    igniteTime = libAffx_chenIgniteTime[killedPlayer];
    if (igniteTime <= 0.0 || GameGetMissionTime() - igniteTime > libAffx_chenIgniteWindow) {
        return true;
    }
    libAffx_chenIgniteTime[killedPlayer] = 0.0;
    libGame_gf_ModifyTokenCount(1, "ChenEternalFlameTokenCounter", libAffx_ChenHero());
    libAffx_ChenQuestDing();
    return true;
}

// Wildfire: an enemy dying while Ignited by Chen spreads the Ignite to enemies around them
bool libAffx_ChenWildfire_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_ChenHero();
    unitgroup nearby;
    unit other;
    int i;
    if (hero == null || !UnitHasBehavior2(hero, "ChenWildfireMarker")) {
        return false;
    }
    if (UnitGetOwner(victim) == libAffx_player || !UnitHasBehavior2(victim, "ChenBreathofFireDoT")) {
        return false;
    }
    if (UnitBehaviorEffectUnit(victim, "ChenBreathofFireDoT", c_effectUnitCaster, 0) != hero) {
        return false;
    }
    nearby = UnitGroupAlliance(libAffx_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(victim), libAffx_chenWildfireRadius), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), 0), 0);
    for (i = UnitGroupCount(nearby, c_unitCountAll); i > 0; i -= 1) {
        other = UnitGroupUnitFromEnd(nearby, i);
        if (other != null && other != victim && UnitIsAlive(other)) {
            UnitCreateEffectUnit(hero, "ChenBreathOfFireApplyDoT", other);
        }
    }
    return true;
}

// ---------- Iron Ox ----------

// Damage to Chen: reflected while Shielded by Fortifying Brew or drinking, and what Stagger prevented, or Fortifying Brew Shields
// absorbed, counts toward Iron Belly
bool libAffx_ChenIronBellyDamage_Func (bool testConds, bool runActions) {
    unit hero = libAffx_ChenHero();
    unit attacker = EventUnitDamageSourceUnit();
    fixed blocked = 0.0;
    fixed reflected;
    if (hero == null || EventUnit() != hero || !UnitHasBehavior2(hero, "ChenIronOxMarker")) {
        return false;
    }
    // a hit that breaks the last Shield stack still counts (EventUnitDamageBehaviorShield). Never while Stagger is up: its
    // prevented damage is also recorded as Shield damage, and leftover Brew Shields shouldn't make Stagger reflect.
    if (!UnitHasBehavior2(hero, "ChenStaggerProtectedBuff") && (UnitHasBehavior2(hero, "ChenFortifyingBrewShield") || UnitHasBehavior2(hero, "ChenFortifyingBrewEnergyBehavior") || EventUnitDamageBehaviorShield() > 0.0)) {
        reflected = EventUnitDamageAttempted() * libAffx_chenReflectFraction;
        if (attacker != null && !UnitTypeTestAttribute(UnitGetType(attacker), c_unitAttributeHeroic) && !UnitTypeTestAttribute(UnitGetType(attacker), c_unitAttributeStructure)) {
            reflected = EventUnitDamageAttempted() * libAffx_chenReflectFractionNonHero;
        }
        if (UnitHasBehavior2(hero, "ChenMountainsWrathMarker")) {
            reflected = reflected * libAffx_chenReflectLegendaryMultiplier;
        }
        if (reflected > 0.0 && attacker != null && attacker != hero && UnitIsAlive(attacker) && UnitGetOwner(attacker) != libAffx_player) {
            UnitDamage(hero, "ChenIronOxReflectDamage", attacker, reflected);
        }
    }
    if (UnitHasBehavior2(hero, "ChenStaggerProtectedBuff")) {
        blocked = EventUnitDamageAttempted() - EventUnitDamageAmount();
    } else if (UnitHasBehavior2(hero, "ChenFortifyingBrewShield")) {
        blocked = EventUnitDamageBehaviorShield();
    }
    if (blocked <= 0.0) {
        return false;
    }
    libAffx_chenIronBellyProgress += blocked;
    while (libAffx_chenIronBellyProgress >= libAffx_chenIronBellyDamagePerStack) {
        libAffx_chenIronBellyProgress -= libAffx_chenIronBellyDamagePerStack;
        libGame_gf_ModifyTokenCount(1, "ChenIronBellyTokenCounter", hero);
        libAffx_ChenQuestDing();
    }
    return true;
}

// Sets the Fortifying Brew Shield per stack to the level-scaled base plus the Iron Belly bonus times bonusFactor (0-1)
void libAffx_ChenSetBrewShield (fixed bonusFactor) {
    unit hero = libAffx_ChenHero();
    fixed shield = StringToFixed(CatalogFieldValueGet(c_gameCatalogBehavior, "ChenIronBellyShieldReference", "DamageResponse.ModifyLimit", libAffx_player));
    shield = shield * (1.0 + UnitGetTokenCount(hero, "ChenIronBellyTokenCounter") * libAffx_chenIronBellyShieldPerStack * bonusFactor);
    if (AbsF(StringToFixed(CatalogFieldValueGet(c_gameCatalogBehavior, "ChenFortifyingBrewShield", "DamageResponse.ModifyLimit", libAffx_player)) - shield) > 0.01) {
        CatalogFieldValueSet(c_gameCatalogBehavior, "ChenFortifyingBrewShield", "DamageResponse.ModifyLimit", libAffx_player, FixedToString(shield, 2));
    }
}

// A Fortifying Brew Shield stack was just added: sets the bonus for the next one from how long Chen has been drinking
bool libAffx_ChenBrewShieldStack_Func (bool testConds, bool runActions) {
    unit hero = libAffx_ChenHero();
    fixed now = GameGetMissionTime();
    fixed nextTime;
    fixed factor = libAffx_chenBrewBonusFloor;
    if (hero == null || EventPlayerEffectUsedUnit(c_effectUnitCaster) != hero || !UnitHasBehavior2(hero, "ChenIronOxMarker")) {
        return false;
    }
    if (now - libAffx_chenBrewLastStack > libAffx_chenBrewShieldPeriod * 1.5) {
        libAffx_chenBrewStart = now;
    }
    libAffx_chenBrewLastStack = now;
    nextTime = now - libAffx_chenBrewStart + libAffx_chenBrewShieldPeriod;
    if (nextTime <= libAffx_chenBrewBonusFullTime + 0.05) {
        factor = 1.0;
    } else if (nextTime < libAffx_chenBrewBonusEndTime) {
        factor = libAffx_chenBrewBonusFloor + (1.0 - libAffx_chenBrewBonusFloor) * (libAffx_chenBrewBonusEndTime - nextTime) / (libAffx_chenBrewBonusEndTime - libAffx_chenBrewBonusFullTime);
    }
    libAffx_ChenSetBrewShield(factor);
    return true;
}

// Keeps ChenIronBellyLife equal to the Iron Belly stack count (covers stacks loaded from the bank), and keeps Iron Ox's
// CC reduction on Chen
bool libAffx_ChenSync_Func (bool testConds, bool runActions) {
    unit hero = libAffx_ChenHero();
    int tokens;
    int stacks;
    if (hero == null || !UnitHasBehavior2(hero, "ChenIronOxMarker")) {
        return false;
    }
    if (!UnitHasBehavior2(hero, "50PercentCCReduction")) {
        UnitBehaviorAdd(hero, "50PercentCCReduction", hero, 1);
    }
    if (!UnitHasBehavior2(hero, "ChenIronOxArmor")) {
        UnitBehaviorAdd(hero, "ChenIronOxArmor", hero, 1);
    }
    tokens = FixedToInt(UnitGetTokenCount(hero, "ChenIronBellyTokenCounter"));
    stacks = UnitBehaviorCount(hero, "ChenIronBellyLife");
    if (tokens > stacks) {
        UnitBehaviorAdd(hero, "ChenIronBellyLife", hero, tokens - stacks);
        if (UnitIsAlive(hero)) {
            UnitSetPropertyFixed(hero, c_unitPropLife, UnitGetPropertyFixed(hero, c_unitPropLife, c_unitPropCurrent) + IntToFixed((tokens - stacks) * libAffx_chenIronBellyLifePerStack));
        }
    } else if (tokens < stacks) {
        UnitBehaviorRemove(hero, "ChenIronBellyLife", stacks - tokens);
    }
    // Outside a drink the next drink's first Shield stack gets the full bonus (also re-applies it after level-ups)
    if (!UnitHasBehavior2(hero, "ChenFortifyingBrewRegen")) {
        libAffx_ChenSetBrewShield(1.0);
    }
    return true;
}

// AffixAdded for all three starters
bool libAffx_ChenStart (bool testConds, bool runActions) {
    trigger igniteTick;
    trigger wildfire;
    trigger ironBelly;
    if (libAffx_chenStarted) {
        return true;
    }
    libAffx_chenStarted = true;
    igniteTick = TriggerCreate("libAffx_ChenIgniteTick_Func");
    TriggerAddEventUnitDamaged(igniteTick, null, c_unitDamageTypeAny, c_unitDamageEither, "ChenBreathOfFireDoTDamage");
    wildfire = TriggerCreate("libAffx_ChenWildfire_Func");
    TriggerAddEventUnitDamaged(wildfire, null, c_unitDamageTypeAny, c_unitDamageFatal, null);
    ironBelly = TriggerCreate("libAffx_ChenIronBellyDamage_Func");
    TriggerAddEventUnitDamaged(ironBelly, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_ChenSync_Func"), 0.5, c_timeGame);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_ChenBrewShieldStack_Func"), libAffx_player, "FortifyingBrewApplyShieldStack");
    return true;
}
