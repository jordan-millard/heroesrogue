bool libAffx_DVaNukeHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_DVaHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_DVaIsEnemyHero(victim) || !UnitHasBehavior2(hero, "DVaGoldenNuclearMarker")) {
        return false;
    }
    libAffx_DVaNukeTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "DVaGoldenYieldTokenCounter", hero);
    return true;
}
// Pilot Pro hit on an enemy Hero: takedown window, DVaGoldenHighScoreTokenCounter, the heal, and on-hit boons
bool libAffx_DVaPilotHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_DVaHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_DVaIsEnemyHero(victim) || !UnitHasBehavior2(hero, "DVaGoldenPilotMarker")) {
        return false;
    }
    libAffx_DVaPilotTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "DVaGoldenHighScoreTokenCounter", hero);
    // Streak at 100: the hit summons an exploding mech at the Hero (once every 60 seconds)
    if (libAffx_DVaStacks("DVaGoldenStreakTokenCounter") >= 100 && !UnitHasBehavior2(hero, "DVaGoldenMiniNukeCooldown")) {
        UnitBehaviorAdd(hero, "DVaGoldenMiniNukeCooldown", hero, 1);
        UnitCreateEffectPoint(hero, "DVaGoldenMiniNukePersistent", UnitGetPosition(victim));
    }
    // Speedrun: the first Hero each shot hits is Stunned
    if (UnitHasBehavior2(hero, "DVaGoldenSpeedrunMarker") && GameGetMissionTime() - libAffx_DVaSpeedrunTime > 0.25) {
        libAffx_DVaSpeedrunTime = GameGetMissionTime();
        UnitCreateEffectUnit(hero, "DVaGoldenSpeedrunApply", victim);
    }
    return true;
}
// Pilot Pro: these effects on an enemy Hero only refresh the takedown window (no quest token, heal or on-hit boons)
bool libAffx_DVaPilotWindow_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_DVaHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_DVaIsEnemyHero(victim) || !UnitHasBehavior2(hero, "DVaGoldenPilotMarker")) {
        return false;
    }
    libAffx_DVaPilotTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[4] libAffx_DVaTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_DVaTakedownCrossStart () {
    unit hero = libAffx_DVaHero();
    if (hero == null) {
        return;
    }
    libAffx_DVaTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "DVaGoldenRiderTokenCounter"));
    libAffx_DVaTakedownBefore[2] = FixedToInt(UnitGetTokenCount(hero, "DVaGoldenMeltdownTokenCounter"));
    libAffx_DVaTakedownBefore[3] = FixedToInt(UnitGetTokenCount(hero, "DVaGoldenStreakTokenCounter"));
}
void libAffx_DVaTakedownCross () {
    unit hero = libAffx_DVaHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "DVaGoldenRiderTokenCounter")) == libAffx_DVaTakedownBefore[1] && FixedToInt(UnitGetTokenCount(hero, "DVaGoldenMeltdownTokenCounter")) == libAffx_DVaTakedownBefore[2] && FixedToInt(UnitGetTokenCount(hero, "DVaGoldenStreakTokenCounter")) == libAffx_DVaTakedownBefore[3]) {
        return;
    }
    if (UnitHasBehavior2(hero, "DVaGoldenBoostMarker") && FixedToInt(UnitGetTokenCount(hero, "DVaGoldenRiderTokenCounter")) == libAffx_DVaTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "DVaGoldenRiderTokenCounter", hero);
        libAffx_DVaSyncBoost();
    }
    if (UnitHasBehavior2(hero, "DVaGoldenNuclearMarker") && FixedToInt(UnitGetTokenCount(hero, "DVaGoldenMeltdownTokenCounter")) == libAffx_DVaTakedownBefore[2]) {
        libGame_gf_ModifyTokenCount(1, "DVaGoldenMeltdownTokenCounter", hero);
        libAffx_DVaSyncNuke();
    }
    if (UnitHasBehavior2(hero, "DVaGoldenPilotMarker") && FixedToInt(UnitGetTokenCount(hero, "DVaGoldenStreakTokenCounter")) == libAffx_DVaTakedownBefore[3]) {
        libGame_gf_ModifyTokenCount(1, "DVaGoldenStreakTokenCounter", hero);
        libAffx_DVaSyncPilot();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_DVaTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_DVaHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_DVaTakedownCrossStart();
    if (UnitHasBehavior2(hero, "DVaGoldenBoostMarker") && libAffx_DVaBoostTime[killedPlayer] > 0.0 && now - libAffx_DVaBoostTime[killedPlayer] <= 6.0) {
        libAffx_DVaBoostTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "DVaGoldenRiderTokenCounter", hero);
        libAffx_DVaSyncBoost();
        libAffx_DVaQuestDing();
    }
    if (UnitHasBehavior2(hero, "DVaGoldenNuclearMarker") && libAffx_DVaNukeTime[killedPlayer] > 0.0 && now - libAffx_DVaNukeTime[killedPlayer] <= 10.0) {
        libAffx_DVaNukeTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "DVaGoldenMeltdownTokenCounter", hero);
        libAffx_DVaSyncNuke();
        libAffx_DVaQuestDing();
    }
    if (UnitHasBehavior2(hero, "DVaGoldenPilotMarker") && libAffx_DVaPilotTime[killedPlayer] > 0.0 && now - libAffx_DVaPilotTime[killedPlayer] <= 6.0) {
        libAffx_DVaPilotTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "DVaGoldenStreakTokenCounter", hero);
        libAffx_DVaSyncPilot();
        libAffx_DVaQuestDing();
    }
    libAffx_DVaTakedownCross();
    if (PlayerHasTalent(libAffx_player, "DVaGoldenWorldRecord")) {
        UnitAddChargeUsed(hero, "Abil/DVaPilotBigShot", -1.0 * UnitGetChargeUsed(hero, "Abil/DVaPilotBigShot"));
    }
    return true;
}
bool libAffx_DVaStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_DVaStarted) {
        return true;
    }
    libAffx_DVaStarted = true;
    trig = TriggerCreate("libAffx_DVaBoostHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaBoostersImpactDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaBoostersHitTheNitrousImpactDamage");
    trig = TriggerCreate("libAffx_DVaBoostWindow_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaGoldenFireTrailDamage");
    trig = TriggerCreate("libAffx_DVaNukeHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaMechSelfDestructDetonationSearchDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaMechSelfDestructDetonationSearchDamageNear");
    trig = TriggerCreate("libAffx_DVaPilotHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaPilotBigShotDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaBigShotPewPewPewTalentDamage");
    trig = TriggerCreate("libAffx_DVaPilotWindow_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DVaPilotWeaponDamage");
    libAffx_DVaTokens[0] = "DVaGoldenTurboTokenCounter";
    libAffx_DVaTokens[1] = "DVaGoldenRiderTokenCounter";
    libAffx_DVaTokens[2] = "DVaGoldenYieldTokenCounter";
    libAffx_DVaTokens[3] = "DVaGoldenMeltdownTokenCounter";
    libAffx_DVaTokens[4] = "DVaGoldenHighScoreTokenCounter";
    libAffx_DVaTokens[5] = "DVaGoldenStreakTokenCounter";
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_DVaTick_Func"), 0.25, c_timeGame);
    trig = TriggerCreate("libAffx_DVaChargeHit_Func");
    TriggerAddEventPlayerEffectUsed(trig, libAffx_player, "DVaMechSelfDestructAddCharge");
    TriggerAddEventPlayerEffectUsed(trig, libAffx_player, "DVaMechDefenseMatrixFusionGeneratorAddChargetoCaster");
    TriggerAddDamageEvent(TriggerCreate("libAffx_DVaChargeTaken_Func"), null, "HeroDVaMech", c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_DVaDetonated_Func"), libAffx_player, "DVaMechSelfDestructDetonationSet");
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_DVaDebugHit_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, "DVaPilotBigShotDamage");
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_DVaDebugAny_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, null);
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_DVaSync_Func"), 1.0, c_timeGame);
    return true;
}
