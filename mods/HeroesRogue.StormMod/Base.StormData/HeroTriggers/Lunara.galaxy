include "AffixTriggers"

// ============================================================
// Golden Lunara. Her quest stacks all carry over between games: Poisoner gets them back at level 1,
// the other quests 10% per Hero level (levels 1-10). Stacks earned this game are added on top.
// Quests: 1 Poisoner, 2 Splintered Huntress, 3 Pollinator.
// ============================================================

const int libAffx_lunaraQuests = 3;
const int libAffx_lunaraPoisoner = 1;
const int libAffx_lunaraPoisonerStacksPerApplySecond = 50; // stacks per extra second added by each application
const fixed libAffx_lunaraToxinPerApplication = 4.0; // Poisoner: 1 second more than the normal 3
const int libAffx_lunaraHuntressReward = 30;
const int libAffx_lunaraPollinatorReward = 40;

bool libAffx_lunaraStarted;
int[libAffx_lunaraQuests + 1] libAffx_lunaraBanked;   // stacks from previous games
int[libAffx_lunaraQuests + 1] libAffx_lunaraRestored; // banked stacks given back so far this game
bool libAffx_lunaraHuntressRewarded;
fixed libAffx_lunaraToxinDuration; // Poisoner duration per application last written to the catalog
unitgroup libAffx_lunaraPoisoned;   // Poisoner: enemies poisoned this game, checked for the lethal marker

string libAffx_LunaraQuestToken(int quest) {
    if (quest == 1) { return "DryadPoisonerTokenCounter"; }
    if (quest == 2) { return "DryadHuntressTokenCounter"; }
    return "DryadPollinatorTokenCounter";
}
// Percent of the banked stacks given back at each Hero level
int libAffx_LunaraCarryPerLevel(int quest) {
    if (quest == libAffx_lunaraPoisoner) {
        return 100;
    }
    return 10;
}
unit libAffx_LunaraHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_LunaraHasQuest(int quest) {
    unit hero = libAffx_LunaraHero();
    if (hero == null) {
        return false;
    }
    if (quest == libAffx_lunaraPoisoner && UnitHasBehavior2(hero, "DryadPoisonerMarker")) {
        return true;
    }
    return UnitHasBehavior2(hero, libAffx_LunaraQuestToken(quest));
}
int libAffx_LunaraStacks(int quest) {
    if (!libAffx_LunaraHasQuest(quest)) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(libAffx_LunaraHero(), libAffx_LunaraQuestToken(quest)));
}

// Poison expiry tracked per enemy unit (Poisoner)
string libAffx_LunaraToxinKey(unit target) {
    return "LunaraToxinExpires_" + IntToString(UnitGetTag(target));
}

// Carried-over stacks plus this game's progress; saved with the run
void libAffx_LunaraSaveBank() {
    int quest;
    if (!libAffx_lunaraStarted) {
        return;
    }
    for (quest = 1; quest <= libAffx_lunaraQuests; quest += 1) {
        if (libAffx_LunaraHasQuest(quest)) {
            libAffx_BankSaveValueInt("Lunara_" + libAffx_LunaraQuestToken(quest),
                libAffx_lunaraBanked[quest] + MaxI(0, libAffx_LunaraStacks(quest) - libAffx_lunaraRestored[quest]));
        }
    }
}

// Poisoner: seconds of Nature's Toxin each Basic Attack or Ability adds
fixed libAffx_LunaraPoisonerSecondsPerHit() {
    return libAffx_lunaraToxinPerApplication +
        IntToFixed(libAffx_LunaraStacks(libAffx_lunaraPoisoner) / libAffx_lunaraPoisonerStacksPerApplySecond);
}

// Poisoner: Nature's Toxin has no maximum duration; each application adds 4 seconds, plus 1 second per 50 stacks
bool libAffx_LunaraToxinApplied_Func (bool testConds, bool runActions) {
    unit target = EventUnit();
    string key = libAffx_LunaraToxinKey(target);
    fixed now = GameGetMissionTime();
    fixed previous = MaxF(0.0, DataTableGetFixed(true, key) - now);
    fixed perApplication = libAffx_LunaraPoisonerSecondsPerHit();
    fixed current;
    fixed wanted;
    if (testConds) {
        if (!libAffx_LunaraHasQuest(libAffx_lunaraPoisoner) ||
            UnitBehaviorEffectPlayer(target, "DryadNaturesToxin", c_effectPlayerCaster, 0) != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    current = UnitBehaviorDuration(target, "DryadNaturesToxin");
    if (EventUnitBehaviorChange() == c_unitBehaviorChangeCreate) {
        previous = 0.0;
    }
    wanted = MaxF(current, previous + perApplication);
    if (wanted > current) {
        UnitBehaviorSetDurationRemaining(target, "DryadNaturesToxin", wanted);
    }
    DataTableSetFixed(true, key, now + wanted);
    UnitGroupAdd(libAffx_lunaraPoisoned, target);
    return true;
}

// ============================================================
// Poisoner lethal marker: Malthael's Last Rites kill marker (the shared ViableKillMarker actor, seen only by Lunara's
// player through DryadPoisonerLethalTarget) over each enemy Hero that Crippling Spores would kill right now. The game's green bar can't be made exact, so the burst is predicted from the poison's own ticks instead.
// Each tick's real damage, divided by the talent bonuses it had (tick probes), leaves a factor for that target (Spell
// Power, armor, the Poisoner quest). The prediction is the burst's ticks times one tick times that factor times the
// bonuses the burst would have (burst probes). The marker needs the burst to cover the target's Health plus their
// shields plus a second of their Health regeneration (time to react). Armor is inside the factor, so while the target
// has gained or lost an Armor buff or debuff since the last tick, the marker waits for the next tick to relearn it.
// ============================================================
const fixed libAffx_lunaraLethalRegenSeconds = 1.0;
string libAffx_LunaraBurstFactorKey(unit target) {
    return "LunaraBurstFactor_" + IntToString(UnitGetTag(target));
}
string libAffx_LunaraArmorStateKey(unit target) {
    return "LunaraArmorState_" + IntToString(UnitGetTag(target));
}
// Which kinds of Armor change the target has (1: an Armor buff, 2: an Armor debuff), plus 4 so a stored 0 means none yet
int libAffx_LunaraArmorState(unit target) {
    int state = 4;
    if (UnitHasBehaviorWithCategoryFlag(target, c_behaviorCategoryBuffResistant)) {
        state += 1;
    }
    if (UnitHasBehaviorWithCategoryFlag(target, c_behaviorCategoryDebuffVulnerable)) {
        state += 2;
    }
    return state;
}
// Damage the target's shields would soak, over all their behaviors (behaviors that don't absorb report 0)
fixed libAffx_LunaraShields(unit target) {
    int i;
    int count = UnitBehaviorCountAll(target);
    string behavior;
    string previous = "";
    fixed total = 0.0;
    for (i = 1; i <= count; i += 1) {
        behavior = UnitBehaviorGet(target, i);
        if (behavior == previous) {
            continue;
        }
        previous = behavior;
        total += UnitBehaviorDamageModifyRemaining(target, behavior);
    }
    return total;
}
// Reads and clears the probes: the product of the bonuses they mark (Intensifying Toxin, Unfair Advantage,
// Nature's Culling, as on DryadNaturesToxinDamage)
fixed libAffx_LunaraTakeProbes(unit target, string prefix) {
    fixed mult = 1.0;
    if (UnitHasBehavior2(target, prefix + "Intensifying")) {
        mult = mult * 1.4;
        UnitBehaviorRemove(target, prefix + "Intensifying", c_unitBehaviorCountAll);
    }
    if (UnitHasBehavior2(target, prefix + "Unfair")) {
        mult = mult * 1.6;
        UnitBehaviorRemove(target, prefix + "Unfair", c_unitBehaviorCountAll);
    }
    if (UnitHasBehavior2(target, prefix + "Culling")) {
        mult = mult * 2.25;
        UnitBehaviorRemove(target, prefix + "Culling", c_unitBehaviorCountAll);
    }
    return mult;
}
// Ticks of poison the burst would pay out: a part second left is still a whole tick
fixed libAffx_LunaraBurstTicks(unit target) {
    fixed remaining = UnitBehaviorDuration(target, "DryadNaturesToxin");
    if (remaining <= 0.0) {
        remaining = DataTableGetFixed(true, libAffx_LunaraToxinKey(target)) - GameGetMissionTime();
    }
    return Ceiling(remaining - 0.05);
}
bool libAffx_LunaraToxinTick_Func (bool testConds, bool runActions) {
    unit target = EventUnit();
    fixed dealt = EventUnitDamageAmount() + EventUnitDamageBehaviorShield();
    fixed perSecond = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, "DryadNaturesToxinDamage", "Amount", libAffx_player));
    fixed mult;
    if (testConds) {
        if (EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_LunaraHasQuest(libAffx_lunaraPoisoner)) {
            return false;
        }
    }
    mult = libAffx_LunaraTakeProbes(target, "DryadPoisonerTickProbe");
    if (!runActions || dealt <= 0.0 || perSecond <= 0.0) {
        return true;
    }
    DataTableSetFixed(true, libAffx_LunaraBurstFactorKey(target), dealt / (perSecond * mult));
    DataTableSetInt(true, libAffx_LunaraArmorStateKey(target), libAffx_LunaraArmorState(target));
    return true;
}
void libAffx_LunaraShowLethal(unit target, bool show) {
    unit hero = libAffx_LunaraHero();
    if (show && hero != null && !UnitHasBehavior2(target, "DryadPoisonerLethalTarget")) {
        UnitBehaviorAdd(target, "DryadPoisonerLethalTarget", hero, 1);
    } else if (!show && UnitHasBehavior2(target, "DryadPoisonerLethalTarget")) {
        UnitBehaviorRemove(target, "DryadPoisonerLethalTarget", c_unitBehaviorCountAll);
    }
}
bool libAffx_LunaraLethalTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_LunaraHero();
    fixed perSecond = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, "DryadNaturesToxinDamage", "Amount", libAffx_player));
    bool heroReady = hero != null && UnitIsAlive(hero) && libAffx_LunaraHasQuest(libAffx_lunaraPoisoner);
    int i;
    unit target;
    fixed factor;
    fixed ticks;
    fixed burst;
    bool lethal;
    for (i = UnitGroupCount(libAffx_lunaraPoisoned, c_unitCountAll); i >= 1; i -= 1) {
        target = UnitGroupUnit(libAffx_lunaraPoisoned, i);
        if (target == null) {
            continue;
        }
        if (!UnitIsAlive(target) || !UnitHasBehavior2(target, "DryadNaturesToxin")) {
            libAffx_LunaraShowLethal(target, false);
            UnitGroupRemove(libAffx_lunaraPoisoned, target);
            continue;
        }
        lethal = false;
        factor = DataTableGetFixed(true, libAffx_LunaraBurstFactorKey(target));
        ticks = libAffx_LunaraBurstTicks(target);
        if (heroReady && factor > 0.0 && ticks > 0.0 && UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic) &&
                DataTableGetInt(true, libAffx_LunaraArmorStateKey(target)) == libAffx_LunaraArmorState(target)) {
            UnitCreateEffectUnit(hero, "DryadPoisonerBurstProbeSet", target);
            burst = perSecond * ticks * factor * libAffx_LunaraTakeProbes(target, "DryadPoisonerBurstProbe");
            lethal = burst >= UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent) + libAffx_LunaraShields(target) +
                MaxF(0.0, UnitGetPropertyFixed(target, c_unitPropLifeRegen, c_unitPropCurrent)) * libAffx_lunaraLethalRegenSeconds;
        }
        libAffx_LunaraShowLethal(target, lethal);
    }
    return true;
}

// Poisoner: Crippling Spores deals the poison stored on each poisoned enemy (the ticks left times Nature's Toxin
// damage per tick) and removes the poison. Hero kills by the burst grant a stack. It matches the poison shown on the
// Health bar: the same ticks (a part second left is still a whole tick), and the same bonuses (DryadPoisonerSporesDamage),
// dealt before the poison is removed so Intensifying Toxin still sees it.
bool libAffx_LunaraSporesBurst_Func (bool testConds, bool runActions) {
    unit target = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    string key = libAffx_LunaraToxinKey(target);
    fixed perSecond = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, "DryadNaturesToxinDamage", "Amount", libAffx_player));
    fixed ticks;
    bool dealt = false;
    unit hero = libAffx_LunaraHero();
    if (!runActions) {
        return true;
    }
    ticks = libAffx_LunaraBurstTicks(target);
    if (ticks > 0.0 && hero != null && UnitIsAlive(target)) {
        CatalogFieldValueSet(c_gameCatalogEffect, "DryadPoisonerSporesDamage", "Amount", libAffx_player, FixedToString(perSecond * ticks, 2));
        UnitCreateEffectUnit(hero, "DryadPoisonerSporesDamage", target);
        dealt = true;
    }
    UnitBehaviorRemove(target, "DryadNaturesToxin", c_unitBehaviorCountAll);
    DataTableSetFixed(true, key, 0.0);
    libAffx_LunaraShowLethal(target, false);
    if (!dealt) {
        return true;
    }
    if (!UnitIsAlive(target) && !UnitTestState(target, c_unitStateHallucination) &&
        UnitFilterMatch(target, libAffx_player, UnitFilter((1 << c_targetFilterHeroic), 0, 0, 0))) {
        libGame_gf_ModifyTokenCount(1, libAffx_LunaraQuestToken(libAffx_lunaraPoisoner), hero);
    }
    return true;
}

bool libAffx_LunaraTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_LunaraHero();
    int quest;
    int level;
    int wanted;
    if (hero == null || !UnitIsAlive(hero) || libAffx_gamePaused) {
        return true;
    }

    // Give back carried-over stacks as Lunara levels up
    for (quest = 1; quest <= libAffx_lunaraQuests; quest += 1) {
        if (!libAffx_LunaraHasQuest(quest)) {
            continue;
        }
        level = UnitLevel(hero);
        wanted = libAffx_lunaraBanked[quest] * MinI(level * libAffx_LunaraCarryPerLevel(quest), 100) / 100;
        if (wanted > libAffx_lunaraRestored[quest]) {
            libGame_gf_ModifyTokenCount(wanted - libAffx_lunaraRestored[quest], libAffx_LunaraQuestToken(quest), hero);
            libAffx_lunaraRestored[quest] = wanted;
        }
    }

    // Poisoner: the toxin's own duration is what each application adds, so the first hit gets it too
    // (setting the remaining duration when the poison is created gets overwritten by the 3 second default)
    if (libAffx_LunaraHasQuest(libAffx_lunaraPoisoner) && libAffx_lunaraToxinDuration != libAffx_LunaraPoisonerSecondsPerHit()) {
        libAffx_lunaraToxinDuration = libAffx_LunaraPoisonerSecondsPerHit();
        CatalogFieldValueSet(c_gameCatalogBehavior, "DryadNaturesToxin", "Duration", libAffx_player, FixedToString(libAffx_lunaraToxinDuration, 2));
    }
    // Poisoner: Health bars show the poison as what Crippling Spores would burst; one tick of it follows Nature's Toxin
    // damage (level scaling and boons)
    if (libAffx_LunaraHasQuest(libAffx_lunaraPoisoner)) {
        if (CatalogFieldValueGet(c_gameCatalogBehavior, "DryadNaturesToxin", "PeriodicDisplayEffect", libAffx_player) != "DryadPoisonerToxinDisplayDamage") {
            CatalogFieldValueSet(c_gameCatalogBehavior, "DryadNaturesToxin", "PeriodicDisplayEffect", libAffx_player, "DryadPoisonerToxinDisplayDamage");
        }
        CatalogFieldValueSet(c_gameCatalogEffect, "DryadPoisonerToxinDisplayDamage", "Amount", libAffx_player, CatalogFieldValueGet(c_gameCatalogEffect, "DryadNaturesToxinDamage", "Amount", libAffx_player));
    }

    // Splintered Huntress reward: Noxious Blossom empowers 4 Basic Attacks instead of 3
    if (!libAffx_lunaraHuntressRewarded && libAffx_LunaraStacks(2) >= libAffx_lunaraHuntressReward) {
        libAffx_lunaraHuntressRewarded = true;
        CatalogFieldValueSet(c_gameCatalogBehavior, "DryadSplineredSpearTokenCounter", "Max", libAffx_player, "4");
        CatalogFieldValueSet(c_gameCatalogEffect, "DryadSplinteredSpearAddTokens", "Value", libAffx_player, "4");
    }
    // Pollinator reward: Noxious Blossom explodes a second time
    if (libAffx_LunaraStacks(3) >= libAffx_lunaraPollinatorReward && !UnitHasBehavior2(hero, "DryadPollinatorSecondBloom")) {
        UnitBehaviorAdd(hero, "DryadPollinatorSecondBloom", hero, 1);
    }
    return true;
}

// AffixAdded for each Lunara starter boon
bool libAffx_LunaraQuestStart (bool testConds, bool runActions) {
    int quest;
    trigger t;
    if (libAffx_lunaraStarted) {
        return true;
    }
    libAffx_lunaraStarted = true;
    libAffx_lunaraPoisoned = UnitGroupEmpty();
    for (quest = 1; quest <= libAffx_lunaraQuests; quest += 1) {
        libAffx_lunaraBanked[quest] = libAffx_BankLoadValueInt("Lunara_" + libAffx_LunaraQuestToken(quest));
    }
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_LunaraTick_Func"), 1.0, c_timeGame);
    t = TriggerCreate("libAffx_LunaraToxinApplied_Func");
    TriggerAddEventUnitBehaviorChange(t, null, "DryadNaturesToxin", c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChange(t, null, "DryadNaturesToxin", c_unitBehaviorChangeRefresh);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_LunaraSporesBurst_Func"), libAffx_player, "DryadPoisonerSporesBurst");
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_LunaraToxinTick_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, "DryadNaturesToxinDamage");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_LunaraLethalTick_Func"), 0.25, c_timeGame);
    return true;
}
