include "AffixTriggers"

// ============================================================
// Golden Lunara. Her quest stacks carry over between games and come back 10% per Hero level:
// Poisoner keeps 80% of its stacks (levels 1-8), the other quests keep all of them (levels 1-10).
// Stacks earned this game are added on top.
// Quests: 1 Poisoner, 2 Splintered Huntress, 3 Pollinator.
// ============================================================

const int libAffx_lunaraQuests = 3;
const int libAffx_lunaraPoisoner = 1;
const int libAffx_lunaraPoisonerCarryLevels = 8;        // 10% per level, so 80% of the stacks carry over
const int libAffx_lunaraPoisonerSecondsPerStack = 5;  // seconds an enemy Hero spends poisoned per stack
const int libAffx_lunaraPoisonerStacksPerApplySecond = 100; // stacks per extra second added by each application
const fixed libAffx_lunaraToxinPerApplication = 3.0;
const int libAffx_lunaraHuntressReward = 30;
const int libAffx_lunaraPollinatorReward = 40;

bool libAffx_lunaraStarted;
int[libAffx_lunaraQuests + 1] libAffx_lunaraBanked;   // stacks from previous games
int[libAffx_lunaraQuests + 1] libAffx_lunaraRestored; // banked stacks given back so far this game
bool libAffx_lunaraHuntressRewarded;

string libAffx_LunaraQuestToken(int quest) {
    if (quest == 1) { return "DryadPoisonerTokenCounter"; }
    if (quest == 2) { return "DryadHuntressTokenCounter"; }
    return "DryadPollinatorTokenCounter";
}
// Levels that each give back 10% of the banked stacks
int libAffx_LunaraCarryLevels(int quest) {
    if (quest == libAffx_lunaraPoisoner) {
        return libAffx_lunaraPoisonerCarryLevels;
    }
    return 10;
}
unit libAffx_LunaraHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_LunaraHasQuest(int quest) {
    unit hero = libAffx_LunaraHero();
    return hero != null && UnitHasBehavior2(hero, libAffx_LunaraQuestToken(quest));
}
int libAffx_LunaraStacks(int quest) {
    if (!libAffx_LunaraHasQuest(quest)) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(libAffx_LunaraHero(), libAffx_LunaraQuestToken(quest)));
}

// Carried-over stacks plus this game's progress; saved with the run
void libAffx_LunaraSaveBank() {
    int quest;
    int carried;
    if (!libAffx_lunaraStarted) {
        return;
    }
    for (quest = 1; quest <= libAffx_lunaraQuests; quest += 1) {
        if (libAffx_LunaraHasQuest(quest)) {
            carried = libAffx_lunaraBanked[quest] * libAffx_LunaraCarryLevels(quest) / 10;
            libAffx_BankSaveValueInt("Lunara_" + libAffx_LunaraQuestToken(quest),
                carried + MaxI(0, libAffx_LunaraStacks(quest) - libAffx_lunaraRestored[quest]));
        }
    }
}

// Poisoner: Nature's Toxin has no maximum duration, and every 100 stacks add 1 second to what each
// application adds (3 seconds base)
bool libAffx_LunaraToxinApplied_Func (bool testConds, bool runActions) {
    unit target = EventUnit();
    string key = "LunaraToxinExpires_" + IntToString(UnitGetTag(target));
    fixed now = GameGetMissionTime();
    fixed previous = MaxF(0.0, DataTableGetFixed(true, key) - now);
    int stacks = libAffx_LunaraStacks(libAffx_lunaraPoisoner);
    fixed perApplication = libAffx_lunaraToxinPerApplication + IntToFixed(stacks / libAffx_lunaraPoisonerStacksPerApplySecond);
    fixed current;
    fixed wanted;
    if (testConds) {
        if (!libAffx_LunaraHasQuest(libAffx_lunaraPoisoner) ||
            UnitBehaviorEffectPlayer(target, "DryadNaturesToxin", c_effectPlayerCaster, 0) != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    current = UnitBehaviorDuration(target, "DryadNaturesToxin");
    if (EventUnitBehaviorChange() == c_unitBehaviorChangeCreate) {
        previous = 0.0;
    }
    wanted = MaxF(current, previous + perApplication);
    if (wanted > current) {
        UnitBehaviorSetDurationRemaining(target, "DryadNaturesToxin", wanted);
    }
    DataTableSetFixed(true, key, now + wanted);
    return true;
}

// Poisoner: every 5 seconds an enemy Hero spends poisoned by Lunara grants a stack
void libAffx_LunaraPoisonerTick(unit hero) {
    unitgroup heroes;
    unit target;
    string key;
    int seconds;
    int i;
    if (!libAffx_LunaraHasQuest(libAffx_lunaraPoisoner)) {
        return;
    }
    // Only enemies carry Lunara's poison, so any Heroic unit will do here
    heroes = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterHeroic), 0,
        (1 << c_targetFilterMissile) | (1 << c_targetFilterItem), (1 << (c_targetFilterDead - 32))), 0);
    for (i = 1; i <= UnitGroupCount(heroes, c_unitCountAll); i += 1) {
        target = UnitGroupUnit(heroes, i);
        if (!UnitHasBehavior2(target, "DryadNaturesToxin") ||
            UnitBehaviorEffectPlayer(target, "DryadNaturesToxin", c_effectPlayerCaster, 0) != libAffx_player) {
            continue;
        }
        key = "LunaraPoisonedSeconds_" + IntToString(UnitGetTag(target));
        seconds = DataTableGetInt(true, key) + 1;
        if (seconds >= libAffx_lunaraPoisonerSecondsPerStack) {
            seconds = 0;
            libGame_gf_ModifyTokenCount(1, libAffx_LunaraQuestToken(libAffx_lunaraPoisoner), hero);
        }
        DataTableSetInt(true, key, seconds);
    }
}

bool libAffx_LunaraTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_LunaraHero();
    int quest;
    int level;
    int wanted;
    if (hero == null || !UnitIsAlive(hero) || libAffx_gamePaused) {
        return true;
    }

    // Give back carried-over stacks as Lunara levels up
    for (quest = 1; quest <= libAffx_lunaraQuests; quest += 1) {
        if (!libAffx_LunaraHasQuest(quest)) {
            continue;
        }
        level = MinI(UnitLevel(hero), libAffx_LunaraCarryLevels(quest));
        wanted = libAffx_lunaraBanked[quest] * level / 10;
        if (wanted > libAffx_lunaraRestored[quest]) {
            libGame_gf_ModifyTokenCount(wanted - libAffx_lunaraRestored[quest], libAffx_LunaraQuestToken(quest), hero);
            libAffx_lunaraRestored[quest] = wanted;
        }
    }

    libAffx_LunaraPoisonerTick(hero);

    // Splintered Huntress reward: Noxious Blossom empowers 4 Basic Attacks instead of 3
    if (!libAffx_lunaraHuntressRewarded && libAffx_LunaraStacks(2) >= libAffx_lunaraHuntressReward) {
        libAffx_lunaraHuntressRewarded = true;
        CatalogFieldValueSet(c_gameCatalogBehavior, "DryadSplineredSpearTokenCounter", "Max", libAffx_player, "4");
        CatalogFieldValueSet(c_gameCatalogEffect, "DryadSplinteredSpearAddTokens", "Value", libAffx_player, "4");
    }
    // Pollinator reward: Noxious Blossom explodes a second time
    if (libAffx_LunaraStacks(3) >= libAffx_lunaraPollinatorReward && !UnitHasBehavior2(hero, "DryadPollinatorSecondBloom")) {
        UnitBehaviorAdd(hero, "DryadPollinatorSecondBloom", hero, 1);
    }
    return true;
}

// AffixAdded for each Lunara starter boon
bool libAffx_LunaraQuestStart (bool testConds, bool runActions) {
    int quest;
    trigger t;
    if (libAffx_lunaraStarted) {
        return true;
    }
    libAffx_lunaraStarted = true;
    for (quest = 1; quest <= libAffx_lunaraQuests; quest += 1) {
        libAffx_lunaraBanked[quest] = libAffx_BankLoadValueInt("Lunara_" + libAffx_LunaraQuestToken(quest));
    }
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_LunaraTick_Func"), 1.0, c_timeGame);
    t = TriggerCreate("libAffx_LunaraToxinApplied_Func");
    TriggerAddEventUnitBehaviorChange(t, null, "DryadNaturesToxin", c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChange(t, null, "DryadNaturesToxin", c_unitBehaviorChangeRefresh);
    return true;
}
