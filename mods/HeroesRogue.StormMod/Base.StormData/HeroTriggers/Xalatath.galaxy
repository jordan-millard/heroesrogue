bool libAffx_XalatathSync_Func (bool testConds, bool runActions) {
    libAffx_XalatathSyncVolley();
    libAffx_XalatathSyncMark();
    libAffx_XalatathSyncHeart();
    return true;
}
fixed libAffx_XalatathXalatathVoidVolleyCreatePersistentsLastEcho = -1.0;
// XalatathSecondVolleyMarker: XalatathVoidVolleyCreatePersistents is cast again toward the same point 0.75 seconds later. The echo is skipped by its own event.
bool libAffx_XalatathXalatathVoidVolleyCreatePersistentsEcho_Func (bool testConds, bool runActions) {
    unit hero = libAffx_XalatathHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    if (hero == null || !UnitHasBehavior2(hero, "XalatathSecondVolleyMarker") || GameGetMissionTime() == libAffx_XalatathXalatathVoidVolleyCreatePersistentsLastEcho) {
        return false;
    }
    Wait(0.75, c_timeGame);
    if (!UnitIsAlive(hero) || target == null) {
        return true;
    }
    libAffx_XalatathXalatathVoidVolleyCreatePersistentsLastEcho = GameGetMissionTime();
    UnitCreateEffectPoint(hero, "XalatathVoidVolleyCreatePersistents", target);
    return true;
}
// Takedown quest stage 2 (stacks 41 to 80): number of stage 2 stacks for a takedown token
int libAffx_XalatathStage2 (string token) {
    return MaxI(0, MinI(libAffx_XalatathStacks(token) - 40, 40));
}
// Prophecy stage 2: +0.05 Void Volley range per stack. Void Whispers' first milestone sets the range to 10, so the range
// is set from the milestone's base every second.
void libAffx_XalatathVolleyRangeSync () {
    unit hero = libAffx_XalatathHero();
    int n;
    fixed range = 8.0;
    if (hero == null || !UnitHasBehavior2(hero, "XalatathVolleyMarker")) {
        return;
    }
    n = libAffx_XalatathStage2("XalatathProphecyTokenCounter");
    if (n <= 0) {
        return;
    }
    if (UnitGetTokenCount(hero, "XalatathVoidVolleyQuestTokenCounter") >= 20.0) {
        range = 10.0;
    }
    range = range + IntToFixed(n) * libAffx_XalatathVolleyRangePerStack;
    CatalogFieldValueSet(c_gameCatalogAbil, "XalatathVoidVolley", "Range", libAffx_player, FixedToString(range, c_fixedPrecisionAny));
    CatalogFieldValueSet(c_gameCatalogActor, "XalatathVoidVolleyRangeSplat", "Scale", libAffx_player, FixedToString(range + 0.6875, c_fixedPrecisionAny));
}
// Doom stage 2: Shadow Mark's orb flies 1% faster per stack (its flight time is 0.65 seconds)
void libAffx_XalatathMarkSpeedSync () {
    unit hero = libAffx_XalatathHero();
    int n;
    if (hero == null || !UnitHasBehavior2(hero, "XalatathMarkMarker")) {
        return;
    }
    n = libAffx_XalatathStage2("XalatathDoomTokenCounter");
    if (n == libAffx_XalatathMarkFaster) {
        return;
    }
    libAffx_XalatathMarkFaster = n;
    CatalogFieldValueSet(c_gameCatalogMover, "XalatathShadowMarkLobMissile", "MotionPhases[0].FlightTime", libAffx_player, FixedToString(libAffx_XalatathMarkFlightTime * (1.0 - 0.01 * IntToFixed(n)), 4) + ",-1");
}
// Sacrifice stage 2: the Dark Heart lasts 1% longer per stack (of its 8 seconds)
void libAffx_XalatathHeartDurationSync () {
    unit hero = libAffx_XalatathHero();
    int n;
    if (hero == null || !UnitHasBehavior2(hero, "XalatathHeartMarker")) {
        return;
    }
    n = libAffx_XalatathStage2("XalatathSacrificeTokenCounter");
    if (n == libAffx_XalatathHeartLonger) {
        return;
    }
    libAffx_CatalogReferenceModify("Behavior,XalatathDarkHeartRitualTimedLife,Duration", libAffx_player, FixedToString(IntToFixed(n - libAffx_XalatathHeartLonger) * 0.08, c_fixedPrecisionAny), c_upgradeOperationAdd);
    libAffx_XalatathHeartLonger = n;
}
bool libAffx_XalatathStage2_Func (bool testConds, bool runActions) {
    libAffx_XalatathVolleyRangeSync();
    libAffx_XalatathMarkSpeedSync();
    libAffx_XalatathHeartDurationSync();
    return true;
}
// Heart of Darkness Shield: each Dark Heart hit on an enemy Hero adds 3% of maximum Health to what is left, up to 21%
void libAffx_XalatathHeartShield (unit hero) {
    fixed lifeMax;
    fixed left = 0.0;
    if (!UnitIsAlive(hero)) {
        return;
    }
    lifeMax = UnitGetPropertyFixed(hero, c_unitPropLifeMax, c_unitPropCurrent);
    if (UnitHasBehavior2(hero, "XalatathHeartShield")) {
        left = UnitBehaviorDamageModifyRemaining(hero, "XalatathHeartShield");
    }
    CatalogFieldValueSetFixed(c_gameCatalogBehavior, "XalatathHeartShield", "DamageResponse.ModifyLimit", libAffx_player, MinF(left + lifeMax * libAffx_XalatathHeartShieldFraction, lifeMax * libAffx_XalatathHeartShieldMax));
    UnitBehaviorRemove(hero, "XalatathHeartShield", 1);
    UnitBehaviorAdd(hero, "XalatathHeartShield", hero, 1);
}
// Void Herald hit on an enemy Hero: takedown window, XalatathEchoingWhispersTokenCounter, the heal, and on-hit boons
bool libAffx_XalatathVolleyHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_XalatathHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_XalatathIsEnemyHero(victim) || !UnitHasBehavior2(hero, "XalatathVolleyMarker")) {
        return false;
    }
    libAffx_XalatathVolleyTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "XalatathEchoingWhispersTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "XalatathVolleyHeal", hero);
    }
    return true;
}
// Shadow Seer hit on an enemy Hero: takedown window, XalatathOmenTokenCounter, the heal, and on-hit boons
bool libAffx_XalatathMarkHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_XalatathHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_XalatathIsEnemyHero(victim) || !UnitHasBehavior2(hero, "XalatathMarkMarker")) {
        return false;
    }
    libAffx_XalatathMarkTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "XalatathOmenTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "XalatathMarkHeal", hero);
    }
    return true;
}
// Heart of Darkness hit on an enemy Hero: takedown window, XalatathRitualTokenCounter, the heal, and on-hit boons
bool libAffx_XalatathHeartHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_XalatathHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_XalatathIsEnemyHero(victim) || !UnitHasBehavior2(hero, "XalatathHeartMarker")) {
        return false;
    }
    libAffx_XalatathHeartTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "XalatathRitualTokenCounter", hero);
    libAffx_XalatathHeartShield(hero);
    return true;
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_XalatathTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_XalatathHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    if (UnitHasBehavior2(hero, "XalatathVolleyMarker") && libAffx_XalatathInWindow(libAffx_XalatathVolleyTime[killedPlayer], now)) {
        libAffx_XalatathVolleyTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "XalatathProphecyTokenCounter", hero);
        libAffx_XalatathSyncVolley();
        libAffx_XalatathQuestDing();
        libAffx_XalatathVolleyRangeSync();
    }
    if (UnitHasBehavior2(hero, "XalatathMarkMarker") && libAffx_XalatathInWindow(libAffx_XalatathMarkTime[killedPlayer], now)) {
        libAffx_XalatathMarkTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "XalatathDoomTokenCounter", hero);
        libAffx_XalatathSyncMark();
        libAffx_XalatathQuestDing();
        libAffx_XalatathMarkSpeedSync();
    }
    if (UnitHasBehavior2(hero, "XalatathHeartMarker") && libAffx_XalatathInWindow(libAffx_XalatathHeartTime[killedPlayer], now)) {
        libAffx_XalatathHeartTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "XalatathSacrificeTokenCounter", hero);
        libAffx_XalatathSyncHeart();
        libAffx_XalatathQuestDing();
        libAffx_XalatathHeartDurationSync();
    }
    return true;
}
bool libAffx_XalatathStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_XalatathStarted) {
        return true;
    }
    libAffx_XalatathStarted = true;
    trig = TriggerCreate("libAffx_XalatathVolleyHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "XalatathVoidVolleyDamage");
    trig = TriggerCreate("libAffx_XalatathMarkHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "XalatathShadowMarkOuterDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "XalatathShadowMarkInnerDamage");
    trig = TriggerCreate("libAffx_XalatathHeartHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "XalatathDarkHeartRitualChainDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "XalatathDarkHeartRitualDetonationDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_XalatathXalatathVoidVolleyCreatePersistentsEcho_Func"), libAffx_player, "XalatathVoidVolleyCreatePersistents");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_XalatathStage2_Func"), 1.0, c_timeGame);
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_XalatathSync_Func"), 1.0, c_timeGame);
    return true;
}
