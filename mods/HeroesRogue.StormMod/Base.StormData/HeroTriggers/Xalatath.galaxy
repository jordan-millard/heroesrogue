include "AffixTriggers"

// ============================================================
// Golden Xal'atath. Each starter: hits on enemy Heroes open a 3 second takedown window, add the hit quest token and heal;
// takedowns in the window add the takedown token (capped part, then 1% damage per stack past the cap).
// Second Volley (Epic): Void Volley's barrage fires again at the same spot 0.75 seconds later.
// ============================================================

const fixed libAffx_XalatathTakedownWindow = 3.0;
const fixed libAffx_XalatathPastCapDamagePerStack = 0.01;
bool libAffx_XalatathStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_XalatathVolleyTime; // per enemy player, last Void Herald hit
int libAffx_XalatathVolleyAdded; // Void Herald: takedown stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_XalatathMarkTime; // per enemy player, last Shadow Seer hit
int libAffx_XalatathMarkAdded; // Shadow Seer: takedown stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_XalatathHeartTime; // per enemy player, last Heart of Darkness hit
int libAffx_XalatathHeartAdded; // Heart of Darkness: takedown stacks already applied to the catalog this game
const fixed libAffx_XalatathHeartShieldFraction = 0.03; // Heart of Darkness Shield: share of maximum Health per hit
const fixed libAffx_XalatathHeartShieldMax = 0.21; // most it can hold
const fixed libAffx_XalatathVolleyRangePerStack = 0.05; // Prophecy stage 2: Void Volley range per stack
const fixed libAffx_XalatathMarkFlightTime = 0.65; // Shadow Mark's base flight time
int libAffx_XalatathMarkFaster; // Doom stage 2: stacks applied to Shadow Mark's flight time
int libAffx_XalatathHeartLonger; // Sacrifice stage 2: stacks applied to the Dark Heart's duration

unit libAffx_XalatathHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_XalatathIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_XalatathStacks(string tokenId) {
    unit hero = libAffx_XalatathHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_XalatathQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_XalatathInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_XalatathTakedownWindow;
}
// XalatathProphecyTokenCounter: stacks 1-40: 1% of the 1.5 explosion radius each; 41-80: 0.05 Void Volley range each (libAffx_XalatathVolleyRangeSync); then 3% damage each, Heroics too
void libAffx_XalatathSyncVolley () {
    unit hero = libAffx_XalatathHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "XalatathVolleyMarker")) {
        return;
    }
    stacks = libAffx_XalatathStacks("XalatathProphecyTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_XalatathVolleyAdded) {
        libAffx_CatalogReferenceModify("Effect,XalatathVoidVolley2AoESearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_XalatathVolleyAdded) * 0.015, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_XalatathVolleyAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 80)) * 0.03, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidVolleyDamage", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathFracturedRealityFireDamage", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFlightDamageTier1", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFlightDamageTier2", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFlightDamageTier3", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFlightDamageTier4", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFinalDamageTier1", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFinalDamageTier2", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFinalDamageTier3", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidEruptionFinalDamageTier4", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFlightDamageTier1", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFlightDamageTier2", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFlightDamageTier3", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFlightDamageTier4", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFinalDamageTier1", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFinalDamageTier2", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFinalDamageTier3", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathOrbitalEruptionFinalDamageTier4", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "XalatathVoidMinionWeaponDamage", "MultiplicativeModifierArray[XalatathVolleyLegacy].Modifier", libAffx_player, bonus);
}
