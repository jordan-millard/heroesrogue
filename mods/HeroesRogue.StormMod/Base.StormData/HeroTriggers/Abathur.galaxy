include "AffixTriggers"

// ============================================================
// Abathur, Minefield.
// Toxic Nests are no longer cast. One drops under Abathur every 3 seconds (2 with Rapid Gestation), but not within
// 2 seconds of his Basic Attack hitting anything. Activating Frenzy removes all of his nests; during Frenzy they drop
// every 0.5 seconds regardless (0.12 with Overgrowth, which then stops normal drops for 30 seconds after Frenzy ends).
// Nesting Instinct makes every rate 40% faster.
// Hit quest: each enemy Hero hit by a nest explosion adds 2% nest damage.
// Slapathur quest: an enemy Hero takedown by Slapathur's stunning hit, or within 4 seconds of that Stun, adds 1%
// Slapathur Stun duration, 30 maximum Health, 2 flat nest damage (AbathurData.xml) and 3% Locust Health.
// Stacks carry over between games through QuestRetain; nest damage is in AbathurData.xml.
// ============================================================

const fixed libAffx_abathurDropInterval = 3.0;
const fixed libAffx_abathurDropIntervalRapid = 2.0;
const fixed libAffx_abathurDropIntervalFrenzy = 0.5;
const fixed libAffx_abathurDropIntervalOvergrowth = 0.12; // about 25 nests over the 3 second Overgrowth Frenzy
const fixed libAffx_abathurOvergrowthLockout = 30.0; // no normal drops this long after an Overgrowth Frenzy
const fixed libAffx_abathurNestingInstinctFactor = 0.6; // 40% faster
const fixed libAffx_abathurAttackLockout = 2.0; // no nests this long after a Basic Attack hit, outside Frenzy
const fixed libAffx_abathurTakedownWindow = 4.0;
const int libAffx_abathurSlapLifePerStack = 30; // matches AbathurSlapathurQuestLife
const fixed libAffx_abathurSlapStunPerStack = 0.01;
const int libAffx_abathurHeroHitStacks = 2;
const fixed libAffx_abathurDropTickPeriod = 0.0625;
const fixed libAffx_abathurSlapNestArming = 2.0; // Parasitic Slap

bool libAffx_abathurStarted;
bool libAffx_abathurFrenzyActive;
fixed libAffx_abathurSinceLastNest; // advances only while the game isn't paused (boon picks and menus)
fixed libAffx_abathurAttackLockoutLeft; // counts down only while the game isn't paused
fixed libAffx_abathurOvergrowthLockoutLeft; // counts down only while the game isn't paused
fixed libAffx_abathurStunBonusApplied; // seconds the Slapathur quest currently adds to AbathurSlapathurStun
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_abathurSlapStunTime; // per enemy player, last Slapathur Stun

unit libAffx_AbathurHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_AbathurHasStarter() {
    unit hero = libAffx_AbathurHero();
    return hero != null && UnitHasBehavior2(hero, "AbathurMinefieldMarker");
}
bool libAffx_AbathurIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}

// Nest explosion on an enemy Hero: hit quest stacks and a shield stack
bool libAffx_AbathurNestHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    if (EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_AbathurHasStarter()) {
        return false;
    }
    if (!UnitTypeTestAttribute(UnitGetType(victim), c_unitAttributeHeroic)) {
        return false;
    }
    libGame_gf_ModifyTokenCount(libAffx_abathurHeroHitStacks, "AbathurMinefieldTokenCounter", libAffx_AbathurHero());
    if (PlayerHasTalent(libAffx_player, "AbathurChitinousBulwark")) {
        UnitBehaviorAdd(libAffx_AbathurHero(), "AbathurMinefieldShield", libAffx_AbathurHero(), 1);
    }
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
    return true;
}

// Parasitic Slap: a Toxic Nest under the stunned Hero that arms after 2 seconds instead of the usual 1
void libAffx_AbathurSlapNest(unit target) {
    point at = UnitGetPosition(target);
    unitgroup nests;
    int i;
    unit nest;
    UnitCreateEffectPoint(libAffx_AbathurHero(), "AbathurToxicNestInitialSet", at);
    nests = UnitGroupSearch("AbathurToxicNest", libAffx_player, at, 1.0, UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(nests, c_unitCountAll); i > 0; i -= 1) {
        nest = UnitGroupUnitFromEnd(nests, i);
        if (nest != null && UnitHasBehavior2(nest, "ToxicNestArmingBehavior")) {
            UnitBehaviorSetDurationRemaining(nest, "ToxicNestArmingBehavior", libAffx_abathurSlapNestArming);
        }
    }
}

// Slapathur Stun applied to an enemy Hero: opens the Slapathur quest window (and Parasitic Slap drops a nest)
bool libAffx_AbathurSlapStun_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit caster = UnitBehaviorEffectUnit(victim, "AbathurSlapathurStun", c_effectUnitCaster, 0);
    if (caster == null || UnitGetOwner(caster) != libAffx_player || !libAffx_AbathurIsEnemyHero(victim)) {
        return false;
    }
    libAffx_abathurSlapStunTime[UnitGetOwner(victim)] = GameGetMissionTime();
    if (UnitHasBehavior2(caster, "AbathurParasiticSlapMarker")) {
        libAffx_AbathurSlapNest(victim);
    }
    return true;
}

// A Basic Attack that kills an enemy Hero who isn't on Slapathur's internal cooldown was the stunning hit (the Stun
// itself never lands on a dead target)
bool libAffx_AbathurSlapKill_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    if (EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_AbathurIsEnemyHero(victim)) {
        return false;
    }
    if (UnitHasBehavior2(victim, "SlapathurInternalCooldown")) {
        return false;
    }
    libAffx_abathurSlapStunTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}

// HeroTakedown for the Slapathur quest
bool libAffx_AbathurTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    fixed stunTime;
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || !libAffx_AbathurHasStarter()) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    stunTime = libAffx_abathurSlapStunTime[killedPlayer];
    if (stunTime <= 0.0 || GameGetMissionTime() - stunTime > libAffx_abathurTakedownWindow) {
        return true;
    }
    libAffx_abathurSlapStunTime[killedPlayer] = 0.0;
    libGame_gf_ModifyTokenCount(1, "AbathurMinefieldTakedownTokenCounter", libAffx_AbathurHero());
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
    return true;
}

// Keeps the Slapathur quest rewards equal to its stack count (covers stacks loaded from the bank): one
// AbathurSlapathurQuestLife stack (+30 maximum Health) per stack, and 1% Slapathur Stun duration per stack on top of
// whatever the Stun duration is otherwise (Crushing Slap adds to it)
void libAffx_AbathurSyncSlapRewards(unit hero) {
    int tokens = FixedToInt(UnitGetTokenCount(hero, "AbathurMinefieldTakedownTokenCounter"));
    int stacks = UnitBehaviorCount(hero, "AbathurSlapathurQuestLife");
    fixed stun = CatalogFieldValueGetAsFixed(c_gameCatalogBehavior, "AbathurSlapathurStun", "Duration", libAffx_player);
    fixed baseStun = stun - libAffx_abathurStunBonusApplied;
    fixed stunBonus = baseStun * libAffx_abathurSlapStunPerStack * IntToFixed(tokens);
    if (tokens > stacks) {
        UnitBehaviorAdd(hero, "AbathurSlapathurQuestLife", hero, tokens - stacks);
        UnitSetPropertyFixed(hero, c_unitPropLife, UnitGetPropertyFixed(hero, c_unitPropLife, c_unitPropCurrent) + IntToFixed((tokens - stacks) * libAffx_abathurSlapLifePerStack));
    } else if (tokens < stacks) {
        UnitBehaviorRemove(hero, "AbathurSlapathurQuestLife", stacks - tokens);
    }
    if (stunBonus - libAffx_abathurStunBonusApplied > 0.001 || libAffx_abathurStunBonusApplied - stunBonus > 0.001) {
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AbathurSlapathurStun", "Duration", libAffx_player, baseStun + stunBonus);
        libAffx_abathurStunBonusApplied = stunBonus;
    }
}

// New Locusts gain 3% Health per Slapathur quest stack
bool libAffx_AbathurLocustSpawned_Func (bool testConds, bool runActions) {
    unit locust = EventUnitCreatedUnit();
    string type = UnitGetType(locust);
    fixed lifeMax;
    unit hero = libAffx_AbathurHero();
    if (UnitGetOwner(locust) != libAffx_player || hero == null || !libAffx_AbathurHasStarter()) {
        return false;
    }
    if (type != "AbathurLocustNormal" && type != "AbathurLocustBombardStrain" && type != "AbathurLocustAssaultStrain") {
        return false;
    }
    lifeMax = UnitGetPropertyFixed(locust, c_unitPropLifeMax, c_unitPropCurrent) * (1.0 + UnitGetTokenCount(hero, "AbathurMinefieldTakedownTokenCounter") * 0.03);
    UnitSetPropertyFixed(locust, c_unitPropLifeMax, lifeMax);
    UnitSetPropertyFixed(locust, c_unitPropLife, lifeMax);
    return true;
}

// Any Basic Attack hit by Abathur starts the nest lockout
bool libAffx_AbathurAttackHit_Func (bool testConds, bool runActions) {
    if (EventUnitDamageSourcePlayer() != libAffx_player || EventUnitDamageSourceUnit() != libAffx_AbathurHero()) {
        return false;
    }
    libAffx_abathurAttackLockoutLeft = libAffx_abathurAttackLockout;
    return true;
}

// Frenzy: removes every Toxic Nest Abathur has placed
void libAffx_AbathurRemoveNests() {
    unitgroup nests = UnitGroup("AbathurToxicNest", libAffx_player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    int i = UnitGroupCount(nests, c_unitCountAll);
    unit nest;
    for (; i > 0; i -= 1) {
        nest = UnitGroupUnitFromEnd(nests, i);
        if (nest != null) {
            UnitRemove(nest);
        }
    }
}

// Drops nests on the timer, except shortly after a Basic Attack (Frenzy ignores that)
bool libAffx_AbathurDropTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_AbathurHero();
    bool frenzy;
    fixed interval = libAffx_abathurDropInterval;
    if (hero == null || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "AbathurMinefieldMarker")) {
        libAffx_abathurFrenzyActive = false;
        return false;
    }
    libAffx_AbathurSyncSlapRewards(hero);
    if (libAffx_gamePaused || UnitHasBehaviorWithCategoryFlag(hero, c_behaviorCategoryTimeStop)) {
        return false;
    }
    if (libAffx_abathurAttackLockoutLeft > 0.0) {
        libAffx_abathurAttackLockoutLeft -= libAffx_abathurDropTickPeriod;
    }
    if (libAffx_abathurOvergrowthLockoutLeft > 0.0) {
        libAffx_abathurOvergrowthLockoutLeft -= libAffx_abathurDropTickPeriod;
    }
    frenzy = UnitHasBehavior2(hero, "AbathurMinefieldFrenzyBuff");
    if (frenzy) {
        interval = libAffx_abathurDropIntervalFrenzy;
        if (PlayerHasTalent(libAffx_player, "AbathurOvergrowth")) {
            interval = libAffx_abathurDropIntervalOvergrowth;
        }
        if (!libAffx_abathurFrenzyActive) {
            // Frenzy just started: clear the field, and the first new nest drops right away
            libAffx_abathurFrenzyActive = true;
            libAffx_AbathurRemoveNests();
            libAffx_abathurSinceLastNest = interval;
        }
    } else {
        if (libAffx_abathurFrenzyActive && PlayerHasTalent(libAffx_player, "AbathurOvergrowth")) {
            // Overgrowth Frenzy just ended
            libAffx_abathurOvergrowthLockoutLeft = libAffx_abathurOvergrowthLockout;
        }
        libAffx_abathurFrenzyActive = false;
        if (UnitHasBehavior2(hero, "AbathurRapidGestationMarker")) {
            interval = libAffx_abathurDropIntervalRapid;
        }
    }
    if (PlayerHasTalent(libAffx_player, "AbathurNestingInstinct")) {
        interval = interval * libAffx_abathurNestingInstinctFactor;
    }
    libAffx_abathurSinceLastNest += libAffx_abathurDropTickPeriod;
    if (libAffx_abathurSinceLastNest > interval) {
        libAffx_abathurSinceLastNest = interval; // a full timer waits for the next chance to drop
    }
    if (!frenzy && (libAffx_abathurAttackLockoutLeft > 0.0 || libAffx_abathurOvergrowthLockoutLeft > 0.0)) {
        return false;
    }
    if (libAffx_abathurSinceLastNest < interval - 0.01) {
        return false;
    }
    libAffx_abathurSinceLastNest -= interval;
    if (libAffx_abathurSinceLastNest < 0.0) {
        libAffx_abathurSinceLastNest = 0.0;
    }
    UnitCreateEffectPoint(hero, "AbathurToxicNestInitialSet", UnitGetPosition(hero));
    UnitBehaviorAdd(hero, "AbathurMinefieldDropSpeed", hero, 1);
    return true;
}

// HeroGainTalent: Prolific Dispersal adds 45 seconds to the nest lifetime, which would end "last forever", so set it back
bool libAffx_AbathurTalentGained (bool testConds, bool runActions) {
    if (testConds) {
        if (libGame_gf_HeroGainTalentPlayer() != libAffx_player) {
            return false;
        }
    }
    if (!libAffx_AbathurHasStarter()) {
        return false;
    }
    Wait(0.0625, c_timeGame);
    CatalogFieldValueSet(c_gameCatalogBehavior, "ToxicNestSearchBehaviorTimedLife", "Duration", libAffx_player, "0");
    return true;
}

// AffixAdded for Minefield
bool libAffx_AbathurStart (bool testConds, bool runActions) {
    trigger nestHit;
    trigger slapStun;
    trigger slapKill;
    if (libAffx_abathurStarted) {
        return true;
    }
    libAffx_abathurStarted = true;
    libAffx_abathurSinceLastNest = libAffx_abathurDropInterval;
    nestHit = TriggerCreate("libAffx_AbathurNestHit_Func");
    TriggerAddEventUnitDamaged(nestHit, null, c_unitDamageTypeAny, c_unitDamageEither, "ToxicNestDamage");
    slapStun = TriggerCreate("libAffx_AbathurSlapStun_Func");
    TriggerAddEventUnitBehaviorChange(slapStun, null, "AbathurSlapathurStun", c_unitBehaviorChangeCreate);
    slapKill = TriggerCreate("libAffx_AbathurSlapKill_Func");
    TriggerAddEventUnitDamaged(slapKill, null, c_unitDamageTypeAny, c_unitDamageFatal, "AbathurWeaponDamage");
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_AbathurAttackHit_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, "AbathurWeaponDamage");
    TriggerAddEventUnitCreated(TriggerCreate("libAffx_AbathurLocustSpawned_Func"), null, null, null);
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_AbathurDropTick_Func"), libAffx_abathurDropTickPeriod, c_timeGame);
    return true;
}
