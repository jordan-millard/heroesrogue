include "AffixTriggers"

// ============================================================
// Abathur, Minefield.
// Each enemy Hero hit by a Toxic Nest explosion adds 1 flat and 1% Toxic Nest damage.
// Stacks carry over between games through QuestRetain; the damage itself is in AbathurData.xml.
// ============================================================

bool libAffx_abathurStarted;
bool libAffx_abathurTrailStarted;
const fixed libAffx_abathurTrailCooldown = 3.0;
fixed libAffx_abathurTrailLastNest;
point libAffx_abathurTrailLastPosition;

unit libAffx_AbathurHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}

// Toxic Nest explosion hit on an enemy Hero: one Minefield stack, with a quest ding
bool libAffx_AbathurNestHit_Func (bool testConds, bool runActions) {
    unit hero = libAffx_AbathurHero();
    unit victim = EventUnit();
    if (EventUnitDamageSourcePlayer() != libAffx_player) {
        return false;
    }
    if (!UnitTypeTestAttribute(UnitGetType(victim), c_unitAttributeHeroic)) {
        return false;
    }
    if (hero == null || !UnitHasBehavior2(hero, "AbathurMinefieldMarker")) {
        return false;
    }
    libGame_gf_ModifyTokenCount(1, "AbathurMinefieldTokenCounter", hero);
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
    return true;
}

// HeroGainTalent: Prolific Dispersal adds 45 seconds to the nest lifetime, which would end "last forever", so set it back
bool libAffx_AbathurTalentGained (bool testConds, bool runActions) {
    unit hero = libAffx_AbathurHero();
    if (testConds) {
        if (libGame_gf_HeroGainTalentPlayer() != libAffx_player) {
            return false;
        }
    }
    if (hero == null || !UnitHasBehavior2(hero, "AbathurMinefieldMarker")) {
        return false;
    }
    Wait(0.0625, c_timeGame);
    CatalogFieldValueSet(c_gameCatalogBehavior, "ToxicNestSearchBehaviorTimedLife", "Duration", libAffx_player, "0");
    return true;
}

// AffixAdded for Minefield
bool libAffx_AbathurStart (bool testConds, bool runActions) {
    trigger nestHit;
    if (libAffx_abathurStarted) {
        return true;
    }
    libAffx_abathurStarted = true;
    nestHit = TriggerCreate("libAffx_AbathurNestHit_Func");
    TriggerAddEventUnitDamaged(nestHit, null, c_unitDamageTypeAny, c_unitDamageEither, "ToxicNestDamage");
    return true;
}

// Mine Trail (Legendary): while Abathur walks, a Toxic Nest is placed under him every 3 seconds
bool libAffx_AbathurTrailTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_AbathurHero();
    point position;
    bool moved = false;
    if (hero == null || !UnitIsAlive(hero)) {
        libAffx_abathurTrailLastPosition = null;
        return false;
    }
    position = UnitGetPosition(hero);
    if (libAffx_abathurTrailLastPosition != null) {
        moved = DistanceBetweenPoints(position, libAffx_abathurTrailLastPosition) > 0.1;
    }
    libAffx_abathurTrailLastPosition = position;
    if (!moved || GameGetMissionTime() - libAffx_abathurTrailLastNest < libAffx_abathurTrailCooldown) {
        return false;
    }
    libAffx_abathurTrailLastNest = GameGetMissionTime();
    UnitCreateEffectPoint(hero, "AbathurToxicNestInitialSet", position);
    return true;
}

// AffixAdded for Mine Trail
bool libAffx_AbathurTrailStart (bool testConds, bool runActions) {
    if (libAffx_abathurTrailStarted) {
        return true;
    }
    libAffx_abathurTrailStarted = true;
    libAffx_abathurTrailLastNest = -libAffx_abathurTrailCooldown;
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_AbathurTrailTick_Func"), 0.25, c_timeGame);
    return true;
}
