include "AffixTriggers"

// ============================================================
// Abathur, Minefield.
// Toxic Nests are no longer cast: one drops under Abathur every 3 seconds (2 with Rapid Gestation, 0.5 during Frenzy).
// Hit quest: each enemy Hero hit by a nest explosion adds 3% nest damage.
// Slapathur quest: an enemy Hero takedown within 3 seconds of Abathur's Basic Attack hitting them adds 20 flat nest
// damage and 50 maximum Health.
// Stacks carry over between games through QuestRetain; the damage itself is in AbathurData.xml.
// ============================================================

const fixed libAffx_abathurDropInterval = 3.0;
const fixed libAffx_abathurDropIntervalRapid = 2.0;
const fixed libAffx_abathurDropIntervalFrenzy = 0.5;
const fixed libAffx_abathurScuttlingBroodFactor = 0.6; // 40% faster while moving
const fixed libAffx_abathurTakedownWindow = 3.0;
const int libAffx_abathurSlapLifePerStack = 50; // matches AbathurSlapathurQuestLife
const int libAffx_abathurHeroHitStacks = 3;

bool libAffx_abathurStarted;
const fixed libAffx_abathurDropTickPeriod = 0.25;
fixed libAffx_abathurSinceLastNest; // advances only while the game isn't paused (boon picks and menus)
point libAffx_abathurLastPosition;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_abathurSlapTime; // per enemy player, last hit by Abathur's Basic Attack

unit libAffx_AbathurHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_AbathurHasStarter() {
    unit hero = libAffx_AbathurHero();
    return hero != null && UnitHasBehavior2(hero, "AbathurMinefieldMarker");
}

// Nest explosion on an enemy Hero: hit quest stacks and a shield stack
bool libAffx_AbathurNestHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    if (EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_AbathurHasStarter()) {
        return false;
    }
    if (!UnitTypeTestAttribute(UnitGetType(victim), c_unitAttributeHeroic)) {
        return false;
    }
    libGame_gf_ModifyTokenCount(libAffx_abathurHeroHitStacks, "AbathurMinefieldTokenCounter", libAffx_AbathurHero());
    if (PlayerHasTalent(libAffx_player, "AbathurChitinousBulwark")) {
        UnitBehaviorAdd(libAffx_AbathurHero(), "AbathurMinefieldShield", libAffx_AbathurHero(), 1);
    }
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
    return true;
}

// Abathur's Basic Attack on an enemy Hero opens the Slapathur quest window
bool libAffx_AbathurSlap_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    int victimPlayer = UnitGetOwner(victim);
    if (EventUnitDamageSourcePlayer() != libAffx_player) {
        return false;
    }
    if (!UnitTypeTestAttribute(UnitGetType(victim), c_unitAttributeHeroic)) {
        return false;
    }
    if (victimPlayer < 1 || victimPlayer > libCore_gv_bALMaxPlayers) {
        return false;
    }
    libAffx_abathurSlapTime[victimPlayer] = GameGetMissionTime();
    return true;
}

// HeroTakedown for the Slapathur quest
bool libAffx_AbathurTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    fixed hitTime;
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || !libAffx_AbathurHasStarter()) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    hitTime = libAffx_abathurSlapTime[killedPlayer];
    if (hitTime <= 0.0 || GameGetMissionTime() - hitTime > libAffx_abathurTakedownWindow) {
        return true;
    }
    libAffx_abathurSlapTime[killedPlayer] = 0.0;
    libGame_gf_ModifyTokenCount(1, "AbathurMinefieldTakedownTokenCounter", libAffx_AbathurHero());
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
    return true;
}

// Keeps one AbathurSlapathurQuestLife stack (+50 maximum Health) per Slapathur quest stack
void libAffx_AbathurSyncSlapLife(unit hero) {
    int tokens = FixedToInt(UnitGetTokenCount(hero, "AbathurMinefieldTakedownTokenCounter"));
    int stacks = UnitBehaviorCount(hero, "AbathurSlapathurQuestLife");
    if (tokens > stacks) {
        UnitBehaviorAdd(hero, "AbathurSlapathurQuestLife", hero, tokens - stacks);
        UnitSetPropertyFixed(hero, c_unitPropLife, UnitGetPropertyFixed(hero, c_unitPropLife, c_unitPropCurrent) + IntToFixed((tokens - stacks) * libAffx_abathurSlapLifePerStack));
    } else if (tokens < stacks) {
        UnitBehaviorRemove(hero, "AbathurSlapathurQuestLife", stacks - tokens);
    }
}

// Drops a nest under Abathur on the timer (Scuttling Brood: 40% faster while he moves)
bool libAffx_AbathurDropTick_Func (bool testConds, bool runActions) {
    unit hero = libAffx_AbathurHero();
    point position;
    bool moved = false;
    fixed interval = libAffx_abathurDropInterval;
    if (hero == null || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "AbathurMinefieldMarker")) {
        libAffx_abathurLastPosition = null;
        return false;
    }
    libAffx_AbathurSyncSlapLife(hero);
    position = UnitGetPosition(hero);
    if (libAffx_abathurLastPosition != null) {
        moved = DistanceBetweenPoints(position, libAffx_abathurLastPosition) > 0.1;
    }
    libAffx_abathurLastPosition = position;
    if (UnitHasBehavior2(hero, "AbathurMinefieldFrenzyBuff")) {
        interval = libAffx_abathurDropIntervalFrenzy;
    } else {
        if (UnitHasBehavior2(hero, "AbathurRapidGestationMarker")) {
            interval = libAffx_abathurDropIntervalRapid;
        }
        if (moved && PlayerHasTalent(libAffx_player, "AbathurScuttlingBrood")) {
            interval = interval * libAffx_abathurScuttlingBroodFactor;
        }
    }
    if (libAffx_gamePaused || UnitHasBehaviorWithCategoryFlag(hero, c_behaviorCategoryTimeStop)) {
        return false;
    }
    libAffx_abathurSinceLastNest += libAffx_abathurDropTickPeriod;
    if (libAffx_abathurSinceLastNest < interval - 0.01) {
        return false;
    }
    libAffx_abathurSinceLastNest = 0.0;
    UnitCreateEffectPoint(hero, "AbathurToxicNestInitialSet", position);
    UnitBehaviorAdd(hero, "AbathurMinefieldDropSpeed", hero, 1);
    return true;
}

// HeroGainTalent: Prolific Dispersal adds 45 seconds to the nest lifetime, which would end "last forever", so set it back
bool libAffx_AbathurTalentGained (bool testConds, bool runActions) {
    if (testConds) {
        if (libGame_gf_HeroGainTalentPlayer() != libAffx_player) {
            return false;
        }
    }
    if (!libAffx_AbathurHasStarter()) {
        return false;
    }
    Wait(0.0625, c_timeGame);
    CatalogFieldValueSet(c_gameCatalogBehavior, "ToxicNestSearchBehaviorTimedLife", "Duration", libAffx_player, "0");
    return true;
}

// AffixAdded for Minefield
bool libAffx_AbathurStart (bool testConds, bool runActions) {
    trigger nestHit;
    trigger slap;
    if (libAffx_abathurStarted) {
        return true;
    }
    libAffx_abathurStarted = true;
    libAffx_abathurSinceLastNest = libAffx_abathurDropInterval;
    nestHit = TriggerCreate("libAffx_AbathurNestHit_Func");
    TriggerAddEventUnitDamaged(nestHit, null, c_unitDamageTypeAny, c_unitDamageEither, "ToxicNestDamage");
    slap = TriggerCreate("libAffx_AbathurSlap_Func");
    TriggerAddEventUnitDamaged(slap, null, c_unitDamageTypeAny, c_unitDamageEither, "AbathurWeaponDamage");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_AbathurDropTick_Func"), libAffx_abathurDropTickPeriod, c_timeGame);
    return true;
}
