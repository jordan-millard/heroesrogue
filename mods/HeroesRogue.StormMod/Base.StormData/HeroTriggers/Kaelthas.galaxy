include "AffixTriggers"

// ============================================================
// Golden Kael'thas. Each starter: hits on enemy Heroes open a 3 second takedown window, add the hit quest token
// and heal; takedowns in the window add the takedown token.
// Sunfire, Sunwell quest: 1% Flamestrike radius per stack, up to 30%; then 1% Flamestrike damage
// each. Twin Suns (Legendary): each Flamestrike is cast again 0.5 seconds later.
// Bombardier, Chain Detonation quest: every 15 stacks 1 more Living Bomb charge, up to 2; past 30 stacks 1% damage.
// Pyromancer, Phoenix Fire quest: 1% of Pyroblast's 20 second cooldown per stack, up to 40%; then 1% damage each.
// Inferno (Legendary): those takedowns reset Pyroblast.
// Verdant Spheres: an empowered Living Bomb refunds its charge (Bombardier), and Verdant Spheres ending restores
// Living Bomb's real Mana cost and cooldown instead of the base 50 Mana and 10 seconds.
// ============================================================

const fixed libAffx_KaelthasTakedownWindow = 3.0;
const fixed libAffx_KaelthasPastCapDamagePerStack = 0.01;
bool libAffx_KaelthasStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KaelthasFlamestrikeTime; // per enemy player, last Sunfire hit
int libAffx_KaelthasFlamestrikeAdded; // Sunfire: takedown stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KaelthasBombTime; // per enemy player, last Bombardier hit
int libAffx_KaelthasBombAdded; // Bombardier: charges added by the takedown quest this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_KaelthasPyroTime; // per enemy player, last Pyromancer hit
int libAffx_KaelthasPyroAdded; // Pyromancer: takedown stacks already applied to the catalog this game
bool libAffx_KaelthasBombVerdant; // the Living Bomb being cast is empowered by Verdant Spheres
string libAffx_KaelthasBombEnergy; // Living Bomb's real Mana cost and cooldown, outside Verdant Spheres
string libAffx_KaelthasBombCooldown;
fixed libAffx_KaelthasVerdantEnd = -10.0; // when Verdant Spheres last ended

unit libAffx_KaelthasHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_KaelthasIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_KaelthasStacks(string tokenId) {
    unit hero = libAffx_KaelthasHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_KaelthasQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_KaelthasInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_KaelthasTakedownWindow;
}
// KaelthasSunwellTokenCounter: 1% Flamestrike radius per stack (of 2, or 3 with Verdant Spheres), up to 30%, then Flamestrike damage
void libAffx_KaelthasSyncFlamestrike () {
    unit hero = libAffx_KaelthasHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KaelthasFlamestrikeMarker")) {
        return;
    }
    stacks = libAffx_KaelthasStacks("KaelthasSunwellTokenCounter");
    wanted = MinI(stacks, 30);
    if (wanted != libAffx_KaelthasFlamestrikeAdded) {
        libAffx_CatalogReferenceModify("Effect,KaelthasFlamestrikeSearchArea,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KaelthasFlamestrikeAdded) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,KaelthasFlamestrikeSearchAreaBurnedFlesh,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KaelthasFlamestrikeAdded) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,KaelthasFlamestrikeVerdantSpheresSearchArea,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KaelthasFlamestrikeAdded) * 0.03, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,KaelThasFlamestrikeVerdantSpheresBurnedFleshSearchArea,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KaelthasFlamestrikeAdded) * 0.03, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KaelthasFlamestrikeAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 30)) * libAffx_KaelthasPastCapDamagePerStack, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasFlamestrikeDamage", "MultiplicativeModifierArray[KaelthasFlamestrikeLegacy].Modifier", libAffx_player, bonus);
}
// KaelthasChainDetonationTokenCounter: 1 more Living Bomb charge per 15 stacks, up to 2, then damage
void libAffx_KaelthasSyncBomb () {
    unit hero = libAffx_KaelthasHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KaelthasBombMarker")) {
        return;
    }
    stacks = libAffx_KaelthasStacks("KaelthasChainDetonationTokenCounter");
    wanted = MinI(2, stacks / 15);
    if (wanted != libAffx_KaelthasBombAdded) {
        libAffx_CatalogReferenceModify("Abil,KaelthasLivingBomb,Cost.Charge.CountMax", libAffx_player, IntToString(wanted - libAffx_KaelthasBombAdded), c_upgradeOperationAdd);
        libAffx_KaelthasBombAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 30)) * libAffx_KaelthasPastCapDamagePerStack, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasLivingBombImpactDamage", "MultiplicativeModifierArray[KaelthasBombLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasLivingBombDoTDamage", "MultiplicativeModifierArray[KaelthasBombLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasLivingBombExplosionDamage", "MultiplicativeModifierArray[KaelthasBombLegacy].Modifier", libAffx_player, bonus);
}
// KaelthasPhoenixFireTokenCounter: 1% of the 20 second cooldown per stack, up to 40%, then damage
void libAffx_KaelthasSyncPyro () {
    unit hero = libAffx_KaelthasHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "KaelthasPyroMarker")) {
        return;
    }
    stacks = libAffx_KaelthasStacks("KaelthasPhoenixFireTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_KaelthasPyroAdded) {
        libAffx_CatalogReferenceModify("Abil,KaelthasPyroblast,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_KaelthasPyroAdded) * -0.2, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_KaelthasPyroAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 40)) * libAffx_KaelthasPastCapDamagePerStack, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasPyroblastDamage", "MultiplicativeModifierArray[KaelthasPyroLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasPyroblastSplashDamage", "MultiplicativeModifierArray[KaelthasPyroLegacy].Modifier", libAffx_player, bonus);
}
bool libAffx_KaelthasSync_Func (bool testConds, bool runActions) {
    libAffx_KaelthasSyncFlamestrike();
    libAffx_KaelthasSyncBomb();
    libAffx_KaelthasSyncPyro();
    return true;
}
fixed libAffx_KaelthasKaelthasFlamestrikeInitialSetLastEcho = -1.0;
// KaelthasTwinSunsMarker: KaelthasFlamestrikeInitialSet is cast again toward the same point 0.5 seconds later. The echo is skipped by its own event.
bool libAffx_KaelthasKaelthasFlamestrikeInitialSetEcho_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KaelthasHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    if (hero == null || !UnitHasBehavior2(hero, "KaelthasTwinSunsMarker") || GameGetMissionTime() == libAffx_KaelthasKaelthasFlamestrikeInitialSetLastEcho) {
        return false;
    }
    Wait(0.5, c_timeGame);
    if (!UnitIsAlive(hero) || target == null) {
        return true;
    }
    libAffx_KaelthasKaelthasFlamestrikeInitialSetLastEcho = GameGetMissionTime();
    UnitCreateEffectPoint(hero, "KaelthasFlamestrikeInitialSet", target);
    return true;
}
// Verdant Spheres ending sets Living Bomb to 50 Mana and a 10 second cooldown, undoing the starter and boons.
// While Verdant Spheres is off (and not just ended), remember Living Bomb's real values; when it ends, put them back.
bool libAffx_KaelthasVerdantRemember_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KaelthasHero();
    if (hero == null || UnitHasBehavior2(hero, "KaelthasVerdantSpheresActive") || GameGetMissionTime() - libAffx_KaelthasVerdantEnd < 1.0) {
        return false;
    }
    libAffx_KaelthasBombEnergy = CatalogFieldValueGet(c_gameCatalogAbil, "KaelthasLivingBomb", "Cost[0].Vital[Energy]", libAffx_player);
    libAffx_KaelthasBombCooldown = CatalogFieldValueGet(c_gameCatalogAbil, "KaelthasLivingBomb", "Cost[0].Cooldown.TimeUse", libAffx_player);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasVerdantSpheresDeactivateLivingBombModifyPlayer", "EffectArray[0].Value", libAffx_player, libAffx_KaelthasBombEnergy);
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasVerdantSpheresDeactivateLivingBombModifyPlayer", "EffectArray[1].Value", libAffx_player, libAffx_KaelthasBombCooldown);
    return true;
}
void libAffx_KaelthasVerdantPutBack (unit hero) {
    fixed cooldown = StringToFixed(libAffx_KaelthasBombCooldown);
    CatalogFieldValueSet(c_gameCatalogAbil, "KaelthasLivingBomb", "Cost[0].Vital[Energy]", libAffx_player, libAffx_KaelthasBombEnergy);
    CatalogFieldValueSet(c_gameCatalogAbil, "KaelthasLivingBomb", "Cost[0].Cooldown.TimeUse", libAffx_player, libAffx_KaelthasBombCooldown);
    if (UnitGetCooldown(hero, "Abil/KaelthasLivingBomb") > cooldown) {
        UnitModifyCooldown(hero, "Abil/KaelthasLivingBomb", cooldown, c_cooldownOperationSet);
    }
}
bool libAffx_KaelthasVerdantEnded_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KaelthasHero();
    if (hero == null || EventUnit() != hero || libAffx_KaelthasBombEnergy == "") {
        return false;
    }
    libAffx_KaelthasVerdantEnd = GameGetMissionTime();
    libAffx_KaelthasVerdantPutBack(hero);
    // again after the cast finishes, in case the reset lands after this event
    Wait(0.125, c_timeGame);
    libAffx_KaelthasVerdantPutBack(hero);
    Wait(0.5, c_timeGame);
    libAffx_KaelthasVerdantPutBack(hero);
    return true;
}
// Sunfire: the Flamestrike targeting circle follows the Sunwell radius (Verdant Spheres sets it to 3 or 2 when it starts and ends)
bool libAffx_KaelthasFlamestrikeCursor_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KaelthasHero();
    fixed radius = 2.0;
    if (hero == null || !UnitHasBehavior2(hero, "KaelthasFlamestrikeMarker")) {
        return false;
    }
    if (UnitHasBehavior2(hero, "KaelthasVerdantSpheresActive")) {
        radius = 3.0;
    }
    radius = radius * (1.0 + 0.01 * IntToFixed(MinI(libAffx_KaelthasStacks("KaelthasSunwellTokenCounter"), 30)));
    CatalogFieldValueSet(c_gameCatalogEffect, "KaelthasFlamestrikeDummySearchArea", "AreaArray[0].Radius", libAffx_player, FixedToString(radius, 3));
    return true;
}
// Living Bomb cast start: remember whether Verdant Spheres empowers it
bool libAffx_KaelthasBombPrep_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KaelthasHero();
    libAffx_KaelthasBombVerdant = hero != null && UnitHasBehavior2(hero, "KaelthasVerdantSpheresActive");
    return true;
}
// Bombardier: an empowered Living Bomb gives its charge back once the cost is paid
bool libAffx_KaelthasBombVerdantRefund_Func (bool testConds, bool runActions) {
    unit hero = libAffx_KaelthasHero();
    if (!libAffx_KaelthasBombVerdant || hero == null || !UnitHasBehavior2(hero, "KaelthasBombMarker")) {
        return false;
    }
    libAffx_KaelthasBombVerdant = false;
    UnitCreateEffectUnit(hero, "KaelthasBombVerdantRefund", hero);
    return true;
}
// Sunfire hit on an enemy Hero: takedown window, KaelthasEmberTokenCounter, the heal, and on-hit boons
bool libAffx_KaelthasFlamestrikeHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KaelthasHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KaelthasIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KaelthasFlamestrikeMarker")) {
        return false;
    }
    libAffx_KaelthasFlamestrikeTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KaelthasEmberTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "KaelthasFlamestrikeHeal", hero);
    }
    if (UnitHasBehavior2(hero, "KaelthasKindlingMarker")) {
        UnitCreateEffectUnit(hero, "KaelthasKindlingModifyCooldown", hero);
    }
    if (UnitHasBehavior2(hero, "KaelthasScorchMarker")) {
        UnitCreateEffectUnit(hero, "KaelthasScorchApply", victim);
    }
    return true;
}
// Bombardier hit on an enemy Hero: takedown window, KaelthasFuseTokenCounter, the heal, and on-hit boons
bool libAffx_KaelthasBombHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KaelthasHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KaelthasIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KaelthasBombMarker")) {
        return false;
    }
    libAffx_KaelthasBombTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KaelthasFuseTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "KaelthasBombHeal", hero);
    }
    if (UnitHasBehavior2(hero, "KaelthasChainReactionMarker")) {
        UnitCreateEffectUnit(hero, "KaelthasChainReactionModifyCooldown", hero);
    }
    if (UnitHasBehavior2(hero, "KaelthasSearingMarker")) {
        UnitCreateEffectUnit(hero, "KaelthasSearingApply", victim);
    }
    return true;
}
// Pyromancer hit on an enemy Hero: takedown window, KaelthasFirestormTokenCounter, the heal, and on-hit boons
bool libAffx_KaelthasPyroHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_KaelthasHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_KaelthasIsEnemyHero(victim) || !UnitHasBehavior2(hero, "KaelthasPyroMarker")) {
        return false;
    }
    libAffx_KaelthasPyroTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "KaelthasFirestormTokenCounter", hero);
    if (UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "KaelthasPyroHeal", hero);
    }
    if (UnitHasBehavior2(hero, "KaelthasPyroclasmMarker")) {
        UnitCreateEffectUnit(hero, "KaelthasPyroclasmMana", hero);
    }
    if (UnitHasBehavior2(hero, "KaelthasMeteorStrikeMarker")) {
        UnitCreateEffectUnit(hero, "KaelthasMeteorStrikeModifyCooldown", hero);
    }
    return true;
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_KaelthasTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_KaelthasHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    if (UnitHasBehavior2(hero, "KaelthasFlamestrikeMarker") && libAffx_KaelthasInWindow(libAffx_KaelthasFlamestrikeTime[killedPlayer], now)) {
        libAffx_KaelthasFlamestrikeTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KaelthasSunwellTokenCounter", hero);
        libAffx_KaelthasSyncFlamestrike();
        libAffx_KaelthasQuestDing();
    }
    if (UnitHasBehavior2(hero, "KaelthasBombMarker") && libAffx_KaelthasInWindow(libAffx_KaelthasBombTime[killedPlayer], now)) {
        libAffx_KaelthasBombTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KaelthasChainDetonationTokenCounter", hero);
        libAffx_KaelthasSyncBomb();
        libAffx_KaelthasQuestDing();
    }
    if (UnitHasBehavior2(hero, "KaelthasPyroMarker") && libAffx_KaelthasInWindow(libAffx_KaelthasPyroTime[killedPlayer], now)) {
        libAffx_KaelthasPyroTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "KaelthasPhoenixFireTokenCounter", hero);
        libAffx_KaelthasSyncPyro();
        libAffx_KaelthasQuestDing();
        if (UnitHasBehavior2(hero, "KaelthasInfernoMarker")) {
            UnitCreateEffectUnit(hero, "KaelthasInfernoReset", hero);
        }
    }
    return true;
}
bool libAffx_KaelthasStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_KaelthasStarted) {
        return true;
    }
    libAffx_KaelthasStarted = true;
    trig = TriggerCreate("libAffx_KaelthasFlamestrikeHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KaelthasFlamestrikeDamage");
    trig = TriggerCreate("libAffx_KaelthasBombHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KaelthasLivingBombImpactDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KaelthasLivingBombExplosionDamage");
    trig = TriggerCreate("libAffx_KaelthasPyroHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KaelthasPyroblastDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "KaelthasPyroblastSplashDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_KaelthasKaelthasFlamestrikeInitialSetEcho_Func"), libAffx_player, "KaelthasFlamestrikeInitialSet");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_KaelthasVerdantRemember_Func"), 0.25, c_timeGame);
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_KaelthasFlamestrikeCursor_Func"), 0.25, c_timeGame);
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_KaelthasVerdantEnded_Func"), null, "KaelthasVerdantSpheresActive", c_unitBehaviorChangeDestroy);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_KaelthasBombPrep_Func"), libAffx_player, "KaelthasLivingBombPrepSet");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_KaelthasBombVerdantRefund_Func"), libAffx_player, "KaelthasLivingBombInitialSet");
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_KaelthasSync_Func"), 1.0, c_timeGame);
    return true;
}
