    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonFendChannelDamage", "MultiplicativeModifierArray[CassiaSkirmLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonAvoidanceSurgeOfLightDamage", "MultiplicativeModifierArray[CassiaSkirmLegacy].Modifier", libAffx_player, bonus);
