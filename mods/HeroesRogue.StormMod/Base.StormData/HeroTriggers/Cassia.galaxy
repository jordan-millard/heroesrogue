include "AffixTriggers"

// ============================================================
// Golden Cassia (Amazon). Each starter: hits on enemy Heroes open a 3 second takedown window and add the hit
// quest token; takedowns in the window add the takedown token.
// Valkyrie's Javelin: Thunderbolt counts each enemy Hero once per throw; Javelin Mastery stacks 1-40 recharge,
// 41-80 width, 81-100 a Slow, 100 an echo throw for half damage, then 2.5% all damage each.
// Warden of Arreat: Fend Strikes counts each enemy Hero once per Fend; Fend Mastery stacks 1-40 cooldown, 41-80
// arc, 81-100 strike speed, 100 a final strike, then 2.5% all damage each. A full Fend heals 5% (data).
// Skirmisher: Skirmish counts Basic Attacks on Heroes for Fend damage; every 10 empower the next Fend to
// Root (data). Hit and Run stacks 1-40 Attack Speed, 41-80 shorter Slows and Stuns, 100 maximum
// Health damage on Basic Attacks, then 1.5% all damage each.
// ============================================================

const fixed libAffx_CassiaTakedownWindow = 3.0;
const fixed libAffx_CassiaPastCapDamagePerStack = 0.01;
bool libAffx_CassiaStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_CassiaJavelinTime; // per enemy player, last Valkyrie's Javelin hit
int libAffx_CassiaJavelinAdded; // Valkyrie's Javelin: takedown stacks already applied to the catalog this game
int libAffx_CassiaJavelinAdded2; // Valkyrie's Javelin: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_CassiaJavelinAdded3; // Valkyrie's Javelin: takedown quest stage 3 stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_CassiaFendTime; // per enemy player, last Warden of Arreat hit
int libAffx_CassiaFendAdded; // Warden of Arreat: takedown stacks already applied to the catalog this game
int libAffx_CassiaFendAdded2; // Warden of Arreat: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_CassiaFendAdded3; // Warden of Arreat: takedown quest stage 3 stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_CassiaSkirmTime; // per enemy player, last Skirmisher hit
int libAffx_CassiaSkirmAdded; // Skirmisher: takedown stacks already applied to the catalog this game
fixed libAffx_CassiaJavelinCast; // last Lightning Fury throw (real or echo)
fixed libAffx_CassiaJavelinEchoTime = -1.0; // when the script threw the last echo
int libAffx_CassiaJavelinHeroes; // enemy Heroes hit by the current throw
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_CassiaJavelinCounted; // per enemy player, last hit counted for Thunderbolt
fixed libAffx_CassiaFendCast; // last Fend
int libAffx_CassiaFendShields; // Static Field shields from the current Fend
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_CassiaFendCounted; // per enemy player, last hit counted for Fend Strikes
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_CassiaFendHitTime; // per enemy player, last Fend hit
int[libCore_gv_bALMaxPlayers + 1] libAffx_CassiaFendHits; // per enemy player, hits by the current Fend
int libAffx_CassiaKiting; // Basic Attacks on Heroes toward the next Kiting Shot
fixed libAffx_CassiaMovingSince = -1.0; // Untouchable: when Cassia started moving unhurt
fixed libAffx_CassiaHurtTime; // Untouchable: when Cassia last took damage

unit libAffx_CassiaHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_CassiaIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_CassiaStacks(string tokenId) {
    unit hero = libAffx_CassiaHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_CassiaQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_CassiaInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_CassiaTakedownWindow;
}
// AmazonGoldenJavelinTokenCounter: stacks 1-40: 1% of the 5 second recharge each; 41-80: 1% width each; 81-100: 1% Slow each; then 2.5% all damage each
void libAffx_CassiaSyncJavelin () {
    unit hero = libAffx_CassiaHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "AmazonGoldenJavelinMarker")) {
        return;
    }
    stacks = libAffx_CassiaStacks("AmazonGoldenJavelinTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_CassiaJavelinAdded) {
        libAffx_CatalogReferenceModify("Abil,AmazonLightningFury,Cost.Charge.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_CassiaJavelinAdded) * -0.05, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CassiaJavelinAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 1% of the 0.6 width each, javelin and bolts
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_CassiaJavelinAdded2) {
        libAffx_CatalogReferenceModify("Effect,AmazonLightningFuryMissileSearch,AreaArray[0].RectangleWidth", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_CassiaJavelinAdded2) * 0.006, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,AmazonLightningFuryLightningMissileSearch,AreaArray[0].RectangleWidth", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_CassiaJavelinAdded2) * 0.006, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CassiaJavelinAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): 1% more Slow each on enemy Heroes hit, for 1 second
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_CassiaJavelinAdded3) {
        libAffx_CatalogReferenceModify("Behavior,AmazonGoldenJavelinSlow,Modification.UnifiedMoveSpeedFactor", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_CassiaJavelinAdded3) * -0.01, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CassiaJavelinAdded3 = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 100)) * 0.025, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonLightningFuryDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonLightningFuryLightningDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonLightningFuryStaticElectricityLightningDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenStormSpearDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonFendChannelDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonHeroWeaponDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonHeroWeaponDamageTitansRevenge", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonChargedStrikesWeaponDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonChargedStrikesWeaponDamageTitansRevenge", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenKitingShotDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenSkirmishMaxHealthDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonAvoidanceSurgeOfLightDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonBlindingLightDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonMartialLawDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonMartialLawBaseDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonValkyrieImprisoningLightDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonValkyrieImpaleDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonBallLightningBounceToEnemyDamage", "MultiplicativeModifierArray[CassiaJavelinLegacy].Modifier", libAffx_player, bonus);
}
// AmazonGoldenFendMasteryTokenCounter: stacks 1-40: 1% of the 10 second cooldown each; 41-80: 1% arc each; 81-100: 1% faster strikes each; then 2.5% all damage each
void libAffx_CassiaSyncFend () {
    unit hero = libAffx_CassiaHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "AmazonGoldenWardenMarker")) {
        return;
    }
    stacks = libAffx_CassiaStacks("AmazonGoldenFendMasteryTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_CassiaFendAdded) {
        libAffx_CatalogReferenceModify("Abil,AmazonFend,Cost.Cooldown.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_CassiaFendAdded) * -0.1, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CassiaFendAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 1% of the 45 degree arc each
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_CassiaFendAdded2) {
        libAffx_CatalogReferenceModify("Effect,AmazonFendChannelSearchArea,AreaArray[0].Arc", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_CassiaFendAdded2) * 0.45, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CassiaFendAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): 1% of the 0.125 second strike period each
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_CassiaFendAdded3) {
        libAffx_CatalogReferenceModify("Effect,AmazonFendChannelCreatePersistent,PeriodicPeriodArray[0]", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_CassiaFendAdded3) * -0.00125, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CassiaFendAdded3 = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 100)) * 0.025, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonFendChannelDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonLightningFuryDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonLightningFuryLightningDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonLightningFuryStaticElectricityLightningDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenStormSpearDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonHeroWeaponDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonHeroWeaponDamageTitansRevenge", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonChargedStrikesWeaponDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonChargedStrikesWeaponDamageTitansRevenge", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenKitingShotDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenSkirmishMaxHealthDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonAvoidanceSurgeOfLightDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonBlindingLightDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonMartialLawDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonMartialLawBaseDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonValkyrieImprisoningLightDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonValkyrieImpaleDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonBallLightningBounceToEnemyDamage", "MultiplicativeModifierArray[CassiaFendLegacy].Modifier", libAffx_player, bonus);
