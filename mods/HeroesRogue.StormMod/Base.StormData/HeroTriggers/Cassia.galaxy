bool libAffx_CassiaSync_Func (bool testConds, bool runActions) {
    libAffx_CassiaSyncJavelin();
    libAffx_CassiaSyncFend();
    libAffx_CassiaSyncSkirm();
    return true;
}
// Kiting Shot and Storm Spear follow Lightning Fury (level scaling): copy their Amount each second. The Fend blast (Warden of Arreat at 100 Fend Mastery stacks) is turned on here too.
bool libAffx_CassiaAmounts_Func (bool testConds, bool runActions) {
    unit hero = libAffx_CassiaHero();
    string blast = "0";
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenStormSpearDamage", "Amount", libAffx_player,
                         CatalogFieldValueGet(c_gameCatalogEffect, "AmazonLightningFuryLightningDamage", "Amount", libAffx_player));
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenKitingShotDamage", "Amount", libAffx_player,
                         CatalogFieldValueGet(c_gameCatalogEffect, "AmazonLightningFuryDamage", "Amount", libAffx_player));
    if (hero != null && UnitHasBehavior2(hero, "AmazonGoldenWardenMarker") && libAffx_CassiaStacks("AmazonGoldenFendMasteryTokenCounter") >= 100) {
        blast = "1";
    }
    CatalogFieldValueSet(c_gameCatalogEffect, "AmazonGoldenFendBlastSet", "Chance", libAffx_player, blast);
    return true;
}
// Lightning Fury throws (real or echo). Each throw starts a new count of Heroes hit; at 100 Javelin Mastery stacks a
// real throw is thrown again 0.5 seconds later toward the same point for half damage.
bool libAffx_CassiaJavelinCast_Func (bool testConds, bool runActions) {
    unit hero = libAffx_CassiaHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    fixed now = GameGetMissionTime();
    if (hero == null || !UnitHasBehavior2(hero, "AmazonGoldenJavelinMarker")) {
        return false;
    }
    libAffx_CassiaJavelinCast = now;
    libAffx_CassiaJavelinHeroes = 0;
    if (now == libAffx_CassiaJavelinEchoTime) {
        return true;
    }
    UnitBehaviorRemove(hero, "AmazonGoldenJavelinEchoMarker", 1);
    if (libAffx_CassiaStacks("AmazonGoldenJavelinTokenCounter") < 100 || target == null) {
        return true;
    }
    Wait(0.5, c_timeGame);
    if (!UnitIsAlive(hero)) {
        return true;
    }
    libAffx_CassiaJavelinEchoTime = GameGetMissionTime();
    UnitBehaviorAdd(hero, "AmazonGoldenJavelinEchoMarker", hero, 1);
    UnitCreateEffectPoint(hero, "AmazonLightningFuryLaunchMissile", target);
    return true;
}
// Thunderbolt quest gate: an enemy Hero counts once per throw. The 2nd Hero hit by one throw refunds half a charge
// (Javelin Mastery).
bool libAffx_CassiaJavelinNewHit (unit victim) {
    unit hero = libAffx_CassiaHero();
    int owner = UnitGetOwner(victim);
    fixed half;
    fixed left;
    if (libAffx_CassiaJavelinCounted[owner] >= libAffx_CassiaJavelinCast) {
        return false;
    }
    libAffx_CassiaJavelinCounted[owner] = GameGetMissionTime();
    libAffx_CassiaJavelinHeroes += 1;
    if (libAffx_CassiaJavelinHeroes == 2 && UnitHasBehavior2(hero, "AmazonGoldenJavelinMasteryMarker")) {
        half = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, "AmazonLightningFury", "Cost[0].Charge.TimeUse", libAffx_player)) * 0.5;
        left = UnitGetChargeRegen(hero, "Abil/AmazonLightningFury");
        if (left > 0.0) {
            UnitAddChargeRegen(hero, "Abil/AmazonLightningFury", -MinF(half, left));
        }
    }
    return true;
}
// Storm Spear (Epic): a split bolt that hits an enemy Hero chains to the nearest other enemy Hero within 4
bool libAffx_CassiaStormSpear_Func (bool testConds, bool runActions) {
    unit hero = libAffx_CassiaHero();
    unit victim = EventUnit();
    unit best;
    unit enemy;
    fixed bestDistance = 4.0;
    fixed distance;
    int p;
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !UnitHasBehavior2(hero, "AmazonGoldenStormSpearMarker") || !libAffx_CassiaIsEnemyHero(victim)) {
        return false;
    }
    for (p = 1; p <= libCore_gv_bALMaxPlayers; p += 1) {
        enemy = libGame_gv_players[p].lv_heroUnit;
        if (enemy != null && enemy != victim && UnitIsAlive(enemy) && libAffx_CassiaIsEnemyHero(enemy)) {
            distance = DistanceBetweenPoints(UnitGetPosition(enemy), UnitGetPosition(victim));
            if (distance <= bestDistance) {
                bestDistance = distance;
                best = enemy;
            }
        }
    }
    if (best != null) {
        UnitCreateEffectUnit(hero, "AmazonGoldenStormSpearDamage", best);
    }
    return true;
}
// Fend casts: each Fend starts new counts (Fend Strikes gate, Hold the Line, Static Field shields)
bool libAffx_CassiaFendCast_Func (bool testConds, bool runActions) {
    libAffx_CassiaFendCast = GameGetMissionTime();
    libAffx_CassiaFendShields = 0;
    return true;
}
// Skirmisher: an empowered Fend was cast (its data removes the buff), so the counter starts again from 0
bool libAffx_CassiaEmpoweredFendUsed_Func (bool testConds, bool runActions) {
    unit hero = libAffx_CassiaHero();
    if (hero == null || EventUnit() != hero) {
        return false;
    }
    libGame_gf_ModifyTokenCount(-libAffx_CassiaStacks("AmazonGoldenEmpoweredFendTokenCounter"), "AmazonGoldenEmpoweredFendTokenCounter", hero);
    return true;
}
// Fend Strikes quest gate: an enemy Hero counts once per Fend
bool libAffx_CassiaFendNewHit (unit victim) {
    int owner = UnitGetOwner(victim);
    if (libAffx_CassiaFendCounted[owner] >= libAffx_CassiaFendCast) {
        return false;
    }
    libAffx_CassiaFendCounted[owner] = GameGetMissionTime();
    return true;
}
// Fend hit on an enemy Hero: Hold the Line (4th hit of one Fend Slows) and Static Field (shield, up to 10 per Fend)
void libAffx_CassiaFendOnHit (unit hero, unit victim) {
    int owner = UnitGetOwner(victim);
    if (libAffx_CassiaFendHitTime[owner] < libAffx_CassiaFendCast) {
        libAffx_CassiaFendHits[owner] = 0;
    }
    libAffx_CassiaFendHitTime[owner] = GameGetMissionTime();
    libAffx_CassiaFendHits[owner] += 1;
    if (libAffx_CassiaFendHits[owner] == 4 && UnitHasBehavior2(hero, "AmazonGoldenHoldTheLineMarker")) {
        UnitCreateEffectUnit(hero, "AmazonGoldenHoldTheLineApply", victim);
    }
    if (UnitHasBehavior2(hero, "AmazonGoldenStaticFieldMarker") && libAffx_CassiaFendShields < 10) {
        libAffx_CassiaFendShields += 1;
        UnitBehaviorAdd(hero, "AmazonGoldenStaticFieldShield", hero, 1);
    }
}
// Skirmisher: Hit and Run stacks 1-40 set the Attack Speed stacks; Untouchable readies after 3 seconds of moving unhurt
bool libAffx_CassiaSkirmish_Func (bool testConds, bool runActions) {
    unit hero = libAffx_CassiaHero();
    fixed now = GameGetMissionTime();
    int count;
    int wanted;
    bool moving;
    if (hero == null || !UnitIsAlive(hero) || !UnitHasBehavior2(hero, "AmazonGoldenSkirmisherMarker")) {
        libAffx_CassiaMovingSince = -1.0;
        return false;
    }
    wanted = MinI(40, libAffx_CassiaStacks("AmazonGoldenSkirmisherTokenCounter"));
    count = UnitBehaviorCount(hero, "AmazonGoldenSkirmisherAttackSpeed");
    if (count < wanted) {
        UnitBehaviorAdd(hero, "AmazonGoldenSkirmisherAttackSpeed", hero, wanted - count);
    }
    else if (count > wanted) {
        UnitBehaviorRemove(hero, "AmazonGoldenSkirmisherAttackSpeed", count - wanted);
    }
    moving = UnitBehaviorEnabled(hero, "AmazonAvoidanceMovementCheck");
    if (moving) {
        if (libAffx_CassiaMovingSince < 0.0) {
            libAffx_CassiaMovingSince = now;
        }
    }
    else {
        libAffx_CassiaMovingSince = -1.0;
    }
    if (moving && UnitHasBehavior2(hero, "AmazonGoldenUntouchableMarker") && !UnitHasBehavior2(hero, "AmazonGoldenUntouchableReady")
        && now - libAffx_CassiaMovingSince >= 3.0 && now - libAffx_CassiaHurtTime >= 3.0) {
        UnitBehaviorAdd(hero, "AmazonGoldenUntouchableReady", hero, 1);
    }
    return true;
}
// Skirmisher: Hit and Run stacks 41-80 shorten Slows and Stuns on Cassia by 1% each (like the game's own CC reduction:
// Stuns marked Unreducible are skipped)
bool libAffx_CassiaTenacity_Func (bool testConds, bool runActions) {
    unit hero = libAffx_CassiaHero();
    string beh = EventUnitBehavior();
    fixed cut;
    fixed left;
    if (hero == null || EventUnit() != hero || !UnitHasBehavior2(hero, "AmazonGoldenSkirmisherMarker")) {
        return false;
    }
    if (UnitBehaviorHasCategoryFlag(beh, c_behaviorCategoryUnreducible) && UnitBehaviorHasCategoryFlag(beh, c_behaviorCategoryStun)) {
        return false;
    }
    cut = IntToFixed(MaxI(0, MinI(libAffx_CassiaStacks("AmazonGoldenSkirmisherTokenCounter") - 40, 40))) * 0.01;
    left = UnitBehaviorDuration(hero, beh);
    if (cut > 0.0 && left > 0.0) {
        UnitBehaviorSetDurationRemaining(hero, beh, left * (1.0 - cut));
    }
    return true;
}
// Untouchable: taking damage restarts the 3 seconds
bool libAffx_CassiaHurt_Func (bool testConds, bool runActions) {
    if (EventUnit() != libAffx_CassiaHero()) {
        return false;
    }
    libAffx_CassiaHurtTime = GameGetMissionTime();
    if (libAffx_CassiaMovingSince >= 0.0) {
        libAffx_CassiaMovingSince = GameGetMissionTime();
    }
    return true;
}
// Untouchable: the empowered Basic Attack is used up on any target and Stuns an enemy Hero
bool libAffx_CassiaUntouchableHit_Func (bool testConds, bool runActions) {
    unit hero = libAffx_CassiaHero();
    unit victim = EventUnit();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !UnitHasBehavior2(hero, "AmazonGoldenUntouchableReady")) {
        return false;
    }
    UnitBehaviorRemove(hero, "AmazonGoldenUntouchableReady", 1);
    if (libAffx_CassiaIsEnemyHero(victim)) {
        UnitCreateEffectUnit(hero, "AmazonGoldenUntouchableStunApply", victim);
    }
    return true;
}
// Valkyrie's Javelin hit on an enemy Hero: takedown window, AmazonGoldenThunderboltTokenCounter, the heal, and on-hit boons
bool libAffx_CassiaJavelinHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_CassiaHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_CassiaIsEnemyHero(victim) || !UnitHasBehavior2(hero, "AmazonGoldenJavelinMarker")) {
        return false;
    }
    libAffx_CassiaJavelinTime[UnitGetOwner(victim)] = GameGetMissionTime();
    if (libAffx_CassiaJavelinNewHit(victim)) {
        libGame_gf_ModifyTokenCount(1, "AmazonGoldenThunderboltTokenCounter", hero);
    }
    if (libAffx_CassiaStacks("AmazonGoldenJavelinTokenCounter") > 80) {
        UnitCreateEffectUnit(hero, "AmazonGoldenJavelinSlowApply", victim);
    }
    return true;
}
// Warden of Arreat hit on an enemy Hero: takedown window, AmazonGoldenFendStrikesTokenCounter, the heal, and on-hit boons
bool libAffx_CassiaFendHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_CassiaHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_CassiaIsEnemyHero(victim) || !UnitHasBehavior2(hero, "AmazonGoldenWardenMarker")) {
        return false;
    }
    libAffx_CassiaFendTime[UnitGetOwner(victim)] = GameGetMissionTime();
    if (libAffx_CassiaFendNewHit(victim)) {
        libGame_gf_ModifyTokenCount(1, "AmazonGoldenFendStrikesTokenCounter", hero);
    }
    libAffx_CassiaFendOnHit(hero, victim);
    return true;
}
// Skirmisher hit on an enemy Hero: takedown window, AmazonGoldenSkirmishTokenCounter, the heal, and on-hit boons
bool libAffx_CassiaSkirmHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_CassiaHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_CassiaIsEnemyHero(victim) || !UnitHasBehavior2(hero, "AmazonGoldenSkirmisherMarker")) {
        return false;
    }
    libAffx_CassiaSkirmTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "AmazonGoldenSkirmishTokenCounter", hero);
    if (UnitHasBehavior2(hero, "AmazonGoldenKitingShotMarker")) {
        libAffx_CassiaKiting += 1;
        if (libAffx_CassiaKiting >= 4) {
            libAffx_CassiaKiting = 0;
            UnitCreateEffectUnit(hero, "AmazonGoldenKitingShotDamage", victim);
        }
    }
    if (!UnitHasBehavior2(hero, "AmazonGoldenEmpoweredFendReady")) {
        libGame_gf_ModifyTokenCount(1, "AmazonGoldenEmpoweredFendTokenCounter", hero);
        if (libAffx_CassiaStacks("AmazonGoldenEmpoweredFendTokenCounter") >= 10) {
            UnitBehaviorAdd(hero, "AmazonGoldenEmpoweredFendReady", hero, 1);
        }
    }
    if (libAffx_CassiaStacks("AmazonGoldenSkirmisherTokenCounter") >= 100) {
        UnitCreateEffectUnit(hero, "AmazonGoldenSkirmishMaxHealthDamage", victim);
    }
    return true;
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_CassiaTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_CassiaHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    if (UnitHasBehavior2(hero, "AmazonGoldenJavelinMarker") && libAffx_CassiaInWindow(libAffx_CassiaJavelinTime[killedPlayer], now)) {
        libAffx_CassiaJavelinTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "AmazonGoldenJavelinTokenCounter", hero);
        libAffx_CassiaSyncJavelin();
        libAffx_CassiaQuestDing();
    }
    if (UnitHasBehavior2(hero, "AmazonGoldenWardenMarker") && libAffx_CassiaInWindow(libAffx_CassiaFendTime[killedPlayer], now)) {
        libAffx_CassiaFendTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "AmazonGoldenFendMasteryTokenCounter", hero);
        libAffx_CassiaSyncFend();
        libAffx_CassiaQuestDing();
    }
    if (UnitHasBehavior2(hero, "AmazonGoldenSkirmisherMarker") && libAffx_CassiaInWindow(libAffx_CassiaSkirmTime[killedPlayer], now)) {
        libAffx_CassiaSkirmTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "AmazonGoldenSkirmisherTokenCounter", hero);
        libAffx_CassiaSyncSkirm();
        libAffx_CassiaQuestDing();
    }
    return true;
}
bool libAffx_CassiaStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_CassiaStarted) {
        return true;
    }
    libAffx_CassiaStarted = true;
    trig = TriggerCreate("libAffx_CassiaJavelinHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonLightningFuryDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonLightningFuryLightningDamage");
    trig = TriggerCreate("libAffx_CassiaFendHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonFendChannelDamage");
    trig = TriggerCreate("libAffx_CassiaSkirmHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonHeroWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonHeroWeaponDamageTitansRevenge");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonChargedStrikesWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonChargedStrikesWeaponDamageTitansRevenge");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_CassiaAmounts_Func"), 1.0, c_timeGame);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_CassiaJavelinCast_Func"), libAffx_player, "AmazonLightningFuryLaunchMissile");
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_CassiaStormSpear_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonLightningFuryLightningDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_CassiaFendCast_Func"), libAffx_player, "AmazonFendChannelCreatePersistent");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_CassiaSkirmish_Func"), 0.25, c_timeGame);
    TriggerAddEventUnitDamaged(TriggerCreate("libAffx_CassiaHurt_Func"), null, c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_CassiaEmpoweredFendUsed_Func"), null, "AmazonGoldenEmpoweredFendReady", c_unitBehaviorChangeDestroy);
    trig = TriggerCreate("libAffx_CassiaTenacity_Func");
    TriggerAddEventUnitBehaviorChangeFromCategory(trig, null, c_behaviorCategoryStun, c_unitBehaviorChangeCreate);
    TriggerAddEventUnitBehaviorChangeFromCategory(trig, null, c_behaviorCategoryStun, c_unitBehaviorChangeRefresh);
    TriggerAddEventUnitBehaviorChangeFromCategory(trig, null, c_behaviorCategorySlow, c_unitBehaviorChangeRefresh);
    TriggerAddEventUnitBehaviorChangeFromCategory(trig, null, c_behaviorCategorySlow, c_unitBehaviorChangeIncrease);
    trig = TriggerCreate("libAffx_CassiaUntouchableHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonHeroWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonHeroWeaponDamageTitansRevenge");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonChargedStrikesWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "AmazonChargedStrikesWeaponDamageTitansRevenge");
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_CassiaSync_Func"), 1.0, c_timeGame);
    return true;
}
