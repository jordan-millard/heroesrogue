include "AffixTriggers"

// ============================================================
// Golden Gazlowe. Turret Engineer: turret and turret Deth Lazor hits on enemy Heroes open a 6 second takedown window
// (Gazlowe's own Deth Lazor too) and add the hit quest token; turret drops spend all Scrap. Takedowns in the window add
// Upgrades: Scrap regeneration, then turret Attack Speed, then at 100 leech and Health, then 1% damage per stack.
// Lazor Specialist: Deth Lazor hits on enemy Heroes add Calibration and open a 6 second window. Takedowns add
// Amplification: Deth Lazor length, then a Shield per hit, then at 100 a turret per hit, then 1% damage per stack.
// ============================================================

const fixed libAffx_GazloweTakedownWindow = 3.0;
const fixed libAffx_GazlowePastCapDamagePerStack = 0.01;
bool libAffx_GazloweStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_GazloweEngineerTime; // per enemy player, last Turret Engineer hit
int libAffx_GazloweEngineerAdded; // Turret Engineer: takedown stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_GazloweLazorTime; // per enemy player, last Lazor Specialist hit
int libAffx_GazloweLazorAdded; // Lazor Specialist: takedown stacks already applied to the catalog this game
int libAffx_GazloweSpeedApplied; // Turret Engineer: Upgrades stacks applied as turret Attack Speed
int libAffx_GazlowePowerApplied; // Turret Engineer: Upgrades stacks past 100 applied as damage
bool libAffx_GazloweHullOn; // Turret Engineer: 100 Upgrades stacks reached this game (leech and Health turned on)
fixed libAffx_GazloweRelicBonus; // Turret Engineer: range added to Superior Schematics' side shot search (largest Scrap range bonus)
int libAffx_GazloweLazorPowerApplied; // Lazor Specialist: Amplification stacks past 100 applied as damage

unit libAffx_GazloweHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_GazloweIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_GazloweStacks(string tokenId) {
    unit hero = libAffx_GazloweHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_GazloweQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_GazloweInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_GazloweTakedownWindow;
}
// GazloweGoldenUpgradesTokenCounter: stacks 1-40: 1% of the 3.94 second Scrap regeneration each; 41-80 turret Attack Speed, 100 leech and Health, then damage (libAffx_GazloweEngineerSync)
void libAffx_GazloweSyncEngineer () {
    unit hero = libAffx_GazloweHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "GazloweEngineerMarker")) {
        return;
    }
    stacks = libAffx_GazloweStacks("GazloweGoldenUpgradesTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_GazloweEngineerAdded) {
        libAffx_CatalogReferenceModify("Behavior,GazloweReduceReuseRecycleTraitScrapRegenerationCooldown,Duration", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_GazloweEngineerAdded) * -0.039375, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_GazloweEngineerAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 100)) * 0.0, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "RockItTurretWeaponDamage", "MultiplicativeModifierArray[GazloweEngineerLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "RockItTurretWeaponRelicSideDamage", "MultiplicativeModifierArray[GazloweEngineerLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "TinkerDethLazorFirinMahLazorzTalentDamage", "MultiplicativeModifierArray[GazloweEngineerLegacy].Modifier", libAffx_player, bonus);
}
// GazloweGoldenAmplificationTokenCounter: stacks 1-40: Deth Lazor 0.5% longer each; 41-80 a Shield per hit, 100 a turret per hit, then damage (libAffx_GazloweLazorOnHit, libAffx_GazloweLazorSync)
void libAffx_GazloweSyncLazor () {
    unit hero = libAffx_GazloweHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "GazloweLazorMarker")) {
        return;
    }
    stacks = libAffx_GazloweStacks("GazloweGoldenAmplificationTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_GazloweLazorAdded) {
        libAffx_CatalogReferenceModify("Effect,GazloweDethLazorSearch,AreaArray[0].RectangleHeight", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_GazloweLazorAdded) * 0.05, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,GazloweDethLazorSearch,ImpactLocation.ProjectionOffset.Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_GazloweLazorAdded) * -0.025, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,GazloweDethLazorBeamPersistent,InitialOffset.Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_GazloweLazorAdded) * -0.05, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,GazloweDethLazorWarningPersistent,InitialOffset.Y", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_GazloweLazorAdded) * -0.05, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_GazloweLazorAdded = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 100)) * 0.0, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "DethLazorCharged1Damage", "MultiplicativeModifierArray[GazloweLazorLegacy].Modifier", libAffx_player, bonus);
}
bool libAffx_GazloweSync_Func (bool testConds, bool runActions) {
    libAffx_GazloweSyncEngineer();
    libAffx_GazloweSyncLazor();
    return true;
}
// Lazor Specialist: Amplification stacks past 100 add 1% to all of Gazlowe's damage each
void libAffx_GazloweLazorSync () {
    unit hero = libAffx_GazloweHero();
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "GazloweLazorMarker")) {
        return;
    }
    power = MaxI(0, libAffx_GazloweStacks("GazloweGoldenAmplificationTokenCounter") - 100);
    if (power != libAffx_GazloweLazorPowerApplied) {
        libAffx_GazloweLazorPowerApplied = power;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "GazloweGoldenOverdrive", "Modification.DamageDealtFraction[Basic]", libAffx_player, 0.01 * IntToFixed(power));
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "GazloweGoldenOverdrive", "Modification.DamageDealtFraction[Ability]", libAffx_player, 0.01 * IntToFixed(power));
        UnitBehaviorRemove(hero, "GazloweGoldenOverdrive", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "GazloweGoldenOverdrive")) {
        UnitBehaviorAdd(hero, "GazloweGoldenOverdrive", hero, 1);
    }
}
// Lazor Specialist, Deth Lazor hit on an enemy Hero. Amplification stacks 41-80: the hit adds a Shield (no duration) of
// up to 5% of maximum Health, to a total of up to 20%, both growing with each stack. At 100: the hit drops a Rock-It!
// Turret at the Hero.
void libAffx_GazloweLazorOnHit (unit hero, unit victim) {
    int stacks = libAffx_GazloweStacks("GazloweGoldenAmplificationTokenCounter");
    int n = MaxI(0, MinI(stacks - 40, 40));
    fixed life;
    fixed current = 0.0;
    if (!UnitIsAlive(hero)) {
        return;
    }
    if (n > 0) {
        life = UnitGetPropertyFixed(hero, c_unitPropLifeMax, c_unitPropCurrent);
        if (UnitHasBehavior2(hero, "GazloweGoldenLazorShield")) {
            current = UnitBehaviorDamageModifyRemaining(hero, "GazloweGoldenLazorShield");
        }
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "GazloweGoldenLazorShield", "DamageResponse.ModifyLimit", libAffx_player, MinF(current + 0.00125 * IntToFixed(n) * life, 0.005 * IntToFixed(n) * life));
        UnitBehaviorAdd(hero, "GazloweGoldenLazorShield", hero, 1);
    }
    if (stacks >= 100) {
        UnitCreateEffectPoint(hero, "RockItTurretCreateUnit", UnitGetPosition(victim));
    }
}
// Turret Engineer: Upgrades stacks 41-80 give turrets 1% Attack Speed each; at 100 turrets leech 50% and have 50% more
// Health; each stack past 100 adds 1% to all damage (turrets and Gazlowe). Amounts are set in the catalog (new turrets get
// them on creation) and re-added to the existing turrets when they change.
void libAffx_GazloweEngineerSync () {
    unit hero = libAffx_GazloweHero();
    int stacks;
    int speed;
    int power;
    bool hull = false;
    bool tune = false;
    unitgroup turrets;
    unit turret;
    int i;
    if (hero == null || !UnitHasBehavior2(hero, "GazloweEngineerMarker")) {
        return;
    }
    stacks = libAffx_GazloweStacks("GazloweGoldenUpgradesTokenCounter");
    speed = MaxI(0, MinI(stacks - 40, 40));
    power = MaxI(0, stacks - 100);
    if (stacks >= 100 && !libAffx_GazloweHullOn) {
        libAffx_GazloweHullOn = true;
        hull = true;
        libAffx_CatalogReferenceModify("Effect,GazloweGoldenTurretHullApply,Chance", libAffx_player, "1", c_upgradeOperationSet);
        libAffx_CatalogReferenceModify("Effect,RockItTurretWeaponDamage,LeechFraction[Life]", libAffx_player, "0.5", c_upgradeOperationSet);
        libAffx_CatalogReferenceModify("Effect,RockItTurretWeaponRelicSideDamage,LeechFraction[Life]", libAffx_player, "0.5", c_upgradeOperationSet);
    }
    if (speed != libAffx_GazloweSpeedApplied || power != libAffx_GazlowePowerApplied) {
        libAffx_GazloweSpeedApplied = speed;
        libAffx_GazlowePowerApplied = power;
        tune = true;
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "GazloweGoldenTurretTuning", "Modification.AdditiveAttackSpeedFactor", libAffx_player, 0.01 * IntToFixed(speed));
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "GazloweGoldenTurretTuning", "Modification.DamageDealtFraction[Ability]", libAffx_player, 0.01 * IntToFixed(power));
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "GazloweGoldenOverdrive", "Modification.DamageDealtFraction[Basic]", libAffx_player, 0.01 * IntToFixed(power));
        CatalogFieldValueSetFixed(c_gameCatalogBehavior, "GazloweGoldenOverdrive", "Modification.DamageDealtFraction[Ability]", libAffx_player, 0.01 * IntToFixed(power));
        UnitBehaviorRemove(hero, "GazloweGoldenOverdrive", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "GazloweGoldenOverdrive")) {
        UnitBehaviorAdd(hero, "GazloweGoldenOverdrive", hero, 1);
    }
    if (!hull && !tune) {
        return;
    }
    turrets = UnitGroup("TinkerRockItTurret", libAffx_player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(turrets, c_unitCountAll); i > 0; i -= 1) {
        turret = UnitGroupUnitFromEnd(turrets, i);
        if (hull && UnitIsAlive(turret) && !UnitHasBehavior2(turret, "GazloweGoldenTurretHull")) {
            UnitBehaviorAdd(turret, "GazloweGoldenTurretHull", hero, 1);
        }
        if (tune && UnitIsAlive(turret)) {
            UnitBehaviorRemove(turret, "GazloweGoldenTurretTuning", 1);
            UnitBehaviorAdd(turret, "GazloweGoldenTurretTuning", hero, 1);
        }
    }
}
bool libAffx_GazloweEngineerTick_Func (bool testConds, bool runActions) {
    libAffx_GazloweEngineerSync();
    libAffx_GazloweLazorSync();
    return true;
}
// Turret Engineer: a Rock-It! Turret costs 6 Scrap and its drop spends all of Gazlowe's Scrap (the cost is paid first). The
// turret never loses Health over time and heals 1% per second; each Scrap spent past 6 adds 5% Attack Speed and range and
// 10% Health; with 12 or more it reveals enemies in its attack range. Turrets dropped by Lazor Specialist's quest also run
// this set, but only Turret Engineer has the marker.
// Turret Engineer: a turret attack damaged an enemy (any unit). Each Scrap spent past 12 on the turret slows by 1% per
// hit (up to 10% per hit, 50% in total, 1.5 seconds); each past 22 deals 0.2% of a Hero's maximum Health.
bool libAffx_GazloweEngineerTurretHit_Func (bool testConds, bool runActions) {
    unit hero = libAffx_GazloweHero();
    unit turret = EventUnitDamageSourceUnit();
    unit victim = EventUnit();
    int over;
    if (hero == null || turret == null || victim == null || EventUnitDamageSourcePlayer() != libAffx_player || !UnitIsAlive(victim) || !UnitHasBehavior2(hero, "GazloweEngineerMarker")) {
        return false;
    }
    if (UnitGetType(turret) != "TinkerRockItTurret") {
        return false;
    }
    // Overclock stacks are the Scrap spent past 6
    over = UnitBehaviorCount(turret, "GazloweGoldenTurretOverclock") - 6;
    if (over <= 0) {
        return false;
    }
    UnitBehaviorAdd(victim, "GazloweGoldenTurretSlow", turret, MinI(over, 10));
    if (over > 10 && libAffx_GazloweIsEnemyHero(victim)) {
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "GazloweGoldenTurretShredDamage", "VitalFractionMax[Life]", libAffx_player, 0.002 * IntToFixed(over - 10));
        UnitCreateEffectUnit(turret, "GazloweGoldenTurretShredDamage", victim);
    }
    return true;
}
bool libAffx_GazloweEngineerDrop_Func (bool testConds, bool runActions) {
    unit hero = libAffx_GazloweHero();
    unit turret = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    fixed scrap;
    int extra;
    int used;
    if (hero == null || turret == null || EventPlayerEffectUsedUnit(c_effectUnitCaster) != hero || !UnitHasBehavior2(hero, "GazloweEngineerMarker")) {
        return false;
    }
    scrap = UnitGetPropertyFixed(hero, c_unitPropEnergy, c_unitPropCurrent);
    extra = MaxI(0, FixedToInt(scrap));
    UnitSetPropertyFixed(hero, c_unitPropEnergy, scrap - IntToFixed(extra));
    used = FixedToInt(StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, "TinkerRockItTurret", "Cost[0].Vital[Energy]", libAffx_player))) + extra;
    UnitBehaviorAdd(turret, "GazloweGoldenTurretFrame", hero, 1);
    if (used > 6) {
        UnitBehaviorAdd(turret, "GazloweGoldenTurretOverclock", hero, used - 6);
        UnitSetPropertyFixed(turret, c_unitPropLifePercent, 100.0);
        // Superior Schematics' side shots search a fixed radius around the turret: grow it with the largest range bonus
        if (0.3 * IntToFixed(used - 6) > libAffx_GazloweRelicBonus) {
            libAffx_CatalogReferenceModify("Effect,RockItTurretRelicSearch,AreaArray[0].Radius", libAffx_player, FixedToString(0.3 * IntToFixed(used - 6) - libAffx_GazloweRelicBonus, c_fixedPrecisionAny), c_upgradeOperationAdd);
            libAffx_GazloweRelicBonus = 0.3 * IntToFixed(used - 6);
        }
    }
    if (used >= 12) {
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "GazloweGoldenTurretSentryReveal", "RevealRadius", libAffx_player, 6.0 + 0.3 * IntToFixed(used - 6));
        UnitBehaviorAdd(turret, "GazloweGoldenTurretSentry", hero, 1);
    }
    return true;
}
// Turret Engineer: hits counted toward the next batch of 10 tokens (one quest ding per batch)
int libAffx_GazloweEngineerHits;
// Turret Engineer hit on an enemy Hero: takedown window, GazloweGoldenTargetingTokenCounter, the heal, and on-hit boons
bool libAffx_GazloweEngineerHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_GazloweHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_GazloweIsEnemyHero(victim) || !UnitHasBehavior2(hero, "GazloweEngineerMarker")) {
        return false;
    }
    libAffx_GazloweEngineerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libAffx_GazloweEngineerHits += 1;
    if (libAffx_GazloweEngineerHits >= 10) {
        libAffx_GazloweEngineerHits = 0;
        libGame_gf_ModifyTokenCount(10, "GazloweGoldenTargetingTokenCounter", hero);
    }
    return true;
}
// Turret Engineer: these effects on an enemy Hero only refresh the takedown window (no quest token, heal or on-hit boons)
bool libAffx_GazloweEngineerWindow_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_GazloweHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_GazloweIsEnemyHero(victim) || !UnitHasBehavior2(hero, "GazloweEngineerMarker")) {
        return false;
    }
    libAffx_GazloweEngineerTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}
// Lazor Specialist hit on an enemy Hero: takedown window, GazloweGoldenCalibrationTokenCounter, the heal, and on-hit boons
bool libAffx_GazloweLazorHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_GazloweHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_GazloweIsEnemyHero(victim) || !UnitHasBehavior2(hero, "GazloweLazorMarker")) {
        return false;
    }
    libAffx_GazloweLazorTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "GazloweGoldenCalibrationTokenCounter", hero);
    libAffx_GazloweLazorOnHit(hero, victim);
    return true;
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_GazloweTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_GazloweHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    if (UnitHasBehavior2(hero, "GazloweEngineerMarker") && libAffx_GazloweEngineerTime[killedPlayer] > 0.0 && now - libAffx_GazloweEngineerTime[killedPlayer] <= 6.0) {
        libAffx_GazloweEngineerTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "GazloweGoldenUpgradesTokenCounter", hero);
        libAffx_GazloweSyncEngineer();
        libAffx_GazloweQuestDing();
        libAffx_GazloweEngineerSync();
    }
    if (UnitHasBehavior2(hero, "GazloweLazorMarker") && libAffx_GazloweLazorTime[killedPlayer] > 0.0 && now - libAffx_GazloweLazorTime[killedPlayer] <= 6.0) {
        libAffx_GazloweLazorTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "GazloweGoldenAmplificationTokenCounter", hero);
        libAffx_GazloweSyncLazor();
        libAffx_GazloweQuestDing();
        libAffx_GazloweLazorSync();
    }
    return true;
}
bool libAffx_GazloweStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_GazloweStarted) {
        return true;
    }
    libAffx_GazloweStarted = true;
    trig = TriggerCreate("libAffx_GazloweEngineerHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RockItTurretWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RockItTurretWeaponRelicSideDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "TinkerDethLazorFirinMahLazorzTalentDamage");
    trig = TriggerCreate("libAffx_GazloweEngineerWindow_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DethLazorCharged1Damage");
    trig = TriggerCreate("libAffx_GazloweLazorHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "DethLazorCharged1Damage");
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_GazloweEngineerTick_Func"), 1.0, c_timeGame);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_GazloweEngineerDrop_Func"), libAffx_player, "GazloweRockItTurretCreateUnitSet");
    trig = TriggerCreate("libAffx_GazloweEngineerTurretHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RockItTurretWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RockItTurretWeaponRelicSideDamage");
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_GazloweSync_Func"), 1.0, c_timeGame);
    return true;
}
