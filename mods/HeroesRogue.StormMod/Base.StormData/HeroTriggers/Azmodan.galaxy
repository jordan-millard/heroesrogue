    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanAllShallBurnDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanAllShallBurnFinalExplosionDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanAllShallBurnMasterOfDestructionTalentDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGoldenForkDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGlobeOfAnnihilationDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGlobeOfAnnihilationTideOfSinTalentDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGlobeOfAnnihilationTotalAnnihilationTalentDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGoldenSplinterDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanSummonDemonWarriorWeaponDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanSummonDemonWarriorPeriodicDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonicInvasionDemonGruntWeaponDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonicInvasionExplodeDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonicInvasionImpactDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonLieutenantDemonicSmiteDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonLieutenantWeaponDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanHeroWeaponDamage", "MultiplicativeModifierArray[AzmodanSinLegacy].Modifier", libAffx_player, bonus);
