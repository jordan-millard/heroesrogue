include "AffixTriggers"

// ============================================================
// Golden Azmodan. Each ability starter: hits on enemy Heroes open a takedown window and add the hit quest token;
// takedowns in the window add the takedown token: stacks 1-40, 41-80 and 81-100 each improve the starter, stack 100
// unlocks the Globe echo or the beam fork, then 2.5% to all of Azmodan's damage per stack. General of the Burning
// Hells has only the takedown quest (1% Demon Warrior damage and Health per stack up to 80, then 2.5% all damage).
// ============================================================

const fixed libAffx_AzmodanTakedownWindow = 3.0;
const fixed libAffx_AzmodanPastCapDamagePerStack = 0.01;
bool libAffx_AzmodanStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_AzmodanGlobeTime; // per enemy player, last Lord of Annihilation hit
int libAffx_AzmodanGlobeAdded; // Lord of Annihilation: takedown stacks already applied to the catalog this game
int libAffx_AzmodanGlobeAdded2; // Lord of Annihilation: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_AzmodanGlobeAdded3; // Lord of Annihilation: takedown quest stage 3 stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_AzmodanSinTime; // per enemy player, last Lord of Sin hit
int libAffx_AzmodanSinAdded; // Lord of Sin: takedown stacks already applied to the catalog this game
int libAffx_AzmodanSinAdded2; // Lord of Sin: takedown quest stage 2 stacks already applied to the catalog this game
int libAffx_AzmodanSinAdded3; // Lord of Sin: takedown quest stage 3 stacks already applied to the catalog this game
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_AzmodanGenTime; // per enemy player, last General of the Burning Hells hit
int libAffx_AzmodanGenAdded; // General of the Burning Hells: takedown stacks already applied to the catalog this game

unit libAffx_AzmodanHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_AzmodanIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
int libAffx_AzmodanStacks(string tokenId) {
    unit hero = libAffx_AzmodanHero();
    if (hero == null) {
        return 0;
    }
    return FixedToInt(UnitGetTokenCount(hero, tokenId));
}
void libAffx_AzmodanQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
bool libAffx_AzmodanInWindow (fixed hitTime, fixed now) {
    return hitTime > 0.0 && now - hitTime <= libAffx_AzmodanTakedownWindow;
}
// AzmodanGoldenDestructionTokenCounter: stacks 1-40: 1% of the 10 second recharge each; 41-80: 1% shorter cast and 0.5% larger blast each; 81-100: 1% range each; then 2.5% all damage each
void libAffx_AzmodanSyncGlobe () {
    unit hero = libAffx_AzmodanHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "AzmodanGlobeMarker")) {
        return;
    }
    stacks = libAffx_AzmodanStacks("AzmodanGoldenDestructionTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_AzmodanGlobeAdded) {
        libAffx_CatalogReferenceModify("Abil,AzmodanGlobeOfAnnihilation,Cost.Charge.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded) * -0.1, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_AzmodanGlobeAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 1% of the 0.5625 second cast shorter and 0.5% (0.02) larger blast each
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_AzmodanGlobeAdded2) {
        libAffx_CatalogReferenceModify("Abil,AzmodanGlobeOfAnnihilation,CastIntroTime", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded2) * -0.005625, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,AzmodanGlobeOfAnnihilationSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded2) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,AzmodanGlobeOfAnnihilationArtOfChaosTalent2TargetSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded2) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Effect,AzmodanGlobeOfAnnihilationArtOfChaosTalent3TargetSearch,AreaArray[0].Radius", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded2) * 0.02, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Actor,AzmodanGlobeOfAnnihilationWarningModel,Scale", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded2) * 0.005, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Actor,AzmodanGlobeOfAnnihilationTideOfSinWarningModel,Scale", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded2) * 0.005, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_AzmodanGlobeAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): 1% of the 30 range each
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_AzmodanGlobeAdded3) {
        libAffx_CatalogReferenceModify("Abil,AzmodanGlobeOfAnnihilation,Range", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanGlobeAdded3) * 0.3, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_AzmodanGlobeAdded3 = wanted;
    }
    bonus = FixedToString(IntToFixed(MaxI(0, stacks - 100)) * 0.025, c_fixedPrecisionAny);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGlobeOfAnnihilationDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGlobeOfAnnihilationTideOfSinTalentDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGlobeOfAnnihilationTotalAnnihilationTalentDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGoldenSplinterDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanAllShallBurnDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanAllShallBurnFinalExplosionDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanAllShallBurnMasterOfDestructionTalentDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanGoldenForkDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanSummonDemonWarriorWeaponDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanSummonDemonWarriorPeriodicDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonicInvasionDemonGruntWeaponDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonicInvasionExplodeDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonicInvasionImpactDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonLieutenantDemonicSmiteDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanDemonLieutenantWeaponDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanHeroWeaponDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanTideOfSinBlackPoolTalentDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
    CatalogFieldValueSet(c_gameCatalogEffect, "AzmodanTrampleDamage", "MultiplicativeModifierArray[AzmodanGlobeLegacy].Modifier", libAffx_player, bonus);
}
// AzmodanGoldenSinTokenCounter: stacks 1-40: 1% of the 6 second recharge each; 41-80: 1% range and stretch each; 81-100: 1% Movement Speed while channeling each; then 2.5% all damage each
void libAffx_AzmodanSyncSin () {
    unit hero = libAffx_AzmodanHero();
    int stacks;
    int wanted;
    string bonus;
    if (hero == null || !UnitHasBehavior2(hero, "AzmodanSinMarker")) {
        return;
    }
    stacks = libAffx_AzmodanStacks("AzmodanGoldenSinTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_AzmodanSinAdded) {
        libAffx_CatalogReferenceModify("Abil,AzmodanAllShallBurn,Cost.Charge.TimeUse", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanSinAdded) * -0.06, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_AzmodanSinAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 1% of the 7.5 cast range each, also on the stretch (leash) and its range circle
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_AzmodanSinAdded2) {
        libAffx_CatalogReferenceModify("Abil,AzmodanAllShallBurn,Range", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanSinAdded2) * 0.075, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Validator,AzmodanAllShallBurnRangeValidator,Range", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanSinAdded2) * 0.075, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Actor,AzmodanAllShallBurnActiveRange,Range", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanSinAdded2) * 0.075, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_AzmodanSinAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): 1% Movement Speed while channeling each (the channel slows by 30%)
    wanted = MaxI(0, MinI(stacks - 80, 20));
