        libAffx_CatalogReferenceModify("Behavior,AzmodanAllShallBurnChannel,Modification.UnifiedMoveSpeedFactor", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_AzmodanSinAdded3) * 0.01, c_fixedPrecisionAny), c_upgradeOperationAdd);
