bool libAffx_RaynorSync_Func (bool testConds, bool runActions) {
    libAffx_RaynorSyncRound();
    libAffx_RaynorSyncPepper();
    libAffx_RaynorSyncRaider();
    return true;
}
// Penetrator: scales one of Penetrating Round's offsets (a "x,y,z" vector) forward by a factor
void libAffx_RaynorRoundOffset (string effect, string field, fixed scale) {
    string offset = StringReplaceWord(CatalogFieldValueGet(c_gameCatalogEffect, effect, field, libAffx_player), ",", " ", c_stringReplaceAll, c_stringCase);
    fixed y = StringToFixed(StringWord(offset, 2)) * scale;
    CatalogFieldValueSet(c_gameCatalogEffect, effect, field, libAffx_player, StringWord(offset, 1) + "," + FixedToString(y, 3) + "," + StringWord(offset, 3));
}
// Penetrator: 10% more range (once), 30% more width plus 1% per Breach stack 41-80, twice as wide with The Big One, and
// the round flies 1% faster per stack 41-80 (the sweep only runs in 1/16 second steps, so from 20 of those stacks it
// skips one of its three)
void libAffx_RaynorRoundSync () {
    unit hero = libAffx_RaynorHero();
    int speed;
    int shape;
    int i;
    fixed width;
    fixed flight;
    if (hero == null || !UnitHasBehavior2(hero, "RaynorPenetratorMarker")) {
        return;
    }
    if (!libAffx_RaynorRoundRangeSet) {
        libAffx_RaynorRoundRangeSet = true;
        for (i = 0; i <= 9; i += 1) {
            libAffx_RaynorRoundOffset("RaynorPenetratingRoundCreateSearchPersistent", "PeriodicOffsetArray[" + IntToString(i) + "]", 1.1);
        }
        libAffx_RaynorRoundOffset("RaynorPenetratingRoundCreatePersistent", "PeriodicOffsetArray[0]", 1.1);
    }
    speed = MaxI(0, MinI(libAffx_RaynorStacks("RaynorGoldenBreachTokenCounter") - 40, 40));
    shape = speed * 2;
    if (UnitHasBehavior2(hero, "RaynorGoldenBigOne")) {
        shape += 1;
    }
    if (shape == libAffx_RaynorRoundShape) {
        return;
    }
    libAffx_RaynorRoundShape = shape;
    width = 0.8 * (1.3 + 0.01 * IntToFixed(speed));
    if (UnitHasBehavior2(hero, "RaynorGoldenBigOne")) {
        width = width * 2.0;
    }
    CatalogFieldValueSetFixed(c_gameCatalogEffect, "RaynorPenetratingRoundMissileScan", "AreaArray[0].RectangleWidth", libAffx_player, width);
    flight = 40.0 * (1.0 + 0.01 * IntToFixed(speed));
    CatalogFieldValueSetFixed(c_gameCatalogMover, "RaynorPenetratingRoundMissile", "MotionPhases[0].Speed", libAffx_player, flight);
    CatalogFieldValueSetFixed(c_gameCatalogMover, "RaynorPenetratingRoundMissile", "MotionPhases[0].MaxSpeed", libAffx_player, flight);
    CatalogFieldValueSetFixed(c_gameCatalogMover, "RaynorPenetratingRoundMissile", "MotionPhases[1].Speed", libAffx_player, flight);
    CatalogFieldValueSetFixed(c_gameCatalogMover, "RaynorPenetratingRoundMissile", "MotionPhases[1].MaxSpeed", libAffx_player, flight);
    if (speed >= 20) {
        CatalogFieldValueSet(c_gameCatalogEffect, "RaynorPenetratingRoundCreateSearchPersistent", "PeriodicPeriodArray[7]", libAffx_player, "0");
    } else {
        CatalogFieldValueSet(c_gameCatalogEffect, "RaynorPenetratingRoundCreateSearchPersistent", "PeriodicPeriodArray[7]", libAffx_player, "0.0625");
    }
}
// the nearest visible enemy within range of a unit, a Hero if there is one
unit libAffx_RaynorNearestFoe (unit from, fixed range) {
    unitgroup foes = UnitGroupAlliance(libAffx_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(from), range), UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterItem) | (1 << c_targetFilterStructure), (1 << (c_targetFilterStasis - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
    unit foe;
    unit best;
    unit bestHero;
    fixed dist;
    fixed bestDist = 999.0;
    fixed bestHeroDist = 999.0;
    int i = 1;
    while (i <= UnitGroupCount(foes, c_unitCountAll)) {
        foe = UnitGroupUnit(foes, i);
        if (UnitIsAlive(foe)) {
            dist = DistanceBetweenPoints(UnitGetPosition(from), UnitGetPosition(foe));
            if (dist < bestDist) {
                best = foe;
                bestDist = dist;
            }
            if (UnitTypeTestAttribute(UnitGetType(foe), c_unitAttributeHeroic) && dist < bestHeroDist) {
                bestHero = foe;
                bestHeroDist = dist;
            }
        }
        i += 1;
    }
    if (bestHero != null) {
        return bestHero;
    }
    return best;
}
// Rockets Out (Epic): each Banshee fires a volley (a full two-missile attack) at the nearest enemy, a Hero if possible
void libAffx_RaynorRocketsOut () {
    int i;
    unit banshee;
    unit foe;
    for (i = 1; i <= 3; i += 1) {
        banshee = libAffx_RaynorBanshee[i];
        if (banshee != null && UnitIsAlive(banshee) && !UnitHasBehavior2(banshee, "RaynorRaynorsBansheeAscend")) {
            foe = libAffx_RaynorNearestFoe(banshee, 9.0);
            if (foe != null) {
                UnitCreateEffectUnit(banshee, "RaynorBansheeLaunchMissileSet", foe);
            }
        }
    }
}
// Penetrating Round cast: Rockets Out; Breach at 100 also fires a round 20 degrees to each side (its own event is
// skipped by time); The Big One is used up once the round has swept
bool libAffx_RaynorRoundCast_Func (bool testConds, bool runActions) {
    unit hero = libAffx_RaynorHero();
    point target = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    point origin;
    fixed angle;
    if (hero == null || target == null || GameGetMissionTime() == libAffx_RaynorLastFan) {
        return false;
    }
    if (UnitHasBehavior2(hero, "RaynorRocketsOutMarker")) {
        libAffx_RaynorRocketsOut();
    }
    if (UnitHasBehavior2(hero, "RaynorPenetratorMarker") && libAffx_RaynorStacks("RaynorGoldenBreachTokenCounter") >= 100) {
        libAffx_RaynorLastFan = GameGetMissionTime();
        origin = UnitGetPosition(hero);
        angle = AngleBetweenPoints(origin, target);
        UnitCreateEffectPoint(hero, "RaynorPenetratingRoundCreateSet", PointWithOffsetPolar(origin, 10.0, angle + 20.0));
        UnitCreateEffectPoint(hero, "RaynorPenetratingRoundCreateSet", PointWithOffsetPolar(origin, 10.0, angle - 20.0));
    }
    if (UnitHasBehavior2(hero, "RaynorGoldenBigOne")) {
        Wait(0.5, c_timeGame);
        UnitBehaviorRemove(hero, "RaynorGoldenBigOne", 1);
        libAffx_RaynorBigOneAt = GameGetMissionTime() + 20.0;
        libAffx_RaynorRoundSync();
    }
    return true;
}
// The Big One (Legendary): ready again 20 seconds after it was used
void libAffx_RaynorBigOneSync () {
    unit hero = libAffx_RaynorHero();
    if (hero == null || !UnitHasBehavior2(hero, "RaynorBigOneMarker") || UnitHasBehavior2(hero, "RaynorGoldenBigOne") || GameGetMissionTime() < libAffx_RaynorBigOneAt) {
        return;
    }
    UnitBehaviorAdd(hero, "RaynorGoldenBigOne", hero, 1);
    libAffx_RaynorQuestDing();
    libAffx_RaynorRoundSync();
}
// Sergeant Pepper: the Pepper buff (re-added when Sharpshooter changes it), Pepper every other attack at 100, the base
// Gambit replaced by the carried one, and this map's 4 Gambit stacks
void libAffx_RaynorPepperSync () {
    unit hero = libAffx_RaynorHero();
    int stacks;
    int loan;
    if (hero == null || !UnitHasBehavior2(hero, "RaynorPepperMarker")) {
        return;
    }
    libAffx_RaynorIsPepper = true;
    libAffx_RaynorSyncPepper();
    stacks = libAffx_RaynorStacks("RaynorGoldenSharpshooterTokenCounter");
    if (stacks != libAffx_RaynorPepperApplied) {
        libAffx_RaynorPepperApplied = stacks;
        UnitBehaviorRemove(hero, "RaynorGoldenPepperDrill", 1);
        if (stacks >= 100) {
            CatalogFieldValueSet(c_gameCatalogEffect, "RaynorGoldenPepperEveryOther", "Chance", libAffx_player, "1");
        } else {
            CatalogFieldValueSet(c_gameCatalogEffect, "RaynorGoldenPepperEveryOther", "Chance", libAffx_player, "0");
        }
    }
    if (!UnitHasBehavior2(hero, "RaynorGoldenPepperDrill")) {
        UnitBehaviorAdd(hero, "RaynorGoldenPepperDrill", hero, 1);
    }
    loan = FixedToInt(UnitGetTokenCount(hero, "RaynorGiveEmSomePepperVeteranMarksmanLoanToken"));
    if (loan > 0) {
        libGame_gf_ModifyTokenCount(-loan, "RaynorGiveEmSomePepperVeteranMarksmanLoanToken", hero);
    }
    if (!libAffx_RaynorGambitGranted) {
        libAffx_RaynorGambitGranted = true;
        libGame_gf_ModifyTokenCount(4, "RaynorGoldenGambitTokenCounter", hero);
    }
}
// Sergeant Pepper: each death loses one of this map's 4 Gambit stacks (the carried ones can't be lost)
bool libAffx_RaynorGambitDeath_Func (bool testConds, bool runActions) {
    unit hero = libAffx_RaynorHero();
    if (hero == null || libGame_gf_HeroKilledUnit() != hero || !libAffx_RaynorIsPepper || !libAffx_RaynorGambitGranted) {
        return false;
    }
    if (libAffx_RaynorGambitLost < 4) {
        libAffx_RaynorGambitLost += 1;
        libGame_gf_ModifyTokenCount(-1, "RaynorGoldenGambitTokenCounter", hero);
    }
    return true;
}
// Raider Captain: what Raynor is attacking (his attack order's target, or the last unit his Basic Attacks hit in the last
// 2 seconds), for the Banshees to attack too
unit libAffx_RaynorAttackTarget () {
    unit hero = libAffx_RaynorHero();
    unit target;
    if (UnitOrderCount(hero) > 0 && OrderGetAbilityCommand(UnitOrder(hero, 0)) == AbilityCommand("attack", 0)) {
        target = OrderGetTargetUnit(UnitOrder(hero, 0));
        if (target != null && UnitIsAlive(target) && UnitGetOwner(target) != libAffx_player) {
            return target;
        }
    }
    target = libAffx_RaynorLastAttacked;
    if (target != null && UnitIsAlive(target) && GameGetMissionTime() - libAffx_RaynorLastAttackedAt <= 2.0) {
        return target;
    }
    return null;
}
// Shared Rush (Uncommon): Adrenaline Rush on Raynor heals each live Banshee too
bool libAffx_RaynorSharedRush_Func (bool testConds, bool runActions) {
    unit hero = libAffx_RaynorHero();
    unit banshee;
    int i;
    if (hero == null || EventUnit() != hero || !UnitHasBehavior2(hero, "RaynorSharedRushMarker")) {
        return false;
    }
    for (i = 1; i <= 3; i += 1) {
        banshee = libAffx_RaynorBanshee[i];
        if (banshee != null && UnitIsAlive(banshee)) {
            UnitBehaviorAdd(banshee, "RaynorGoldenBansheeRush", hero, 1);
        }
    }
    return true;
}
// Raider Captain: sets one field of the Banshees' Boons buff, for Raynor
void libAffx_RaynorBoonSet (string field, fixed value) {
    CatalogFieldValueSet(c_gameCatalogBehavior, "RaynorGoldenBansheeBoons", field, libAffx_player, FixedToString(value, 4));
}
// Raider Captain: one of a general boon behavior's fields, for Raynor
fixed libAffx_RaynorBoonField (string b, string field) {
    return CatalogFieldValueGetAsFixed(c_gameCatalogBehavior, b, field, libAffx_player);
}
// Raider Captain: half of Raynor's general boon stats (from the boon behaviors he has right now) go into the Banshees'
// Boons buff; true when they changed (the buff is then re-added to the live Banshees)
bool libAffx_RaynorBansheeBoons () {
    unit hero = libAffx_RaynorHero();
    string b;
    string key;
    string[7] armorSet;
    string[6] attribute;
    fixed[7] armorBasic;
    fixed[7] armorAbility;
    fixed[6] attributeBonus;
    fixed k;
    fixed speed;
    fixed attackSpeed;
    fixed damage;
    fixed scaled;
    fixed leech;
    fixed lifeFraction;
    fixed life;
    fixed regen;
    fixed regenMultiplier;
    fixed healTaken;
    fixed range;
    int i;
    int j;
    armorSet[1] = "Hero";
    armorSet[2] = "Merc";
    armorSet[3] = "Monster";
    armorSet[4] = "Summon";
    armorSet[5] = "Structure";
    armorSet[6] = "Minion";
    attribute[1] = "Structure";
    attribute[2] = "Minion";
    attribute[3] = "Merc";
    attribute[4] = "Monster";
    attribute[5] = "Summon";
    for (i = 1; i <= 38; i += 1) {
        b = libAffx_RaynorBoonBehaviors[i];
        if (!UnitHasBehavior2(hero, b)) {
            continue;
        }
        k = IntToFixed(UnitBehaviorCount(hero, b)) * 0.5;
        // Movement Speed bonuses don't stack (the highest wins), so only the best one counts
        speed = MaxF(speed, libAffx_RaynorBoonField(b, "Modification.UnifiedMoveSpeedFactor") * 0.5);
        attackSpeed += k * libAffx_RaynorBoonField(b, "Modification.AdditiveAttackSpeedFactor");
        // Banshee attacks are Ability damage: a boon's Basic or Ability bonus counts, whichever is bigger
        damage += k * MaxF(libAffx_RaynorBoonField(b, "Modification.DamageDealtFraction[Basic]"), libAffx_RaynorBoonField(b, "Modification.DamageDealtFraction[Ability]"));
        scaled += k * MaxF(libAffx_RaynorBoonField(b, "Modification.DamageDealtScaled[Basic]"), libAffx_RaynorBoonField(b, "Modification.DamageDealtScaled[Ability]"));
        leech += k * MaxF(libAffx_RaynorBoonField(b, "Modification.VitalDamageLeechArray[Life].KindArray[Basic]"), libAffx_RaynorBoonField(b, "Modification.VitalDamageLeechArray[Life].KindArray[Ability]"));
        lifeFraction += k * libAffx_RaynorBoonField(b, "Modification.VitalMaxFractionArray[Life]");
        life += k * libAffx_RaynorBoonField(b, "Modification.VitalMaxArray[Life]");
        regen += k * libAffx_RaynorBoonField(b, "Modification.VitalRegenArray[Life]");
        regenMultiplier += k * libAffx_RaynorBoonField(b, "Modification.VitalRegenMultiplier[Life]");
        healTaken += k * libAffx_RaynorBoonField(b, "Modification.HealTakenAdditiveMultiplier[Life]");
        range += k * libAffx_RaynorBoonField(b, "Modification.WeaponRange");
        for (j = 1; j <= 5; j += 1) {
            attributeBonus[j] += k * libAffx_RaynorBoonField(b, "Modification.DamageDealtAttributeMultiplier[" + attribute[j] + "]");
        }
        for (j = 1; j <= 6; j += 1) {
            armorBasic[j] += k * libAffx_RaynorBoonField(b, "ArmorModification.ArmorSet[" + armorSet[j] + "].ArmorMitigationTable[Basic]");
            armorAbility[j] += k * libAffx_RaynorBoonField(b, "ArmorModification.ArmorSet[" + armorSet[j] + "].ArmorMitigationTable[Ability]");
        }
    }
    key = FixedToString(speed, 4) + " " + FixedToString(attackSpeed, 4) + " " + FixedToString(damage, 4) + " " + FixedToString(scaled, 4) + " " + FixedToString(leech, 4) + " " + FixedToString(lifeFraction, 4) + " " + FixedToString(life, 4) + " " + FixedToString(regen, 4) + " " + FixedToString(regenMultiplier, 4) + " " + FixedToString(healTaken, 4) + " " + FixedToString(range, 4);
    for (j = 1; j <= 5; j += 1) {
        key = key + " " + FixedToString(attributeBonus[j], 4);
    }
    for (j = 1; j <= 6; j += 1) {
        key = key + " " + FixedToString(armorBasic[j], 4) + " " + FixedToString(armorAbility[j], 4);
    }
    if (key == libAffx_RaynorBoonKey) {
        return false;
    }
    libAffx_RaynorBoonKey = key;
    libAffx_RaynorBoonSet("Modification.MoveSpeedMultiplier", 1.0 + speed);
    libAffx_RaynorBoonSet("Modification.AdditiveAttackSpeedFactor", attackSpeed);
    libAffx_RaynorBoonSet("Modification.DamageDealtFraction[Ability]", damage);
    libAffx_RaynorBoonSet("Modification.DamageDealtScaled[Ability]", scaled);
    libAffx_RaynorBoonSet("Modification.VitalDamageLeechArray[Life].KindArray[Ability]", leech);
    libAffx_RaynorBoonSet("Modification.VitalMaxFractionArray[Life]", lifeFraction);
    libAffx_RaynorBoonSet("Modification.VitalMaxArray[Life]", life);
    libAffx_RaynorBoonSet("Modification.VitalRegenArray[Life]", regen);
    libAffx_RaynorBoonSet("Modification.VitalRegenMultiplier[Life]", regenMultiplier);
    libAffx_RaynorBoonSet("Modification.HealTakenAdditiveMultiplier[Life]", healTaken);
    libAffx_RaynorBoonSet("Modification.WeaponRange", range);
    for (j = 1; j <= 5; j += 1) {
        libAffx_RaynorBoonSet("Modification.DamageDealtAttributeMultiplier[" + attribute[j] + "]", attributeBonus[j]);
    }
    for (j = 1; j <= 6; j += 1) {
        libAffx_RaynorBoonSet("ArmorModification.ArmorSet[" + armorSet[j] + "].ArmorMitigationTable[Basic]", armorBasic[j]);
        libAffx_RaynorBoonSet("ArmorModification.ArmorSet[" + armorSet[j] + "].ArmorMitigationTable[Ability]", armorAbility[j]);
    }
    return true;
}
// Raider Captain: one of the Banshee damage effect's modifiers (by its key)
fixed libAffx_RaynorRaiderModifier (string key) {
    return StringToFixed(CatalogReferenceGet("Effect,RaynorRaynorsRaidersDamage,MultiplicativeModifierArray[" + key + "].Modifier", libAffx_player));
}
// Raider Captain: the last unit Raynor's Basic Attacks hit
bool libAffx_RaynorAttackTrack_Func (bool testConds, bool runActions) {
    unit hero = libAffx_RaynorHero();
    if (hero == null || EventUnitDamageSourceUnit() != hero || !UnitHasBehavior2(hero, "RaynorRaiderMarker")) {
        return false;
    }
    libAffx_RaynorLastAttacked = EventUnit();
    libAffx_RaynorLastAttackedAt = GameGetMissionTime();
    return true;
}
// Raider Captain: 2 Banshees escort Raynor (3 at 100 Squadron); each one returns a while after it dies (the respawn
// behavior's Duration) and while Raynor is alive. They copy his attacks through the Raiders unit tracker.
bool libAffx_RaynorBanshees_Func (bool testConds, bool runActions) {
    unit hero = libAffx_RaynorHero();
    unit banshee;
    unit target;
    fixed base;
    fixed payroll;
    fixed inspired;
    int count = 2;
    int i;
    int speed;
    fixed now = GameGetMissionTime();
    fixed back;
    if (hero == null || !UnitHasBehavior2(hero, "RaynorRaiderMarker")) {
        return false;
    }
    if (libAffx_RaynorStacks("RaynorGoldenSquadronTokenCounter") >= 100) {
        count = 3;
    }
    // An effect's damage modifiers add up rather than multiply, so two are kept by script as true multipliers: Raider
    // Payroll (its stacks are in a key that never counts) multiplies the other bonuses through the Common key, and
    // Raynor's Inspire attack speed (which reaches the Banshees too while it lasts) doubles the total through the Inspired key
    base = 1.0 + libAffx_RaynorRaiderModifier("RaynorRaiderPower") + libAffx_RaynorRaiderModifier("RaynorRaiderLegacy") + UnitGetTokenCount(hero, "RaynorGoldenAirSupportTokenCounter") * 0.002;
    payroll = MaxF(0.0, base) * libAffx_RaynorRaiderModifier("RaynorRaiderPayroll");
    inspired = MaxF(0.0, base) + payroll;
    if (inspired != libAffx_RaynorInspiredModifier || payroll != libAffx_RaynorPayrollModifier) {
        libAffx_RaynorInspiredModifier = inspired;
        libAffx_RaynorPayrollModifier = payroll;
        libAffx_CatalogReferenceSet("Effect,RaynorRaynorsRaidersDamage,MultiplicativeModifierArray[RaynorRaiderCommon].Modifier", libAffx_player, FixedToString(payroll, 4));
        libAffx_CatalogReferenceSet("Effect,RaynorRaynorsRaidersDamage,MultiplicativeModifierArray[RaynorGoldenInspired].Modifier", libAffx_player, FixedToString(inspired, 4));
    }
    for (i = 1; i <= 3; i += 1) {
        banshee = libAffx_RaynorBanshee[i];
        if (banshee != null && UnitIsAlive(banshee) && UnitHasBehavior2(hero, "RaynorInspireAttackSpeedSelf")) {
            if (UnitHasBehavior2(banshee, "RaynorGoldenBansheeInspired")) {
                UnitBehaviorSetDurationRemaining(banshee, "RaynorGoldenBansheeInspired", 0.5);
            } else {
                UnitBehaviorAdd(banshee, "RaynorGoldenBansheeInspired", banshee, 1);
            }
        }
    }
    // half of Raynor's general boon stats, recomputed every second
    if (now >= libAffx_RaynorBoonsAt) {
        libAffx_RaynorBoonsAt = now + 1.0;
        if (libAffx_RaynorBansheeBoons()) {
            for (i = 1; i <= 3; i += 1) {
                banshee = libAffx_RaynorBanshee[i];
                if (banshee != null && UnitIsAlive(banshee)) {
                    UnitBehaviorRemove(banshee, "RaynorGoldenBansheeBoons", 1);
                    UnitBehaviorAdd(banshee, "RaynorGoldenBansheeBoons", banshee, 1);
                }
            }
        }
    }
    // every live Banshee keeps its Armor buff (re-added if anything removed it), attacks what Raynor attacks (if it
    // isn't already), and flies back to him when it has nothing to do and has drifted away
    target = libAffx_RaynorAttackTarget();
    for (i = 1; i <= 3; i += 1) {
        banshee = libAffx_RaynorBanshee[i];
        if (banshee == null || !UnitIsAlive(banshee)) {
            continue;
        }
        if (!UnitHasBehavior2(banshee, "RaynorGoldenBansheeArmor")) {
            UnitBehaviorAdd(banshee, "RaynorGoldenBansheeArmor", banshee, 1);
        }
        if (!UnitHasBehavior2(banshee, "RaynorGoldenBansheeBoons")) {
            UnitBehaviorAdd(banshee, "RaynorGoldenBansheeBoons", banshee, 1);
        }
        if (target != null && DistanceBetweenPoints(UnitGetPosition(banshee), UnitGetPosition(target)) <= 14.0) {
            if (UnitOrderCount(banshee) == 0 || OrderGetAbilityCommand(UnitOrder(banshee, 0)) != AbilityCommand("attack", 0) || OrderGetTargetUnit(UnitOrder(banshee, 0)) != target) {
                UnitIssueOrder(banshee, OrderTargetingUnit(AbilityCommand("attack", 0), target), c_orderQueueReplace);
            }
        } else if (UnitOrderCount(banshee) == 0 && DistanceBetweenPoints(UnitGetPosition(banshee), UnitGetPosition(hero)) > 5.0) {
            UnitIssueOrder(banshee, OrderTargetingPoint(AbilityCommand("move", 0), UnitGetPosition(hero)), c_orderQueueReplace);
        }
    }
    // Squadron stacks 1-40 changed the Banshees' Movement Speed: re-add their buff so the live ones get it
    speed = MinI(40, libAffx_RaynorStacks("RaynorGoldenSquadronTokenCounter"));
    if (speed != libAffx_RaynorBansheeSpeed) {
        libAffx_RaynorBansheeSpeed = speed;
        for (i = 1; i <= 3; i += 1) {
            banshee = libAffx_RaynorBanshee[i];
            if (banshee != null && UnitIsAlive(banshee)) {
                UnitBehaviorRemove(banshee, "RaynorGoldenBansheeArmor", 1);
                UnitBehaviorAdd(banshee, "RaynorGoldenBansheeArmor", banshee, 1);
            }
        }
    }
    back = MaxF(1.0, CatalogFieldValueGetAsFixed(c_gameCatalogBehavior, "RaynorGoldenBansheeRespawn", "Duration", libAffx_player));
    for (i = 1; i <= 3; i += 1) {
        banshee = libAffx_RaynorBanshee[i];
        if (banshee != null && !UnitIsAlive(banshee)) {
            libAffx_RaynorBanshee[i] = null;
            libAffx_RaynorBansheeBackAt[i] = now + back;
        }
        if (libAffx_RaynorBanshee[i] == null && i <= count && now >= libAffx_RaynorBansheeBackAt[i] && UnitIsAlive(hero)) {
            libNtve_gf_CreateUnitsAtPoint2(1, "RaynorRaynorsBanshee", 0, libAffx_player, libNtve_gf_PointOffsetTowardsPoint(UnitGetPosition(hero), 4.0, libGame_gv_players[libAffx_player].lv_spawnPoint), hero);
            banshee = UnitLastCreated();
            libAffx_RaynorBanshee[i] = banshee;
            UnitCreateEffectUnit(hero, "RaynorBansheeApplyTimeoutBehavior", banshee);
            UnitBehaviorAdd(banshee, "RaynorGoldenBansheeArmor", banshee, 1);
            UnitGroupAdd(libGame_gv_players[libAffx_player].lv_summonedUnitGroup, banshee);
        }
    }
    return true;
}
bool libAffx_RaynorTick_Func (bool testConds, bool runActions) {
    libAffx_RaynorRoundSync();
    libAffx_RaynorBigOneSync();
    libAffx_RaynorPepperSync();
    return true;
}
// Penetrator hit on an enemy Hero: takedown window, RaynorGoldenImpactTokenCounter, the heal, and on-hit boons
bool libAffx_RaynorRoundHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_RaynorHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_RaynorIsEnemyHero(victim) || !UnitHasBehavior2(hero, "RaynorPenetratorMarker")) {
        return false;
    }
    libAffx_RaynorRoundTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "RaynorGoldenImpactTokenCounter", hero);
    return true;
}
// Sergeant Pepper hit on an enemy Hero: takedown window, None, the heal, and on-hit boons
bool libAffx_RaynorPepperHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_RaynorHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_RaynorIsEnemyHero(victim) || !UnitHasBehavior2(hero, "RaynorPepperMarker")) {
        return false;
    }
    libAffx_RaynorPepperTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}
// Raider Captain hit on an enemy Hero: takedown window, RaynorGoldenAirSupportTokenCounter, the heal, and on-hit boons
bool libAffx_RaynorRaiderHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_RaynorHero();
    if (hero == null || EventUnitDamageSourcePlayer() != libAffx_player || !libAffx_RaynorIsEnemyHero(victim) || !UnitHasBehavior2(hero, "RaynorRaiderMarker")) {
        return false;
    }
    libAffx_RaynorRaiderTime[UnitGetOwner(victim)] = GameGetMissionTime();
    libGame_gf_ModifyTokenCount(1, "RaynorGoldenAirSupportTokenCounter", hero);
    if (UnitHasBehavior2(hero, "RaynorRaiderSwarmMarker")) {
        UnitCreateEffectUnit(hero, "RaynorGoldenSwarmDamage", victim);
    }
    return true;
}
// Takedown quests count for each other: each starter keeps its own count (a starter taken later starts from its
// own saved count), but a takedown that counts for any taken starter adds 1 to every taken starter's takedown quest
int[4] libAffx_RaynorTakedownBefore; // each starter's takedown stacks before this takedown
void libAffx_RaynorTakedownCrossStart () {
    unit hero = libAffx_RaynorHero();
    if (hero == null) {
        return;
    }
    libAffx_RaynorTakedownBefore[1] = FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenBreachTokenCounter"));
    libAffx_RaynorTakedownBefore[2] = FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenSharpshooterTokenCounter"));
    libAffx_RaynorTakedownBefore[3] = FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenSquadronTokenCounter"));
}
void libAffx_RaynorTakedownCross () {
    unit hero = libAffx_RaynorHero();
    if (hero == null) {
        return;
    }
    if (FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenBreachTokenCounter")) == libAffx_RaynorTakedownBefore[1] && FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenSharpshooterTokenCounter")) == libAffx_RaynorTakedownBefore[2] && FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenSquadronTokenCounter")) == libAffx_RaynorTakedownBefore[3]) {
        return;
    }
    if (UnitHasBehavior2(hero, "RaynorPenetratorMarker") && FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenBreachTokenCounter")) == libAffx_RaynorTakedownBefore[1]) {
        libGame_gf_ModifyTokenCount(1, "RaynorGoldenBreachTokenCounter", hero);
        libAffx_RaynorSyncRound();
        libAffx_RaynorRoundSync();
    }
    if (UnitHasBehavior2(hero, "RaynorPepperMarker") && FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenSharpshooterTokenCounter")) == libAffx_RaynorTakedownBefore[2]) {
        libGame_gf_ModifyTokenCount(1, "RaynorGoldenSharpshooterTokenCounter", hero);
        libAffx_RaynorSyncPepper();
        libAffx_RaynorPepperSync();
    }
    if (UnitHasBehavior2(hero, "RaynorRaiderMarker") && FixedToInt(UnitGetTokenCount(hero, "RaynorGoldenSquadronTokenCounter")) == libAffx_RaynorTakedownBefore[3]) {
        libGame_gf_ModifyTokenCount(1, "RaynorGoldenSquadronTokenCounter", hero);
        libAffx_RaynorSyncRaider();
    }
}
// HeroTakedown: the takedown quests and takedown boons
bool libAffx_RaynorTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_RaynorHero();
    fixed now = GameGetMissionTime();
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    libAffx_RaynorTakedownCrossStart();
    if (UnitHasBehavior2(hero, "RaynorPenetratorMarker") && libAffx_RaynorRoundTime[killedPlayer] > 0.0 && now - libAffx_RaynorRoundTime[killedPlayer] <= 6.0) {
        libAffx_RaynorRoundTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "RaynorGoldenBreachTokenCounter", hero);
        libAffx_RaynorSyncRound();
        libAffx_RaynorQuestDing();
        libAffx_RaynorRoundSync();
    }
    if (UnitHasBehavior2(hero, "RaynorPepperMarker") && libAffx_RaynorPepperTime[killedPlayer] > 0.0 && now - libAffx_RaynorPepperTime[killedPlayer] <= 6.0) {
        libAffx_RaynorPepperTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "RaynorGoldenSharpshooterTokenCounter", hero);
        libAffx_RaynorSyncPepper();
        libAffx_RaynorQuestDing();
        libAffx_RaynorPepperSync();
    }
    if (UnitHasBehavior2(hero, "RaynorRaiderMarker") && libAffx_RaynorRaiderTime[killedPlayer] > 0.0 && now - libAffx_RaynorRaiderTime[killedPlayer] <= 6.0) {
        libAffx_RaynorRaiderTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "RaynorGoldenSquadronTokenCounter", hero);
        libAffx_RaynorSyncRaider();
        libAffx_RaynorQuestDing();
    }
    libAffx_RaynorTakedownCross();
    return true;
}
bool libAffx_RaynorStart (bool testConds, bool runActions) {
    trigger trig;
    if (libAffx_RaynorStarted) {
        return true;
    }
    libAffx_RaynorStarted = true;
    trig = TriggerCreate("libAffx_RaynorRoundHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RaynorPenetratingRoundDamage");
    trig = TriggerCreate("libAffx_RaynorPepperHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RaynorHeroWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RaynorGiveEmSomePepperWeaponDamage");
    trig = TriggerCreate("libAffx_RaynorRaiderHit_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RaynorRaynorsRaidersDamage");
    libAffx_RaynorBoonBehaviors[1] = "AffixAllRounderBehavior";
    libAffx_RaynorBoonBehaviors[2] = "AffixAmplificationBehavior";
    libAffx_RaynorBoonBehaviors[3] = "AffixAmplifiedHealingBehavior";
    libAffx_RaynorBoonBehaviors[4] = "AffixBlessingoftheDragons";
    libAffx_RaynorBoonBehaviors[5] = "AffixBloodlust";
    libAffx_RaynorBoonBehaviors[6] = "AffixBloodlustSpell";
    libAffx_RaynorBoonBehaviors[7] = "AffixChronoBoostBehavior";
    libAffx_RaynorBoonBehaviors[8] = "AffixDemolitionistBehavior";
    libAffx_RaynorBoonBehaviors[9] = "AffixEfficientGunsBehavior";
    libAffx_RaynorBoonBehaviors[10] = "AffixEnduranceBehavior";
    libAffx_RaynorBoonBehaviors[11] = "AffixFastFeetBehavior";
    libAffx_RaynorBoonBehaviors[12] = "AffixFirstAidBehavior";
    libAffx_RaynorBoonBehaviors[13] = "AffixGatheringPowerBehavior";
    libAffx_RaynorBoonBehaviors[14] = "AffixLifeStealBehavior";
    libAffx_RaynorBoonBehaviors[15] = "AffixMercenaryLordBuff";
    libAffx_RaynorBoonBehaviors[16] = "AffixMinionKillerBehavior";
    libAffx_RaynorBoonBehaviors[17] = "AffixNanoBoost";
    libAffx_RaynorBoonBehaviors[18] = "AffixNexusFrenzyBehavior";
    libAffx_RaynorBoonBehaviors[19] = "AffixNexusRangeBuff";
    libAffx_RaynorBoonBehaviors[20] = "AffixOverwhelmingPowerBehavior";
    libAffx_RaynorBoonBehaviors[21] = "AffixPathoftheAssassinBehavior";
    libAffx_RaynorBoonBehaviors[22] = "AffixPathoftheWarriorBehavior";
    libAffx_RaynorBoonBehaviors[23] = "AffixPhysicalArmorBehavior";
    libAffx_RaynorBoonBehaviors[24] = "AffixPhysicalLeechBehavior";
    libAffx_RaynorBoonBehaviors[25] = "AffixPhysicalLeechSpell";
    libAffx_RaynorBoonBehaviors[26] = "AffixPowerfulBehavior";
    libAffx_RaynorBoonBehaviors[27] = "AffixResilienceBehavior";
    libAffx_RaynorBoonBehaviors[28] = "AffixRingofRegenerationBehavior";
    libAffx_RaynorBoonBehaviors[29] = "AffixSearingAttacksBehavior";
    libAffx_RaynorBoonBehaviors[30] = "AffixSelfReliantBehavior";
    libAffx_RaynorBoonBehaviors[31] = "AffixSelfReliantNoManaBehavior";
    libAffx_RaynorBoonBehaviors[32] = "AffixSpellArmorBehavior";
    libAffx_RaynorBoonBehaviors[33] = "AffixSpellLeechBehavior";
    libAffx_RaynorBoonBehaviors[34] = "AffixSpellShieldActive";
    libAffx_RaynorBoonBehaviors[35] = "AffixSpellcastingBehavior";
    libAffx_RaynorBoonBehaviors[36] = "AffixStrength";
    libAffx_RaynorBoonBehaviors[37] = "AffixSuperiorityBehavior";
    libAffx_RaynorBoonBehaviors[38] = "PreparedDamageBehavior";
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_RaynorTick_Func"), 1.0, c_timeGame);
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_RaynorBanshees_Func"), 0.25, c_timeGame);
    TriggerAddEventUnitBehaviorChange(TriggerCreate("libAffx_RaynorSharedRush_Func"), null, "RaynorAdrenalineRushHoT", c_unitBehaviorChangeCreate);
    trig = TriggerCreate("libAffx_RaynorAttackTrack_Func");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RaynorHeroWeaponDamage");
    TriggerAddEventUnitDamaged(trig, null, c_unitDamageTypeAny, c_unitDamageEither, "RaynorGiveEmSomePepperWeaponDamage");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_RaynorRoundCast_Func"), libAffx_player, "RaynorPenetratingRoundCreateSet");
    libGame_gf_HeroKilled(TriggerCreate("libAffx_RaynorGambitDeath_Func"));
    // also picks up stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_RaynorSync_Func"), 1.0, c_timeGame);
    return true;
}
