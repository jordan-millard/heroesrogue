    unit hero = libAffx_RaynorHero();
    int stacks;
    int wanted;
    string bonus;
    int power;
    if (hero == null || !UnitHasBehavior2(hero, "RaynorPepperMarker")) {
        return;
    }
    stacks = libAffx_RaynorStacks("RaynorGoldenSharpshooterTokenCounter");
    wanted = MinI(stacks, 40);
    if (wanted != libAffx_RaynorPepperAdded) {
        libAffx_CatalogReferenceModify("Behavior,RaynorGoldenPepperDrill,Modification.AdditiveAttackSpeedFactor", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_RaynorPepperAdded) * 0.005, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_RaynorPepperAdded = wanted;
    }
    // stage 2 (stacks 41 to 80): 0.5% Basic Attack range each (of 5.5)
    wanted = MaxI(0, MinI(stacks - 40, 40));
    if (wanted != libAffx_RaynorPepperAdded2) {
        libAffx_CatalogReferenceModify("Behavior,RaynorGoldenPepperDrill,Modification.WeaponRange", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_RaynorPepperAdded2) * 0.0275, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_CatalogReferenceModify("Behavior,RaynorGoldenPepperDrill,Modification.WeaponScanBonus", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_RaynorPepperAdded2) * 0.0275, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_RaynorPepperAdded2 = wanted;
    }
    // stage 3 (stacks 81 to 100): 1% execute chance each
    wanted = MaxI(0, MinI(stacks - 80, 20));
    if (wanted != libAffx_RaynorPepperAdded3) {
        libAffx_CatalogReferenceModify("Effect,RaynorGoldenPepperExecute,Chance", libAffx_player, FixedToString(IntToFixed(wanted - libAffx_RaynorPepperAdded3) * 0.01, c_fixedPrecisionAny), c_upgradeOperationAdd);
        libAffx_RaynorPepperAdded3 = wanted;
    }
    // stacks past 100: 0.02 each to all damage
    power = MaxI(0, stacks - 100);
