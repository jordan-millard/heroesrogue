        UnitBehaviorRemove(hero, "RaynorPepperPastCapDamage", 1);
    }
    if (power > 0 && !UnitHasBehavior2(hero, "RaynorPepperPastCapDamage")) {
        UnitBehaviorAdd(hero, "RaynorPepperPastCapDamage", hero, 1);
    }
}
// RaynorGoldenSquadronTokenCounter: stacks 1-40: 0.5% Banshee Movement Speed each (libAffx_RaynorBanshees_Func re-adds the buff); 41-80 respawn time, 81-100 Health, 100 a third Banshee (libAffx_RaynorBanshees_Func), then damage
