include "AffixTriggers"

// ============================================================
// Golden Nova.
// Deadeye, Confirmed Kill quest: an enemy Hero takedown within 2 seconds of a Snipe hit adds 1% Snipe range. Killshot
// (Legendary): that takedown also refunds Snipe's cooldown and Mana and resets Permanent Cloak. Steady Aim (35% kept
// between games), Headshot and the 2-stack miss penalty are in NovaData.xml.
// Crippling Fire, Hunter's Mark quest: an enemy Hero takedown within 3 seconds of a Pinning Shot hit adds 1% damage
// against enemies Slowed by Pinning Shot. Ricochet (Legendary): Pinning Shot also hits the nearest other enemy Hero.
// Holo Corps, Phantom Strike quest: an enemy Hero takedown while a Decoy is alive adds 2% Decoy damage; Illusionist
// (this game only) counts Decoy hits on enemy Heroes. Decoys deal the damage, so both counts are copied onto each Decoy
// when it spawns. Mimicry (Epic): Decoys cast Snipe and Pinning Shot along with Nova.
// Stacks carry over between games through QuestRetain.
// ============================================================

const fixed libAffx_novaSnipeWindow = 2.0;
const fixed libAffx_novaSnipeBaseRange = 10.0; // SnipeCreatePersistent's first offset is Y -10
const fixed libAffx_novaRangePerStack = 0.01; // Confirmed Kill
// The Snipe missile (speed 50) only hits while SnipeMissileScanPersistent runs: PeriodCount 4 x 0.0625 seconds covers
// about 12.5 range, so longer Snipes need more scan periods
const fixed libAffx_novaSnipeScanRangePerPeriod = 3.125;
const int libAffx_novaSnipeScanMinPeriods = 4;
const fixed libAffx_novaPinWindow = 3.0;
const fixed libAffx_novaRicochetRadius = 6.0;
const fixed libAffx_novaRicochetDelay = 0.15;

bool libAffx_novaStarted;
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_novaSnipeTime; // per enemy player, last Snipe hit
fixed[libCore_gv_bALMaxPlayers + 1] libAffx_novaPinTime; // per enemy player, last Pinning Shot hit
fixed libAffx_novaSnipeRangeAdded; // Snipe range added by Confirmed Kill this game

unit libAffx_NovaHero() {
    return libGame_gv_players[libAffx_player].lv_heroUnit;
}
bool libAffx_NovaIsEnemyHero(unit target) {
    int owner = UnitGetOwner(target);
    if (!UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) {
        return false;
    }
    return owner >= 1 && owner <= libCore_gv_bALMaxPlayers && owner != libAffx_player;
}
void libAffx_NovaQuestDing() {
    SoundPlayForPlayer(SoundLink("TalentQuestProgressCounterIncreaseSound", -1), c_maxPlayers, PlayerGroupSingle(libAffx_player), 100.0, 0.0);
}
unitgroup libAffx_NovaDecoys() {
    return UnitGroup("NovaHoloClone", libAffx_player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
}
// Adds n to a token on Nova and on every live Decoy (the Decoys' copies feed their damage)
void libAffx_NovaAddDecoyToken(string token, int n) {
    unitgroup decoys = libAffx_NovaDecoys();
    unit decoy;
    int i;
    libGame_gf_ModifyTokenCount(n, token, libAffx_NovaHero());
    for (i = UnitGroupCount(decoys, c_unitCountAll); i > 0; i -= 1) {
        decoy = UnitGroupUnitFromEnd(decoys, i);
        if (decoy != null && UnitIsAlive(decoy) && UnitHasBehavior2(decoy, token)) {
            libGame_gf_ModifyTokenCount(n, token, decoy);
        }
    }
}

// ---------- Deadeye ----------

// Moves one of SnipeCreatePersistent's "X,Y,Z" offsets further forward (more negative Y), the way GameLib applies
// Psionic Efficiency
void libAffx_NovaExtendSnipeOffset (string field, fixed delta) {
    string offset = StringReplaceWord(CatalogFieldValueGet(c_gameCatalogEffect, "SnipeCreatePersistent", field, libAffx_player), ",", " ", c_stringReplaceAll, c_stringCase);
    fixed y = StringToFixed(StringWord(offset, 2)) - delta;
    CatalogFieldValueSet(c_gameCatalogEffect, "SnipeCreatePersistent", field, libAffx_player, StringWord(offset, 1) + "," + FixedToString(y, 2) + "," + StringWord(offset, 3));
}

// Confirmed Kill: Snipe range is 1% of its base range higher per stack. Adds only the change since the last sync, so it
// stacks with Psionic Efficiency whichever is applied first.
void libAffx_NovaSyncSnipeRange () {
    unit hero = libAffx_NovaHero();
    fixed wanted;
    fixed delta;
    string offset;
    int periods;
    if (hero == null || !UnitHasBehavior2(hero, "NovaDeadeyeMarker")) {
        return;
    }
    // scan long enough to reach the missile's target offset (checked every sync, since Psionic Efficiency also moves it)
    offset = StringReplaceWord(CatalogFieldValueGet(c_gameCatalogEffect, "SnipeCreatePersistent", "PeriodicOffsetArray[1]", libAffx_player), ",", " ", c_stringReplaceAll, c_stringCase);
    periods = MaxI(libAffx_novaSnipeScanMinPeriods, FixedToInt(-StringToFixed(StringWord(offset, 2)) / libAffx_novaSnipeScanRangePerPeriod) + 1);
    if (CatalogFieldValueGetAsInt(c_gameCatalogEffect, "SnipeMissileScanPersistent", "PeriodCount", libAffx_player) != periods) {
        CatalogFieldValueSetInt(c_gameCatalogEffect, "SnipeMissileScanPersistent", "PeriodCount", libAffx_player, periods);
    }
    wanted = libAffx_novaSnipeBaseRange * libAffx_novaRangePerStack * UnitGetTokenCount(hero, "NovaConfirmedKillTokenCounter");
    delta = wanted - libAffx_novaSnipeRangeAdded;
    if (AbsF(delta) < 0.01) {
        return;
    }
    libAffx_NovaExtendSnipeOffset("PeriodicOffsetArray[0]", delta);
    libAffx_NovaExtendSnipeOffset("PeriodicOffsetArray[1]", delta);
    CatalogFieldValueSetFixed(c_gameCatalogActor, "NovaSnipeGuide", "Height", libAffx_player, CatalogFieldValueGetAsFixed(c_gameCatalogActor, "NovaSnipeGuide", "Height", libAffx_player) + delta);
    libAffx_novaSnipeRangeAdded = wanted;
}
bool libAffx_NovaSync_Func (bool testConds, bool runActions) {
    libAffx_NovaSyncSnipeRange();
    return true;
}

// Snipe hit on an enemy Hero by Nova: opens the Confirmed Kill window
bool libAffx_NovaSnipeHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    if (EventUnitDamageSourceUnit() != libAffx_NovaHero() || !libAffx_NovaIsEnemyHero(victim)) {
        return false;
    }
    libAffx_novaSnipeTime[UnitGetOwner(victim)] = GameGetMissionTime();
    return true;
}

// ---------- Crippling Fire ----------

// Pinning Shot hit by Nova: opens the Hunter's Mark window, and Ricochet bounces it to the nearest other enemy Hero
bool libAffx_NovaPinHit_Func (bool testConds, bool runActions) {
    unit victim = EventUnit();
    unit hero = libAffx_NovaHero();
    unitgroup nearby;
    unit other;
    unit target;
    int i;
    if (hero == null || victim == null || EventUnitDamageSourceUnit() != hero) {
        return false;
    }
    if (libAffx_NovaIsEnemyHero(victim)) {
        libAffx_novaPinTime[UnitGetOwner(victim)] = GameGetMissionTime();
    }
    if (!UnitHasBehavior2(hero, "NovaRicochetMarker") || UnitHasBehavior2(victim, "NovaRicochetHit")) {
        return true;
    }
    nearby = UnitGroupAlliance(libAffx_player, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(victim), libAffx_novaRicochetRadius), UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), 0), 0);
    UnitGroupRemove(nearby, victim);
    for (i = UnitGroupCount(nearby, c_unitCountAll); i > 0; i -= 1) {
        other = UnitGroupUnitFromEnd(nearby, i);
        if (other == null || !UnitIsAlive(other) || !libAffx_NovaIsEnemyHero(other)) {
            UnitGroupRemove(nearby, other);
        }
    }
    if (UnitGroupCount(nearby, c_unitCountAll) == 0) {
        return true;
    }
    target = UnitGroupClosestToPoint(nearby, UnitGetPosition(victim));
    // marked first so the bounce's own hit doesn't bounce again
    UnitBehaviorAdd(target, "NovaRicochetHit", hero, 1);
    Wait(libAffx_novaRicochetDelay, c_timeGame);
    if (UnitIsAlive(target) && UnitIsAlive(hero)) {
        UnitCreateEffectUnit(hero, "PinningShotImpactSet", target);
    }
    return true;
}

// ---------- Holo Corps ----------

// Decoys are their own units, so Nova's general boons (on her as behaviors) don't reach them. Copy the ones that fit a
// Decoy: attack speed and range, damage, leech, on-hit procs, armor and dodge. Health boons are left out (a Decoy spawns
// with Nova's current Health).
const int libAffx_NovaDecoyBoonCount = 23;
string[libAffx_NovaDecoyBoonCount] libAffx_NovaDecoyBoons;
void libAffx_NovaDecoyBoonsInit () {
    libAffx_NovaDecoyBoons[0] = "AffixNexusRangeBuff";
    libAffx_NovaDecoyBoons[1] = "AffixNexusFrenzyBehavior";
    libAffx_NovaDecoyBoons[2] = "AffixBloodlust";
    libAffx_NovaDecoyBoons[3] = "AffixNanoBoost";
    libAffx_NovaDecoyBoons[4] = "AffixAmplificationBehavior";
    libAffx_NovaDecoyBoons[5] = "AffixSearingAttacksBehavior";
    libAffx_NovaDecoyBoons[6] = "AffixPathoftheAssassinBehavior";
    libAffx_NovaDecoyBoons[7] = "AffixAllRounderBehavior";
    libAffx_NovaDecoyBoons[8] = "AffixGatheringPowerBehavior";
    libAffx_NovaDecoyBoons[9] = "AffixDemolitionistBehavior";
    libAffx_NovaDecoyBoons[10] = "AffixMinionKillerBehavior";
    libAffx_NovaDecoyBoons[11] = "AffixPhysicalLeechBehavior";
    libAffx_NovaDecoyBoons[12] = "AffixSpellLeechBehavior";
    libAffx_NovaDecoyBoons[13] = "AffixStrength";
    libAffx_NovaDecoyBoons[14] = "PreparedDamageBehavior";
    libAffx_NovaDecoyBoons[15] = "AffixGiantKiller";
    libAffx_NovaDecoyBoons[16] = "AffixCleaverController";
    libAffx_NovaDecoyBoons[17] = "AffixSuperiorityBehavior";
    libAffx_NovaDecoyBoons[18] = "AffixSpellArmorBehavior";
    libAffx_NovaDecoyBoons[19] = "AffixPhysicalArmorBehavior";
    libAffx_NovaDecoyBoons[20] = "AffixDodgeController";
    libAffx_NovaDecoyBoons[21] = "NimbleBehavior";
    libAffx_NovaDecoyBoons[22] = "NimbleStructureBehavior";
}
void libAffx_NovaCopyBoons (unit hero, unit decoy) {
    int i;
    int stacks;
    for (i = 0; i < libAffx_NovaDecoyBoonCount; i += 1) {
        stacks = UnitBehaviorCount(hero, libAffx_NovaDecoyBoons[i]);
        if (stacks > 0 && !UnitHasBehavior2(decoy, libAffx_NovaDecoyBoons[i])) {
            UnitBehaviorAdd(decoy, libAffx_NovaDecoyBoons[i], decoy, stacks);
        }
    }
}

// A Decoy spawned: it gets Nova's general boons. With Holo Corps it also takes half damage instead of double, and gets
// copies of the Decoy damage quest counts.
bool libAffx_NovaDecoySpawned_Func (bool testConds, bool runActions) {
    unit decoy = EventUnitCreatedUnit();
    unit hero = libAffx_NovaHero();
    int count;
    if (hero == null || UnitGetType(decoy) != "NovaHoloClone" || UnitGetOwner(decoy) != libAffx_player) {
        return false;
    }
    libAffx_NovaCopyBoons(hero, decoy);
    if (!UnitHasBehavior2(hero, "NovaHoloCorpsMarker")) {
        return true;
    }
    UnitBehaviorAdd(decoy, "NovaHoloCorpsDecoyGuard", decoy, 1);
    UnitBehaviorAdd(decoy, "NovaIllusionistTokenCounter", decoy, 1);
    UnitBehaviorAdd(decoy, "NovaPhantomStrikeTokenCounter", decoy, 1);
    count = FixedToInt(UnitGetTokenCount(hero, "NovaIllusionistTokenCounter"));
    if (count > 0) {
        libGame_gf_ModifyTokenCount(count, "NovaIllusionistTokenCounter", decoy);
    }
    count = FixedToInt(UnitGetTokenCount(hero, "NovaPhantomStrikeTokenCounter"));
    if (count > 0) {
        libGame_gf_ModifyTokenCount(count, "NovaPhantomStrikeTokenCounter", decoy);
    }
    return true;
}

// Illusionist: a Decoy damaged an enemy Hero
bool libAffx_NovaDecoyDamage_Func (bool testConds, bool runActions) {
    unit source = EventUnitDamageSourceUnit();
    unit hero = libAffx_NovaHero();
    if (hero == null || source == null || UnitGetType(source) != "NovaHoloClone" || UnitGetOwner(source) != libAffx_player) {
        return false;
    }
    if (!UnitHasBehavior2(hero, "NovaHoloCorpsMarker") || !libAffx_NovaIsEnemyHero(EventUnit()) || EventUnitDamageAmount() <= 0.0) {
        return false;
    }
    libAffx_NovaAddDecoyToken("NovaIllusionistTokenCounter", 1);
    return true;
}

// Mimicry: when Nova casts Snipe or Pinning Shot, every Decoy casts it too
void libAffx_NovaMimic (order ord) {
    unitgroup decoys = libAffx_NovaDecoys();
    unit decoy;
    int i;
    for (i = UnitGroupCount(decoys, c_unitCountAll); i > 0; i -= 1) {
        decoy = UnitGroupUnitFromEnd(decoys, i);
        if (decoy != null && UnitIsAlive(decoy)) {
            UnitSetPropertyFixed(decoy, c_unitPropEnergy, UnitGetPropertyFixed(decoy, c_unitPropEnergyMax, c_unitPropCurrent));
            UnitIssueOrder(decoy, ord, c_orderQueueReplace);
            UnitIssueOrder(decoy, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(decoy)), c_orderQueueAddToEnd);
        }
    }
}
bool libAffx_NovaMimicSnipe_Func (bool testConds, bool runActions) {
    unit hero = libAffx_NovaHero();
    if (hero == null || EventPlayerEffectUsedUnit(c_effectUnitCaster) != hero || !UnitHasBehavior2(hero, "NovaMimicryMarker")) {
        return false;
    }
    libAffx_NovaMimic(OrderTargetingPoint(AbilityCommand("NovaSnipeStorm", 0), EventPlayerEffectUsedPoint(c_effectLocationTargetPoint)));
    return true;
}
bool libAffx_NovaMimicPin_Func (bool testConds, bool runActions) {
    unit hero = libAffx_NovaHero();
    unit target = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    if (hero == null || target == null || EventPlayerEffectUsedUnit(c_effectUnitCaster) != hero || !UnitHasBehavior2(hero, "NovaMimicryMarker")) {
        return false;
    }
    libAffx_NovaMimic(OrderTargetingUnit(AbilityCommand("NovaPinningShot", 0), target));
    return true;
}

// HeroTakedown for Confirmed Kill, Killshot, Hunter's Mark and Phantom Strike
bool libAffx_NovaTakedown (bool testConds, bool runActions) {
    int killedPlayer = libGame_gf_HeroParticipatedInTakedownKilledPlayer();
    unit hero = libAffx_NovaHero();
    fixed now = GameGetMissionTime();
    unitgroup decoys;
    if (testConds) {
        if (libGame_gf_HeroParticipatedInTakedownKillingPlayer() != libAffx_player || hero == null) {
            return false;
        }
    }
    if (killedPlayer < 1 || killedPlayer > libCore_gv_bALMaxPlayers) {
        return true;
    }
    if (UnitHasBehavior2(hero, "NovaDeadeyeMarker") && libAffx_novaSnipeTime[killedPlayer] > 0.0 && now - libAffx_novaSnipeTime[killedPlayer] <= libAffx_novaSnipeWindow) {
        libAffx_novaSnipeTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "NovaConfirmedKillTokenCounter", hero);
        libAffx_NovaSyncSnipeRange();
        libAffx_NovaQuestDing();
        if (UnitHasBehavior2(hero, "NovaKillshotMarker") && UnitIsAlive(hero)) {
            UnitCreateEffectUnit(hero, "NovaKillshotSet", hero);
        }
    }
    if (UnitHasBehavior2(hero, "NovaCripplingFireMarker") && libAffx_novaPinTime[killedPlayer] > 0.0 && now - libAffx_novaPinTime[killedPlayer] <= libAffx_novaPinWindow) {
        libAffx_novaPinTime[killedPlayer] = 0.0;
        libGame_gf_ModifyTokenCount(1, "NovaHuntersMarkTokenCounter", hero);
        libAffx_NovaQuestDing();
    }
    if (UnitHasBehavior2(hero, "NovaHoloCorpsMarker")) {
        decoys = libAffx_NovaDecoys();
        if (UnitGroupCount(decoys, c_unitCountAlive) > 0) {
            libAffx_NovaAddDecoyToken("NovaPhantomStrikeTokenCounter", 1);
            libAffx_NovaQuestDing();
        }
    }
    return true;
}

// AffixAdded for all three starters
bool libAffx_NovaStart (bool testConds, bool runActions) {
    trigger snipeHit;
    trigger pinHit;
    trigger decoyDamage;
    trigger decoySpawned;
    if (libAffx_novaStarted) {
        return true;
    }
    libAffx_novaStarted = true;
    libAffx_NovaDecoyBoonsInit();
    snipeHit = TriggerCreate("libAffx_NovaSnipeHit_Func");
    TriggerAddEventUnitDamaged(snipeHit, null, c_unitDamageTypeAny, c_unitDamageEither, "StormSnipeDamage");
    TriggerAddEventUnitDamaged(snipeHit, null, c_unitDamageTypeAny, c_unitDamageEither, "SnipeExplosiveDamage");
    pinHit = TriggerCreate("libAffx_NovaPinHit_Func");
    TriggerAddEventUnitDamaged(pinHit, null, c_unitDamageTypeAny, c_unitDamageEither, "PinningShotDamage");
    decoyDamage = TriggerCreate("libAffx_NovaDecoyDamage_Func");
    TriggerAddEventUnitDamaged(decoyDamage, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    decoySpawned = TriggerCreate("libAffx_NovaDecoySpawned_Func");
    TriggerAddEventUnitCreated(decoySpawned, null, "NovaHoloDecoy", null);
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_NovaMimicSnipe_Func"), libAffx_player, "NovaSnipeInitialSet");
    TriggerAddEventPlayerEffectUsed(TriggerCreate("libAffx_NovaMimicPin_Func"), libAffx_player, "PinningShotSet");
    // also picks up Confirmed Kill stacks loaded from the bank
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_NovaSync_Func"), 1.0, c_timeGame);
    return true;
}
